      Contact page (settings.contact_page, fallback pages['contact-us']),
      installation guide (Dutch only), shipping policy.
    endcomment
    assign bpf_contact_page = settings.contact_page
    if bpf_contact_page == blank
      assign bpf_contact_page = pages['contact-us']
    endif
    assign bpf_contact_url = ''
    if bpf_contact_page != blank
      capture bpf_contact_url
        render 'localized-internal-url', url: bpf_contact_page.url
      endcapture
      assign bpf_contact_url = bpf_contact_url | strip
    endif
    assign bpf_guide_url = ''
    assign bpf_guide = articles['gids/douchekop-vervangen-in-5-minuten']
    if bpf_guide != blank and bpf_guide.url != blank
      capture bpf_guide_url
        render 'localized-internal-url', url: bpf_guide.url
      endcapture
      assign bpf_guide_url = bpf_guide_url | strip
    endif
    assign bpf_shipping_url = ''
    if shop.shipping_policy != blank and shop.shipping_policy.url != blank
      capture bpf_shipping_url
        render 'localized-internal-url', url: shop.shipping_policy.url
      endcapture
      assign bpf_shipping_url = bpf_shipping_url | strip
    endif

    comment
      Refill set = first non-head product of the first collection whose
      handle contains 'filter'. Filtered alternative = a shower head with a
      filter from the primary showerheads collection (same hose state first).
    endcomment
    assign bpf_refill_found = false
    for bpf_collection in collections
      assign bpf_collection_handle = bpf_collection.handle | downcase
      if bpf_collection_handle contains 'filter'
        for bpf_candidate in bpf_collection.products limit: 12
          if bpf_candidate.id == bpf_product.id
            continue
          endif
          capture bpf_capture
            render 'is-shower-head', product: bpf_candidate
          endcapture
          assign bpf_candidate_head = bpf_capture | strip
          if bpf_candidate_head != 'true'
            assign bpf_refill = bpf_candidate
            assign bpf_refill_found = true
            break
          endif
        endfor
        break
      endif
    endfor

    assign bpf_head_collection = settings.shower_collection
    if bpf_head_collection == blank
      assign bpf_head_collection = collections['badkamer-douche']
    endif
    if bpf_head_collection == blank
      assign bpf_head_collection = collections['douchekoppen']
    endif
    if bpf_head_collection == blank
      assign bpf_head_collection = collections['showerheads']
    endif
    if bpf_head_collection == blank
      assign bpf_head_collection = collections['douche']
    endif
    if bpf_head_collection == blank
      assign bpf_head_collection = collections['shower']
    endif
    if bpf_head_collection == blank
      assign bpf_head_collection = bpf_product.collections.first
    endif
    assign bpf_filtered_alt_found = false
    assign bpf_filtered_alt_same_hose = false
    if bpf_is_head == 'true' and bpf_filter != 'true' and bpf_head_collection != blank
      for bpf_candidate in bpf_head_collection.products limit: 24
        if bpf_candidate.id == bpf_product.id
          continue
        endif
        capture bpf_capture
          render 'is-shower-head', product: bpf_candidate
        endcapture
        assign bpf_candidate_head = bpf_capture | strip
        if bpf_candidate_head != 'true'
          continue
        endif
        capture bpf_capture
          render 'shower-filter-state', product: bpf_candidate
        endcapture
        assign bpf_candidate_filter = bpf_capture | strip
        if bpf_candidate_filter != 'true'
          continue
        endif
        capture bpf_capture
          render 'shower-hose-state', product: bpf_candidate
        endcapture
        assign bpf_candidate_hose = bpf_capture | strip
        if bpf_filtered_alt_found == false
          assign bpf_filtered_alt = bpf_candidate
          assign bpf_filtered_alt_found = true
          if bpf_candidate_hose == bpf_hose
            assign bpf_filtered_alt_same_hose = true
          endif
        elsif bpf_filtered_alt_same_hose == false and bpf_candidate_hose == bpf_hose
          assign bpf_filtered_alt = bpf_candidate
          assign bpf_filtered_alt_same_hose = true
        endif
      endfor
    endif
  -%}
  <details data-besjaar-product-faq>
    <summary>{{ bpf_label }}</summary>
    <div>
      {%- if bpf_is_head == 'true' -%}
        <p><strong>{{ bpf_q_fit }}</strong><br>
          {%- if bpf_filter == 'true' -%}
            {{ bpf_a_fit_filter }}
          {%- else -%}
            {{ bpf_a_fit_other }}
            {%- if bpf_contact_url != blank %} {{ bpf_a_fit_contact_prefix }}<a href="{{ bpf_contact_url }}">{{ bpf_a_fit_contact_link }}</a>.{%- endif -%}
          {%- endif -%}
          {%- if bpf_guide_url != blank %} <a href="{{ bpf_guide_url }}">{{ bpf_guide_link }}</a>{%- endif -%}
        </p>
        {%- if bpf_modes != blank -%}
          <p><strong>{{ bpf_q_modes }}</strong><br>{{ bpf_a_modes_prefix }}{{ bpf_modes }}{{ bpf_a_modes_suffix }}{% if bpf_modes == '10' %}{{ bpf_a_modes_10 }}{% elsif bpf_modes == '3' %}{{ bpf_a_modes_3 }}{% endif %}.</p>
        {%- endif -%}
        {%- if bpf_filter == 'true' -%}
          <p><strong>{{ bpf_q_water_filter }}</strong><br>{{ bpf_a_water_filter }}</p>
        {%- elsif bpf_modes == '3' -%}
          <p><strong>{{ bpf_q_water }}</strong><br>{{ bpf_a_water_3 }}</p>
        {%- endif -%}
        <p><strong>{{ bpf_q_filter }}</strong><br>
          {%- if bpf_filter == 'true' -%}
            {{ bpf_a_filter_yes }}
            {%- if bpf_refill_found %} <a href="{% render 'localized-internal-url', url: bpf_refill.url %}">{{ bpf_a_filter_yes_link }}</a>{%- endif -%}
          {%- else -%}
            {{ bpf_a_filter_no_prefix }}
            {%- if bpf_filtered_alt_found -%}
              {%- capture bpf_title -%}{% render 'localized-product-title', product: bpf_filtered_alt %}{%- endcapture -%}
              <a href="{% render 'localized-internal-url', url: bpf_filtered_alt.url %}">{{ bpf_title | strip | replace: '&amp;', '&' | escape_once }}</a>
            {%- else -%}
              {{ bpf_a_filter_no_name }}
            {%- endif -%}.
          {%- endif -%}
        </p>
        <p><strong>{{ bpf_q_hose }}</strong><br>{% if bpf_hose == 'true' %}{{ bpf_a_hose_yes }}{% else %}{{ bpf_a_hose_no }}{% endif %}</p>
        {%- if bpf_filter == 'true' -%}
          <p><strong>{{ bpf_q_pressure }}</strong><br>{{ bpf_a_pressure }}</p>
        {%- endif -%}
      {%- else -%}
        <p><strong>{{ bpf_q_refill_fit }}</strong><br>{{ bpf_a_refill_fit }}
          {%- if bpf_head_collection != blank -%}
            {%- capture bpf_fit_links -%}
              {%- assign bpf_fit_count = 0 -%}
              {%- for bpf_candidate in bpf_head_collection.products limit: 24 -%}
                {%- if bpf_fit_count >= 4 or bpf_candidate.id == bpf_product.id -%}{%- continue -%}{%- endif -%}
                {%- capture bpf_capture -%}{% render 'is-shower-head', product: bpf_candidate %}{%- endcapture -%}
                {%- assign bpf_candidate_head = bpf_capture | strip -%}
                {%- capture bpf_capture -%}{% render 'shower-filter-state', product: bpf_candidate %}{%- endcapture -%}
                {%- assign bpf_candidate_filter = bpf_capture | strip -%}
                {%- if bpf_candidate_head == 'true' and bpf_candidate_filter == 'true' -%}
                  {%- assign bpf_fit_count = bpf_fit_count | plus: 1 -%}
                  {%- capture bpf_title -%}{% render 'localized-product-title', product: bpf_candidate %}{%- endcapture -%}
                  {%- if bpf_fit_count > 1 %} · {% endif -%}
                  <a href="{% render 'localized-internal-url', url: bpf_candidate.url %}">{{ bpf_title | strip | replace: '&amp;', '&' | escape_once }}</a>
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- if bpf_fit_links contains '<a ' %} {{ bpf_a_refill_fit_links }} {{ bpf_fit_links }}{%- endif -%}
          {%- endif -%}
        </p>
        <p><strong>{{ bpf_q_refill_interval }}</strong><br>{{ bpf_a_refill_interval }}</p>
        <p><strong>{{ bpf_q_refill_swap }}</strong><br>{{ bpf_a_refill_swap }}</p>
      {%- endif -%}
      <p><strong>{{ bpf_q_returns }}</strong><br>{{ bpf_a_returns_prefix }}{{ bpf_returns_days }}{{ bpf_a_returns_suffix }}</p>
      {%- if bpf_warranty_months > 0 -%}
        <p><strong>{{ bpf_q_warranty }}</strong><br>{{ bpf_warranty_months }}{{ bpf_a_warranty_suffix }}</p>
      {%- endif -%}
      <p><strong>{{ bpf_q_shipping }}</strong><br>{{ bpf_a_shipping_prefix }}{{ bpf_threshold_money }}{{ bpf_a_shipping_suffix }}
        {%- if bpf_shipping_url != blank %} <a href="{{ bpf_shipping_url }}">{{ bpf_a_shipping_link }}</a>{%- endif -%}
      </p>
    </div>
  </details>
{%- endif -%}
