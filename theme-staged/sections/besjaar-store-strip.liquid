{%- liquid
  comment
    Besjaar CRO 2026-09-29: on the Dutch storefront the section's own blocks
    win over the translated spec phrases, so the strip can carry the three
    things a shopper wants to know before buying (shipping, delivery, returns)
    instead of product adjectives. Other languages keep the translated copy
    unless "use translated copy" is switched off.

    Static strip: the row carries data-bj-marquee="1" so the ticker in
    sections/besjaar-runtime-1167.liquid leaves it alone (no cloned items, no
    scrolling), and the styles below lay the items out as one fixed grid:
    all items on one line on desktop, two per row on phones.
  endcomment
  assign strip_lang = request.locale.iso_code | split: '-' | first | downcase
  assign strip_use_blocks = false
  if section.blocks.size > 0
    if section.settings.use_localized_copy == false or strip_lang == 'nl'
      assign strip_use_blocks = true
    endif
  endif
  assign strip_count = 5
  if strip_use_blocks
    assign strip_count = section.blocks.size
  endif
-%}
<style>
  body .besjaar-store-strip{overflow:hidden!important}
  body .besjaar-store-strip .besjaar-store-strip__row{display:grid!important;grid-template-columns:repeat({{ strip_count }},minmax(0,1fr))!important;width:min(1400px,calc(100% - 40px))!important;min-width:0!important;max-width:100%!important;margin-inline:auto!important;gap:0!important;padding:0!important;animation:none!important;transform:none!important}
  body .besjaar-store-strip .besjaar-store-strip__row span{min-width:0!important;justify-content:center!important;text-align:center!important;white-space:normal!important}
  body .besjaar-store-strip .besjaar-store-strip__row span:first-child{padding-left:16px!important}
  body .besjaar-store-strip .besjaar-store-strip__row span:last-child{padding-right:16px!important;border-right:0!important}
  @media (max-width:760px){
    body .besjaar-store-strip .besjaar-store-strip__row{grid-template-columns:repeat(2,minmax(0,1fr))!important;width:calc(100% - 24px)!important}
    body .besjaar-store-strip .besjaar-store-strip__row span{min-height:56px!important;padding:10px 8px!important;font-size:.62rem!important;line-height:1.3!important;border-right:0!important}
    body .besjaar-store-strip .besjaar-store-strip__row span:first-child{padding-left:8px!important}
    body .besjaar-store-strip .besjaar-store-strip__row span:last-child{padding-right:8px!important}
  }
</style>
<div class="besjaar-store besjaar-store-strip">
  <div class="besjaar-store-shell besjaar-store-strip__row" data-bj-marquee="1">
    {% if strip_use_blocks %}
      {% for block in section.blocks %}<span {{ block.shopify_attributes }}><i aria-hidden="true">✓</i>{{ block.settings.text | escape }}</span>{% endfor %}
    {% elsif section.settings.use_localized_copy %}
      <span><i aria-hidden="true">✓</i>{{ 'besjaar_store.strip.i1' | t }}</span>
      <span><i aria-hidden="true">✓</i>{{ 'besjaar_store.strip.i2' | t }}</span>
      <span><i aria-hidden="true">✓</i>{{ 'besjaar_store.strip.i3' | t }}</span>
      <span><i aria-hidden="true">✓</i>{{ 'besjaar_store.strip.i4' | t }}</span>
      <span><i aria-hidden="true">✓</i>{{ 'besjaar_store.strip.i5' | t }}</span>
    {% else %}
      <span><i aria-hidden="true">✓</i>PREMIUM CHROOMAFWERKING</span>
      <span><i aria-hidden="true">✓</i>KRACHTIGE STRAAL</span>
      <span><i aria-hidden="true">✓</i>½″ UNIVERSELE AANSLUITING</span>
      <span><i aria-hidden="true">✓</i>FILTEROPTIE BESCHIKBAAR</span>
      <span><i aria-hidden="true">✓</i>30 DAGEN BEDENKTIJD</span>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Besjaar Store spec strip",
  "settings": [
    {"type": "checkbox", "id": "use_localized_copy", "label": "Gebruik vertaalde teksten (NL/EN/DE/FR)", "default": true, "info": "Op /nl worden de blokken hieronder gebruikt zodra er blokken zijn."}
  ],
  "blocks": [
    {"type": "item", "name": "Item", "settings": [{"type": "text", "id": "text", "label": "Text", "default": "CHROOM AFWERKING"}]}
  ],
  "presets": [{"name": "Besjaar Store spec strip"}]
}
{% endschema %}
