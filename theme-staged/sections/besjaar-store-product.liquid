{{ 'besjaar-product-detail.css' | asset_url | stylesheet_tag: preload: true }}
{%- comment -%}
  Besjaar 2026-09-29 (CRO: product page): the facts a shopper needs before
  the buy button now come from product data instead of the collapsed
  description. custom.highlights (list), custom.package_contents,
  custom.diameter_mm, custom.hose_length_cm, custom.material,
  custom.connection_size, custom.water_use, custom.model_number,
  custom.filter_type, custom.filter_replacement_interval and
  custom.compatibility were transcribed from the merchant's own product
  descriptions; nothing is generated. Dutch-only text fields are shown on the
  Dutch storefront; other locales get the language-neutral chips and numbers.
  A "compare the models" block lists the shower heads of the main collection
  with spray modes, filter, hose and price so the €19,99–€34,99 ladder is
  visible on every model page.
{%- endcomment -%}
<style>
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-rating{display:inline-flex;align-items:center;flex-wrap:wrap;gap:8px;width:max-content;max-width:100%;margin:0 0 12px;color:#25394b;text-decoration:none;font-size:.84rem;line-height:1.2}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-rating strong{color:#173555;font-weight:750}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-rating:hover strong:last-child{text-decoration:underline;text-underline-offset:3px}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-stars{position:relative;display:inline-block;color:#d7dde3;font-size:1.05rem;line-height:1;letter-spacing:2px;white-space:nowrap}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-stars i{position:absolute;left:0;top:0;overflow:hidden;color:#f5b301;font-style:normal;white-space:nowrap}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-rating--judgeme{margin:0 0 12px!important}
  body[data-page-type="product"] .besjaar-store-premium-pd__title{font-weight:640!important}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-highlights{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 18px;margin:22px 0 0;padding:0;list-style:none;max-width:640px}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-highlights li{display:flex;gap:12px;align-items:center;margin:0}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-highlights li::before{content:none}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-highlights__icon{display:grid;place-items:center;flex:0 0 54px;width:54px;height:54px;border-radius:50%;background:#173555;color:#fff}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-highlights__icon svg{width:24px;height:24px}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-highlights__text{color:#173555;font-size:.86rem;font-weight:720;line-height:1.32;text-wrap:balance}
  @media(max-width:760px){
    /* Phone: the benefit grid is hidden on request; the same facts are in the Specificaties panel and the description. */
    body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-highlights{display:none!important}
    body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-rating{font-size:.8rem;margin-bottom:8px}
    body[data-page-type="product"] .besjaar-store-premium-pd__description-group .besjaar-store-premium-pd__lede{font-size:.86rem!important;line-height:1.55!important}
    /* Quantity narrower so "In winkelwagen" keeps its full width next to it. */
    body[data-page-type="product"] .besjaar-store-premium-pd__purchase{grid-template-columns:100px minmax(0,1fr)!important;gap:8px!important}
    body[data-page-type="product"] .besjaar-store-premium-pd__qty{width:100px!important;grid-template-columns:30px 40px 30px!important}
    body[data-page-type="product"] .besjaar-store-premium-pd__qty button{width:30px!important}
    body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-add{padding:0 12px!important;font-size:.8rem!important;gap:8px!important}
    /* The floating "back to top" button sat on top of the buy button on phones; the sticky bar already brings the shopper back to the cart button. */
    body[data-page-type="product"] .besjaar-to-top{display:none!important}
  }
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare{margin-top:18px;padding:14px 14px 6px;border:1px solid #e0e7ec;border-radius:14px;background:#fff}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare__title{margin:0 0 4px;color:#0f1924;font-size:.82rem;font-weight:780}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare__row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 12px;align-items:center;padding:10px 8px;margin:0 -8px;border-top:1px solid #eef2f5;border-radius:10px;color:inherit;text-decoration:none}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare__row:first-of-type{border-top:0}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare__row:hover{background:#f7f9fa}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare__row.is-current{background:#eef5f9;border-top-color:transparent}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare__row.is-current + .bj-pd-compare__row{border-top-color:transparent}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare__name{display:block;color:#0f1924;font-size:.78rem;font-weight:720;line-height:1.3}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare__name em{display:inline-block;margin-left:6px;padding:1px 7px;border-radius:999px;background:#173555;color:#fff;font-size:.56rem;font-style:normal;font-weight:800;letter-spacing:.04em;text-transform:uppercase;vertical-align:middle}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare__chips{display:flex;flex-wrap:wrap;gap:4px 10px;color:#5f6d78;font-size:.66rem;font-weight:600;line-height:1.3}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare__chips span+span::before{content:"\00b7";margin-right:10px;color:#b7c2cb}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare__price{grid-row:1 / span 2;align-self:center;color:#173555;font-size:.86rem;font-weight:820;white-space:nowrap}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-spec{display:grid;margin:0;padding:0}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-spec>div{display:grid;grid-template-columns:minmax(120px,42%) minmax(0,1fr);gap:12px;padding:8px 0;border-bottom:1px solid #eef2f5;font-size:.78rem;line-height:1.45}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-spec>div:last-child{border-bottom:0}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-spec span{color:#62717c}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-spec strong{color:#25394b;font-weight:650}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-box{margin:0;padding-left:18px}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-box li{margin:0 0 5px}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-add{justify-content:center!important;gap:10px!important;font-size:.84rem!important;letter-spacing:.01em!important}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-add__icon{flex:0 0 18px;width:18px;height:18px}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-instant{display:grid;gap:8px;margin-top:10px;text-align:center}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-instant:empty{display:none}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-instant .shopify-payment-button{width:100%}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-instant .shopify-payment-button__button{width:100%!important;min-height:54px!important;border-radius:999px!important;font-size:.84rem!important;font-weight:800!important;box-shadow:none!important}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-instant .shopify-payment-button__button--unbranded{background:#173555!important;color:#fff!important}
  body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-instant .shopify-payment-button__more-options{display:block!important;margin-top:4px!important;color:#25394b!important;font-size:.74rem!important;font-weight:600!important;text-decoration:underline!important;text-underline-offset:3px!important}
  @media(max-width:430px){body[data-page-type="product"] .besjaar-store-premium-pd .bj-pd-compare{padding:12px 12px 4px}}
</style>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign selected_media = current_variant.featured_media | default: product.featured_media
  assign selected_image = selected_media.preview_image | default: product.featured_media.preview_image
  assign form_id = 'BesjaarProductForm-' | append: section.id
  capture shipping_threshold_cents
    render 'besjaar-shipping-zone', field: 'threshold_cents'
  endcapture
  assign shipping_threshold_cents = shipping_threshold_cents | strip | plus: 0
  assign shipping_threshold_money = shipping_threshold_cents | money_without_trailing_zeros
  assign returns_days = settings.return_window_days | default: 30
  assign warranty_months = settings.warranty_months | default: 12
  assign ui_shipping = 'besjaar_ui.product.free_shipping_from' | t: amount: shipping_threshold_money
  assign ui_returns = 'besjaar_ui.product.returns_days' | t: days: returns_days
  assign ui_warranty = 'besjaar_ui.product.warranty_months_dynamic' | t: months: warranty_months
  capture focused_collection_url
    render 'shower-store-url'
  endcapture
  assign focused_collection_url = focused_collection_url | strip
  assign ui_decrease = 'Decrease quantity'
  assign ui_increase = 'Increase quantity'
  assign ui_quantity = 'Quantity'
  assign ui_shortcut_reviews = 'Read Reviews'
  assign product_copy_locale = request.locale.iso_code | split: '-' | first | downcase
  case product_copy_locale
    when 'nl'
      assign ui_decrease = 'Aantal verlagen'
      assign ui_increase = 'Aantal verhogen'
      assign ui_quantity = 'Aantal'
      assign ui_shortcut_reviews = 'Lees reviews'
    when 'de'
      assign ui_decrease = 'Menge verringern'
      assign ui_increase = 'Menge erhöhen'
      assign ui_quantity = 'Menge'
      assign ui_shortcut_reviews = 'Bewertungen lesen'
    when 'fr'
      assign ui_decrease = 'Réduire la quantité'
      assign ui_increase = 'Augmenter la quantité'
      assign ui_quantity = 'Quantité'
      assign ui_shortcut_reviews = 'Lire les avis'
  endcase
  capture localized_product_title_capture
    render 'localized-product-title', product: product
  endcapture
  assign display_title = localized_product_title_capture | strip
  if display_title == blank
    assign display_title = product.title
  endif
  assign first_collection = product.collections.first
  assign locale = request.locale.iso_code | split: '-' | first | downcase
  assign rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
  assign connection_size = product.metafields.custom.connection_size.value | default: '½″'

  case locale
    when 'nl'
      assign ui_rating = 'beoordelingen'
      assign ui_in_stock = 'Op voorraad'
      assign ui_sold_out = 'Uitverkocht'
      assign ui_low_stock = 'Beperkte voorraad'
      assign ui_option = 'Kies uitvoering'
      assign ui_add = 'In winkelwagen'
      assign ui_incl_vat = 'incl. btw'
      assign ui_save = 'Bespaar'
      assign ui_desc = 'Omschrijving'
      assign ui_install = 'Installatie'
      assign ui_install_body = 'Schroef de oude handdouche los en draai de Besjaar handvast op een standaard doucheslang. Geen speciaal gereedschap nodig.'
      assign ui_care = 'Pasvorm & onderhoud'
      assign ui_care_body = 'Controleer de modelspecificaties voor filter, slang en sproeistanden. Spoel het douchevlak regelmatig schoon en droog de afwerking met een zachte doek.'
      assign ui_gallery = 'Productfoto'
      assign ui_swipe = 'Veeg om meer foto’s te bekijken'
      assign ui_secure = 'Veilig afrekenen'
      assign ui_lede = 'Een premium Besjaar handdouche voor een krachtige, comfortabele dagelijkse douche. Ontworpen voor een standaard ½″ aansluiting, eenvoudige bediening en een verzorgde badkamerlook.'
    when 'de'
      assign ui_rating = 'Bewertungen'
      assign ui_in_stock = 'Auf Lager'
      assign ui_sold_out = 'Ausverkauft'
      assign ui_low_stock = 'Nur wenige verfügbar'
      assign ui_option = 'Ausführung wählen'
      assign ui_add = 'In den Warenkorb'
      assign ui_incl_vat = 'inkl. MwSt.'
      assign ui_save = 'Spare'
      assign ui_desc = 'Beschreibung'
      assign ui_install = 'Installation'
      assign ui_install_body = 'Alten Handbrausekopf abschrauben und Besjaar handfest auf einen Standard-Duschschlauch drehen. Kein Spezialwerkzeug erforderlich.'
      assign ui_care = 'Passform & Pflege'
      assign ui_care_body = 'Modellspezifische Angaben zu Filter, Schlauch und Strahlarten findest du in den Spezifikationen. Brausefläche regelmäßig abspülen und die Oberfläche mit einem weichen Tuch trocknen.'
      assign ui_gallery = 'Produktbild'
      assign ui_swipe = 'Wischen, um weitere Bilder anzusehen'
      assign ui_secure = 'Sicher bezahlen'
      assign ui_lede = 'Eine hochwertige Besjaar Handbrause für einen kräftigen, angenehmen Duschstrahl im Alltag. Für Standard-½″-Anschlüsse, einfache Bedienung und ein klares Badezimmerdesign.'
    when 'fr'
      assign ui_rating = 'avis'
      assign ui_in_stock = 'En stock'
      assign ui_sold_out = 'Épuisé'
      assign ui_low_stock = 'Stock limité'
      assign ui_option = 'Choisir la version'
      assign ui_add = 'Ajouter au panier'
      assign ui_incl_vat = 'TVA incluse'
      assign ui_save = 'Économisez'
      assign ui_desc = 'Description'
      assign ui_install = 'Installation'
      assign ui_install_body = 'Dévissez l’ancienne douchette puis vissez Besjaar à la main sur un flexible de douche standard. Aucun outil spécial n’est nécessaire.'
      assign ui_care = 'Compatibilité & entretien'
      assign ui_care_body = 'Consultez les spécifications du modèle pour le filtre, le flexible et les modes de jet. Rincez régulièrement la face du pommeau et séchez la finition avec un chiffon doux.'
      assign ui_gallery = 'Photo produit'
      assign ui_swipe = 'Balayez pour voir plus de photos'
      assign ui_secure = 'Paiement sécurisé'
      assign ui_lede = 'Une douchette Besjaar haut de gamme conçue pour un jet puissant et confortable au quotidien. Compatible avec un raccord standard ½″, simple à utiliser et facile à intégrer dans la salle de bains.'
    else
      assign ui_rating = 'reviews'
      assign ui_in_stock = 'In stock'
      assign ui_sold_out = 'Sold out'
      assign ui_low_stock = 'Limited stock'
      assign ui_option = 'Choose an option'
      assign ui_add = 'Add to cart'
      assign ui_incl_vat = 'VAT included'
      assign ui_save = 'Save'
      assign ui_desc = 'Description'
      assign ui_install = 'Installation'
      assign ui_install_body = 'Unscrew your existing hand shower and hand-tighten Besjaar onto a standard shower hose. No special tools required.'
      assign ui_care = 'Fit & care'
      assign ui_care_body = 'Check the model specifications for filter, hose and spray-mode details. Rinse the shower face regularly and dry the finish with a soft cloth.'
      assign ui_gallery = 'Product image'
      assign ui_swipe = 'Swipe to explore more images'
      assign ui_secure = 'Secure checkout'
      assign ui_lede = 'A premium Besjaar hand shower designed for a strong, comfortable everyday shower. Made for a standard ½″ connection, simple operation and a clean modern bathroom setup.'
  endcase

  capture product_is_shower_head
    render 'is-shower-head', product: product
  endcapture
  assign product_is_shower_head = product_is_shower_head | strip
  if product_is_shower_head != 'true'
    assign ui_lede = 'besjaar_seo.product.accessory_intro' | t
    assign ui_install_body = 'besjaar_seo.product.accessory_installation' | t
    assign ui_care_body = 'besjaar_seo.product.accessory_care' | t
  endif
  comment
    Besjaar 2026-09-22 (SEO: product-lede-identical-and-description-collapsed):
    shower-family products take their lede from the merchant's own description
    instead of the generic sentence, so a model with its own description shows
    its own copy above the buy box (and the EN storefront gets the translated
    body). Models that share a description still share a lede until
    custom.introduction is filled in Admin. The description opens with a short
    display headline followed by the intro paragraph; a headline shorter than
    80 characters is skipped in favour of that paragraph. Only 40-320 character
    results are used, and a paragraph that claims to remove heavy metals is
    never used (unsupported claim). custom.introduction still wins below.
    Products without a description render exactly as before.
  endcomment
  capture product_family_capture
    render 'product-family', product: product
  endcapture
  assign product_family = product_family_capture | strip
  if product_family == 'shower' and product.description != blank
    assign description_paragraphs = product.description | split: '</p>'
    assign description_lede = description_paragraphs[0] | strip_html | strip
    assign description_lede_size = description_lede | size
    if description_lede_size < 80 and description_paragraphs.size > 1
      assign description_second = description_paragraphs[1] | strip_html | strip
      assign description_second_size = description_second | size
      if description_second_size >= 40
        assign description_lede = description_second
        assign description_lede_size = description_second_size
      endif
    endif
    assign description_lede_check = description_lede | downcase
    if description_lede_check contains 'zware metalen' or description_lede_check contains 'heavy metals' or description_lede_check contains 'schwermetalle' or description_lede_check contains 'métaux lourds'
      assign description_lede_size = 0
    endif
    if description_lede_size >= 40 and description_lede_size <= 320
      assign ui_lede = description_lede | escape_once
    endif
  endif
  comment
    2026-09-29: the merchant's own opening line of the description (under 80
    characters, e.g. "Gefilterd water. Volle druk. Tien standen.") is shown as
    a headline above the lede instead of being skipped. custom.introduction
    is Dutch copy, so it only replaces the lede on the Dutch storefront;
    custom.introduction_en / _de / _fr do the same for the other languages.
  endcomment
  assign ui_headline = ''
  if product_family == 'shower' and product.description != blank
    assign headline_candidate = description_paragraphs[0] | strip_html | strip
    assign headline_size = headline_candidate | size
    assign headline_check = headline_candidate | downcase
    if headline_size >= 10 and headline_size < 80 and headline_candidate != description_lede
      unless headline_check contains 'zware metalen' or headline_check contains 'heavy metals'
        assign ui_headline = headline_candidate | escape_once
      endunless
    endif
  endif
  assign introduction_key = 'introduction_' | append: product_copy_locale
  if product.metafields.custom[introduction_key].value != blank
    assign ui_lede = product.metafields.custom[introduction_key].value | escape | newline_to_br
  elsif product_copy_locale == 'nl' and product.metafields.custom.introduction.value != blank
    assign ui_lede = product.metafields.custom.introduction.value | escape | newline_to_br
  endif

  comment
    Product facts for the highlights list, the specification panel and the
    model comparison. Text metafields are Dutch and only shown on /nl; the
    numeric facts and yes/no chips are shown in every language.
  endcomment
  capture bj_capture
    render 'shower-spray-modes', product: product
  endcapture
  assign bj_modes = bj_capture | strip
  capture bj_capture
    render 'shower-filter-state', product: product
  endcapture
  assign bj_filter = bj_capture | strip
  capture bj_capture
    render 'shower-hose-state', product: product
  endcapture
  assign bj_hose = bj_capture | strip
  assign bj_nl_copy = false
  if product_copy_locale == 'nl'
    assign bj_nl_copy = true
  endif
  assign bj_highlights = blank
  if bj_nl_copy and product.metafields.custom.highlights.value != blank
    assign bj_highlights = product.metafields.custom.highlights.value
  endif
  assign bj_best_for = ''
  if bj_nl_copy and product.metafields.custom.best_for.value != blank
    assign bj_best_for = product.metafields.custom.best_for.value
  endif
  assign bj_diameter_mm = product.metafields.custom.diameter_mm.value | default: 0 | plus: 0
  assign bj_hose_cm = product.metafields.custom.hose_length_cm.value | default: 0 | plus: 0
  assign bj_model = product.metafields.custom.model_number.value | default: ''
  assign bj_material = ''
  assign bj_connection = ''
  assign bj_water = ''
  assign bj_filter_type = ''
  assign bj_filter_interval = ''
  assign bj_compat = ''
  assign bj_package = ''
  if bj_nl_copy
    assign bj_material = product.metafields.custom.material.value | default: ''
    assign bj_connection = product.metafields.custom.connection_size.value | default: ''
    assign bj_water = product.metafields.custom.water_use.value | default: ''
    assign bj_filter_type = product.metafields.custom.filter_type.value | default: ''
    assign bj_filter_interval = product.metafields.custom.filter_replacement_interval.value | default: ''
    assign bj_compat = product.metafields.custom.compatibility.value | default: ''
    assign bj_package = product.metafields.custom.package_contents.value | default: ''
  endif
  assign bj_decimal_comma = false
  if product_copy_locale == 'nl' or product_copy_locale == 'de' or product_copy_locale == 'fr'
    assign bj_decimal_comma = true
  endif
  assign bj_hose_m = ''
  if bj_hose_cm > 0
    assign bj_hose_m = bj_hose_cm | divided_by: 100.0 | append: ''
    if bj_hose_m contains '.0'
      assign bj_hose_m = bj_hose_m | replace: '.0', ''
    endif
    if bj_decimal_comma
      assign bj_hose_m = bj_hose_m | replace: '.', ','
    endif
    assign bj_hose_m = bj_hose_m | append: ' m'
  endif
  assign bj_diameter_cm = ''
  if bj_diameter_mm > 0
    assign bj_diameter_cm = bj_diameter_mm | divided_by: 10.0 | append: ''
    if bj_diameter_cm contains '.0'
      assign bj_diameter_cm = bj_diameter_cm | replace: '.0', ''
    endif
    if bj_decimal_comma
      assign bj_diameter_cm = bj_diameter_cm | replace: '.', ','
    endif
    assign bj_diameter_cm = bj_diameter_cm | append: ' cm'
  endif
  case product_copy_locale
    when 'nl'
      assign bj_label_water = 'Waterverbruik'
      assign bj_label_model = 'Modelnummer'
      assign bj_compare_title = 'Welke Besjaar past bij jou?'
    when 'de'
      assign bj_label_water = 'Wasserverbrauch'
      assign bj_label_model = 'Modellnummer'
      assign bj_compare_title = 'besjaar_ui.product.compare_heading' | t
    when 'fr'
      assign bj_label_water = 'Consommation d’eau'
      assign bj_label_model = 'Numéro de modèle'
      assign bj_compare_title = 'besjaar_ui.product.compare_heading' | t
    else
      assign bj_label_water = 'Water use'
      assign bj_label_model = 'Model number'
      assign bj_compare_title = 'besjaar_ui.product.compare_heading' | t
  endcase
  assign bj_has_specs = false
  if bj_modes != blank or bj_diameter_cm != '' or bj_hose_m != '' or bj_material != '' or bj_connection != '' or bj_water != '' or bj_model != '' or bj_filter_type != '' or bj_filter_interval != '' or bj_compat != '' or product_is_shower_head == 'true'
    assign bj_has_specs = true
  endif
  if product.metafields.custom.installation.value != blank
    assign ui_install_body = product.metafields.custom.installation.value | escape | newline_to_br
  endif
  if product.metafields.custom.care_instructions.value != blank
    assign ui_care_body = product.metafields.custom.care_instructions.value | escape | newline_to_br
  endif

  assign inventory_qty = current_variant.inventory_quantity
  assign show_low_stock = false
  if current_variant.inventory_management and inventory_qty > 0 and inventory_qty <= 5
    assign show_low_stock = true
  endif

  comment
    Besjaar 11.74: the live automatic Shopify discount for this product. When
    one is running, the price the shopper actually pays leads the buy box and
    the undiscounted price is struck through beside it. A compare-at price is
    suppressed in that case, so the row never shows three numbers.
  endcomment
  capture bjd_badge
    render 'besjaar-discount-badge', product: product, variant: current_variant, layout: 'badge'
  endcapture
  assign bjd_badge = bjd_badge | strip
  capture bjd_now
    render 'besjaar-discount-badge', product: product, variant: current_variant, layout: 'price_now'
  endcapture
  assign bjd_now = bjd_now | strip
  capture bjd_note
    render 'besjaar-discount-badge', product: product, variant: current_variant, layout: 'note'
  endcapture
  assign bjd_note = bjd_note | strip
  comment
    2026-09-22: plain discount data for the "recently viewed" strip, which is
    rendered client-side from the visitor's browser storage and therefore has
    no access to the discount mirror. It stores the discounted price, the
    badge text and the discount's end time, and stops showing the discount by
    itself once that time has passed.
  endcomment
  capture bjd_cents
    render 'besjaar-discount-badge', product: product, variant: current_variant, layout: 'cents'
  endcapture
  assign bjd_cents = bjd_cents | strip
  capture bjd_ends
    render 'besjaar-discount-badge', product: product, variant: current_variant, layout: 'ends'
  endcapture
  assign bjd_ends = bjd_ends | strip
  capture bjd_label
    render 'besjaar-discount-badge', product: product, variant: current_variant, layout: 'label'
  endcapture
  assign bjd_label = bjd_label | strip

  assign show_compare = false
  if current_variant.compare_at_price > current_variant.price
    assign show_compare = true
  endif
  if bjd_now != ''
    assign show_compare = false
  endif
-%}

<section class="besjaar-store besjaar-store-premium-pd" data-besjaar-product-section="{{ section.id }}" data-product-root{% if bjd_cents != '' %} data-discount-cents="{{ bjd_cents }}" data-discount-ends="{{ bjd_ends }}" data-discount-label="{{ bjd_label | escape }}"{% endif %} data-added-status="{{ 'besjaar_ui.cart.added' | t | escape }}" data-add-error="{{ 'besjaar_ui.cart.add_error' | t | escape }}" data-zoom-label="{{ 'besjaar_ui.product.zoom_image' | t | escape }}" data-close-zoom-label="{{ 'besjaar_ui.product.close_zoom' | t | escape }}" data-previous-image-label="{{ 'besjaar_ui.accessibility.previous_product_image' | t | escape }}" data-next-image-label="{{ 'besjaar_ui.accessibility.next_product_image' | t | escape }}" data-in-stock-label="{{ ui_in_stock | escape }}" data-low-stock-label="{{ ui_low_stock | escape }}" data-sold-out-label="{{ ui_sold_out | escape }}">
  <div class="besjaar-store-shell">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="besjaar-store-premium-pd__crumb" aria-label="{{ 'besjaar_ui.product.breadcrumbs' | t | escape }}">
        <a href="{{ routes.root_url }}">{{ 'besjaar_ui.product.home' | t }}</a>
        {% capture breadcrumb_handle %}{% render 'seo-product-collection', product: product %}{% endcapture %}
        {% assign breadcrumb_handle = breadcrumb_handle | strip %}
        {% assign breadcrumb_collection = collections[breadcrumb_handle] %}
        {% if breadcrumb_collection != blank %}
          <span aria-hidden="true">/</span>
          <a href="{% render 'localized-internal-url', url: breadcrumb_collection.url %}">{% render 'localized-collection-title', collection: breadcrumb_collection %}</a>
        {% endif %}
      </nav>
    {%- endif -%}

    <div class="besjaar-store-premium-pd__grid">
      <div class="besjaar-store-premium-pd__gallery">
        <div class="besjaar-store-premium-pd__stage" id="BesjaarStage-{{ section.id }}">
          {%- if selected_image -%}
            <img
              id="BesjaarMainImage-{{ section.id }}"
              src="{{ selected_image | image_url: width: 1600 }}"
              srcset="{{ selected_image | image_url: width: 700 }} 700w, {{ selected_image | image_url: width: 1100 }} 1100w, {{ selected_image | image_url: width: 1600 }} 1600w"
              sizes="(max-width: 900px) 100vw, 56vw"
              loading="eager" decoding="async" fetchpriority="high"
              alt="{{ selected_image.alt | default: display_title | replace: '&amp;', '&' | escape_once }}"
              width="{{ selected_image.width }}"
              height="{{ selected_image.height }}">
          {%- else -%}
            <img id="BesjaarMainImage-{{ section.id }}" src="{{ 'besjaar-product-front-exact.webp' | asset_url }}" alt="{{ display_title | replace: '&amp;', '&' | escape_once }}" width="1254" height="1254" loading="eager" decoding="async" fetchpriority="high">
          {%- endif -%}
          {%- assign savings = current_variant.compare_at_price | minus: current_variant.price -%}
          <span class="besjaar-store-premium-pd__sale" id="BesjaarSale-{{ section.id }}"{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{{ ui_save }} {{ savings | money }}</span>
          {%- if section.settings.enable_image_zoom -%}
            <button class="besjaar-store-premium-pd__zoom" type="button" data-product-zoom aria-label="{{ 'besjaar_ui.product.zoom_image' | t | escape }}" aria-haspopup="dialog">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5M10.5 7.5v6M7.5 10.5h6"></path></svg>
            </button>
          {%- endif -%}
        </div>

        {%- assign image_media_count = 0 -%}
        {%- for media in product.media -%}{%- if media.preview_image -%}{%- assign image_media_count = image_media_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- if image_media_count > 1 -%}
          <div class="besjaar-store-premium-pd__thumbs" id="BesjaarThumbs-{{ section.id }}" aria-label="{{ ui_gallery }}">
            {%- assign thumb_index = 0 -%}
            {%- for media in product.media limit: 10 -%}
              {%- if media.preview_image -%}
                {%- assign thumb_index = thumb_index | plus: 1 -%}
                <button
                  type="button"
                  class="besjaar-store-premium-pd__thumb"
                  aria-current="{% if media.id == selected_media.id or selected_media == blank and thumb_index == 1 %}true{% else %}false{% endif %}"
                  data-src="{{ media.preview_image | image_url: width: 1600 }}"
                  data-src-small="{{ media.preview_image | image_url: width: 700 }}"
                  data-alt="{{ media.preview_image.alt | default: display_title | escape }}"
                  data-media-id="{{ media.id }}"
                  aria-label="{{ ui_gallery }} {{ thumb_index }}">
                  <img src="{{ media.preview_image | image_url: width: 220 }}" alt="{{ media.preview_image.alt | default: display_title | replace: '&amp;', '&' | escape_once }}" width="110" height="110" loading="lazy" decoding="async">
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <p class="besjaar-store-premium-pd__swipe">{{ ui_swipe }}</p>
        {%- endif -%}
      </div>

      <div class="besjaar-store-premium-pd__summary">
        <div class="besjaar-store-premium-pd__topline">
          <span class="besjaar-store-premium-pd__brand">BESJAAR®</span>
          {%- if bjd_badge != '' -%}<span class="bj-discount-badge">{{ bjd_badge }}</span>{%- elsif show_compare -%}<span class="bj-discount-badge">{% render 'besjaar-compare-sale', product: product, variant: current_variant, layout: 'badge' %}</span>{%- endif -%}
          {%- if current_variant.available -%}
            <span class="besjaar-store-premium-pd__stock {% if show_low_stock %}is-low{% endif %}" data-product-stock><i></i><span data-product-stock-label>{% if show_low_stock %}{{ ui_low_stock }}{% else %}{{ ui_in_stock }}{% endif %}</span></span>
          {%- else -%}
            <span class="besjaar-store-premium-pd__stock is-out" data-product-stock><i></i><span data-product-stock-label>{{ ui_sold_out }}</span></span>
          {%- endif -%}
        </div>

        {%- comment -%}
          2026-09-29: rating line above the title (stars · 4,7/5 · 133
          beoordelingen). The numbers are the product's own Judge.me rating
          and review count, which Judge.me syncs into the reviews.rating and
          reviews.rating_count metafields. Nothing is shown when there are no
          reviews.
        {%- endcomment -%}
        {%- assign bj_rating_num = rating | plus: 0.0 -%}
        {%- assign bj_rating_count_num = rating_count | plus: 0 -%}
        {%- if bj_rating_num > 0 and bj_rating_count_num > 0 -%}
          {%- assign bj_rating_pct = bj_rating_num | times: 20.0 | round: 1 | at_most: 100 -%}
          {%- assign bj_rating_text = bj_rating_num | round: 1 | append: '' -%}
          {%- if bj_decimal_comma -%}{%- assign bj_rating_text = bj_rating_text | replace: '.', ',' -%}{%- endif -%}
          <a class="bj-pd-rating" href="#besjaar-ui-reviews" aria-label="{{ 'besjaar_ui.reviews.rating_accessible' | t: rating: bj_rating_text, max: 5, count: bj_rating_count_num | escape }}">
            <span class="bj-pd-stars" aria-hidden="true">★★★★★<i style="width:{{ bj_rating_pct }}%">★★★★★</i></span>
            <strong>{{ bj_rating_text }}/5</strong><span aria-hidden="true"> — </span><strong>{{ bj_rating_count_num }} {{ ui_rating }}</strong>
          </a>
        {%- elsif product.metafields.judgeme.badge != blank -%}
          <a class="besjaar-store-premium-pd__rating besjaar-store-premium-pd__rating--judgeme bj-pd-rating--judgeme" href="#besjaar-ui-reviews" aria-label="{{ ui_shortcut_reviews | escape }}">
            <span class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" data-auto-install="false">{{ product.metafields.judgeme.badge }}</span>
          </a>
        {%- endif -%}

        <h1 class="besjaar-store-premium-pd__title">{{ display_title | replace: '&amp;', '&' | escape_once }}</h1>

        <div class="besjaar-store-premium-pd__description-group">
          <div class="besjaar-store-premium-pd__lede">{{ ui_lede }}</div>
          {%- if section.settings.show_highlights -%}
            {%- comment -%}
              Two-column benefit grid. Each line is the merchant's own product
              fact (custom.highlights); the icon is picked from the wording.
            {%- endcomment -%}
            {%- capture bj_icon_waves -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M3 9c2.2 0 2.2-1.6 4.5-1.6S9.8 9 12 9s2.2-1.6 4.5-1.6S18.8 9 21 9M3 15c2.2 0 2.2-1.6 4.5-1.6s2.3 1.6 4.5 1.6 2.2-1.6 4.5-1.6 2.3 1.6 4.5 1.6"/></svg>{%- endcapture -%}
            {%- capture bj_icon_drop -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M12 3s6 6.4 6 11a6 6 0 0 1-12 0c0-4.6 6-11 6-11Z"/></svg>{%- endcapture -%}
            {%- capture bj_icon_leaf -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19c3-4 6-7 10-9"/></svg>{%- endcapture -%}
            {%- capture bj_icon_shield -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.6-2.9 8.2-7 10-4.1-1.8-7-5.4-7-10V6z"/></svg>{%- endcapture -%}
            {%- capture bj_icon_sparkle -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M11 4l1.6 4.4L17 10l-4.4 1.6L11 16l-1.6-4.4L5 10l4.4-1.6zM18 15l.8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z"/></svg>{%- endcapture -%}
            {%- capture bj_icon_bolt -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M13 3L5 13h6l-1 8 9-11h-6z"/></svg>{%- endcapture -%}
            {%- capture bj_icon_wrench -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 5.5a4 4 0 0 0 4.9 4.9L21 12l-9 9-2-2 5-5-2.4-2.4a4 4 0 0 1-5.1-5.1L10 9l3-3z"/></svg>{%- endcapture -%}
            {%- capture bj_icon_hose -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M4 6h5a3 3 0 0 1 3 3v6a3 3 0 0 0 3 3h5"/><path d="M4 4v4M20 16v4"/></svg>{%- endcapture -%}
            {%- capture bj_icon_heart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-9.5A3.8 3.8 0 0 1 12 8a3.8 3.8 0 0 1 7 2.5C19 15.6 12 20 12 20z"/></svg>{%- endcapture -%}
            {%- capture bj_icon_clock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg>{%- endcapture -%}
            {%- assign bj_grid_items = blank -%}
            {%- if bj_highlights != blank -%}
              {%- assign bj_grid_items = bj_highlights -%}
            {%- elsif product_family == 'shower' and product_is_shower_head == 'true' -%}
              {%- capture bj_auto_items -%}
                {%- if bj_modes != blank -%}{{ 'besjaar_ui.product.shower_modes_chip' | t: count: bj_modes }}|{%- endif -%}
                {%- if bj_filter == 'true' -%}{{ 'besjaar_ui.product.shower_filter_chip' | t }}{%- else -%}{{ 'besjaar_ui.product.shower_filter_none_chip' | t }}{%- endif -%}|
                {%- if bj_hose == 'true' -%}{{ 'besjaar_ui.product.shower_hose_chip' | t }}{% if bj_hose_m != '' %} ({{ bj_hose_m }}){% endif %}{%- else -%}{{ 'besjaar_ui.product.shower_hose_none_chip' | t }}{%- endif -%}|
                {%- if bj_diameter_cm != '' -%}{{ 'besjaar_ui.product.shower_diameter' | t }}: Ø {{ bj_diameter_cm }}|{%- endif -%}
              {%- endcapture -%}
              {%- assign bj_grid_items = bj_auto_items | strip | split: '|' -%}
            {%- endif -%}
            {%- if bj_grid_items != blank -%}
              <ul class="bj-pd-highlights">
                {%- for bj_item in bj_grid_items limit: 6 -%}
                  {%- assign bj_item_text = bj_item | strip -%}
                  {%- if bj_item_text == '' -%}{%- continue -%}{%- endif -%}
                  {%- assign bj_item_lc = bj_item_text | downcase -%}
                  {%- if bj_item_lc contains 'filter' or bj_item_lc contains 'filtr' or bj_item_lc contains 'cartridge' -%}
                    {%- assign bj_icon = bj_icon_drop -%}
                  {%- elsif bj_item_lc contains 'standen' or bj_item_lc contains 'modes' or bj_item_lc contains 'strahl' or bj_item_lc contains 'jet' -%}
                    {%- assign bj_icon = bj_icon_waves -%}
                  {%- elsif bj_item_lc contains 'slang' or bj_item_lc contains 'hose' or bj_item_lc contains 'schlauch' or bj_item_lc contains 'flexible' -%}
                    {%- assign bj_icon = bj_icon_hose -%}
                  {%- elsif bj_item_lc contains 'kalk' or bj_item_lc contains 'sproeier' or bj_item_lc contains 'limescale' -%}
                    {%- assign bj_icon = bj_icon_sparkle -%}
                  {%- elsif bj_item_lc contains 'druk' or bj_item_lc contains 'boost' or bj_item_lc contains 'pressure' -%}
                    {%- assign bj_icon = bj_icon_bolt -%}
                  {%- elsif bj_item_lc contains 'pauze' or bj_item_lc contains 'water' or bj_item_lc contains 'l/min' or bj_item_lc contains 'energie' -%}
                    {%- assign bj_icon = bj_icon_leaf -%}
                  {%- elsif bj_item_lc contains 'gereedschap' or bj_item_lc contains 'monteer' or bj_item_lc contains 'handvast' or bj_item_lc contains 'wissel' or bj_item_lc contains 'tool' -%}
                    {%- assign bj_icon = bj_icon_wrench -%}
                  {%- elsif bj_item_lc contains 'maanden' or bj_item_lc contains 'months' or bj_item_lc contains 'monate' or bj_item_lc contains 'mois' -%}
                    {%- assign bj_icon = bj_icon_clock -%}
                  {%- elsif bj_item_lc contains 'chroom' or bj_item_lc contains 'kop' or bj_item_lc contains 'cm' -%}
                    {%- assign bj_icon = bj_icon_shield -%}
                  {%- else -%}
                    {%- assign bj_icon = bj_icon_heart -%}
                  {%- endif -%}
                  <li><span class="bj-pd-highlights__icon">{{ bj_icon }}</span><span class="bj-pd-highlights__text">{{ bj_item_text | escape }}</span></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- form 'product', product, id: form_id, class: 'besjaar-store-premium-pd__form', novalidate: 'novalidate', data-ajax-product-form: '', data-product-form: '' -%}
          {%- if product.variants.size > 1 -%}
            <label class="besjaar-store-premium-pd__label" for="BesjaarVariant-{{ section.id }}">{{ ui_option }}</label>
            <div class="besjaar-store-premium-pd__select-wrap">
              <select id="BesjaarVariant-{{ section.id }}" class="besjaar-store-premium-pd__select" name="id" data-variant-id>
                {%- for variant in product.variants -%}
                  {%- assign variant_savings = variant.compare_at_price | minus: variant.price -%}
                  {%- assign variant_media = variant.featured_media.preview_image -%}
                  {%- capture variant_discount_price -%}{% render 'besjaar-discount-badge', product: product, variant: variant, layout: 'price_now' %}{%- endcapture -%}
                  {%- assign variant_discount_price = variant_discount_price | strip -%}
                  <option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-price-cents="{{ variant.price }}" data-discount-price="{{ variant_discount_price | escape }}" data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}" data-savings="{% if variant.compare_at_price > variant.price %}{{ variant_savings | money | escape }}{% endif %}" data-available="{{ variant.available }}" data-inventory-quantity="{{ variant.inventory_quantity | default: 0 }}" data-inventory-managed="{% if variant.inventory_management %}true{% else %}false{% endif %}"{% if variant_media %} data-image="{{ variant_media | image_url: width: 1600 }}" data-image-small="{{ variant_media | image_url: width: 700 }}" data-image-alt="{{ variant_media.alt | default: display_title | escape }}" data-media-id="{{ variant.featured_media.id }}"{% endif %} {% if variant.id == current_variant.id %}selected{% endif %}>
                    {{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ ui_sold_out }}{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
              <span aria-hidden="true">⌄</span>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          {%- endif -%}

          <div class="besjaar-store-premium-pd__price-row">
            <div>
              <span class="besjaar-ui-visually-hidden" data-sale-price-prefix{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{{ 'besjaar_ui.product.sale_price' | t }} </span>
              <span class="besjaar-store-premium-pd__price{% if bjd_now != '' or show_compare %} is-bj-discounted{% endif %}" id="BesjaarPrice-{{ section.id }}">{% if bjd_now != '' %}{{ bjd_now }}{% else %}{{ current_variant.price | money }}{% endif %}</span>
              <s class="bj-price__was" data-bj-price-was{% if bjd_now == '' and show_compare == false %} hidden{% endif %}><span class="besjaar-ui-visually-hidden">{{ 'besjaar_ui.product.regular_price' | t }} </span><span data-bj-was-value>{% if bjd_now != '' %}{{ current_variant.price | money }}{% else %}{{ current_variant.compare_at_price | money }}{% endif %}</span></s>
              <small>{{ ui_incl_vat }}</small>
            </div>
            <span class="besjaar-store-premium-pd__compare" id="BesjaarCompare-{{ section.id }}" hidden><span class="besjaar-ui-visually-hidden">{{ 'besjaar_ui.product.regular_price' | t }} </span><s data-compare-value>{{ current_variant.compare_at_price | money }}</s></span>
          </div>
          {{ bjd_note }}

          <div class="besjaar-store-premium-pd__purchase">
            <div class="besjaar-store-premium-pd__qty" data-besjaar-qty>
              <button type="button" data-step="-1" aria-label="{{ ui_decrease | escape }}">−</button>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" enterkeyhint="done" aria-label="{{ ui_quantity | escape }}" data-product-quantity>
              <button type="button" data-step="1" aria-label="{{ ui_increase | escape }}">+</button>
            </div>
            <button id="BesjaarMainAdd-{{ section.id }}" type="submit" class="besjaar-store-premium-pd__add bj-pd-add" data-product-submit data-variant-available="{% if current_variant.available %}true{% else %}false{% endif %}" {% unless current_variant.available %}disabled{% endunless %}>
              <svg class="bj-pd-add__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8Zm3 0V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
              <span data-add-label>{% if current_variant.available %}{{ ui_add }}{% else %}{{ ui_sold_out }}{% endif %}</span>
            </button>
          </div>

          {%- comment -%}
            2026-09-29: dynamic checkout buttons back under "In winkelwagen" on
            request: Shopify renders the shopper's accelerated wallet (Shop Pay,
            PayPal, Apple Pay or Google Pay) plus the "More payment options"
            link. Which wallets appear is set in Settings > Payments.
          {%- endcomment -%}
          <div class="besjaar-store-premium-pd__instant bj-pd-instant">
            {{ form | payment_button }}
          </div>
        {%- endform -%}
        <div class="besjaar-ui-product-form-status" role="status" aria-live="polite" aria-atomic="true" data-product-form-status></div>

        <div class="besjaar-store-premium-pd__trust">
          <div>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm10 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg>
            <span>{{ ui_shipping }}</span>
          </div>
          <div>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 1-2.34-5.66L20 7.68M20 3v5h-5"/></svg>
            <span>{{ ui_returns }}</span>
          </div>
          <div>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.6-2.9 8.2-7 10-4.1-1.8-7-5.4-7-10V6zM9 12l2 2 4-4"/></svg>
            <span>{{ ui_warranty }}</span>
          </div>
          <div>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V8a5 5 0 0 1 10 0v2M5 10h14v11H5z"/></svg>
            <span>{{ ui_secure }}</span>
          </div>
        </div>

        {%- comment -%}Besjaar 11.6: concrete "order before {cutoff}, delivered {date}" promise on the live buy box — the module existed but was only rendered in the cart drawer.{%- endcomment -%}
        {% if settings.show_delivery_estimates %}
          {% render 'delivery-promise', context: 'product' %}
        {% endif %}

        {% if template.suffix == 'shower' %}
          <a class="besjaar-ui-product-model-finder-link" href="#besjaar-model-finder">
            <span aria-hidden="true">⌁</span>
            <span><strong>{{ 'besjaar_ui.product.fbesjaar_store_model_title' | t }}</strong><small>{{ 'besjaar_ui.product.fbesjaar_store_model_copy' | t }}</small></span>
            <i aria-hidden="true">→</i>
          </a>
        {% endif %}

        {%- if section.settings.show_compare and product_is_shower_head == 'true' -%}
          {%- liquid
            assign cmp_collection = settings.shower_collection
            if cmp_collection == blank
              assign cmp_collection = collections['showerhead']
            endif
            if cmp_collection == blank
              assign cmp_collection = collections['douchekoppen']
            endif
            if cmp_collection == blank
              assign cmp_collection = product.collections.first
            endif
          -%}
          {%- if cmp_collection != blank -%}
            {%- capture cmp_rows -%}
              {%- for cmp_p in cmp_collection.products limit: 12 -%}
                {%- unless cmp_p.available -%}{%- continue -%}{%- endunless -%}
                {%- capture cmp_head -%}{% render 'is-shower-head', product: cmp_p %}{%- endcapture -%}
                {%- assign cmp_head = cmp_head | strip -%}
                {%- if cmp_head != 'true' -%}{%- continue -%}{%- endif -%}
                {%- capture cmp_modes -%}{% render 'shower-spray-modes', product: cmp_p %}{%- endcapture -%}
                {%- assign cmp_modes = cmp_modes | strip -%}
                {%- capture cmp_filter -%}{% render 'shower-filter-state', product: cmp_p %}{%- endcapture -%}
                {%- assign cmp_filter = cmp_filter | strip -%}
                {%- capture cmp_hose -%}{% render 'shower-hose-state', product: cmp_p %}{%- endcapture -%}
                {%- assign cmp_hose = cmp_hose | strip -%}
                {%- capture cmp_title -%}{% render 'localized-product-title', product: cmp_p %}{%- endcapture -%}
                {%- assign cmp_title = cmp_title | strip | replace: '&amp;', '&' -%}
                {%- if cmp_title == blank -%}{%- assign cmp_title = cmp_p.title -%}{%- endif -%}
                {%- capture cmp_url -%}{% render 'localized-internal-url', url: cmp_p.url %}{%- endcapture -%}
                {%- assign cmp_variant = cmp_p.selected_or_first_available_variant -%}
                {%- capture cmp_price -%}{% render 'besjaar-discount-badge', product: cmp_p, variant: cmp_variant, layout: 'price_now' %}{%- endcapture -%}
                {%- assign cmp_price = cmp_price | strip -%}
                {%- if cmp_price == '' -%}{%- assign cmp_price = cmp_variant.price | money -%}{%- endif -%}
                <a class="bj-pd-compare__row{% if cmp_p.id == product.id %} is-current{% endif %}" href="{{ cmp_url | strip }}"{% if cmp_p.id == product.id %} aria-current="page"{% endif %}>
                  <span class="bj-pd-compare__name">{{ cmp_title | escape_once }}{% if cmp_p.id == product.id %} <em>{{ 'besjaar_ui.product.compare_current' | t }}</em>{% endif %}</span>
                  <strong class="bj-pd-compare__price">{{ cmp_price }}</strong>
                  <span class="bj-pd-compare__chips">{% if cmp_modes != blank %}<span>{{ 'besjaar_ui.product.shower_modes_chip' | t: count: cmp_modes }}</span>{% endif %}<span>{% if cmp_filter == 'true' %}{{ 'besjaar_ui.product.shower_filter_chip' | t }}{% else %}{{ 'besjaar_ui.product.shower_filter_none_chip' | t }}{% endif %}</span><span>{% if cmp_hose == 'true' %}{{ 'besjaar_ui.product.shower_hose_chip' | t }}{% else %}{{ 'besjaar_ui.product.shower_hose_none_chip' | t }}{% endif %}</span></span>
                </a>
              {%- endfor -%}
            {%- endcapture -%}
            {%- assign cmp_row_count = cmp_rows | split: 'bj-pd-compare__row' | size | minus: 1 -%}
            {%- if cmp_row_count > 1 -%}
              <div class="bj-pd-compare" id="besjaar-compare-models">
                <p class="bj-pd-compare__title">{{ bj_compare_title }}</p>
                {{ cmp_rows }}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}

        <div class="besjaar-store-premium-pd__details" id="besjaar-product-details">
          {%- comment -%}Besjaar 2026-09-12: every product detail panel starts collapsed so the buy box stays close to the top of the page. Panel content is still server-rendered in the initial HTML, so search engines read it whether or not a visitor opens the panel.{%- endcomment -%}
          <details>
            <summary>{{ ui_desc }}</summary>
            <div>{{ product.description }}</div>
          </details>
          {%- if section.settings.show_specs and product_family == 'shower' and bj_has_specs -%}
            <details id="besjaar-product-specs-{{ section.id }}">
              <summary>{{ 'besjaar_ui.product.specifications' | t }}</summary>
              <div>
                <div class="bj-pd-spec">
                  {%- if bj_model != '' -%}<div><span>{{ bj_label_model }}</span><strong>{{ bj_model | escape }}</strong></div>{%- endif -%}
                  {%- if bj_modes != blank -%}<div><span>{{ 'besjaar_ui.product.shower_spray_modes' | t }}</span><strong>{{ bj_modes }}</strong></div>{%- endif -%}
                  {%- if product_is_shower_head == 'true' -%}
                    <div><span>{{ 'besjaar_ui.product.shower_filter' | t }}</span><strong>{% if bj_filter == 'true' %}{{ 'besjaar_ui.common.included' | t }}{% else %}{{ 'besjaar_ui.common.no' | t }}{% endif %}</strong></div>
                  {%- endif -%}
                  {%- if bj_filter_type != '' -%}<div><span>{{ 'besjaar_ui.product.shower_filter_type' | t }}</span><strong>{{ bj_filter_type | escape }}</strong></div>{%- endif -%}
                  {%- if bj_filter_interval != '' -%}<div><span>{{ 'besjaar_ui.product.shower_filter_replacement' | t }}</span><strong>{{ bj_filter_interval | escape }}</strong></div>{%- endif -%}
                  {%- if product_is_shower_head == 'true' -%}
                    <div><span>{{ 'besjaar_ui.product.shower_hose' | t }}</span><strong>{% if bj_hose == 'true' %}{{ 'besjaar_ui.common.included' | t }}{% else %}{{ 'besjaar_ui.common.no' | t }}{% endif %}</strong></div>
                  {%- endif -%}
                  {%- if bj_hose_m != '' -%}<div><span>{{ 'besjaar_ui.product.shower_hose_length' | t }}</span><strong>{{ bj_hose_m }}</strong></div>{%- endif -%}
                  {%- if bj_water != '' -%}<div><span>{{ bj_label_water }}</span><strong>{{ bj_water | escape }}</strong></div>{%- endif -%}
                  {%- if bj_diameter_cm != '' -%}<div><span>{{ 'besjaar_ui.product.shower_diameter' | t }}</span><strong>Ø {{ bj_diameter_cm }}</strong></div>{%- endif -%}
                  {%- if bj_material != '' -%}<div><span>{{ 'besjaar_ui.product.shower_material' | t }}</span><strong>{{ bj_material | escape }}</strong></div>{%- endif -%}
                  {%- if bj_connection != '' -%}<div><span>{{ 'besjaar_ui.product.shower_connection' | t }}</span><strong>{{ bj_connection | escape }}</strong></div>{%- endif -%}
                  {%- if bj_compat != '' -%}<div><span>{{ 'besjaar_ui.product.shower_compatibility' | t }}</span><strong>{{ bj_compat | escape }}</strong></div>{%- endif -%}
                  {%- if warranty_months > 0 -%}<div><span>{{ 'besjaar_ui.product.spec_warranty' | t }}</span><strong>{{ 'besjaar_ui.product.shower_months' | t: count: warranty_months }}</strong></div>{%- endif -%}
                </div>
              </div>
            </details>
          {%- endif -%}
          {%- if section.settings.show_specs and bj_package != '' -%}
            {%- assign bj_box_lines = bj_package | strip | newline_to_br | split: '<br />' -%}
            <details>
              <summary>{{ 'besjaar_ui.product.box_contents' | t }}</summary>
              <div>
                <ul class="bj-pd-box">
                  {%- for bj_line in bj_box_lines -%}
                    {%- assign bj_line_clean = bj_line | strip_html | strip -%}
                    {%- if bj_line_clean != '' -%}<li>{{ bj_line_clean | escape }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            </details>
          {%- endif -%}
          <details id="besjaar-product-installation-{{ section.id }}">
            <summary>{{ ui_install }}</summary>
            <div><p>{{ ui_install_body }}</p></div>
          </details>
          <details>
            <summary>{{ ui_care }}</summary>
            <div><p>{{ ui_care_body }}</p></div>
          </details>
          {%- comment -%}Besjaar 2026-09-22: dynamic cross-links inside the shower family (refill set, filter collection, with/without hose sibling). Renders nothing outside the family.{%- endcomment -%}
          {%- render 'besjaar-product-related', product: product -%}
          {%- for block in section.blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title | escape }}</summary>
              <div>{% if block.settings.use_description %}{{ product.description }}{% else %}{{ block.settings.body }}{% endif %}</div>
            </details>
          {%- endfor -%}
          {%- comment -%}Besjaar 2026-09-22: data-driven product FAQ (fit, spray modes, water use, filter, hose, returns, warranty, shipping) as the last panel. Server-rendered, no FAQPage JSON-LD.{%- endcomment -%}
          {%- render 'besjaar-product-faq', product: product -%}
        </div>
      </div>
    </div>
  </div>

  <div class="besjaar-store-premium-pd__sticky" id="BesjaarSticky-{{ section.id }}" aria-hidden="true">
    <div class="besjaar-store-premium-pd__sticky-copy">
      <strong>{{ display_title | replace: '&amp;', '&' | escape_once }}</strong>
      <span id="BesjaarStickyPrice-{{ section.id }}">{% if bjd_now != '' %}{{ bjd_now }}{% else %}{{ current_variant.price | money }}{% endif %}</span>
    </div>
    <button type="submit" form="{{ form_id }}" class="besjaar-store-premium-pd__sticky-add" data-sticky-submit tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>
      {% if current_variant.available %}{{ ui_add }}{% else %}{{ ui_sold_out }}{% endif %}
    </button>
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('[data-besjaar-product-section="{{ section.id }}"]');
  if (!root) return;
  var mainImage = document.getElementById('BesjaarMainImage-{{ section.id }}');
  var thumbs = document.getElementById('BesjaarThumbs-{{ section.id }}');
  if (thumbs && mainImage) {
    var thumbButtons = Array.prototype.slice.call(thumbs.querySelectorAll('.besjaar-store-premium-pd__thumb'));
    var showThumb = function (btn) {
      if (!btn) return;
      mainImage.src = btn.dataset.src;
      mainImage.srcset = btn.dataset.srcSmall + ' 700w, ' + btn.dataset.src + ' 1600w';
      mainImage.alt = btn.dataset.alt || '';
      thumbButtons.forEach(function (item) {
        item.setAttribute('aria-current', item === btn ? 'true' : 'false');
      });
      try {
        var besjaarReduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        btn.scrollIntoView({ behavior: besjaarReduceMotion ? 'auto' : 'smooth', block: 'nearest', inline: 'nearest' });
      } catch (e) {}
    };
    var moveGallery = function (direction) {
      if (!thumbButtons.length) return;
      var current = thumbButtons.findIndex(function (item) { return item.getAttribute('aria-current') === 'true'; });
      if (current < 0) current = 0;
      var next = (current + direction + thumbButtons.length) % thumbButtons.length;
      showThumb(thumbButtons[next]);
    };
    thumbs.addEventListener('click', function (event) {
      var btn = event.target.closest('.besjaar-store-premium-pd__thumb');
      if (!btn) return;
      showThumb(btn);
    });
    thumbs.addEventListener('keydown', function (event) {
      var btn = event.target.closest('.besjaar-store-premium-pd__thumb');
      if (!btn) return;
      var current = thumbButtons.indexOf(btn);
      var next = current;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (current + 1) % thumbButtons.length;
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (current - 1 + thumbButtons.length) % thumbButtons.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = thumbButtons.length - 1;
      else return;
      event.preventDefault();
      showThumb(thumbButtons[next]);
      thumbButtons[next].focus();
    });

    var stage = document.getElementById('BesjaarStage-{{ section.id }}');
    if (stage && thumbButtons.length > 1) {
      var startX = 0;
      var startY = 0;
      var pointerId = null;
      stage.addEventListener('pointerdown', function (event) {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        pointerId = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
        stage.classList.add('is-dragging');
        try { stage.setPointerCapture(pointerId); } catch (e) {}
      });
      stage.addEventListener('pointerup', function (event) {
        if (pointerId !== null && event.pointerId !== pointerId) return;
        var dx = event.clientX - startX;
        var dy = event.clientY - startY;
        stage.classList.remove('is-dragging');
        pointerId = null;
        if (Math.abs(dx) >= 44 && Math.abs(dx) > Math.abs(dy) * 1.15) moveGallery(dx < 0 ? 1 : -1);
      });
      stage.addEventListener('pointercancel', function () {
        stage.classList.remove('is-dragging');
        pointerId = null;
      });
    }
  }

  root.querySelectorAll('[data-besjaar-qty]').forEach(function (qty) {
    qty.addEventListener('click', function (event) {
      var button = event.target.closest('[data-step]');
      if (!button) return;
      var input = qty.querySelector('input');
      var next = (parseInt(input.value, 10) || 1) + parseInt(button.dataset.step, 10);
      input.value = Math.max(next, parseInt(input.min, 10) || 1);
    });
  });

  var variantSelect = document.getElementById('BesjaarVariant-{{ section.id }}');
  var price = document.getElementById('BesjaarPrice-{{ section.id }}');
  var stickyPrice = document.getElementById('BesjaarStickyPrice-{{ section.id }}');
  var comparePrice = document.getElementById('BesjaarCompare-{{ section.id }}');
  var sale = document.getElementById('BesjaarSale-{{ section.id }}');
  var stock = root.querySelector('[data-product-stock]');
  var stockLabel = root.querySelector('[data-product-stock-label]');
  var mainAdd = document.getElementById('BesjaarMainAdd-{{ section.id }}');
  var sticky = document.getElementById('BesjaarSticky-{{ section.id }}');
  var stickyAdd = sticky ? sticky.querySelector('.besjaar-store-premium-pd__sticky-add') : null;
  var addLabel = {{ ui_add | json }};
  var soldOutLabel = {{ ui_sold_out | json }};
  if (variantSelect) {
    variantSelect.addEventListener('change', function () {
      var option = variantSelect.options[variantSelect.selectedIndex];
      var available = option.dataset.available === 'true';
      var inventory = parseInt(option.dataset.inventoryQuantity || '0', 10);
      var lowStock = available && option.dataset.inventoryManaged === 'true' && inventory > 0 && inventory <= 5;
      /* Besjaar 11.74: an automatic Shopify discount makes the discounted
         figure the price on show, per variant, pre-rendered server side. */
      var discountPrice = option.dataset.discountPrice || '';
      /* 2026-09-27: a compare-at sale shows the same way: sale price in red,
         the earlier price struck through right beside it. */
      var compareSale = discountPrice ? '' : (option.dataset.comparePrice || '');
      if (price) {
        price.textContent = discountPrice || option.dataset.price;
        price.classList.toggle('is-bj-discounted', Boolean(discountPrice || compareSale));
      }
      if (stickyPrice) stickyPrice.textContent = discountPrice || option.dataset.price;
      var bjWas = root.querySelector('[data-bj-price-was]');
      if (bjWas) {
        bjWas.hidden = !(discountPrice || compareSale);
        var bjWasValue = bjWas.querySelector('[data-bj-was-value]');
        if (bjWasValue) bjWasValue.textContent = discountPrice ? option.dataset.price : compareSale;
      }
      if (comparePrice) {
        var compareValue = comparePrice.querySelector('[data-compare-value]');
        (compareValue || comparePrice).textContent = option.dataset.comparePrice || '';
        comparePrice.hidden = true;
      }
      root.querySelectorAll('[data-sale-price-prefix]').forEach(function (salePrefix) {
        salePrefix.hidden = !option.dataset.comparePrice;
      });
      if (sale) {
        sale.textContent = option.dataset.savings ? {{ ui_save | append: ' ' | json }} + option.dataset.savings : '';
        sale.hidden = !option.dataset.savings;
      }
      if (stock) {
        stock.classList.toggle('is-low', lowStock);
        stock.classList.toggle('is-out', !available);
      }
      if (stockLabel) stockLabel.textContent = available ? (lowStock ? root.dataset.lowStockLabel : root.dataset.inStockLabel) : root.dataset.soldOutLabel;
      if (mainAdd) {
        mainAdd.disabled = !available;
        mainAdd.dataset.variantAvailable = available ? 'true' : 'false';
        var currentMainAddLabel = mainAdd.querySelector('[data-add-label]') || mainAdd.querySelector('span:first-child');
        if (currentMainAddLabel) currentMainAddLabel.textContent = available ? addLabel : soldOutLabel;
      }
      if (stickyAdd) {
        stickyAdd.disabled = !available;
        stickyAdd.textContent = available ? addLabel : soldOutLabel;
      }
      if (mainImage && option.dataset.image) {
        mainImage.src = option.dataset.image;
        mainImage.srcset = option.dataset.imageSmall + ' 700w, ' + option.dataset.image + ' 1600w';
        mainImage.alt = option.dataset.imageAlt || mainImage.alt;
        if (thumbs && option.dataset.mediaId) {
          var matchingThumb = thumbs.querySelector('[data-media-id="' + option.dataset.mediaId + '"]');
          if (matchingThumb) showThumb(matchingThumb);
        }
      }
      try {
        var nextUrl = new URL(window.location.href);
        nextUrl.searchParams.set('variant', option.value);
        window.history.replaceState({}, '', nextUrl.toString());
      } catch (error) {}
      /* Besjaar 11.6: keep the back-in-stock module and the Q&A form in sync
         with the selected variant — the restock form must appear for sold-out
         variants and always submit the variant the shopper is looking at. */
      document.querySelectorAll('[data-restock-section]').forEach(function (restockSection) {
        restockSection.hidden = available;
      });
      document.querySelectorAll('[data-restock-variant], [data-qa-variant]').forEach(function (variantField) {
        variantField.value = option.value;
      });
      document.dispatchEvent(new CustomEvent('besjaar_ui:variant-change', { detail: { id: option.value, variantId: option.value, available: available, price: Number(option.dataset.priceCents || 0) } }));
    });
  }

  if (sticky && mainAdd && 'IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      var show = !entries[0].isIntersecting && window.scrollY > 180;
      sticky.classList.toggle('is-visible', show);
      sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
      if (stickyAdd) stickyAdd.tabIndex = show ? 0 : -1;
    }, { threshold: 0.2 });
    observer.observe(mainAdd);
  }
})();
</script>

{% schema %}
{
  "name": "Besjaar premium product",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "checkbox", "id": "enable_image_zoom", "label": "Enable product image zoom", "default": true },
    { "type": "header", "content": "Product facts (2026-09-29)" },
    { "type": "checkbox", "id": "show_highlights", "label": "Show highlights list under the intro", "info": "Reads product metafield custom.highlights (list) on /nl; other languages show spray modes, filter, hose and diameter.", "default": true },
    { "type": "checkbox", "id": "show_specs", "label": "Show Specifications and In the box panels", "info": "Built from product metafields (custom.diameter_mm, hose_length_cm, material, connection_size, water_use, model_number, filter_type, filter_replacement_interval, compatibility, package_contents).", "default": true },
    { "type": "checkbox", "id": "show_compare", "label": "Show \"Which Besjaar fits you\" model comparison", "info": "Lists the available shower heads of the main collection with spray modes, filter, hose and price.", "default": true }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Extra accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "More information" },
        { "type": "checkbox", "id": "use_description", "label": "Use product description", "default": false },
        { "type": "richtext", "id": "body", "label": "Content", "default": "<p>Add additional product information here.</p>" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Besjaar premium product" }]
}
{% endschema %}

