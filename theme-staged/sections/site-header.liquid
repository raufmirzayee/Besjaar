{% liquid
  comment
    2026-09-23: shipping promise per shopper country (snippets/besjaar-shipping-zone).
    Zone 1 (NL) keeps the original wording, zone 2 names the shopper's country,
    other countries get a neutral line without a free-shipping promise.
  endcomment
  capture besjaar_ui_ship_zone
    render 'besjaar-shipping-zone', field: 'zone'
  endcapture
  assign besjaar_ui_ship_zone = besjaar_ui_ship_zone | strip
  capture besjaar_ui_free_shipping_threshold_cents
    render 'besjaar-shipping-zone', field: 'threshold_cents'
  endcapture
  assign besjaar_ui_free_shipping_threshold_cents = besjaar_ui_free_shipping_threshold_cents | strip | plus: 0
  assign besjaar_ui_free_shipping_threshold_money = besjaar_ui_free_shipping_threshold_cents | money_without_trailing_zeros
  capture besjaar_ui_ship_country_name
    render 'besjaar-shipping-zone', field: 'country_name'
  endcapture
  assign besjaar_ui_ship_country_name = besjaar_ui_ship_country_name | strip | upcase
  if section.settings.use_localized_announcement
    if besjaar_ui_ship_zone == '1'
      assign announcement_text = 'besjaar_ui.header.announcement' | t: amount: besjaar_ui_free_shipping_threshold_money
      assign announcement_mobile_text = 'besjaar_ui.header.announcement_mobile' | t: amount: besjaar_ui_free_shipping_threshold_money
    elsif besjaar_ui_ship_zone == '2' and besjaar_ui_free_shipping_threshold_cents > 0
      assign announcement_text = 'besjaar_ui.header.announcement_country' | t: amount: besjaar_ui_free_shipping_threshold_money, country: besjaar_ui_ship_country_name
      assign announcement_mobile_text = 'besjaar_ui.header.announcement_mobile_generic' | t: amount: besjaar_ui_free_shipping_threshold_money
    else
      assign announcement_text = 'besjaar_ui.header.announcement_generic' | t: days: settings.return_window_days
      assign announcement_mobile_text = announcement_text
    endif
  else
    assign announcement_text = section.settings.announcement
    assign announcement_mobile_text = section.settings.announcement_mobile | default: section.settings.announcement
  endif
  capture besjaar_ui_shower_url
    render 'shower-store-url'
  endcapture
  assign besjaar_ui_shower_url = besjaar_ui_shower_url | strip

  assign besjaar_ui_mega_collection = settings.shower_collection
  if besjaar_ui_mega_collection == blank
    assign besjaar_ui_mega_collection = collections['badkamer-douche']
  endif
  if besjaar_ui_mega_collection == blank
    assign besjaar_ui_mega_collection = collections['douchekoppen']
  endif
  if besjaar_ui_mega_collection == blank
    assign besjaar_ui_mega_collection = collections['showerheads']
  endif
  if besjaar_ui_mega_collection == blank
    assign besjaar_ui_mega_collection = collections['douche']
  endif
  if besjaar_ui_mega_collection == blank
    assign besjaar_ui_mega_collection = collections['shower']
  endif
  assign besjaar_ui_mega_filter_all = false
  if besjaar_ui_mega_collection == blank
    assign besjaar_ui_mega_collection = collections['all']
    assign besjaar_ui_mega_filter_all = true
  endif

  assign besjaar_ui_mobile_filter_collection = blank
  for besjaar_ui_mobile_collection_candidate in collections
    assign besjaar_ui_mobile_collection_identity = besjaar_ui_mobile_collection_candidate.title | append: ' ' | append: besjaar_ui_mobile_collection_candidate.handle | downcase
    if besjaar_ui_mobile_collection_candidate.products_count > 0 and besjaar_ui_mobile_collection_identity contains 'filter'
      assign besjaar_ui_mobile_filter_collection = besjaar_ui_mobile_collection_candidate
      break
    endif
  endfor

  assign besjaar_ui_mega_featured_product = blank
  if section.settings.mega_featured_product != blank
    assign besjaar_ui_mega_featured_product = section.settings.mega_featured_product
  endif
  if besjaar_ui_mega_featured_product == blank and besjaar_ui_mega_collection != blank
    for besjaar_ui_mega_candidate in besjaar_ui_mega_collection.products limit: 24
      assign besjaar_ui_mega_candidate_identity = besjaar_ui_mega_candidate.title | append: ' ' | append: besjaar_ui_mega_candidate.handle | append: ' ' | append: besjaar_ui_mega_candidate.type | downcase
      assign besjaar_ui_mega_candidate_family = besjaar_ui_mega_candidate.metafields.custom.product_family.value | default: '' | downcase | strip
      if besjaar_ui_mega_candidate_identity contains 'filter' or besjaar_ui_mega_candidate_family contains 'filter'
        assign besjaar_ui_mega_featured_product = besjaar_ui_mega_candidate
        break
      endif
    endfor
  endif
  if besjaar_ui_mega_featured_product == blank and besjaar_ui_mega_collection != blank and besjaar_ui_mega_collection.products_count > 0
    assign besjaar_ui_mega_featured_product = besjaar_ui_mega_collection.products.first
  endif

  assign besjaar_ui_account_url = routes.account_login_url
  if customer
    assign besjaar_ui_account_url = routes.account_url
  endif
  assign besjaar_ui_customer_account_menu = section.settings.customer_account_menu.handle | default: 'customer-account-main-menu'

  assign besjaar_ui_faq_current = false
  assign besjaar_ui_contact_current = false
  if request.page_type == 'page' and page != blank
    if page.handle == 'veelgestelde-vragen' or page.handle == 'faq' or page.handle == 'frequently-asked-questions'
      assign besjaar_ui_faq_current = true
    endif
    if page.handle == 'contact' or page.handle == 'contact-us' or page.handle == 'contacteer-ons' or page.handle == 'klantenservice'
      assign besjaar_ui_contact_current = true
    endif
  endif
  assign besjaar_ui_track_current = false
  if request.path contains '/track-order' or request.path contains '/track-your-order' or request.path contains '/order-tracking' or request.path contains '/tracking' or request.path contains '/apps/parcelpanel'
    assign besjaar_ui_track_current = true
  endif

  assign besjaar_ui_faq_page = settings.faq_page
  if besjaar_ui_faq_page == blank
    assign besjaar_ui_faq_page = pages['veelgestelde-vragen']
  endif
  if besjaar_ui_faq_page == blank
    assign besjaar_ui_faq_page = pages['faq']
  endif
  if besjaar_ui_faq_page == blank
    assign besjaar_ui_faq_page = pages['frequently-asked-questions']
  endif
  capture besjaar_ui_faq_url
    if besjaar_ui_faq_page != blank
      render 'localized-internal-url', url: besjaar_ui_faq_page.url
    else
      render 'localized-internal-url', url: '/pages/faq'
    endif
  endcapture
  assign besjaar_ui_faq_url = besjaar_ui_faq_url | strip

  assign besjaar_ui_contact_page = settings.contact_page
  if besjaar_ui_contact_page == blank
    assign besjaar_ui_contact_page = pages['contact']
  endif
  if besjaar_ui_contact_page == blank
    assign besjaar_ui_contact_page = pages['contact-us']
  endif
  if besjaar_ui_contact_page == blank
    assign besjaar_ui_contact_page = pages['contacteer-ons']
  endif
  if besjaar_ui_contact_page == blank
    assign besjaar_ui_contact_page = pages['klantenservice']
  endif
  capture besjaar_ui_contact_url
    if besjaar_ui_contact_page != blank
      render 'localized-internal-url', url: besjaar_ui_contact_page.url
    else
      render 'localized-internal-url', url: '/pages/contact'
    endif
  endcapture
  assign besjaar_ui_contact_url = besjaar_ui_contact_url | strip

  assign besjaar_ui_tracking_page = settings.tracking_page
  if besjaar_ui_tracking_page == blank
    assign besjaar_ui_tracking_page = pages['track-order']
  endif
  if besjaar_ui_tracking_page == blank
    assign besjaar_ui_tracking_page = pages['track-your-order']
  endif
  if besjaar_ui_tracking_page == blank
    assign besjaar_ui_tracking_page = pages['order-tracking']
  endif
  if besjaar_ui_tracking_page == blank
    assign besjaar_ui_tracking_page = pages['tracking']
  endif
  capture besjaar_ui_track_url
    if besjaar_ui_tracking_page != blank
      render 'localized-internal-url', url: besjaar_ui_tracking_page.url
    else
      render 'localized-internal-url', url: '/apps/parcelpanel'
    endif
  endcapture
  assign besjaar_ui_track_url = besjaar_ui_track_url | strip

  assign besjaar_ui_about_current = false
  if request.page_type == 'page' and page != blank
    if page.handle == 'over-ons' or page.handle == 'overons' or page.handle == 'about-us' or page.handle == 'about'
      assign besjaar_ui_about_current = true
    endif
  endif
  assign besjaar_ui_about_page = pages['over-ons']
  if besjaar_ui_about_page == blank
    assign besjaar_ui_about_page = pages['overons']
  endif
  if besjaar_ui_about_page == blank
    assign besjaar_ui_about_page = pages['about-us']
  endif
  if besjaar_ui_about_page == blank
    assign besjaar_ui_about_page = pages['about']
  endif
  capture besjaar_ui_about_url
    if besjaar_ui_about_page != blank
      render 'localized-internal-url', url: besjaar_ui_about_page.url
    else
      render 'localized-internal-url', url: '/pages/about-us'
    endif
  endcapture
  assign besjaar_ui_about_url = besjaar_ui_about_url | strip
  assign besjaar_ui_reviews_url = routes.root_url | append: '#besjaar-store-reviews'

  comment
    2026-09-22: the nav 'guide' slot used to point at the homepage feature
    cards (#besjaar-store-details). When the guide blog has published posts
    and we are on the primary (nl) storefront the slot links the blog instead;
    the guides are Dutch-only, so other languages keep the homepage anchor.
  endcomment
  assign besjaar_ui_guide_url = routes.root_url | append: '#besjaar-store-details'
  assign besjaar_ui_guide_label = 'besjaar_ui.shower_store.nav.guide' | t
  assign besjaar_ui_guide_blog = blogs['gids']
  if besjaar_ui_guide_blog != blank and besjaar_ui_guide_blog.articles_count > 0
    capture besjaar_ui_guide_url
      render 'localized-internal-url', url: besjaar_ui_guide_blog.url
    endcapture
    assign besjaar_ui_guide_url = besjaar_ui_guide_url | strip
    assign besjaar_ui_guide_label = 'besjaar_ui.blog.title' | t
  endif
%}
{% if section.settings.show_announcement and announcement_text != blank %}
  {% liquid
    assign besjaar_ui_announcement_link = section.settings.announcement_link | default: routes.root_url
    capture besjaar_ui_announcement_link_capture
      render 'localized-internal-url', url: besjaar_ui_announcement_link
    endcapture
    assign besjaar_ui_announcement_url = besjaar_ui_announcement_link_capture | strip
    if section.settings.announcement_discount_code != blank
      assign besjaar_ui_announcement_target = besjaar_ui_announcement_url | url_encode
      assign besjaar_ui_announcement_code = section.settings.announcement_discount_code | url_encode
      assign besjaar_ui_discount_path = 'discount/' | append: besjaar_ui_announcement_code | append: '?redirect=' | append: besjaar_ui_announcement_target
      capture besjaar_ui_discount_url_capture
        render 'localized-internal-url', url: besjaar_ui_discount_path
      endcapture
      assign besjaar_ui_announcement_url = besjaar_ui_discount_url_capture | strip
    endif
  %}
  <div class="besjaar-ui-announcement" data-campaign-window data-campaign-start="{{ section.settings.announcement_start_at | escape }}" data-campaign-end="{{ section.settings.announcement_end_at | escape }}">
    <div class="besjaar-ui-shell besjaar-ui-announcement__inner">
      {%- comment -%}
        2026-09-30 (Univex header): the bar shows three short messages side by
        side with an icon each (shipping · dispatch · returns), rotating one at
        a time on phones. Shipping uses the shopper's zone threshold; the
        dispatch line uses the theme's cut-off hour.
      {%- endcomment -%}
      {%- liquid
        assign bja_lang = request.locale.iso_code | split: '-' | first | downcase
        assign bja_cutoff = settings.order_cutoff_hour | default: 16
        case bja_lang
          when 'de'
            assign bja_dispatch = 'Vor ' | append: bja_cutoff | append: ':00 bestellt, heute versendet'
            assign bja_returns = settings.return_window_days | append: ' Tage Rückgabe'
          when 'fr'
            assign bja_dispatch = 'Commandé avant ' | append: bja_cutoff | append: 'h, expédié le jour même'
            assign bja_returns = 'Retours sous ' | append: settings.return_window_days | append: ' jours'
          when 'en'
            assign bja_dispatch = 'Order before ' | append: bja_cutoff | append: ':00, ships today'
            assign bja_returns = settings.return_window_days | append: '-day returns'
          else
            assign bja_dispatch = 'Voor ' | append: bja_cutoff | append: ':00 besteld, vandaag verzonden'
            assign bja_returns = settings.return_window_days | append: ' dagen retour'
        endcase
        assign bja_ship = ''
        if besjaar_ui_free_shipping_threshold_cents > 0
          assign bja_ship = 'besjaar_ui.product.free_shipping_from' | t: amount: besjaar_ui_free_shipping_threshold_money
        endif
      -%}
      <a class="bj-ann" href="{{ besjaar_ui_announcement_url }}">
        {%- if bja_ship != '' -%}<span class="bj-ann__item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 6h12v10H2zM14 10h4l3 3v3h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>{{ bja_ship }}</span>{%- endif -%}
        <span class="bj-ann__item"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>{{ bja_dispatch }}</span>
        <span class="bj-ann__item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10h11a5 5 0 0 1 0 10H9"/><path d="m8 6-4 4 4 4"/></svg>{{ bja_returns }}</span>
      </a>
      {% if section.settings.announcement_discount_code != blank %}<button type="button" data-promo-copy="{{ section.settings.announcement_discount_code | escape }}"><span>{{ 'besjaar_ui.campaign.code' | t }}</span> <strong>{{ section.settings.announcement_discount_code | escape }}</strong></button>{% endif %}
      {% if settings.enable_campaign_countdowns and section.settings.announcement_show_countdown and section.settings.announcement_end_at != blank %}<span class="besjaar-ui-announcement__countdown" data-campaign-countdown data-end="{{ section.settings.announcement_end_at | escape }}"><span>{{ 'besjaar_ui.campaign.ends_in' | t }}</span> <strong data-campaign-countdown-value>—</strong></span>{% endif %}
    </div>
  </div>
{% endif %}
{%- comment -%}
  2026-09-30 header layout copied from the owner's Univex theme: charcoal
  announcement bar with inline messages; white header with a hairline border
  and a soft shadow once scrolled; logo left, menu centred, icons right on
  computers; menu button left, logo centred, icons right on phones; pill
  hover on menu links and round icon buttons; green cart-count bubble.
{%- endcomment -%}
<style>
  html body .besjaar-ui-announcement:not(#bj-h1):not(#bj-h2){background:#1C2326!important;color:#F5F2EC!important;border:0!important}
  html body .besjaar-ui-announcement__inner:not(#bj-h1):not(#bj-h2){min-height:40px!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:16px!important;padding-top:0!important;padding-bottom:0!important}
  html body .besjaar-ui-announcement a.bj-ann:not(#bj-h1):not(#bj-h2){display:flex!important;align-items:center!important;justify-content:center!important;gap:40px!important;color:#F5F2EC!important;text-decoration:none!important;font-size:13px!important;font-weight:500!important;letter-spacing:.01em!important;text-transform:none!important}
  html body .besjaar-ui-announcement .bj-ann__item:not(#bj-h1):not(#bj-h2){display:inline-flex!important;align-items:center!important;gap:8px!important;white-space:nowrap!important}
  html body .besjaar-ui-announcement .bj-ann__item svg:not(#bj-h1):not(#bj-h2){width:16px!important;height:16px!important;fill:none!important;stroke:#8FD1BF!important;stroke-width:1.7!important;stroke-linecap:round!important;stroke-linejoin:round!important}
  @media (max-width:760px){
    html body .besjaar-ui-announcement a.bj-ann:not(#bj-h1):not(#bj-h2){position:relative!important;display:block!important;width:100%!important;height:40px!important;gap:0!important;overflow:hidden!important}
    html body .besjaar-ui-announcement .bj-ann__item:not(#bj-h1):not(#bj-h2){position:absolute!important;inset:0!important;justify-content:center!important;opacity:0;animation:bj-ann-cycle 15s infinite}
    html body .besjaar-ui-announcement .bj-ann__item:nth-child(2):not(#bj-h1):not(#bj-h2){animation-delay:5s}
    html body .besjaar-ui-announcement .bj-ann__item:nth-child(3):not(#bj-h1):not(#bj-h2){animation-delay:10s}
    html body .besjaar-ui-announcement .bj-ann__item:only-child:not(#bj-h1):not(#bj-h2){opacity:1;animation:none}
  }
  @keyframes bj-ann-cycle{0%{opacity:0;transform:translateY(6px)}4%,30%{opacity:1;transform:none}34%,100%{opacity:0;transform:translateY(-6px)}}
  @media (prefers-reduced-motion:reduce){html body .besjaar-ui-announcement .bj-ann__item:not(#bj-h1):not(#bj-h2){animation:none!important} html body .besjaar-ui-announcement .bj-ann__item:first-child:not(#bj-h1):not(#bj-h2){opacity:1}}

  html body .besjaar-ui-header:not(#bj-h1):not(#bj-h2){background:#fff!important;border-bottom:1px solid rgba(28,35,38,.14)!important;box-shadow:none!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;transition:box-shadow .3s ease!important}
  html body .besjaar-ui-header.is-scrolled:not(#bj-h1):not(#bj-h2){box-shadow:0 6px 24px -18px rgba(0,0,0,.45)!important}
  html body .besjaar-ui-header__row:not(#bj-h1):not(#bj-h2){position:relative!important;display:grid!important;align-items:center!important;column-gap:32px!important;min-height:76px!important;padding-top:6px!important;padding-bottom:6px!important}
  html body .besjaar-ui-header .besjaar-ui-nav__link,html body .besjaar-ui-header .besjaar-ui-nav>a,html body .besjaar-ui-header .besjaar-ui-nav :is(.besjaar-ui-nav__link,.besjaar-ui-shop-mega__trigger):not(#bj-h1):not(#bj-h2){display:inline-flex!important;align-items:center!important;gap:4px!important;padding:10px 12px!important;border-radius:99px!important;color:#1C2326!important;font-size:15px!important;font-weight:500!important;letter-spacing:0!important;text-transform:none!important;text-decoration:none!important;white-space:nowrap!important;transition:background-color .2s ease!important}
  html body .besjaar-ui-header .besjaar-ui-nav :is(a,.besjaar-ui-shop-mega__trigger):hover:not(#bj-h1):not(#bj-h2){background:rgba(28,35,38,.06)!important}
  html body .besjaar-ui-header .besjaar-ui-nav a[aria-current="page"]:not(#bj-h1):not(#bj-h2){color:#1F5F52!important}
  html body .besjaar-ui-header .besjaar-ui-nav .besjaar-ui-shop-mega__trigger svg:not(#bj-h1):not(#bj-h2){width:14px!important;height:14px!important}
  html body .besjaar-ui-header__actions:not(#bj-h1):not(#bj-h2){display:flex!important;align-items:center!important;justify-content:flex-end!important;gap:2px!important}
  html body .besjaar-ui-header :is(.besjaar-ui-icon-btn,.besjaar-ui-account-trigger):not(#bj-h1):not(#bj-h2){position:relative!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;width:44px!important;height:44px!important;min-height:44px!important;padding:0!important;border:0!important;border-radius:50%!important;background:transparent!important;color:#1C2326!important;box-shadow:none!important;transition:background-color .2s ease!important}
  html body .besjaar-ui-header :is(.besjaar-ui-icon-btn,.besjaar-ui-account-trigger):hover:not(#bj-h1):not(#bj-h2){background:rgba(28,35,38,.06)!important}
  html body .besjaar-ui-header :is(.besjaar-ui-icon-btn,.besjaar-ui-account-trigger) svg:not(#bj-h1):not(#bj-h2){width:22px!important;height:22px!important}
  html body .besjaar-ui-header .besjaar-ui-count:not(#bj-h1):not(#bj-h2){position:absolute!important;top:4px!important;right:2px!important;min-width:19px!important;height:19px!important;padding:0 5px!important;border:0!important;border-radius:99px!important;background:#1F5F52!important;color:#fff!important;font-size:11px!important;font-weight:700!important;line-height:19px!important;text-align:center!important}
  html body .besjaar-ui-header .besjaar-ui-count:is(:empty):not(#bj-h1):not(#bj-h2){display:none!important}
  @media (min-width:990px){
    html body .besjaar-ui-header__row:not(#bj-h1):not(#bj-h2){grid-template-columns:auto minmax(0,1fr) auto!important;grid-template-areas:"logo nav icons"!important}
    html body .besjaar-ui-header .besjaar-ui-brand:not(#bj-h1):not(#bj-h2){grid-area:logo!important;justify-self:start!important}
    html body .besjaar-ui-header .besjaar-ui-nav:not(#bj-h1):not(#bj-h2){grid-area:nav!important;justify-self:center!important;display:flex!important;align-items:center!important;gap:4px!important;min-width:0!important}
    html body .besjaar-ui-header__actions:not(#bj-h1):not(#bj-h2){grid-area:icons!important}
    html body .besjaar-ui-header .besjaar-ui-menu-toggle:not(#bj-h1):not(#bj-h2){display:none!important}
  }
  @media (max-width:989px){
    html body .besjaar-ui-header__row:not(#bj-h1):not(#bj-h2){grid-template-columns:1fr auto 1fr!important;grid-template-areas:"left logo icons"!important;min-height:64px!important;column-gap:10px!important}
    html body .besjaar-ui-header .besjaar-ui-brand:not(#bj-h1):not(#bj-h2){grid-area:logo!important;justify-self:center!important}
    html body .besjaar-ui-header .besjaar-ui-nav:not(#bj-h1):not(#bj-h2){display:none!important}
    html body .besjaar-ui-header__actions:not(#bj-h1):not(#bj-h2){grid-area:icons!important;justify-self:end!important;margin-right:-6px!important;position:static!important}
    html body .besjaar-ui-header .besjaar-ui-menu-toggle:not(#bj-h1):not(#bj-h2){position:absolute!important;left:max(6px,calc(var(--besjaar-ui-gutter,16px) - 10px))!important;top:50%!important;transform:translateY(-50%)!important;display:inline-flex!important}
  }
</style>
<header class="besjaar-ui-header" data-site-header>
  <div class="besjaar-ui-shell besjaar-ui-header__row">
    <a class="besjaar-ui-brand notranslate" translate="no" data-besjaar-ui-brand href="{{ routes.root_url }}" aria-label="Besjaar — {{ 'besjaar_ui.header.home' | t | escape }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 320 | image_tag: widths: '140,220,320', alt: 'Besjaar' }}
      {% else %}<span translate="no">BESJAAR</span>{% endif %}
    </a>

    <nav class="besjaar-ui-nav besjaar-ui-nav--shower-focus" aria-label="{{ 'besjaar_ui.accessibility.main_navigation' | t | escape }}">
      <div class="besjaar-ui-shop-mega-wrap" data-shop-mega>
        <a class="besjaar-ui-nav__link besjaar-ui-shop-mega__trigger" href="{{ besjaar_ui_shower_url }}" aria-haspopup="true" aria-expanded="false" aria-controls="BesjaarUIShopMega-{{ section.id }}" data-shop-mega-trigger>
          <span>{{ 'besjaar_ui.shower_store.nav.shop' | t }}</span>
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 5 4 4 4-4"/></svg>
        </a>
        <div class="besjaar-ui-shop-mega" id="BesjaarUIShopMega-{{ section.id }}" data-shop-mega-panel aria-hidden="true" inert>
          <div class="besjaar-ui-shell besjaar-ui-shop-mega__inner{% if besjaar_ui_mega_featured_product != blank %} has-featured{% else %} is-catalog-only{% endif %}">
            <div class="besjaar-ui-shop-mega__catalog">
              <a class="besjaar-ui-shop-mega__eyebrow besjaar-ui-shop-mega__all-link" href="{{ besjaar_ui_shower_url }}">{{ 'besjaar_ui.header.shop_all' | t }} <span aria-hidden="true">→</span></a>
              <div class="besjaar-ui-shop-mega__grid">
                {% assign besjaar_ui_mega_rendered = 0 %}
                {% if besjaar_ui_mega_collection != blank %}
                  {% for mega_product in besjaar_ui_mega_collection.products limit: 24 %}
                    {% assign besjaar_ui_mega_include = true %}
                    {% if besjaar_ui_mega_filter_all %}
                      {% capture besjaar_ui_mega_is_head_capture %}{% render 'is-shower-head', product: mega_product %}{% endcapture %}
                      {% assign besjaar_ui_mega_is_head = besjaar_ui_mega_is_head_capture | strip %}
                      {% unless besjaar_ui_mega_is_head == 'true' %}{% assign besjaar_ui_mega_include = false %}{% endunless %}
                    {% endif %}
                    {% if besjaar_ui_mega_featured_product != blank and mega_product.id == besjaar_ui_mega_featured_product.id %}
                      {% assign besjaar_ui_mega_include = false %}
                    {% endif %}
                    {% if besjaar_ui_mega_include and besjaar_ui_mega_rendered < 4 %}
                      {% liquid
                        assign besjaar_ui_mega_meta_label = ''
                        if mega_product.metafields.custom.best_for != blank
                          assign besjaar_ui_mega_meta_label = mega_product.metafields.custom.best_for.value
                        endif
                        if besjaar_ui_mega_meta_label == blank and mega_product.metafields.custom.product_subtitle != blank
                          assign besjaar_ui_mega_meta_label = mega_product.metafields.custom.product_subtitle.value
                        endif
                        if besjaar_ui_mega_meta_label == blank and mega_product.metafields.descriptors.subtitle != blank
                          assign besjaar_ui_mega_meta_label = mega_product.metafields.descriptors.subtitle.value
                        endif
                        if besjaar_ui_mega_meta_label == blank
                          assign besjaar_ui_mega_identity = mega_product.title | append: ' ' | append: mega_product.handle | downcase
                          assign besjaar_ui_mega_is_filter_product = false
                          if besjaar_ui_mega_identity contains 'douchefilter' or besjaar_ui_mega_identity contains 'duschfilter' or besjaar_ui_mega_identity contains 'shower filter' or besjaar_ui_mega_identity contains 'filtre de douche'
                            assign besjaar_ui_mega_is_filter_product = true
                          endif
                          assign besjaar_ui_mega_is_refill = false
                          if besjaar_ui_mega_identity contains 'navul' or besjaar_ui_mega_identity contains 'refill' or besjaar_ui_mega_identity contains 'nachf' or besjaar_ui_mega_identity contains 'recharge'
                            assign besjaar_ui_mega_is_refill = true
                          endif
                          if request.locale.iso_code == 'nl'
                            if besjaar_ui_mega_is_refill
                              assign besjaar_ui_mega_meta_label = 'Navulset'
                            elsif besjaar_ui_mega_is_filter_product
                              assign besjaar_ui_mega_meta_label = 'Douchefilter'
                            elsif besjaar_ui_mega_identity contains 'filter'
                              assign besjaar_ui_mega_meta_label = 'Met filter'
                            elsif besjaar_ui_mega_identity contains 'slang' or besjaar_ui_mega_identity contains 'hose'
                              assign besjaar_ui_mega_meta_label = 'Complete set'
                            else
                              assign besjaar_ui_mega_meta_label = 'Douchekop'
                            endif
                          elsif request.locale.iso_code == 'de'
                            if besjaar_ui_mega_is_refill
                              assign besjaar_ui_mega_meta_label = 'Nachfüllset'
                            elsif besjaar_ui_mega_is_filter_product
                              assign besjaar_ui_mega_meta_label = 'Duschfilter'
                            elsif besjaar_ui_mega_identity contains 'filter'
                              assign besjaar_ui_mega_meta_label = 'Mit Filter'
                            elsif besjaar_ui_mega_identity contains 'schlauch' or besjaar_ui_mega_identity contains 'hose'
                              assign besjaar_ui_mega_meta_label = 'Komplettset'
                            else
                              assign besjaar_ui_mega_meta_label = 'Duschkopf'
                            endif
                          elsif request.locale.iso_code == 'fr'
                            if besjaar_ui_mega_is_refill
                              assign besjaar_ui_mega_meta_label = 'Recharge'
                            elsif besjaar_ui_mega_is_filter_product
                              assign besjaar_ui_mega_meta_label = 'Filtre de douche'
                            elsif besjaar_ui_mega_identity contains 'filter'
                              assign besjaar_ui_mega_meta_label = 'Avec filtre'
                            elsif besjaar_ui_mega_identity contains 'tuyau' or besjaar_ui_mega_identity contains 'hose'
                              assign besjaar_ui_mega_meta_label = 'Kit complet'
                            else
                              assign besjaar_ui_mega_meta_label = 'Pommeau de douche'
                            endif
                          else
                            if besjaar_ui_mega_is_refill
                              assign besjaar_ui_mega_meta_label = 'Refill pack'
                            elsif besjaar_ui_mega_is_filter_product
                              assign besjaar_ui_mega_meta_label = 'Shower filter'
                            elsif besjaar_ui_mega_identity contains 'filter'
                              assign besjaar_ui_mega_meta_label = 'Filtered'
                            elsif besjaar_ui_mega_identity contains 'hose'
                              assign besjaar_ui_mega_meta_label = 'Complete set'
                            else
                              assign besjaar_ui_mega_meta_label = 'Showerhead'
                            endif
                          endif
                        endif
                      %}
                      {% capture besjaar_ui_mega_product_url %}{% render 'localized-internal-url', url: mega_product.url %}{% endcapture %}
                      <a class="besjaar-ui-shop-mega__item" href="{{ besjaar_ui_mega_product_url | strip }}">
                        <span class="besjaar-ui-shop-mega__thumb">
                          {% if mega_product.featured_image != blank %}
                            {% assign besjaar_ui_mega_image_alt = mega_product.featured_image.alt | default: mega_product.title %}
                            {{ mega_product.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', decoding: 'async', widths: '80,120,180', sizes: '72px', alt: besjaar_ui_mega_image_alt }}
                          {% else %}
                            <span class="besjaar-ui-shop-mega__thumb-placeholder" aria-hidden="true"></span>
                          {% endif %}
                        </span>
                        <span class="besjaar-ui-shop-mega__item-copy">
                          <strong>{% render 'localized-product-title', product: mega_product %}</strong>
                          <small>{{ besjaar_ui_mega_meta_label | strip | strip_html }}</small>
                        </span>
                      </a>
                      {% assign besjaar_ui_mega_rendered = besjaar_ui_mega_rendered | plus: 1 %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
              </div>
              {%- comment -%}2026-09-22: the desktop mega menu never linked the Douchefilters collection (the navulset is the 5th product and the grid stops at 4).{%- endcomment -%}
              {% if besjaar_ui_mobile_filter_collection != blank and besjaar_ui_mobile_filter_collection.id != besjaar_ui_mega_collection.id %}
                {%- capture besjaar_ui_mega_filter_title -%}{% render 'localized-collection-title', collection: besjaar_ui_mobile_filter_collection %}{%- endcapture -%}
                <a class="besjaar-ui-shop-mega__eyebrow besjaar-ui-shop-mega__all-link" href="{% render 'localized-internal-url', url: besjaar_ui_mobile_filter_collection.url %}">{{ besjaar_ui_mega_filter_title | strip | replace: '&amp;', '&' | escape_once }} <span aria-hidden="true">→</span></a>
              {% endif %}
            </div>

            {% if besjaar_ui_mega_featured_product != blank %}
              {% capture besjaar_ui_mega_featured_url %}{% render 'localized-internal-url', url: besjaar_ui_mega_featured_product.url %}{% endcapture %}
              <a class="besjaar-ui-shop-mega__featured" href="{{ besjaar_ui_mega_featured_url | strip }}">
                {% if besjaar_ui_mega_featured_product.featured_image != blank %}
                  {% assign besjaar_ui_mega_featured_alt = besjaar_ui_mega_featured_product.featured_image.alt | default: besjaar_ui_mega_featured_product.title %}
                  {{ besjaar_ui_mega_featured_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', decoding: 'async', widths: '420,640,900', sizes: '340px', alt: besjaar_ui_mega_featured_alt }}
                {% endif %}
                <span class="besjaar-ui-shop-mega__featured-shade" aria-hidden="true"></span>
                <span class="besjaar-ui-shop-mega__featured-copy">
                  <small>{{ 'besjaar_ui.header.featured' | t }}</small>
                  <strong>{% render 'localized-product-title', product: besjaar_ui_mega_featured_product %}</strong>
                  <span>{{ 'besjaar_shower_collection.shop_now' | t }} →</span>
                </span>
              </a>
            {% endif %}
          </div>
        </div>
      </div>
      <a class="besjaar-ui-nav__link" href="{{ besjaar_ui_guide_url }}">{{ besjaar_ui_guide_label | escape }}</a>
      <a class="besjaar-ui-nav__link" href="{{ besjaar_ui_about_url }}"{% if besjaar_ui_about_current %} aria-current="page"{% endif %}>{{ 'besjaar_ui.shower_store.nav.about' | t }}</a>
      <div class="besjaar-ui-more-menu{% if besjaar_ui_faq_current or besjaar_ui_contact_current or besjaar_ui_track_current %} is-current{% endif %}" data-more-menu>
        <button class="besjaar-ui-nav__link besjaar-ui-more-menu__trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="BesjaarUIMoreMenu-{{ section.id }}" data-more-menu-trigger>
          <span>{{ 'besjaar_ui.shower_store.nav.more' | t }}</span>
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 5 4 4 4-4"/></svg>
        </button>
        <div class="besjaar-ui-more-menu__panel" id="BesjaarUIMoreMenu-{{ section.id }}" data-more-menu-panel aria-hidden="true" inert>
          <a href="{{ besjaar_ui_reviews_url }}">{{ 'besjaar_ui.shower_store.nav.reviews' | t }} <span aria-hidden="true">→</span></a>
          <a href="{{ besjaar_ui_faq_url }}"{% if besjaar_ui_faq_current %} aria-current="page"{% endif %}>{{ 'besjaar_ui.shower_store.nav.faq' | t }} <span aria-hidden="true">→</span></a>
          <a href="{{ besjaar_ui_contact_url }}"{% if besjaar_ui_contact_current %} aria-current="page"{% endif %}>{{ 'besjaar_ui.shower_store.nav.contact' | t }} <span aria-hidden="true">→</span></a>
          <a href="{{ besjaar_ui_track_url }}"{% if besjaar_ui_track_current %} aria-current="page"{% endif %}>{{ 'besjaar_ui.shower_store.nav.track' | t }} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </nav>

    <div class="besjaar-ui-header__actions">
      <button class="besjaar-ui-icon-btn besjaar-ui-menu-toggle" type="button" aria-label="{{ 'besjaar_ui.accessibility.menu' | t }}" aria-expanded="false" aria-controls="BesjaarUIMobileMenu-{{ section.id }}" aria-haspopup="true" data-menu-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <button class="besjaar-ui-icon-btn" type="button" aria-label="{{ 'besjaar_ui.accessibility.search' | t }}" aria-expanded="false" aria-haspopup="dialog" aria-controls="BesjaarUISearchPanel-{{ section.id }}" data-search-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
      </button>
      {% if settings.show_header_localization %}{% unless request.visual_preview_mode %}<div class="besjaar-ui-localization-slot besjaar-ui-localization-slot--desktop">{% render 'besjaar-ui-localization', context: 'header', section_id: section.id %}</div>{% endunless %}{% endif %}
      {% if shop.customer_accounts_enabled %}
        {% if section.settings.use_shopify_account_component %}
          <div class="besjaar-ui-account-action besjaar-ui-shopify-account-wrap">
            <shopify-account class="besjaar-ui-shopify-account" menu="{{ besjaar_ui_customer_account_menu }}" aria-label="{{ 'besjaar_ui.header.my_account' | t | escape }}"></shopify-account>
          </div>
        {% elsif customer %}
          <details class="besjaar-ui-account-menu besjaar-ui-account-action">
            <summary class="besjaar-ui-account-trigger" aria-label="{{ 'besjaar_ui.header.my_account' | t | escape }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4.8 21a7.2 7.2 0 0 1 14.4 0"/></svg>
              {% if settings.show_account_labels %}<span>{{ 'besjaar_ui.header.my_account' | t }}</span>{% endif %}
            </summary>
            <div class="besjaar-ui-account-popover besjaar-ui-account-popover--retail">
              <div class="besjaar-ui-account-popover__head">
                <div class="besjaar-ui-account-popover__avatar" aria-hidden="true">{{ customer.first_name | default: customer.email | slice: 0 | upcase }}</div>
                <div><span>{{ settings.account_member_label | default: 'Besjaar Account' | escape }}</span><strong>{{ customer.first_name | default: customer.email | escape }}</strong><small>{{ customer.email | escape }}</small></div>
              </div>
              <div class="besjaar-ui-account-popover__snapshot"><span><b>{{ customer.orders_count }}</b>{{ 'besjaar_ui.account.orders' | t }}</span><span><b>{{ customer.addresses.size }}</b>{{ 'besjaar_ui.account.addresses' | t }}</span></div>
              <a href="{{ routes.account_url }}">{{ 'besjaar_ui.account.overview' | t }} <span>→</span></a>
              <a href="{{ routes.account_url }}#orders">{{ 'besjaar_ui.account.orders_tracking' | t }} <span>→</span></a>
              <a href="{{ routes.account_addresses_url }}">{{ 'besjaar_ui.account.delivery_details' | t }} <span>→</span></a>
              {% if settings.returns_info_page != blank %}<a href="{% render 'localized-internal-url', url: settings.returns_info_page.url %}">{{ 'besjaar_ui.account.returns_v46' | t }} <span>→</span></a>{% endif %}
              {% if settings.enable_besjaar_club and settings.show_club_header_link %}{% assign besjaar_ui_club_url = routes.account_url %}{% if settings.club_page != blank %}{% assign besjaar_ui_club_url = settings.club_page.url %}{% elsif settings.account_rewards_page != blank %}{% assign besjaar_ui_club_url = settings.account_rewards_page.url %}{% endif %}<a href="{% render 'localized-internal-url', url: besjaar_ui_club_url %}">{{ settings.club_name | default: 'Besjaar Club' | escape }} <span>→</span></a>{% endif %}
              {% if settings.account_support_page != blank %}<a href="{% render 'localized-internal-url', url: settings.account_support_page.url %}">{{ 'besjaar_ui.account.support' | t }} <span>→</span></a>{% endif %}
              <a class="besjaar-ui-account-popover__logout" href="{{ routes.account_logout_url }}">{{ 'besjaar_ui.account.logout' | t }}</a>
            </div>
          </details>
          <a class="besjaar-ui-icon-btn besjaar-ui-account-action besjaar-ui-account-action--mobile" href="{{ routes.account_url }}" aria-label="{{ 'besjaar_ui.header.my_account' | t | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4.8 21a7.2 7.2 0 0 1 14.4 0"/></svg>
          </a>
        {% else %}
          <a class="besjaar-ui-account-trigger besjaar-ui-account-action" href="{{ routes.account_login_url }}" rel="nofollow" aria-label="{{ 'besjaar_ui.header.sign_in' | t | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4.8 21a7.2 7.2 0 0 1 14.4 0"/></svg>
            {% if settings.show_account_labels %}<span>{{ 'besjaar_ui.header.sign_in' | t }}</span>{% endif %}
          </a>
        {% endif %}
      {% endif %}
      <button class="besjaar-ui-icon-btn" type="button" aria-label="{{ 'besjaar_ui.accessibility.cart' | t }}" aria-haspopup="dialog" aria-controls="BesjaarUICartDrawer" data-open-drawer="cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 4h2l2.2 10.1a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L20.5 7H6"/><circle cx="9.5" cy="20" r="1"/><circle cx="17" cy="20" r="1"/></svg>
        <span class="besjaar-ui-count" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  <nav class="besjaar-ui-mobile-menu" id="BesjaarUIMobileMenu-{{ section.id }}" data-mobile-menu aria-hidden="true" aria-label="{{ 'besjaar_ui.accessibility.mobile_menu' | t | escape }}" inert>
    {%- comment -%}2026-09-22: language switch moved from the bottom of the mobile menu to the top (merchant: shoppers could not find it at the end).{%- endcomment -%}
    {% if settings.show_header_localization %}{% unless request.visual_preview_mode %}<div class="besjaar-ui-mobile-menu__localization besjaar-ui-mobile-menu__localization--top"><span class="besjaar-ui-mobile-menu__localization-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18"/></svg>{{ 'besjaar_ui.markets.change_language' | t }}</span>{% render 'besjaar-ui-localization', context: 'mobile', section_id: section.id %}</div>{% endunless %}{% endif %}
    <div class="besjaar-ui-mobile-menu__shop">
      <a class="besjaar-ui-mobile-menu__shop-title besjaar-ui-mobile-menu__shop-all" href="{{ besjaar_ui_shower_url }}">{{ 'besjaar_ui.header.shop_all' | t }} <span aria-hidden="true">→</span></a>
      <div class="besjaar-ui-mobile-menu__categories">
        {% if besjaar_ui_mega_collection != blank %}
          <a href="{% render 'localized-internal-url', url: besjaar_ui_mega_collection.url %}">
            <span>{% render 'localized-collection-title', collection: besjaar_ui_mega_collection %}</span><b aria-hidden="true">→</b>
          </a>
        {% endif %}
        {% if besjaar_ui_mobile_filter_collection != blank and besjaar_ui_mobile_filter_collection.id != besjaar_ui_mega_collection.id %}
          <a href="{% render 'localized-internal-url', url: besjaar_ui_mobile_filter_collection.url %}">
            <span>{% render 'localized-collection-title', collection: besjaar_ui_mobile_filter_collection %}</span><b aria-hidden="true">→</b>
          </a>
        {% endif %}
      </div>
    </div>
    <a href="{{ besjaar_ui_guide_url }}">{{ besjaar_ui_guide_label | escape }}</a>
    <a href="{{ besjaar_ui_about_url }}"{% if besjaar_ui_about_current %} aria-current="page"{% endif %}>{{ 'besjaar_ui.shower_store.nav.about' | t }}</a>
    <div class="besjaar-ui-mobile-menu__more">
      <span>{{ 'besjaar_ui.shower_store.nav.more' | t }}</span>
      <a href="{{ besjaar_ui_reviews_url }}">{{ 'besjaar_ui.shower_store.nav.reviews' | t }}</a>
      <a href="{{ besjaar_ui_faq_url }}"{% if besjaar_ui_faq_current %} aria-current="page"{% endif %}>{{ 'besjaar_ui.shower_store.nav.faq' | t }}</a>
      <a href="{{ besjaar_ui_contact_url }}"{% if besjaar_ui_contact_current %} aria-current="page"{% endif %}>{{ 'besjaar_ui.shower_store.nav.contact' | t }}</a>
      <a href="{{ besjaar_ui_track_url }}"{% if besjaar_ui_track_current %} aria-current="page"{% endif %}>{{ 'besjaar_ui.shower_store.nav.track' | t }}</a>
    </div>
    {% if shop.customer_accounts_enabled %}
      {% if section.settings.use_shopify_account_component %}
        <div class="besjaar-ui-mobile-menu__account-component"><span>{{ 'besjaar_ui.header.my_account' | t }}</span><shopify-account class="besjaar-ui-shopify-account besjaar-ui-shopify-account--mobile" menu="{{ besjaar_ui_customer_account_menu }}"></shopify-account></div>
      {% else %}
        <a class="besjaar-ui-mobile-menu__account" href="{{ besjaar_ui_account_url }}" rel="nofollow">{% if customer %}{{ 'besjaar_ui.header.my_account' | t }}{% else %}{{ 'besjaar_ui.header.sign_in_create' | t }}{% endif %} →</a>
      {% endif %}
    {% endif %}
  </nav>

  <div class="besjaar-ui-search-panel" id="BesjaarUISearchPanel-{{ section.id }}" data-search-panel aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="BesjaarUISearchDialogTitle-{{ section.id }}" tabindex="-1" inert>
    <div class="besjaar-ui-shell besjaar-ui-search-panel__inner">
      <div class="besjaar-ui-search-panel__top"><div><p class="besjaar-ui-kicker">{{ 'besjaar_ui.search.kicker' | t }}</p><strong class="besjaar-ui-search-panel__mobile-title" id="BesjaarUISearchDialogTitle-{{ section.id }}">{{ 'besjaar_ui.mobile.search_title' | t }}</strong></div><button type="button" class="besjaar-ui-drawer__close" data-search-close aria-label="{{ 'besjaar_ui.accessibility.close' | t }}">×</button></div>
      <form class="besjaar-ui-search-form besjaar-ui-search-form--predictive" action="{{ routes.search_url }}" method="get" role="search">
        <label class="besjaar-ui-visually-hidden" for="BesjaarUIHeaderSearch-{{ section.id }}">{{ 'besjaar_ui.accessibility.search' | t }}</label>
        <input class="besjaar-ui-input" id="BesjaarUIHeaderSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'besjaar_ui.header.search_placeholder' | t }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-controls="BesjaarUIPredictiveSearch-{{ section.id }}" aria-expanded="false" data-predictive-input required>
        <input name="type" type="hidden" value="product">
        <input name="options[prefix]" type="hidden" value="last">
        <button class="besjaar-ui-button besjaar-ui-button--primary" type="submit">{{ 'besjaar_ui.header.search_button' | t }}</button>
      </form>
      {%- comment -%}Besjaar 11.6: the container is a plain live region — the listbox role is applied by besjaar-ui-core.js to the element that directly wraps the option links, per the ARIA listbox content model.{%- endcomment -%}
      <div class="besjaar-ui-predictive" id="BesjaarUIPredictiveSearch-{{ section.id }}" aria-live="polite" data-predictive-results hidden></div>
      <div class="besjaar-ui-search-discovery" data-search-discovery>
        {% if settings.show_recent_searches %}
          <div class="besjaar-ui-search-discovery__block" data-recent-searches-wrap hidden>
            <div class="besjaar-ui-search-discovery__head"><span>{{ 'besjaar_ui.search.recent' | t }}</span><button type="button" data-clear-recent-searches>{{ 'besjaar_ui.search.clear_recent' | t }}</button></div>
            <div class="besjaar-ui-search-shortcuts" data-recent-searches></div>
          </div>
        {% endif %}
        {% if settings.show_search_popular %}
          <div class="besjaar-ui-search-discovery__block">
            <div class="besjaar-ui-search-discovery__head"><span>{{ 'besjaar_ui.search.popular' | t }}</span></div>
            <div class="besjaar-ui-search-shortcuts" data-search-shortcuts>
              {% assign besjaar_ui_popular_terms = 'besjaar_ui.search.popular_terms' | t | split: ',' %}
              {% for term in besjaar_ui_popular_terms %}{% assign clean_term = term | strip %}{% if clean_term != blank %}<a href="{{ routes.search_url }}?type=product&options%5Bprefix%5D=last&q={{ clean_term | url_encode }}">{{ clean_term }}</a>{% endif %}{% endfor %}
            </div>
          </div>
        {% endif %}
        {% if settings.show_search_brands %}
          <div class="besjaar-ui-search-discovery__block">
            <div class="besjaar-ui-search-discovery__head"><span>{{ 'besjaar_ui.search.brands' | t }}</span></div>
            <div class="besjaar-ui-search-brands">
              <a href="{% render 'localized-internal-url', url: besjaar_ui_shower_url %}">BESJAAR · {{ 'besjaar_ui.shower_store.nav.shop' | t }} <span>→</span></a>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</header>

<noscript>
  <div class="besjaar-ui-nojs-tools" role="region" aria-label="{{ 'besjaar_ui.accessibility.main_navigation' | t | escape }}">
