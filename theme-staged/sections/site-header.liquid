        <a href="{{ besjaar_ui_reviews_url }}">{{ 'besjaar_ui.shower_store.nav.reviews' | t }}</a>
        <a href="{{ besjaar_ui_about_url }}">{{ 'besjaar_ui.shower_store.nav.about' | t }}</a>
