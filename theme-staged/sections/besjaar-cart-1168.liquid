<script>
(function () {
  'use strict';
  var previous = window.fetch;
  if (typeof previous !== 'function' || window.__bjCartQueueInstalled) return;
  window.__bjCartQueueInstalled = true;
  var noop = function () {};
  var queue = Promise.resolve();
  var pathOf = function (input) {
    try { return new URL(typeof input === 'string' ? input : ((input && input.url) || ''), window.location.href).pathname; } catch (e) { return ''; }
  };
  var wait = function (ms) { return new Promise(function (resolve) { window.setTimeout(resolve, ms); }); };
  var attempt = function (args, retries) {
    return previous.apply(window, args).then(function (response) {
      if (response && response.status >= 500 && retries > 0) return wait(450).then(function () { return attempt(args, retries - 1); });
      return response;
    }, function (error) {
      if (retries > 0) return wait(450).then(function () { return attempt(args, retries - 1); });
      throw error;
    });
  };
  /* Hand every cart state the theme reads or writes to the drawer script
     below (line discounts, code chips), so it needs no request of its own. */
  var tap = function (response) {
    try {
      if (response && response.ok) response.clone().json().then(function (cart) {
        if (cart && cart.items) { window.__bjCart = cart; document.dispatchEvent(new CustomEvent('bj:cart', { detail: cart })); }
      }, noop);
    } catch (e) {}
    return response;
  };
  window.fetch = function (input, init) {
    var args = arguments;
    var path = pathOf(input);
    var method = ((init && init.method) || (input && input.method) || 'GET').toUpperCase();
    var retryable = typeof input === 'string';
    if (method === 'POST' && /\/cart\/(change|update|add|clear)\.js$/.test(path)) {
      var retries = retryable && /\/cart\/(change|update)\.js$/.test(path) ? 1 : 0;
      var run = function () { return attempt(args, retries); };
      var pending = queue.then(run, run);
      queue = pending.then(noop, noop);
      return /\/cart\/(change|update)\.js$/.test(path) ? pending.then(tap) : pending;
    }
    if (method === 'GET' && /\/cart\.js$/.test(path)) return attempt(args, retryable ? 1 : 0).then(tap);
    return previous.apply(window, args);
  };
})();
</script>
<script>
(function () {
  /* 2026-09-30 cart drawer: discount code, order note and the heading of the
     left column. Codes go to the cart with /cart/update.js (discount); the
     drawer is then reopened so the theme repaints totals and lines. */
  var start = function () {
  var drawer = document.getElementById('BesjaarUICartDrawer');
  if (!drawer || drawer.dataset.bjCdReady) return;
  drawer.dataset.bjCdReady = '1';
  var lang = (document.documentElement.lang || 'nl').slice(0, 2).toLowerCase();
  var T = {
    nl: { ok: 'Kortingscode %c toegepast.', bad: 'Code %c is niet geldig voor deze bestelling.', empty: 'Vul een kortingscode in.', err: 'Er ging iets mis. Probeer het opnieuw.', heading: 'Maak je bestelling compleet' },
    en: { ok: 'Discount code %c applied.', bad: 'Code %c is not valid for this order.', empty: 'Enter a discount code.', err: 'Something went wrong. Please try again.', heading: 'Complete your order' },
    de: { ok: 'Rabattcode %c angewendet.', bad: 'Code %c ist für diese Bestellung nicht gültig.', empty: 'Gib einen Rabattcode ein.', err: 'Etwas ist schiefgelaufen. Bitte versuche es erneut.', heading: 'Vervollständige deine Bestellung' },
    fr: { ok: 'Code %c appliqué.', bad: 'Le code %c n’est pas valable pour cette commande.', empty: 'Saisissez un code de réduction.', err: 'Une erreur est survenue. Veuillez réessayer.', heading: 'Complétez votre commande' }
  }[lang] || null;
  if (!T) T = { ok: 'Kortingscode %c toegepast.', bad: 'Code %c is niet geldig voor deze bestelling.', empty: 'Vul een kortingscode in.', err: 'Er ging iets mis. Probeer het opnieuw.', heading: 'Maak je bestelling compleet' };
  var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
  var post = function (payload) {
    return fetch(root + 'cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload) })
      .then(function (r) { if (!r.ok) throw new Error('cart_update'); return r.json(); });
  };
  var repaint = function () {
    var opener = document.querySelector('[data-open-drawer="cart"]');
    if (opener) opener.click();
  };

  var form = drawer.querySelector('[data-bj-cd-discount-form]');
  var msg = drawer.querySelector('[data-bj-cd-discount-msg]');
  var say = function (text, ok) { if (!msg) return; msg.textContent = text; msg.classList.toggle('is-ok', !!ok); msg.classList.toggle('is-error', !ok); };
  if (form) {
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var input = form.querySelector('[data-bj-cd-discount-input]');
      var button = form.querySelector('button');
      var code = (input && input.value || '').trim();
      if (!code) { say(T.empty, false); return; }
      if (button) button.disabled = true;
      fetch(root + 'cart.js', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          var existing = (cart.discount_codes || []).filter(function (d) { return d.applicable; }).map(function (d) { return d.code; });
          if (existing.map(function (c) { return c.toUpperCase(); }).indexOf(code.toUpperCase()) === -1) existing.push(code);
          return post({ discount: existing.join(',') });
        })
        .then(function (cart) {
          var hit = (cart.discount_codes || []).filter(function (d) { return String(d.code).toUpperCase() === code.toUpperCase(); })[0];
          if (hit && hit.applicable) { say(T.ok.replace('%c', code.toUpperCase()), true); if (input) input.value = ''; repaint(); }
          else { say(T.bad.replace('%c', code.toUpperCase()), false); }
        })
        .catch(function () { say(T.err, false); })
        .then(function () { if (button) button.disabled = false; });
    });
  }

  var note = drawer.querySelector('[data-bj-cd-note]');
  if (note) {
    var timer = null, last = note.value;
    var save = function () { if (note.value === last) return; last = note.value; post({ note: note.value }).catch(function () {}); };
    note.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(save, 700); });
    note.addEventListener('blur', save);
  }

  /* Line discounts ("SHOP25 (−€2,49)" in red under the title), applied
     code chips with a remove button, the currency after the total, and the
     subtotal/discount rows only for order-level discounts. */
  var tagIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8L3 12Z"/><circle cx="7.5" cy="8.5" r="1.4"/></svg>';
  var esc = function (v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
  var money = function (cents, cur) {
    try { return new Intl.NumberFormat('nl-NL', { style: 'currency', currency: cur || 'EUR' }).format((Number(cents) || 0) / 100).replace(/\s/g, ''); }
    catch (e) { return (Number(cents) / 100).toFixed(2).replace('.', ','); }
  };
  var body = drawer.querySelector('[data-cart-drawer-body]');
  var codesBox = drawer.querySelector('[data-bj-cd-codes]');
  var decorating = false;
  var decorate = function () {
    var cart = window.__bjCart;
    if (!cart || !cart.items || decorating) return;
    decorating = true;
    try {
      var cur = cart.currency || 'EUR';
      cart.items.forEach(function (item) {
        var btn = body && Array.prototype.filter.call(body.querySelectorAll('[data-remove-line]'), function (b) { return b.getAttribute('data-remove-line') === item.key; })[0];
        var line = btn && btn.closest('.besjaar-ui-cart-drawer__line');
        var main = line && line.querySelector('.besjaar-ui-cart-drawer__line-main');
        if (!main) return;
        var allocs = (item.line_level_discount_allocations || []).filter(function (a) { return Number(a.amount) > 0; });
        var html = allocs.map(function (a) { return '<li>' + tagIcon + '<span>' + esc((a.discount_application && a.discount_application.title) || '') + ' (\u2212' + money(a.amount, cur) + ')</span></li>'; }).join('');
        var list = main.querySelector('.bj-cd-line-disc');
        if (!html) { if (list) list.remove(); return; }
        if (!list) { list = document.createElement('ul'); list.className = 'bj-cd-line-disc'; list.setAttribute('role', 'list'); main.appendChild(list); }
        if (list.innerHTML !== html) list.innerHTML = html;
      });
      var codes = (cart.discount_codes || []).filter(function (d) { return d && d.applicable; }).map(function (d) { return String(d.code); });
      if (codesBox) {
        var label = codesBox.getAttribute('data-remove-label') || 'Remove';
        var chips = codes.map(function (c) { return '<li class="bj-cd-code">' + tagIcon + '<span>' + esc(c.toUpperCase()) + '</span><button type="button" data-bj-cd-remove-code="' + esc(c) + '" aria-label="' + esc(label + ' ' + c.toUpperCase()) + '"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17"/></svg></button></li>'; }).join('');
        if (codesBox.innerHTML !== chips) codesBox.innerHTML = chips;
        codesBox.hidden = !codes.length;
      }
      drawer.classList.toggle('bj-cd-order-disc', (cart.cart_level_discount_applications || []).some(function (d) { return Number(d.total_allocated_amount) > 0; }));
      var total = drawer.querySelector('[data-cart-drawer-total]');
      if (total && total.getAttribute('data-cur') !== cur) total.setAttribute('data-cur', cur);
    } finally { decorating = false; }
  };
  document.addEventListener('bj:cart', function () { setTimeout(decorate, 0); });
  if (body && 'MutationObserver' in window) new MutationObserver(function () { if (!decorating) decorate(); }).observe(body, { childList: true });
  decorate();
  if (codesBox) {
    codesBox.addEventListener('click', function (event) {
      var b = event.target.closest('[data-bj-cd-remove-code]');
      if (!b) return;
      var gone = String(b.getAttribute('data-bj-cd-remove-code')).toUpperCase();
      b.disabled = true;
      var keep = ((window.__bjCart && window.__bjCart.discount_codes) || []).filter(function (d) { return d.applicable && String(d.code).toUpperCase() !== gone; }).map(function (d) { return d.code; });
      post({ discount: keep.join(',') }).then(repaint, function () { b.disabled = false; say(T.err, false); });
    });
  }

  var upsell = drawer.querySelector('[data-cart-drawer-upsell]');
  if (upsell && 'MutationObserver' in window) {
    var rename = function () {
      var label = upsell.querySelector('.besjaar-ui-cart-upsell__label span');
      if (label && label.textContent !== T.heading) label.textContent = T.heading;
    };
    new MutationObserver(rename).observe(upsell, { childList: true, subtree: true });
    rename();
  }
  };
  /* This section is rendered before the header section that holds the
     drawer, so wait for the document before looking for it. */
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
</script>
{%- comment -%}
  2026-09-29: one gold (#E0A526) for every review star on every page –
  collection and search cards, product page, homepage, cart. Older theme rules
  painted stars navy, amber (#D79545) or a darker gold, some with an id in the
  selector. The two :not(#…) parts only raise specificity (no element has
  those ids), so this rule wins over any of them.
{%- endcomment -%}
