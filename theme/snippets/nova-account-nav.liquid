{% liquid
  assign account_active = active | default: 'overview'
  assign support_url = blank
  if settings.account_support_page != blank
    capture support_url
      render 'localized-internal-url', url: settings.account_support_page.url
    endcapture
    assign support_url = support_url | strip
  endif
%}
<nav class="nova-account-v41__nav" aria-label="{{ 'nova.account.account_navigation' | t | escape }}">
  <a href="{{ routes.account_url }}"{% if account_active == 'overview' %} class="is-active" aria-current="page"{% endif %}>{{ 'nova.account.overview' | t }}</a>
  <a href="{{ routes.account_url }}#orders"{% if account_active == 'orders' %} class="is-active" aria-current="page"{% endif %}>{{ 'nova.account.orders' | t }}</a>
  <a href="{{ routes.account_addresses_url }}"{% if account_active == 'addresses' %} class="is-active" aria-current="page"{% endif %}>{{ 'nova.account.addresses' | t }}</a>
  {% if support_url != blank %}<a href="{{ support_url }}">{{ 'nova.account.support' | t }}</a>{% endif %}
</nav>
