{%- liquid
  assign nova_item = product
  assign nova_modes = ''
  if nova_item != blank
    if nova_item.metafields.custom.spray_modes != blank
      assign nova_modes = nova_item.metafields.custom.spray_modes.value
    else
      assign nova_title = nova_item.title | downcase
      if nova_title contains '12 sproei' or nova_title contains '12 spray'
        assign nova_modes = 12
      elsif nova_title contains '11 sproei' or nova_title contains '11 spray'
        assign nova_modes = 11
      elsif nova_title contains '10 sproei' or nova_title contains '10 spray'
        assign nova_modes = 10
      elsif nova_title contains '9 sproei' or nova_title contains '9 spray'
        assign nova_modes = 9
      elsif nova_title contains '8 sproei' or nova_title contains '8 spray'
        assign nova_modes = 8
      elsif nova_title contains '7 sproei' or nova_title contains '7 spray'
        assign nova_modes = 7
      elsif nova_title contains '6 sproei' or nova_title contains '6 spray'
        assign nova_modes = 6
      elsif nova_title contains '5 sproei' or nova_title contains '5 spray'
        assign nova_modes = 5
      elsif nova_title contains '4 sproei' or nova_title contains '4 spray'
        assign nova_modes = 4
      elsif nova_title contains '3 sproei' or nova_title contains '3 spray'
        assign nova_modes = 3
      elsif nova_title contains '2 sproei' or nova_title contains '2 spray'
        assign nova_modes = 2
      endif
    endif
  endif
-%}{{- nova_modes -}}
