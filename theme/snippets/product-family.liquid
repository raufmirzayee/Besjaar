{%- liquid
  assign nova_family_product = product
  assign nova_family = 'other'
  assign nova_template_hint = template_hint | default: '' | downcase | strip

  if nova_family_product != blank
    if nova_template_hint == 'shower'
      assign nova_family = 'shower'
    elsif nova_family_product.metafields.custom.product_family != blank
      assign nova_declared_family = nova_family_product.metafields.custom.product_family.value | downcase | strip | replace: ' ', '_' | replace: '-', '_'
      case nova_declared_family
        when 'shower', 'bath', 'bathroom', 'showerhead', 'shower_head', 'filtered_shower_head', 'shower_set', 'hand_shower'
          assign nova_family = 'shower'
      endcase
    endif

    if nova_family != 'shower' and nova_family_product.metafields.custom.shower_family != blank
      assign nova_family = 'shower'
    endif

    comment
      Temporary migration fallback for shower products while structured
      metafields are being populated. Once custom.product_family = shower is set
      on each selected model, title/type wording no longer matters.
    endcomment
    if nova_family != 'shower'
      assign nova_type = nova_family_product.type | downcase
      assign nova_title = nova_family_product.title | downcase
      if nova_type contains 'douche' or nova_type contains 'shower' or nova_title contains 'douchekop' or nova_title contains 'handdouche' or nova_title contains 'douchefilter' or nova_title contains 'doucheslang' or nova_title contains 'shower head' or nova_title contains 'showerhead' or nova_title contains 'hand shower' or nova_title contains 'shower filter' or nova_title contains 'shower hose'
        assign nova_family = 'shower'
      endif
    endif
  endif
-%}{{- nova_family -}}
