{% assign nova_focus_product_value = 'true' %}
{% if request.page_type == 'product' and product != blank %}
  {% capture nova_focus_product_capture %}{% render 'is-focus-showerhead', product: product %}{% endcapture %}
  {% assign nova_focus_product_value = nova_focus_product_capture | strip %}
{% endif %}
{% liquid
  assign nova_is_focus_product = true
  if request.page_type == 'product' and nova_focus_product_value != 'true'
    assign nova_is_focus_product = false
  endif
%}

{% if request.page_type == 'product' and product != blank and nova_is_focus_product %}
  {%- liquid
    assign sd_variant = product.selected_or_first_available_variant | default: product.variants.first
    assign sd_currency = cart.currency.iso_code | default: shop.currency
    assign sd_country = localization.country.iso_code | default: 'NL'
    assign sd_return_days = settings.return_window_days | default: 30
    comment
      Besjaar 11.6: rating-type metafields store an object {rating, scale_min, scale_max};
      unwrap it the same way review-stars.liquid and nova-reviews.liquid do, so the
      JSON-LD emits a plain number instead of an invalid object.
    endcomment
    assign sd_rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value
    assign sd_rating_max = product.metafields.reviews.rating.value.scale_max | default: 5
    assign sd_rating_count = product.metafields.reviews.rating_count.value
    comment
      Besjaar 11.6: when no review app writes reviews.rating, fall back to the theme's
      native custom.reviews list (same computation as product-reviews-list.liquid) so
      the built-in review flow also earns review rich results.
    endcomment
    assign sd_native_reviews = blank
    if sd_rating == blank or sd_rating_count == blank or sd_rating_count == 0
      assign sd_native_source = product.metafields.custom.reviews.value
      assign sd_native_total = 0
      assign sd_native_sum = 0
      if sd_native_source != blank
        for sd_entry in sd_native_source
          assign sd_entry_rating = sd_entry.rating | default: 0
          if sd_entry_rating > 0
            assign sd_native_total = sd_native_total | plus: 1
            assign sd_native_sum = sd_native_sum | plus: sd_entry_rating
          endif
        endfor
      endif
      if sd_native_total > 0
        assign sd_native_reviews = sd_native_source
        assign sd_rating = sd_native_sum | times: 1.0 | divided_by: sd_native_total | round: 2
        assign sd_rating_count = sd_native_total
        assign sd_rating_max = 5
      endif
    endif
    assign sd_barcode = sd_variant.barcode | strip
    assign sd_free_ship_cents = settings.free_shipping_threshold | times: 100
    assign sd_standard_ship_rate = settings.standard_shipping_rate | default: 0
    assign sd_price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
    assign sd_review_anonymous_label = 'nova.reviews.anonymous' | t
  -%}
  {% capture sd_product_name %}{% render 'localized-product-title', product: product %}{% endcapture %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ canonical_url | append: '#product' | json }},
      "name": {{ sd_product_name | strip | default: product.title | json }},
      "url": {{ canonical_url | json }},
      "description": {{ product.description | strip_html | strip | truncate: 500 | json }},
      "sku": {{ sd_variant.sku | default: sd_variant.id | json }},
      {% case sd_barcode.size %}{% when 8 %}"gtin8": {{ sd_barcode | json }},{% when 12 %}"gtin12": {{ sd_barcode | json }},{% when 13 %}"gtin13": {{ sd_barcode | json }},{% when 14 %}"gtin14": {{ sd_barcode | json }},{% endcase %}
      "brand": {"@type": "Brand", "name": {{ product.vendor | default: 'Besjaar' | json }}},
      "image": [{% for media in product.media limit: 6 %}{{ media.preview_image | image_url: width: 1400 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
      {% if sd_rating != blank and sd_rating_count != blank and sd_rating_count > 0 %}"aggregateRating": {"@type": "AggregateRating", "ratingValue": {{ sd_rating | json }}, "bestRating": {{ sd_rating_max | json }}, "reviewCount": {{ sd_rating_count | json }}},{% endif %}
      {% if sd_native_reviews != blank %}"review": [{% assign sd_review_emitted = 0 %}{% for sd_entry in sd_native_reviews %}{% assign sd_entry_rating = sd_entry.rating | default: 0 %}{% if sd_entry_rating > 0 and sd_review_emitted < 8 %}{% if sd_review_emitted > 0 %},{% endif %}{"@type": "Review", "reviewRating": {"@type": "Rating", "ratingValue": {{ sd_entry_rating | json }}, "bestRating": 5}, "author": {"@type": "Person", "name": {{ sd_entry.author | default: sd_review_anonymous_label | json }}}{% if sd_entry.date != blank %}, "datePublished": {{ sd_entry.date | json }}{% endif %}{% if sd_entry.body != blank %}, "reviewBody": {{ sd_entry.body | strip | truncate: 500 | json }}{% endif %}}{% assign sd_review_emitted = sd_review_emitted | plus: 1 %}{% endif %}{% endfor %}],{% endif %}
      "offers": [{% assign sd_canonical_base = canonical_url | split: '?' | first %}{% for sd_offer_variant in product.variants limit: 20 %}{%- liquid
        assign sd_offer_barcode = sd_offer_variant.barcode | strip
        capture sd_offer_url
          echo sd_canonical_base
          if product.variants.size > 1
            echo '?variant=' | append: sd_offer_variant.id
          endif
        endcapture
      -%}{
        "@type": "Offer",
        "url": {{ sd_offer_url | json }},
        "sku": {{ sd_offer_variant.sku | default: sd_offer_variant.id | json }},
        {% case sd_offer_barcode.size %}{% when 8 %}"gtin8": {{ sd_offer_barcode | json }},{% when 12 %}"gtin12": {{ sd_offer_barcode | json }},{% when 13 %}"gtin13": {{ sd_offer_barcode | json }},{% when 14 %}"gtin14": {{ sd_offer_barcode | json }},{% endcase %}
        "priceCurrency": {{ sd_currency | json }},
        "price": {{ sd_offer_variant.price | divided_by: 100.0 | json }},
        "priceValidUntil": {{ sd_price_valid_until | json }},
        "availability": {% if sd_offer_variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
        "itemCondition": "https://schema.org/NewCondition",
        "seller": {"@type": "Organization", "name": "Besjaar"},
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": {{ sd_country | json }},
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": {{ sd_return_days | json }},
          "returnMethod": "https://schema.org/ReturnByMail"
        },
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          {% if sd_offer_variant.price >= sd_free_ship_cents %}"shippingRate": {"@type": "MonetaryAmount", "value": 0, "currency": {{ sd_currency | json }}},{% elsif sd_standard_ship_rate > 0 %}"shippingRate": {"@type": "MonetaryAmount", "value": {{ sd_standard_ship_rate | json }}, "currency": {{ sd_currency | json }}},{% endif %}
          "shippingDestination": {"@type": "DefinedRegion", "addressCountry": {{ sd_country | json }}},
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": {"@type": "QuantitativeValue", "minValue": 0, "maxValue": {{ settings.processing_business_days | default: 1 | json }}, "unitCode": "DAY"},
            "transitTime": {"@type": "QuantitativeValue", "minValue": {{ settings.transit_min_business_days | default: 1 | json }}, "maxValue": {{ settings.transit_max_business_days | default: 3 | json }}, "unitCode": "DAY"}
          }
        }
      }{% unless forloop.last %},{% endunless %}{% endfor %}]
    }
  </script>
{% elsif request.page_type == 'article' and article != blank %}
  <script type="application/ld+json">{{ article | structured_data }}</script>
{% endif %}

{% if request.page_type == 'index' %}
  {% liquid
    assign nova_org_logo = shop.brand.logo
    assign nova_org_description = 'nova.shower_store.schema.organization_description' | t
    comment
      Besjaar 11.6.1: the SearchAction template must be assembled inside a tag —
      a literal closing brace in an output tag ends the token early in Shopify's
      Liquid tokenizer, which made the whole snippet fail theme upload.
    endcomment
    assign nova_search_url_template = shop.url | append: routes.search_url | append: '?q={search_term_string}'
  %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": {{ shop.url | append: '#organization' | json }},
      "name": "Besjaar",
      {% if shop.name != blank and shop.name != 'Besjaar' %}"alternateName": {{ shop.name | json }},{% endif %}
      "url": {{ shop.url | json }},
      "description": {{ nova_org_description | json }},
      "knowsAbout": [
        {{ 'nova.shower_store.schema.topic_showerheads' | t | json }},
        {{ 'nova.shower_store.schema.topic_filtered' | t | json }},
        {{ 'nova.shower_store.schema.topic_hoses' | t | json }},
        {{ 'nova.shower_store.schema.topic_spray_modes' | t | json }},
        {{ 'nova.shower_store.schema.topic_fit' | t | json }},
        {{ 'nova.shower_store.schema.topic_care' | t | json }}
      ]{% if nova_org_logo != blank %},
      "logo": {{ nova_org_logo | image_url: width: 600 | prepend: 'https:' | json }}{% endif %}{% if settings.social_share_image != blank %},
      "image": {{ settings.social_share_image | image_url: width: 1200 | prepend: 'https:' | json }}{% endif %}{% liquid
        comment
          Besjaar 11.6: social profiles and a customer-service contact point help
          brand entity association. All optional theme settings.
        endcomment
        capture nova_org_same_as
          assign nova_same_as_first = true
          if settings.social_instagram != blank
            echo settings.social_instagram | json
            assign nova_same_as_first = false
          endif
          if settings.social_facebook != blank
            unless nova_same_as_first
              echo ','
            endunless
            echo settings.social_facebook | json
            assign nova_same_as_first = false
          endif
          if settings.social_tiktok != blank
            unless nova_same_as_first
              echo ','
            endunless
            echo settings.social_tiktok | json
            assign nova_same_as_first = false
          endif
          if settings.social_youtube != blank
            unless nova_same_as_first
              echo ','
            endunless
            echo settings.social_youtube | json
            assign nova_same_as_first = false
          endif
        endcapture
        assign nova_org_same_as = nova_org_same_as | strip
      %}{% if nova_org_same_as != blank %},
      "sameAs": [{{ nova_org_same_as }}]{% endif %}{% if settings.support_email != blank or settings.support_phone != blank %},
      "contactPoint": {"@type": "ContactPoint", "contactType": "customer service"{% if settings.support_email != blank %}, "email": {{ settings.support_email | json }}{% endif %}{% if settings.support_phone != blank %}, "telephone": {{ settings.support_phone | json }}{% endif %}, "availableLanguage": ["nl", "en", "de", "fr"]}{% endif %}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ shop.url | append: '#website' | json }},
      "name": "Besjaar",
      {% if shop.name != blank and shop.name != 'Besjaar' %}"alternateName": {{ shop.name | json }},{% endif %}
      "url": {{ shop.url | json }},
      "description": {{ 'nova.shower_store.meta.description' | t | json }},
      "publisher": {"@id": {{ shop.url | append: '#organization' | json }}},
      "inLanguage": {{ request.locale.iso_code | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ nova_search_url_template | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{% endif %}

{% liquid
  assign nova_emit_breadcrumbs = true
  if request.page_type == 'product' and nova_is_focus_product == false
    assign nova_emit_breadcrumbs = false
  endif
%}
{% if nova_emit_breadcrumbs %}
{% if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'article' or request.page_type == 'blog' or request.page_type == 'page' %}
  {% capture nova_schema_product_title %}{% if product != blank %}{% render 'localized-product-title', product: product %}{% endif %}{% endcapture %}
  {% capture nova_schema_collection_title %}{% if collection != blank %}{% render 'localized-collection-title', collection: collection %}{% endif %}{% endcapture %}
  {% capture nova_schema_page_title %}{% if page != blank %}{% render 'localized-page-title', page: page %}{% endif %}{% endcapture %}
  {% liquid
    comment
      Besjaar 11.6: on canonical /products/ URLs (no collection in scope) the visible
      breadcrumb still shows the focused shower collection, so mirror it in the
      markup instead of dropping the category level.
    endcomment
    assign nova_schema_crumb_collection = blank
    if request.page_type == 'product' and collection == blank
      assign nova_schema_crumb_collection = settings.shower_collection
      if nova_schema_crumb_collection == blank
        assign nova_schema_crumb_collection = collections['badkamer-douche']
      endif
      if nova_schema_crumb_collection == blank
        assign nova_schema_crumb_collection = collections['douchekoppen']
      endif
      if nova_schema_crumb_collection == blank
        assign nova_schema_crumb_collection = collections['showerheads']
      endif
      if nova_schema_crumb_collection == blank
        assign nova_schema_crumb_collection = collections['douche']
      endif
      if nova_schema_crumb_collection == blank
        assign nova_schema_crumb_collection = collections['shower']
      endif
    endif
  %}
  {% capture nova_schema_crumb_collection_title %}{% if nova_schema_crumb_collection != blank %}{% render 'localized-collection-title', collection: nova_schema_crumb_collection %}{% endif %}{% endcapture %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'nova.product.home' | t | json }},
          "item": {{ shop.url | append: routes.root_url | json }}
        }{% if request.page_type == 'product' and collection != blank %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ nova_schema_collection_title | strip | default: collection.title | json }},
          "item": {{ shop.url | append: collection.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ nova_schema_product_title | strip | default: product.title | json }},
          "item": {{ canonical_url | json }}
        }{% elsif request.page_type == 'product' and nova_schema_crumb_collection != blank %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ nova_schema_crumb_collection_title | strip | default: nova_schema_crumb_collection.title | json }},
          "item": {{ shop.url | append: nova_schema_crumb_collection.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ nova_schema_product_title | strip | default: product.title | json }},
          "item": {{ canonical_url | json }}
        }{% elsif request.page_type == 'product' %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ nova_schema_product_title | strip | default: product.title | json }},
          "item": {{ canonical_url | json }}
        }{% elsif request.page_type == 'collection' %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ nova_schema_collection_title | strip | default: collection.title | json }},
          "item": {{ canonical_url | json }}
        }{% elsif request.page_type == 'article' %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": {{ shop.url | append: blog.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ article.title | json }},
          "item": {{ canonical_url | json }}
        }{% elsif request.page_type == 'blog' %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": {{ canonical_url | json }}
        }{% elsif request.page_type == 'page' %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ nova_schema_page_title | strip | default: page.title | json }},
          "item": {{ canonical_url | json }}
        }{% endif %}
      ]
    }
  </script>
{% endif %}
{% endif %}

{% if request.page_type == 'collection' and collection != blank and collection.products.size > 0 %}
  {% capture nova_itemlist_collection_title %}{% render 'localized-collection-title', collection: collection %}{% endcapture %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": {{ nova_itemlist_collection_title | strip | default: collection.title | json }},
      "itemListElement": [{% for sd_p in collection.products limit: 24 %}{% capture sd_p_name %}{% render 'localized-product-title', product: sd_p %}{% endcapture %}{"@type": "ListItem", "position": {{ forloop.index }}, "name": {{ sd_p_name | strip | default: sd_p.title | json }}, "url": {{ shop.url | append: sd_p.url | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
    }
  </script>
{% endif %}
