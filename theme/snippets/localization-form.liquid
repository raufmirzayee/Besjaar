{%- comment -%}
  Country/currency and language selectors (Shopify Markets).

  Accepts:
  - form_id: {String} Unique ID
  - show_country: {Boolean}
  - show_language: {Boolean}
  - class: {String} Optional wrapper class
  - compact: {Boolean} Show a small button that opens the selectors in a dropdown
{%- endcomment -%}
{%- liquid
  assign has_countries = false
  if show_country and localization.available_countries.size > 1
    assign has_countries = true
  endif
  assign has_languages = false
  if show_language and localization.available_languages.size > 1
    assign has_languages = true
  endif
-%}
{%- if has_countries or has_languages -%}
  <localization-form class="{{ class }}">
    {%- if compact -%}
      <details-dropdown data-trigger="click" class="localization-dropdown">
        <details>
          <summary class="header__menu-link localization-dropdown__toggle" aria-expanded="false">
            {% render 'icon', icon: 'globe' %}
            <span class="visually-hidden">{{ 'localization.title' | t }}</span>
            <span aria-hidden="true">
              {%- if has_countries -%}{{ localization.country.iso_code }} · {{ localization.country.currency.iso_code }}{%- endif -%}
              {%- if has_countries and has_languages %} / {% endif -%}
              {%- if has_languages -%}{{ localization.language.iso_code | upcase }}{%- endif -%}
            </span>
            {% render 'icon', icon: 'chevron-down' %}
          </summary>
          <div class="dropdown-panel dropdown-panel--right localization-dropdown__panel">
          {%- form 'localization', id: form_id, class: 'localization-form' -%}
            {%- if has_countries -%}
              <div class="select">
                <label class="visually-hidden" for="{{ form_id }}-country">{{ 'localization.country_label' | t }}</label>
                <select id="{{ form_id }}-country" name="country_code" class="select__select">
                  {%- for country in localization.available_countries -%}
                    <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                      {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                    </option>
                  {%- endfor -%}
                </select>
                {% render 'icon', icon: 'chevron-down' %}
              </div>
            {%- endif -%}
            {%- if has_languages -%}
              <div class="select">
                <label class="visually-hidden" for="{{ form_id }}-language">{{ 'localization.language_label' | t }}</label>
                <select id="{{ form_id }}-language" name="language_code" class="select__select">
                  {%- for language in localization.available_languages -%}
                    <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                      {{- language.endonym_name | capitalize -}}
                    </option>
                  {%- endfor -%}
                </select>
                {% render 'icon', icon: 'chevron-down' %}
              </div>
            {%- endif -%}
            <noscript><button type="submit" class="button button--small">{{ 'localization.update' | t }}</button></noscript>
          {%- endform -%}
          </div>
        </details>
      </details-dropdown>
    {%- else -%}
    {%- form 'localization', id: form_id, class: 'localization-form' -%}
      {%- if has_countries -%}
        <div class="select">
          <label class="visually-hidden" for="{{ form_id }}-country">{{ 'localization.country_label' | t }}</label>
          <select id="{{ form_id }}-country" name="country_code" class="select__select">
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
              </option>
            {%- endfor -%}
          </select>
          {% render 'icon', icon: 'chevron-down' %}
        </div>
      {%- endif -%}
      {%- if has_languages -%}
        <div class="select">
          <label class="visually-hidden" for="{{ form_id }}-language">{{ 'localization.language_label' | t }}</label>
          <select id="{{ form_id }}-language" name="language_code" class="select__select">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                {{- language.endonym_name | capitalize -}}
              </option>
            {%- endfor -%}
          </select>
          {% render 'icon', icon: 'chevron-down' %}
        </div>
      {%- endif -%}
      <noscript><button type="submit" class="button button--small">{{ 'localization.update' | t }}</button></noscript>
    {%- endform -%}
    {%- endif -%}
  </localization-form>
{%- endif -%}
