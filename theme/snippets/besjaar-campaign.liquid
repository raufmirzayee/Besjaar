{%- comment -%}
  Besjaar — temporary promotional campaign (Nationale Kraanwaterdag 2026)

  Renders the single-line campaign bar for "BESJAAR WATER WEEK 💧",
  21–30 September 2026.

  HOW THE CAMPAIGN IS TIED TO REAL SHOPIFY DISCOUNTS
  --------------------------------------------------
  The campaign never claims a discount on its own. It is configured in the same
  shop metafield as the discount mirror (`besjaar_discounts.active`), and
  `campaign.discount_ids` lists the automatic Shopify discounts that
  tools/sync-shopify-discounts.mjs resolved by title. A campaign can run several
  at once — a different percentage per product is normal — so the bar states the
  range of values that are actually live.

  Nothing renders unless ALL of these hold, re-checked on every request:

    1. the mirror is present, enabled and fresh;
    2. the campaign is enabled and was linked to at least one discount;
    3. now is inside the campaign window (21 Sept – 30 Sept 2026, Amsterdam);
    4. at least one linked discount is still in the mirror and inside its OWN
       window.

  Pause or delete the discounts in Shopify and re-sync, and the campaign goes
  dark. Let their own end dates pass and it goes dark with no sync at all. Every
  percentage shown is read from a discount, never hard-coded.

  The per-product campaign block that used to sit in the buy box was removed —
  the discount badge and the discounted price already say it there. Product
  cards and the buy box get their campaign wording from
  snippets/besjaar-discount-badge.liquid.
{%- endcomment -%}

{%- liquid
  assign bjc_data = shop.metafields.besjaar_discounts.active.value
  assign bjc_campaign = bjc_data.campaign
  assign bjc_live = true

  unless bjc_data
    assign bjc_live = false
  endunless
  if bjc_data.enabled == false
    assign bjc_live = false
  endif
  unless bjc_campaign
    assign bjc_live = false
  endunless
  unless bjc_campaign.enabled == true
    assign bjc_live = false
  endunless
  unless bjc_campaign.linked == true
    assign bjc_live = false
  endunless

  assign bjc_now = 'now' | date: '%s' | plus: 0

  comment
    Same staleness guard the discount badges use: stale data must not keep a
    campaign on air after the discounts behind it are gone.
  endcomment
  if bjc_live
    assign bjc_max_age_days = bjc_data.max_age_days | default: 30
    if bjc_max_age_days > 0
      assign bjc_generated = bjc_data.generated_at | default: 0
      if bjc_generated == 0
        assign bjc_live = false
      else
        assign bjc_age = bjc_now | minus: bjc_generated
        assign bjc_max_age = bjc_max_age_days | times: 86400
        if bjc_age > bjc_max_age
          assign bjc_live = false
        endif
      endif
    endif
  endif

  comment
    The campaign window itself. ends_at is the first second AFTER the campaign,
    so the last day is included and the bar disappears on its own.
  endcomment
  assign bjc_ends = 0
  if bjc_live
    assign bjc_starts = bjc_campaign.starts_at | default: 0
    assign bjc_ends = bjc_campaign.ends_at | default: 0
    if bjc_starts > bjc_now
      assign bjc_live = false
    endif
    if bjc_ends > 0
      if bjc_ends <= bjc_now
        assign bjc_live = false
      endif
    else
      assign bjc_live = false
    endif
  endif

  comment
    Walk the linked discounts once and collect the range of values still
    running, so the bar narrows by itself when one of them ends.
  endcomment
  assign bjc_any = false
  assign bjc_min_bp = 0
  assign bjc_max_bp = 0
  assign bjc_min_label = ''
  assign bjc_max_label = ''
  assign bjc_first_label = ''

  if bjc_live
    for bjc_rule in bjc_data.rules
      capture bjc_rule_token
        echo '|'
        echo bjc_rule.id
        echo '|'
      endcapture
      unless bjc_campaign.discount_ids contains bjc_rule_token
        continue
      endunless

      assign bjc_rule_starts = bjc_rule.starts_at | default: 0
      if bjc_rule_starts > bjc_now
        continue
      endif
      if bjc_rule.ends_at
        assign bjc_rule_ends = bjc_rule.ends_at | plus: 0
        if bjc_rule_ends <= bjc_now
          continue
        endif
      endif

      assign bjc_any = true

      capture bjc_label
        if bjc_rule.value_type == 'percentage'
          echo bjc_rule.percentage_label
        else
          echo bjc_rule.amount_cents | money_without_trailing_zeros
        endif
      endcapture
      assign bjc_label = bjc_label | strip
      if bjc_first_label == ''
        assign bjc_first_label = bjc_label
      endif

      comment
        The range covers percentage discounts, the only values that compare
        meaningfully without a product price in hand.
      endcomment
      if bjc_rule.value_type == 'percentage'
        assign bjc_rule_bp = bjc_rule.percentage_bp | plus: 0
        if bjc_min_label == ''
          assign bjc_min_bp = bjc_rule_bp
          assign bjc_min_label = bjc_label
          assign bjc_max_bp = bjc_rule_bp
          assign bjc_max_label = bjc_label
        else
          if bjc_rule_bp < bjc_min_bp
            assign bjc_min_bp = bjc_rule_bp
            assign bjc_min_label = bjc_label
          endif
          if bjc_rule_bp > bjc_max_bp
            assign bjc_max_bp = bjc_rule_bp
            assign bjc_max_label = bjc_label
          endif
        endif
      endif
    endfor

    unless bjc_any
      assign bjc_live = false
    endunless
  endif

  comment
    The promotional line always carries real discount values: the live range
    when they differ, the single value when they do not.
  endcomment
  if bjc_live
    assign bjc_spread = false
    if bjc_min_label != ''
      if bjc_min_label != bjc_max_label
        assign bjc_spread = true
      endif
    endif
    if bjc_spread
      assign bjc_line = bjc_campaign.line_template_range | replace: '{min}', bjc_min_label | replace: '{max}', bjc_max_label
    else
      assign bjc_banner_label = bjc_max_label
      if bjc_banner_label == ''
        assign bjc_banner_label = bjc_first_label
      endif
      assign bjc_line = bjc_campaign.line_template | replace: '{value}', bjc_banner_label
    endif
  endif

  comment
    The bar is aimed at shoppers in the Netherlands. An empty country list shows
    it everywhere. If the market country cannot be resolved — markets
    localization switched off, for instance — fall back to the request locale
    rather than silently dropping the campaign.
  endcomment
  if bjc_live
    if bjc_campaign.countries != ''
      assign bjc_country = localization.country.iso_code
      if bjc_country
        capture bjc_country_token
          echo '|'
          echo bjc_country
          echo '|'
        endcapture
        unless bjc_campaign.countries contains bjc_country_token
          assign bjc_live = false
        endunless
      else
        assign bjc_locale = request.locale.iso_code | split: '-' | first | downcase
        unless bjc_locale == 'nl'
          assign bjc_live = false
        endunless
      endif
    endif
  endif

  if bjc_live
    capture bjc_cta_url
      render 'localized-internal-url', url: bjc_campaign.cta_url
    endcapture
    assign bjc_cta_url = bjc_cta_url | strip
  endif
-%}

{%- if bjc_live -%}
  {%- comment -%}
    One row, in one line. The whole bar is the link, so the call to action can
    shrink to an arrow on a narrow screen without losing the tap target. The
    stylesheet drops the tagline, then the label, then the countdown, then the
    campaign name as the viewport narrows, so the offer itself always fits.
  {%- endcomment -%}
  <aside class="bj-campaign bj-campaign--banner" aria-label="{{ bjc_campaign.name | escape }}" data-bj-campaign-banner>
    {%- if bjc_cta_url != '' -%}<a class="bj-campaign__bar" href="{{ bjc_cta_url }}">{%- else -%}<div class="bj-campaign__bar">{%- endif -%}
      <span class="bj-campaign__name">{{ bjc_campaign.name }}</span>
      {%- if bjc_campaign.tagline != '' -%}<span class="bj-campaign__tagline">{{ bjc_campaign.tagline }}</span>{%- endif -%}
      <span class="bj-campaign__line">{{ bjc_line }}</span>
      {%- if bjc_campaign.countdown == true -%}
        <span class="bj-campaign__countdown" data-bj-countdown="{{ bjc_ends }}" data-bj-countdown-label="{{ bjc_campaign.countdown_label | escape }}" hidden></span>
      {%- endif -%}
      {%- if bjc_cta_url != '' -%}
        <span class="bj-campaign__cta">
          {%- if bjc_campaign.cta_label != '' -%}<span class="bj-campaign__cta-label">{{ bjc_campaign.cta_label }}</span>{%- endif -%}
          <span aria-hidden="true">→</span>
        </span>
      {%- endif -%}
    {%- if bjc_cta_url != '' -%}</a>{%- else -%}</div>{%- endif -%}
  </aside>
{%- endif -%}
