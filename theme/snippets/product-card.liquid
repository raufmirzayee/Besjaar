{% liquid
  assign card_product = product
  assign image_url = ''
  assign image_alt = card_product.title
  if card_product.featured_image
    assign image_url = card_product.featured_image | image_url: width: 900
    if card_product.featured_image.alt != blank
      assign image_alt = card_product.featured_image.alt
    endif
  endif

  capture nova_localized_card_title
    render 'localized-product-title', product: card_product
  endcapture
  assign display_title = nova_localized_card_title | strip
  if settings.compact_card_titles
    assign display_title = display_title | truncatewords: 8
  endif

  assign vendor_lc = card_product.vendor | downcase
  assign best_for = ''
  if card_product.metafields.custom.best_for != blank
    assign best_for = card_product.metafields.custom.best_for.value
  endif
  capture shower_spray_modes_capture
    render 'shower-spray-modes', product: card_product
  endcapture
  assign shower_spray_modes = shower_spray_modes_capture | strip

  capture shower_filter_capture
    render 'shower-filter-state', product: card_product
  endcapture
  assign shower_filter_capture = shower_filter_capture | strip
  assign shower_filter_included = false
  if shower_filter_capture == 'true'
    assign shower_filter_included = true
  endif
  assign shower_filter_defined = false
  if card_product.metafields.custom.filter_included != blank or shower_filter_included
    assign shower_filter_defined = true
  endif

  capture shower_hose_capture
    render 'shower-hose-state', product: card_product
  endcapture
  assign shower_hose_capture = shower_hose_capture | strip
  assign shower_hose_included = false
  if shower_hose_capture == 'true'
    assign shower_hose_included = true
  endif
  assign shower_hose_defined = false
  if card_product.metafields.custom.hose_included != blank or shower_hose_included
    assign shower_hose_defined = true
  endif
  assign shower_connection = card_product.metafields.custom.connection_size.value | default: ''

  assign merch_badge_key = ''
  if settings.show_merchandising_badges
    for nova_tag in card_product.tags
      assign nova_tag_lc = nova_tag | downcase | strip
      if nova_tag_lc == 'nova:bestseller' or nova_tag_lc == 'bestseller'
        assign merch_badge_key = 'nova.product_card.bestseller'
        break
      elsif nova_tag_lc == 'nova:new' or nova_tag_lc == 'new-arrival' or nova_tag_lc == 'nieuw'
        assign merch_badge_key = 'nova.product_card.new_arrival'
        break
      elsif nova_tag_lc == 'nova:exclusive' or nova_tag_lc == 'exclusive' or nova_tag_lc == 'exclusief'
        assign merch_badge_key = 'nova.product_card.exclusive'
        break
      elsif nova_tag_lc == 'nova:limited' or nova_tag_lc == 'limited'
        assign merch_badge_key = 'nova.product_card.limited'
        break
      endif
    endfor
  endif

  assign nova_sale_percent = 0
  assign nova_sale_variant = card_product.selected_or_first_available_variant
  if nova_sale_variant.compare_at_price > nova_sale_variant.price and nova_sale_variant.compare_at_price > 0
    assign nova_sale_difference = nova_sale_variant.compare_at_price | minus: nova_sale_variant.price
    assign nova_sale_percent = nova_sale_difference | times: 100 | divided_by: nova_sale_variant.compare_at_price
  endif

  assign has_shower_card_specs = false
  if shower_spray_modes != blank or shower_filter_defined or shower_hose_defined or shower_connection != blank
    assign has_shower_card_specs = true
  endif

  capture nova_card_url_capture
    render 'localized-internal-url', url: card_product.url
  endcapture
  assign nova_card_url = nova_card_url_capture | strip
%}
<article class="nova-card nova-product-card{% unless card_product.available %} is-unavailable{% endunless %}" data-reveal data-product-available="{{ card_product.available }}" data-product-vendor="{{ vendor_lc | escape }}">
  <a class="nova-product-card__media" href="{{ nova_card_url }}">
    {% if card_product.featured_image %}
      {{ card_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240,360,540,720,900', sizes: '(max-width: 720px) 50vw, (max-width: 1080px) 33vw, 25vw', alt: image_alt }}
    {% else %}
      <div class="nova-abstract-device" aria-hidden="true"></div>
    {% endif %}
    {% if card_product.compare_at_price_max > card_product.price %}<span class="nova-product-card__badge nova-product-card__badge--sale"><i></i>{{ 'nova.product_card.sale' | t }}{% if nova_sale_percent > 0 %} · -{{ nova_sale_percent }}%{% endif %}</span>{% elsif merch_badge_key != blank %}<span class="nova-product-card__badge nova-product-card__badge--merch">{{ merch_badge_key | t }}</span>{% elsif card_product.available %}<span class="nova-product-card__badge">{{ 'nova.product_card.available' | t }}</span>{% else %}<span class="nova-product-card__badge nova-product-card__badge--sold">{{ 'nova.product_card.sold_out' | t }}</span>{% endif %}
    <span class="nova-product-card__quicklink">{{ 'nova.product_card.view_product' | t }} →</span>
  </a>
  <div class="nova-product-card__body">
    {% if settings.show_product_brand_badges %}
      <div class="nova-product-card__identity"><strong translate="no">Besjaar</strong><span>{{ 'nova.product_card.family_bath' | t }}</span></div>
    {% endif %}
    {% if best_for != blank %}<p class="nova-product-card__best-for"><span>{{ 'nova.product.best_for' | t }}</span>{{ best_for }}</p>{% endif %}
    <h3 class="nova-product-card__title"><a href="{{ nova_card_url }}">{{ display_title }}</a></h3>
    {% if settings.show_card_review_ratings %}{% render 'review-stars', product: card_product, compact: true %}{% endif %}
    {% if settings.show_product_spec_chips and has_shower_card_specs %}
      <div class="nova-product-card__specs nova-product-card__specs--shower">
        {% if shower_spray_modes != blank %}<span>{{ 'nova.product.shower_modes_chip' | t: count: shower_spray_modes }}</span>{% endif %}
        {% if shower_filter_defined and shower_filter_included %}<span>{{ 'nova.product.shower_filter_chip' | t }}</span>{% endif %}
        {% if shower_hose_defined and shower_hose_included %}<span>{{ 'nova.product.shower_hose_chip' | t }}</span>{% endif %}
        {% if shower_connection != blank %}<span>{{ shower_connection }}</span>{% endif %}
      </div>
    {% endif %}
    <div class="nova-price">
      <span>{{ card_product.price | money }}</span>
      {% if card_product.compare_at_price_max > card_product.price %}<s><span class="nova-visually-hidden">{{ 'nova.product.regular_price' | t }} </span>{{ card_product.compare_at_price_max | money }}</s>{% endif %}
    </div>
    {% assign nova_card_variant = card_product.selected_or_first_available_variant %}
    {% if nova_card_variant.unit_price_measurement %}<small class="nova-unit-price nova-unit-price--card">{{ nova_card_variant.unit_price | money | unit_price_with_measurement: nova_card_variant.unit_price_measurement }}</small>{% endif %}
    <div class="nova-product-card__foot nova-product-card__foot--v21">
      <div class="nova-product-card__availability">{% if card_product.available %}<span class="nova-chip">{{ 'nova.product_card.in_stock' | t }}</span>{% else %}<span class="nova-chip nova-chip--muted">{{ 'nova.product_card.sold_out' | t }}</span>{% endif %}</div>
      {% if settings.show_card_quick_add and card_product.available and card_product.has_only_default_variant %}
        <form class="nova-card-quick-form" action="{{ routes.cart_add_url }}" method="post">
          <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button class="nova-card-quick-add" type="submit" data-card-quick-add="{{ card_product.selected_or_first_available_variant.id }}" aria-label="{{ 'nova.product_card.quick_add_label' | t: title: display_title | escape }}">+ {{ 'nova.product_card.quick_add' | t }}</button>
        </form>
      {% elsif settings.show_card_quick_add and card_product.available %}
        <a class="nova-card-quick-add nova-card-quick-add--link" href="{{ nova_card_url }}">{{ 'nova.product_card.choose_options' | t }} →</a>
      {% else %}
        <a class="nova-mini-link" href="{{ nova_card_url }}">{{ 'nova.product_card.view_product' | t }} →</a>
      {% endif %}
    </div>
  </div>
</article>
