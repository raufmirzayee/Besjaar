{%- liquid
  assign besjaar_ui_collection = collection
  assign besjaar_ui_handle = handle | default: besjaar_ui_collection.handle | downcase | strip
  assign besjaar_ui_title = title | default: besjaar_ui_collection.title
  assign besjaar_ui_focus_collection = settings.shower_collection
  assign is_focus_collection = false
  assign besjaar_ui_lang = request.locale.iso_code | split: '-' | first | downcase
  assign besjaar_ui_identity = besjaar_ui_title | append: ' ' | append: besjaar_ui_handle | downcase

  if besjaar_ui_focus_collection != blank and besjaar_ui_collection != blank and besjaar_ui_collection.id == besjaar_ui_focus_collection.id
    assign is_focus_collection = true
  elsif besjaar_ui_handle == 'badkamer-douche' or besjaar_ui_handle == 'douche' or besjaar_ui_handle == 'shower' or besjaar_ui_handle == 'showerheads' or besjaar_ui_handle == 'douchekoppen'
    assign is_focus_collection = true
  endif

  if is_focus_collection
    assign besjaar_ui_title = 'besjaar_ui.shower_store.catalog.collection_name' | t
  elsif besjaar_ui_handle == 'all'
    case besjaar_ui_lang
      when 'en'
        assign besjaar_ui_title = 'Besjaar showerheads & filters'
      when 'de'
        assign besjaar_ui_title = 'Besjaar Duschköpfe & Filter'
      when 'fr'
        assign besjaar_ui_title = 'Besjaar pommeaux & filtres de douche'
      else
        assign besjaar_ui_title = 'Besjaar douchekoppen & filters'
    endcase
  elsif besjaar_ui_identity contains 'filter'
    case besjaar_ui_lang
      when 'en'
        assign besjaar_ui_title = 'Besjaar shower filters'
      when 'de'
        assign besjaar_ui_title = 'Besjaar Duschfilter'
      when 'fr'
        assign besjaar_ui_title = 'Filtres de douche Besjaar'
      else
        assign besjaar_ui_title = 'Besjaar douchefilters'
    endcase
  endif

  echo besjaar_ui_title
-%}
