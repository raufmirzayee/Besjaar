<div class="nova-shower-confidence nova-shower-confidence--catalog" aria-label="{{ 'nova.shower_collection.confidence_label' | t | escape }}">
  <div class="nova-shower-confidence__summary">
    <div class="nova-shower-confidence__summary-badge">
      <span class="nova-shower-confidence__dot" aria-hidden="true"></span>
      <strong>{{ 'nova.shower_collection.confidence_kicker' | t }}</strong>
    </div>
    <p class="nova-shower-confidence__summary-text">{{ 'nova.shower_collection.confidence_summary' | t }}</p>
  </div>
  <div class="nova-shower-confidence__grid">
    <div class="nova-shower-confidence__item nova-shower-confidence__item--delivery">
      <span class="nova-shower-confidence__icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5h15v13h-15z"/><path d="M18.5 13h5.5l4.5 5v3.5h-10z"/><circle cx="9" cy="24" r="2.5"/><circle cx="24" cy="24" r="2.5"/><path d="M6.5 12h7"/></svg>
      </span>
      <div>
        <span class="nova-shower-confidence__eyebrow">{{ 'nova.delivery.estimate_title' | t }}</span>
        <strong>{{ 'nova.delivery.estimate_fallback' | t }}</strong>
        <small>{{ 'nova.delivery.cutoff' | t: hour: settings.order_cutoff_hour }}</small>
      </div>
    </div>
    <div class="nova-shower-confidence__item nova-shower-confidence__item--returns">
      <span class="nova-shower-confidence__icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4.5 26 8v7.5c0 6-4.2 10.2-10 12-5.8-1.8-10-6-10-12V8z"/><path d="m11.5 16 3 3 6-7"/></svg>
      </span>
      <div>
        <span class="nova-shower-confidence__eyebrow">{{ 'nova.delivery.returns_title' | t }}</span>
        <strong>{{ 'nova.product.return' | t }}</strong>
        <small>{{ 'nova.shower_collection.confidence_returns_note' | t }}</small>
      </div>
    </div>
    <div class="nova-shower-confidence__item nova-shower-confidence__item--payment">
      <span class="nova-shower-confidence__icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="7" width="24" height="18" rx="3"/><path d="M4 12h24"/><path d="M9 20h5"/><path d="M22 17.5v5"/><path d="m19.5 20 2.5 2.5 4-5"/></svg>
      </span>
      <div>
        <span class="nova-shower-confidence__eyebrow">{{ 'nova.product.secure_payment' | t }}</span>
        <strong>{{ 'nova.product.secure_payment' | t }}</strong>
        <small>{{ 'nova.shower_collection.confidence_payment_note' | t }}</small>
      </div>
    </div>
  </div>
</div>
