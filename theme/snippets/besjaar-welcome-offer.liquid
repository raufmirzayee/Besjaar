<div id="BjwTab" class="bjw-tab{% if bjw_bf %} bjw-tab--bf{% endif %}">
  <button type="button" class="bjw-tab__open" data-bjw-open aria-controls="BjwDialog">
    <span class="bjw-tab__badge" aria-hidden="true">
      {%- if bjw_bf -%}
        <svg viewBox="0 0 24 24"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
      {%- elsif bjw_id == 'shipping' -%}
        <svg viewBox="0 0 24 24"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
      {%- else -%}
        <svg viewBox="0 0 24 24"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
      {%- endif -%}
    </span>
    <span class="bjw-tab__label">{% if bjw_bf %}{{ bjw_tab | escape | replace: 'Black Friday', '<b>Black Friday</b>' }}{% elsif bjw_id == 'shipping' %}{{ bjw_tab | escape }}{% else %}{{ bjw_tab | escape | replace: bjw_hl, bjw_hl_html }}{% endif %}</span>
  </button>
</div>

<dialog id="BjwDialog" class="bjw{% if bjw_bf %} bjw--bf{% endif %}"
  data-mode="{% if bjw_bf %}bf{% else %}welcome{% endif %}"
  data-stage="signup"
  data-reward-id="{{ bjw_id }}"
  data-reward-code="{{ bjw_code | escape }}"
  data-quick-id="{{ bjw_q_id }}"
  data-quick-code="{{ bjw_q_code | escape }}"
  data-copied="{{ bjw_c_copied | escape }}"
  data-auto-open="{% if bjw_auto %}true{% else %}false{% endif %}"
  data-delay="15"
  data-has-errors="{% if form.errors %}true{% else %}false{% endif %}"
  aria-labelledby="BjwTitle">
  <button type="button" class="bjw__close" data-bjw-close aria-label="{{ bjw_close | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  <div class="bjw__hero">
    {%- if bjw_bf %}<p class="bjw__eyebrow">{{ bjw_bf_eyebrow | escape }}</p>{% endif %}
    <h2 id="BjwTitle" class="bjw__title">
      {%- if bjw_bf -%}
      <span data-bjw-show="signup">Black <span class="bjw__pct">Friday</span></span><span data-bjw-show="done">{{ bjw_bf_done_title | escape }}</span>
      {%- else -%}
      <span data-bjw-show="signup">{{ bjw_c_head | escape | replace: bjw_big, bjw_big_html }}</span>
      {%- endif -%}
      {%- if bjw_quick %}<span data-bjw-show="quick">{{ bjw_c_quick_title | escape | replace: bjw_small, bjw_small_html }}</span>{% endif -%}
    </h2>
    <p class="bjw__sub">
      <span data-bjw-show="signup">{{ bjw_c_head_sub | escape }}</span>
      {%- if bjw_quick %}<span data-bjw-show="quick">{{ bjw_c_quick_text | escape }}</span>{% endif -%}
      {%- if bjw_bf %}<span data-bjw-show="done">{{ bjw_bf_done_text | escape }}</span>{% endif -%}
    </p>
  </div>
  <div class="bjw__body">
    <div class="bjw__card" data-bjw-stage="signup">
      {% form 'customer', return_to: bjw_return_to, id: 'BjwForm', class: 'bjw__form' %}
        {%- if bjw_bf %}
        <input type="hidden" name="contact[tags]" value="newsletter,besjaar-bf-early-access-2026,besjaar-bf-20-2026,besjaar-locale-{{ bjw_lang }}">
        {%- else %}
        <input type="hidden" name="contact[tags]" value="newsletter,besjaar-welcome-offer,besjaar-welcome-simple-v2,besjaar-welcome-{{ bjw_id }},besjaar-welcome-code-{{ bjw_code | escape }},besjaar-locale-{{ bjw_lang }}">
        {%- endif %}
        {% if form.errors %}<p class="bjw__error" role="alert">{{ bjw_error | escape }}</p>{% endif %}
        <input class="bjw__field" type="email" name="contact[email]" placeholder="{{ bjw_email | escape }}" autocomplete="email" required aria-label="{{ bjw_email | escape }}">
        <button class="bjw__btn" type="submit">{{ bjw_c_cta | escape }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      {% endform %}
      {%- if bjw_quick %}
      <button type="button" class="bjw__quick" data-bjw-quick>{{ bjw_c_quick_btn | escape }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
      {%- endif %}
    </div>
    {%- if bjw_quick %}
    <div class="bjw__card" data-bjw-stage="quick" hidden>
      <div class="bjw__code">
        <strong data-bjw-code>{{ bjw_q_code | escape }}</strong>
        <button type="button" class="bjw__copy" data-bjw-copy>{{ bjw_c_copy | escape }}</button>
      </div>
      <a class="bjw__btn bjw__btn--navy" href="{{ bjw_q_url }}" data-bjw-apply>{{ bjw_c_apply | escape }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <button type="button" class="bjw__back" data-bjw-back>{{ bjw_c_back | escape }}</button>
    </div>
    {%- endif %}
    {%- if bjw_bf %}
    <div class="bjw__card" data-bjw-stage="done" hidden>
      <div class="bjw__code">
        <strong data-bjw-code>{{ bjw_bf_code | escape }}</strong>
        <button type="button" class="bjw__copy" data-bjw-copy>{{ bjw_c_copy | escape }}</button>
      </div>
      <button type="button" class="bjw__btn bjw__btn--navy" data-bjw-done>{{ bjw_bf_done_btn | escape }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </div>
    {%- endif %}
    <p class="bjw__note">{{ bjw_note | escape }}</p>
  </div>
</dialog>

<script src="{{ 'besjaar-x-welcome-offer-2.js' | asset_url }}" defer="defer"></script>
{%- endif -%}