<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title translate="no">Besjaar</title>
  {{ content_for_header }}
  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {% else %}
    <link rel="icon" type="image/png" sizes="16x16" href="{{ 'besjaar-favicon-16.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'besjaar-favicon-32.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="128x128" href="{{ 'besjaar-favicon.png' | asset_url }}">
    <link rel="shortcut icon" type="image/png" href="{{ 'besjaar-favicon-32.png' | asset_url }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'besjaar-apple-touch-icon.png' | asset_url }}">
  {% endif %}
  <style>:root{--nova-bg:#050807;--nova-surface:#0B1210;--nova-text:#F5FFF9;--nova-muted:#9CB0A6;--nova-accent:#B9FF57;--nova-accent-2:#53E7E0;--nova-width:1200px;--nova-radius:18px}</style>
  {{ 'nova-core.css' | asset_url | stylesheet_tag }}
  {{ 'nova-pages.css' | asset_url | stylesheet_tag }}
  {{ 'nova-accessibility.css' | asset_url | stylesheet_tag }}
</head>
<body><a class="nova-skip" href="#MainContent">{{ 'nova.accessibility.skip_to_content' | t }}</a><main id="MainContent" class="nova-password" tabindex="-1">{{ content_for_layout }}</main></body>
</html>
