<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#FFFFFF">
    <meta name="color-scheme" content="light">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="//cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- comment -%}Besjaar 11.3: variable Inter (true intermediate weights instead of browser-synthesized ones) + Jost, the display face the homepage skin was designed around.{%- endcomment -%}
    {%- comment -%}Besjaar 11.6: font CSS loads asynchronously (print-swap trick) so first paint never waits on the cross-origin stylesheet; display=swap plus the size-adjusted fallback faces below keep text visible and stable meanwhile.{%- endcomment -%}
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Jost:wght@300..800&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Jost:wght@300..800&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Jost:wght@300..800&display=swap"></noscript>
    <link rel="canonical" href="{{ canonical_url }}">
    {% if request.page_type == 'index' %}
      <link rel="preload" as="image" href="{{ 'besjaar-premium-hero-pressure-v3.webp' | asset_url }}" fetchpriority="high">
    {% elsif request.page_type == 'product' and product.featured_image != blank %}
      {%- comment -%}Besjaar 11.6: preload the image the gallery actually renders (variant media wins over featured image) with the section's exact sizes value, so the preload always matches the LCP request.{%- endcomment -%}
      {% assign nova_preload_image = product.selected_or_first_available_variant.featured_media.preview_image | default: product.featured_media.preview_image | default: product.featured_image %}
      <link rel="preload" as="image" href="{{ nova_preload_image | image_url: width: 1600 }}" imagesrcset="{{ nova_preload_image | image_url: width: 700 }} 700w, {{ nova_preload_image | image_url: width: 1100 }} 1100w, {{ nova_preload_image | image_url: width: 1600 }} 1600w" imagesizes="(max-width: 900px) 100vw, 56vw" fetchpriority="high">
    {% endif %}
    {%- comment -%}
      Besjaar 11.6.18: Google only uses a favicon that is square and a multiple
      of 48px (48, 96, 144 …) and explicitly says NOT to supply a 16x16 — the
      old 16/32/128 set is why search showed a generic globe. A merchant
      favicon is now emitted at 96 and 192; without one the theme falls back to
      an SVG mark (square, so size-independent) plus the bundled PNGs. Google
      re-reads this on its own crawl schedule, so changes take days to weeks.
    {%- endcomment -%}
    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" sizes="96x96" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {% else %}
      <link rel="icon" type="image/svg+xml" href="{{ 'besjaar-favicon.svg' | asset_url }}">
      <link rel="icon" type="image/png" sizes="128x128" href="{{ 'besjaar-favicon.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'besjaar-favicon-32.png' | asset_url }}">
      <link rel="shortcut icon" type="image/png" href="{{ 'besjaar-favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ 'besjaar-apple-touch-icon.png' | asset_url }}">
    {% endif %}

    {% capture nova_localized_browser_title %}
      {% case request.page_type %}
        {% when 'product' %}{% render 'localized-product-title', product: product %}
        {% when 'collection' %}{% render 'localized-collection-title', collection: collection %}
        {% when 'page' %}{% render 'localized-page-title', page: page %}
        {% else %}{{ page_title | default: 'Besjaar' }}
      {% endcase %}
    {% endcapture %}
    {%- comment -%}
      Besjaar 11.6.20: the four home page descriptions moved into
      snippets/besjaar-home-description.liquid — Bing flagged the old copy as
      too long (~180 chars against its 160 limit), and keeping the strings in a
      snippet means future wording changes do not require touching this layout.
    {%- endcomment -%}
    {% capture nova_home_description %}{% render 'besjaar-home-description' %}{% endcapture %}
    {% assign nova_home_description = nova_home_description | strip %}
    {% liquid
      comment
        Respect Shopify's Search engine listing title when the merchant has set one.
        The localized title is only a fallback. Keep the brand spelling protected.
      endcomment
      assign nova_browser_title = page_title | default: nova_localized_browser_title | strip | default: 'Besjaar'
      comment
        Besjaar 11.6: page_title is virtually never blank (Shopify falls back to the
        resource title), which left the localized titles unreachable. When the
        merchant has NOT set a custom Search engine listing title (page_title still
        equals the raw resource title), prefer the localized title so de/fr/en
        visitors get a browser/SERP title in their own language. A custom SEO title
        always wins.
      endcomment
      assign nova_default_resource_title = blank
      case request.page_type
        when 'product'
          assign nova_default_resource_title = product.title
        when 'collection'
          assign nova_default_resource_title = collection.title
        when 'page'
          assign nova_default_resource_title = page.title
      endcase
      assign nova_localized_browser_title_clean = nova_localized_browser_title | strip
      if nova_default_resource_title != blank and page_title == nova_default_resource_title and nova_localized_browser_title_clean != blank
        assign nova_browser_title = nova_localized_browser_title_clean
      endif
      assign nova_browser_title = nova_browser_title | replace: 'Beshear', 'Besjaar' | replace: 'beshear', 'Besjaar' | replace: 'BESHEAR', 'BESJAAR'
      if request.page_type == 'collection' and collection.handle == 'besjaar'
        if page_title == blank or page_title == 'Besjaar'
          assign nova_browser_title = 'nova.shower_store.catalog.collection_name' | t
        endif
      endif

      comment
        Besjaar 11.6.15: the home page title leads with the brand and says
        "official webshop" in the visitor's language. A title the merchant sets
        under Online Store > Preferences always wins (Shopify hands it over as
        page_title; the untouched default equals the shop name, treated as "not
        set").
      endcomment
      assign nova_lang = request.locale.iso_code | split: '-' | first | downcase
      case nova_lang
        when 'en'
          assign nova_home_title = 'Besjaar® – Official webshop | Showerheads & shower filters'
        when 'de'
          assign nova_home_title = 'Besjaar® – Offizieller Webshop | Duschköpfe & Duschfilter'
        when 'fr'
          assign nova_home_title = 'Besjaar® – Boutique officielle | Pommeaux de douche & filtres'
        else
          assign nova_home_title = 'Besjaar® – Officiële webshop | Douchekoppen & douchefilters'
      endcase
      if request.page_type == 'index'
        if page_title != blank and page_title != shop.name
          assign nova_home_title = page_title
        endif
        assign nova_browser_title = nova_home_title
      endif
      assign nova_browser_title_downcase = nova_browser_title | downcase

      assign nova_meta_description = page_description | strip_html | strip
      assign nova_is_focus_collection = false
      if request.page_type == 'collection'
        if settings.shower_collection != blank and collection.id == settings.shower_collection.id
          assign nova_is_focus_collection = true
        elsif collection.handle == 'badkamer-douche' or collection.handle == 'douchekoppen' or collection.handle == 'showerheads' or collection.handle == 'douche' or collection.handle == 'shower'
          assign nova_is_focus_collection = true
        endif
      endif
      if request.page_type == 'index'
        if nova_meta_description == blank or nova_meta_description == shop.description
          assign nova_meta_description = nova_home_description
        endif
      elsif nova_meta_description == blank and nova_is_focus_collection
        assign nova_meta_description = 'nova.seo_keywords.collection_meta_description' | t
      elsif nova_meta_description == blank and request.page_type == 'page' and page.handle == 'faq'
        assign nova_meta_description = 'nova.seo_keywords.faq_meta_description' | t
      elsif nova_meta_description == blank and request.page_type == 'product' and product.description != blank
        assign nova_meta_description = product.description | strip_html | strip | truncate: 155
      elsif nova_meta_description == blank and request.page_type == 'collection' and collection.description != blank
        capture nova_localized_collection_description
          render 'localized-collection-description', collection: collection
        endcapture
        assign nova_meta_description = nova_localized_collection_description | default: collection.description | strip_html | strip | truncate: 155
      elsif nova_meta_description == blank and request.page_type == 'page' and page.content != blank
        assign nova_meta_description = page.content | strip_html | strip | truncate: 155
      elsif nova_meta_description == blank and shop.description != blank
        assign nova_meta_description = shop.description | strip_html | strip | truncate: 155
      endif
    %}
    <title translate="no">
      {% if request.page_type == 'index' %}{{ nova_browser_title }}{% else %}{{ nova_browser_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} – {{ 'nova.page.page_number' | t: number: current_page }}{% endif %}{% unless nova_browser_title_downcase contains 'besjaar' %} – Besjaar{% endunless %}{% endif %}
    </title>
    <meta name="application-name" content="Besjaar">

    {% if nova_meta_description != blank %}<meta name="description" content="{{ nova_meta_description | escape }}">{% endif %}
    {% render 'meta-tags', nova_browser_title: nova_browser_title, nova_meta_description: nova_meta_description %}
    {% render 'structured-data' %}
    {{ content_for_header }}

    <style>
      :root {
        --nova-bg: {{ settings.bg }};
        --nova-surface: {{ settings.surface }};
        --nova-text: {{ settings.text }};
        --nova-muted: {{ settings.muted }};
        --nova-accent: {{ settings.accent }};
        --nova-accent-2: {{ settings.accent_2 }};
        --nova-accent-warm: {{ settings.accent_warm }};
        --nova-width: {{ settings.page_width }}px;
        --nova-radius: {{ settings.card_radius }}px;
      }
    </style>
    <style id="nova-critical-css">
      /* Besjaar 11.6: size-adjusted local fallback faces so the Inter/Jost swap-in causes no layout shift while the async font CSS loads. */
      @font-face{font-family:"Inter Fallback";src:local("Arial");size-adjust:107%;ascent-override:90%;descent-override:22.5%;line-gap-override:0%}
      @font-face{font-family:"Jost Fallback";src:local("Arial");size-adjust:93%;ascent-override:101%;descent-override:28%;line-gap-override:0%}
      html,body{margin:0;padding:0}body{background:var(--nova-bg,#FFFFFF);color:var(--nova-text,#10231C);font-family:Inter,"Inter Fallback",ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}img{max-width:100%;height:auto;display:block}*,*:before,*:after{box-sizing:border-box}.nova-shell{width:min(calc(100% - 32px),var(--nova-width,1360px));margin-inline:auto}.nova-header{position:sticky;top:0;z-index:100}.nova-hero__grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);align-items:center;gap:48px}.nova-button{display:inline-flex;align-items:center;justify-content:center}.nova-grid{display:grid;gap:18px}@media(max-width:900px){.nova-hero__grid{grid-template-columns:1fr}}@media(max-width:700px){.nova-shell{width:min(calc(100% - 24px),var(--nova-width,1360px))}}
    </style>
    {{ 'nova-core.css' | asset_url | stylesheet_tag }}
    {{ 'nova-shell.css' | asset_url | stylesheet_tag }}
    {%- comment -%}Besjaar 9.3: load the editorial system only where homepage/product storytelling needs it.{%- endcomment -%}
    {% if request.page_type == 'index' or request.page_type == 'product' %}
      {{ 'industry-home.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {%- comment -%}Cart drawer is global, so its styles must be global too.{%- endcomment -%}
    {{ 'nova-cart.css' | asset_url | stylesheet_tag }}
    {% case request.page_type %}
      {% when 'index' %}
        {%- comment -%}Besjaar 9.0: homepage uses the current editorial system; legacy nova-home.css remains compatibility-only.{%- endcomment -%}
      {% when 'product' %}
        {% if template.suffix == 'shower' %}
          {{ 'nova-product-page.css' | asset_url | stylesheet_tag }}
          {% if settings.enable_shower_bundle %}{{ 'nova-bundle.css' | asset_url | stylesheet_tag }}{% endif %}
          {% if settings.enable_smart_recommendations %}{{ 'nova-recommendations.css' | asset_url | stylesheet_tag }}{% endif %}
        {% endif %}
      {% when 'collection' %}
        {%- comment -%}Besjaar 11.6: both collection templates render besjaar-collection-grid (bk-* classes) — nova-catalog.css styled nothing there while the real collection CSS was only discovered late from the section body. Load the bk files from the head (the section's identical tags deduplicate); main-collection.liquid now self-loads nova-catalog.css if it is ever reselected.{%- endcomment -%}
        {{ 'besjaar-collection-grid.css' | asset_url | stylesheet_tag }}
        {{ 'besjaar-collection-step3.css' | asset_url | stylesheet_tag }}
        {{ 'besjaar-collection-actions-1134.css' | asset_url | stylesheet_tag }}
      {% when 'search', 'list-collections' %}
        {{ 'nova-catalog.css' | asset_url | stylesheet_tag }}
      {% when 'cart' %}
        {% if settings.show_cart_addons %}{{ 'nova-bundle.css' | asset_url | stylesheet_tag }}{% endif %}
        {% if settings.enable_smart_recommendations %}{{ 'nova-recommendations.css' | asset_url | stylesheet_tag }}{% endif %}
      {% when 'page', 'blog', 'article', '404' %}
        {{ 'nova-pages.css' | asset_url | stylesheet_tag }}
    {% endcase %}
    {% if request.page_type contains 'customers' or template.name contains 'customers' %}
      {{ 'nova-account.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if request.path contains '/apps/parcelpanel' and request.page_type != 'page' and request.page_type != 'blog' and request.page_type != 'article' and request.page_type != '404' %}
      {{ 'nova-pages.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {{ 'nova-polish.css' | asset_url | stylesheet_tag }}
    {{ 'nova-accessibility.css' | asset_url | stylesheet_tag }}
    {%- comment -%}Besjaar 10.2: layout correction + unified navy/white visual system.{%- endcomment -%}
    {{ 'besjaar-editorial.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-polish.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-foundation-v1.css' | asset_url | stylesheet_tag }}
    {% if request.page_type == 'index' %}{{ 'besjaar-home-step2.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if request.page_type == 'index' %}{{ 'besjaar-mobile-feature-cards.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if request.page_type == 'product' and template.suffix == 'shower' %}{{ 'nova-shower-trust-education.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if request.page_type == 'product' %}{{ 'besjaar-product-step4.css' | asset_url | stylesheet_tag }}{% endif %}
    {{ 'besjaar-commerce-step5.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-final-step6.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-mobile-corrections.css' | asset_url | stylesheet_tag }}
    {% if request.page_type == 'product' %}{{ 'besjaar-mobile-detail-clarity.css' | asset_url | stylesheet_tag }}{% endif %}
    {{ 'besjaar-cart-polish-1140.css' | asset_url | stylesheet_tag }}
    {%- comment -%}Besjaar 11.3: premium lux layer — must stay the LAST stylesheet so its navy unification and polish sit on top of every earlier generation.{%- endcomment -%}
    {{ 'besjaar-premium-lux.css' | asset_url | stylesheet_tag }}
    {%- comment -%}Besjaar 11.5: shared storefront refinement and interaction states.{%- endcomment -%}
    {{ 'besjaar-1150.css' | asset_url | stylesheet_tag }}
    {% unless request.visual_preview_mode %}
    {% liquid
      capture nova_js_shop_url_capture
        render 'shower-store-url'
      endcapture
      assign nova_js_shop_url = nova_js_shop_url_capture | strip

      assign nova_search_collection = settings.shower_collection
      if nova_search_collection == blank
        assign nova_search_collection = collections['badkamer-douche']
      endif
      if nova_search_collection == blank
        assign nova_search_collection = collections['douchekoppen']
      endif
      if nova_search_collection == blank
        assign nova_search_collection = collections['showerheads']
      endif
      if nova_search_collection == blank
        assign nova_search_collection = collections['douche']
      endif
      if nova_search_collection == blank
        assign nova_search_collection = collections['shower']
      endif

      comment
        Featured shower model selectors are presentation controls only. They must
        never become a hard catalogue whitelist, so future shower products remain
        purchasable and discoverable without a theme update.
      endcomment
      assign nova_focus_locked = false

      capture nova_focus_product_ids
        echo '['
        assign nova_focus_first = true
        if settings.shower_model_1 != blank
          echo settings.shower_model_1.id | json
          assign nova_focus_first = false
        endif
        if settings.shower_model_2 != blank
          unless nova_focus_first
            echo ','
          endunless
          echo settings.shower_model_2.id | json
          assign nova_focus_first = false
        endif
        if settings.shower_model_3 != blank
          unless nova_focus_first
            echo ','
          endunless
          echo settings.shower_model_3.id | json
          assign nova_focus_first = false
        endif
        if settings.shower_model_4 != blank
          unless nova_focus_first
            echo ','
          endunless
          echo settings.shower_model_4.id | json
          assign nova_focus_first = false
        endif
        if settings.shower_model_5 != blank
          unless nova_focus_first
            echo ','
          endunless
          echo settings.shower_model_5.id | json
        endif
        echo ']'
      endcapture

      capture nova_search_product_ids
        echo '['
        assign nova_search_first = true
        if nova_search_collection != blank
          for nova_search_product in nova_search_collection.products limit: 50
            unless nova_search_first
              echo ','
            endunless
            echo nova_search_product.id | json
            assign nova_search_first = false
          endfor
        endif
        if settings.bundle_accessory_1 != blank
          unless nova_search_first
            echo ','
          endunless
          echo settings.bundle_accessory_1.id | json
          assign nova_search_first = false
        endif
        if settings.bundle_accessory_2 != blank
          unless nova_search_first
            echo ','
          endunless
          echo settings.bundle_accessory_2.id | json
          assign nova_search_first = false
        endif
        if settings.bundle_accessory_3 != blank
          unless nova_search_first
            echo ','
          endunless
          echo settings.bundle_accessory_3.id | json
          assign nova_search_first = false
        endif
        echo ']'
      endcapture

      capture nova_focus_handles
        echo '['
        assign nova_focus_first = true
        if settings.shower_model_1 != blank
          echo settings.shower_model_1.handle | json
          assign nova_focus_first = false
        endif
        if settings.shower_model_2 != blank
          unless nova_focus_first
            echo ','
          endunless
          echo settings.shower_model_2.handle | json
          assign nova_focus_first = false
        endif
        if settings.shower_model_3 != blank
          unless nova_focus_first
            echo ','
          endunless
          echo settings.shower_model_3.handle | json
          assign nova_focus_first = false
        endif
        if settings.shower_model_4 != blank
          unless nova_focus_first
            echo ','
          endunless
          echo settings.shower_model_4.handle | json
          assign nova_focus_first = false
        endif
        if settings.shower_model_5 != blank
          unless nova_focus_first
            echo ','
          endunless
          echo settings.shower_model_5.handle | json
        endif
        echo ']'
      endcapture

      assign nova_runtime_contact_page = settings.contact_page
      if nova_runtime_contact_page == blank
        assign nova_runtime_contact_page = pages['contact']
      endif
      capture nova_runtime_contact_url
        if nova_runtime_contact_page != blank
          render 'localized-internal-url', url: nova_runtime_contact_page.url
        else
          render 'localized-internal-url', url: '/pages/contact'
        endif
      endcapture
      assign nova_runtime_contact_url = nova_runtime_contact_url | strip

      assign nova_runtime_faq_page = settings.faq_page
      if nova_runtime_faq_page == blank
        assign nova_runtime_faq_page = pages['veelgestelde-vragen']
      endif
      if nova_runtime_faq_page == blank
        assign nova_runtime_faq_page = pages['faq']
      endif
      capture nova_runtime_faq_url
        if nova_runtime_faq_page != blank
          render 'localized-internal-url', url: nova_runtime_faq_page.url
        else
          render 'localized-internal-url', url: '/pages/faq'
        endif
      endcapture
      assign nova_runtime_faq_url = nova_runtime_faq_url | strip

      assign nova_runtime_tracking_page = settings.tracking_page
      capture nova_runtime_tracking_url
        if nova_runtime_tracking_page != blank
          render 'localized-internal-url', url: nova_runtime_tracking_page.url
        else
          render 'localized-internal-url', url: '/apps/parcelpanel'
        endif
      endcapture
      assign nova_runtime_tracking_url = nova_runtime_tracking_url | strip
    %}
    <script>
      window.NovaConfig = {
        routes: {
          root: {{ routes.root_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          cart: {{ routes.cart_url | json }},
          cartJson: {{ routes.cart_url | append: '.js' | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          allProducts: {{ nova_js_shop_url | json }},
          contact: {{ nova_runtime_contact_url | json }},
          faq: {{ nova_runtime_faq_url | json }},
          tracking: {{ nova_runtime_tracking_url | json }}
        },
        trackingCopy: {
          kicker: {{ 'nova.tracking_app.kicker' | t | json }},
          title: {{ 'nova.tracking_app.title' | t | json }},
          body: {{ 'nova.tracking_app.body' | t | json }},
          order: {{ 'nova.tracking_app.order' | t | json }},
          tracking: {{ 'nova.tracking_app.tracking' | t | json }},
          support: {{ 'nova.tracking_app.support' | t | json }},
          supportBody: {{ 'nova.tracking_app.support_body' | t | json }},
          supportCta: {{ 'nova.tracking_app.support_cta' | t | json }},
          chip1: {{ 'nova.tracking_app.chip1' | t | json }},
          chip2: {{ 'nova.tracking_app.chip2' | t | json }},
          chip3: {{ 'nova.tracking_app.chip3' | t | json }}
        },
        currency: {{ cart.currency.iso_code | default: shop.currency | json }},
        catalog: {
          focusLocked: {{ nova_focus_locked | json }},
          focusProductIds: {{ nova_focus_product_ids | strip }},
          searchProductIds: {{ nova_search_product_ids | strip }},
          focusHandles: {{ nova_focus_handles | strip }}
        },
        commerce: {
          showFreeShippingBar: {{ settings.show_free_shipping_bar | json }},
