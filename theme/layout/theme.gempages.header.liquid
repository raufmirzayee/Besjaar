        if besjaar_ui_runtime_faq_page != blank
          render 'localized-internal-url', url: besjaar_ui_runtime_faq_page.url
        else
          render 'localized-internal-url', url: '/pages/faq'
        endif
      endcapture
      assign besjaar_ui_runtime_faq_url = besjaar_ui_runtime_faq_url | strip

