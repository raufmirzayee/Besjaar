<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#FFFFFF">
    <meta name="color-scheme" content="light">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="//cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Jost:wght@300..800&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Jost:wght@300..800&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Jost:wght@300..800&display=swap"></noscript>
    <link rel="canonical" href="{{ canonical_url }}">
    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" sizes="96x96" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {% else %}
      <link rel="icon" type="image/svg+xml" href="{{ 'besjaar-favicon.svg' | asset_url }}">
      <link rel="icon" type="image/png" sizes="128x128" href="{{ 'besjaar-favicon.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'besjaar-favicon-32.png' | asset_url }}">
      <link rel="shortcut icon" type="image/png" href="{{ 'besjaar-favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ 'besjaar-apple-touch-icon.png' | asset_url }}">
    {% endif %}

    {% capture besjaar_ui_localized_browser_title %}
      {% case request.page_type %}
        {% when 'product' %}{% render 'localized-product-title', product: product %}
        {% when 'collection' %}{% render 'localized-collection-title', collection: collection %}
        {% when 'page' %}{% render 'localized-page-title', page: page %}
        {% else %}{{ page_title | default: 'Besjaar' }}
      {% endcase %}
    {% endcapture %}
    {% liquid
      comment
        Respect Shopify's Search engine listing title when the merchant has set one.
        The localized title is only a fallback. Keep the brand spelling protected.
      endcomment
      assign besjaar_ui_browser_title = page_title | default: besjaar_ui_localized_browser_title | strip | default: 'Besjaar'
      if request.page_type == 'index'
        assign besjaar_ui_browser_title = 'besjaar_ui.shower_store.meta.title' | t
      endif
      assign besjaar_ui_browser_title = besjaar_ui_browser_title | replace: 'Beshear', 'Besjaar' | replace: 'beshear', 'Besjaar' | replace: 'BESHEAR', 'BESJAAR'
      assign besjaar_ui_browser_title_downcase = besjaar_ui_browser_title | downcase
      assign besjaar_ui_is_brand_collection = false
      if request.page_type == 'collection' and collection.handle == 'besjaar'
        assign besjaar_ui_is_brand_collection = true
        if page_title == blank or page_title == 'Besjaar'
          assign besjaar_ui_browser_title = 'besjaar_ui.shower_store.catalog.collection_name' | t
        endif
      endif
      assign besjaar_ui_browser_title_downcase = besjaar_ui_browser_title | downcase

      assign besjaar_ui_meta_description = page_description | strip_html | strip
      assign besjaar_ui_is_focus_collection = false
      if request.page_type == 'collection'
        if settings.shower_collection != blank and collection.id == settings.shower_collection.id
          assign besjaar_ui_is_focus_collection = true
        elsif collection.handle == 'badkamer-douche' or collection.handle == 'douchekoppen' or collection.handle == 'showerheads' or collection.handle == 'douche' or collection.handle == 'shower'
          assign besjaar_ui_is_focus_collection = true
        endif
      endif
      if request.page_type == 'index'
        assign besjaar_ui_meta_description = 'besjaar_ui.shower_store.meta.description' | t
      elsif besjaar_ui_meta_description == blank and besjaar_ui_is_focus_collection
        assign besjaar_ui_meta_description = 'besjaar_ui.seo_keywords.collection_meta_description' | t
      elsif besjaar_ui_meta_description == blank and request.page_type == 'page' and page.handle == 'faq'
        assign besjaar_ui_meta_description = 'besjaar_ui.seo_keywords.faq_meta_description' | t
      elsif besjaar_ui_meta_description == blank and request.page_type == 'page'
        assign besjaar_ui_gem_lang = request.locale.iso_code | split: '-' | first | downcase
        assign besjaar_ui_gem_page_handle = page.handle | downcase
        if besjaar_ui_gem_page_handle == 'over-ons' or besjaar_ui_gem_page_handle == 'overons' or besjaar_ui_gem_page_handle == 'about-us' or besjaar_ui_gem_page_handle == 'about'
          case besjaar_ui_gem_lang
            when 'en'
              assign besjaar_ui_meta_description = 'Learn about Besjaar, our focused range of showerheads, shower filters and accessories, and how we support customers before and after purchase.'
            when 'de'
              assign besjaar_ui_meta_description = 'Erfahre mehr über Besjaar, unser fokussiertes Sortiment an Duschköpfen, Duschfiltern und Zubehör sowie unseren Kundenservice vor und nach dem Kauf.'
            when 'fr'
              assign besjaar_ui_meta_description = 'Découvrez Besjaar, notre gamme ciblée de pommeaux, filtres de douche et accessoires, ainsi que notre accompagnement avant et après l’achat.'
            else
              assign besjaar_ui_meta_description = 'Ontdek Besjaar, ons gerichte assortiment douchekoppen, douchefilters en accessoires, en hoe we klanten vóór en na aankoop ondersteunen.'
          endcase
        elsif besjaar_ui_gem_page_handle == 'contact' or besjaar_ui_gem_page_handle == 'contact-us' or besjaar_ui_gem_page_handle == 'contacteer-ons' or besjaar_ui_gem_page_handle == 'klantenservice'
          case besjaar_ui_gem_lang
            when 'en'
              assign besjaar_ui_meta_description = 'Contact Besjaar for product advice, compatibility questions, orders, delivery, returns or support with your showerhead or shower filter.'
            when 'de'
              assign besjaar_ui_meta_description = 'Kontaktiere Besjaar bei Fragen zu Produkten, Kompatibilität, Bestellungen, Lieferung, Rückgabe oder Support zu Duschkopf und Duschfilter.'
            when 'fr'
              assign besjaar_ui_meta_description = 'Contactez Besjaar pour des conseils produit, la compatibilité, les commandes, la livraison, les retours ou l’assistance.'
            else
              assign besjaar_ui_meta_description = 'Neem contact op met Besjaar voor productadvies, compatibiliteit, bestellingen, levering, retouren of support bij douchekoppen en douchefilters.'
          endcase
        elsif besjaar_ui_gem_page_handle == 'zakelijk' or besjaar_ui_gem_page_handle == 'business' or besjaar_ui_gem_page_handle == 'business-orders'
          case besjaar_ui_gem_lang
            when 'en'
              assign besjaar_ui_meta_description = 'Business orders from Besjaar: contact us about volume purchasing, professional use, product selection, delivery and account questions.'
            when 'de'
              assign besjaar_ui_meta_description = 'Besjaar für Geschäftskunden: Informationen zu größeren Bestellungen, professioneller Nutzung, Produktauswahl, Lieferung und Support.'
            when 'fr'
              assign besjaar_ui_meta_description = 'Commandes professionnelles Besjaar : achats en volume, sélection de produits, livraison et accompagnement pour les entreprises.'
            else
              assign besjaar_ui_meta_description = 'Zakelijk bestellen bij Besjaar: neem contact op over grotere aantallen, professionele toepassingen, productkeuze, levering en support.'
          endcase
        endif
      elsif besjaar_ui_meta_description == blank and request.page_type == 'product' and product.description != blank
        assign besjaar_ui_meta_description = product.description | strip_html | strip | truncate: 190
      elsif besjaar_ui_meta_description == blank and request.page_type == 'collection'
        assign besjaar_ui_gem_collection_identity = collection.title | append: ' ' | append: collection.handle | downcase
        if besjaar_ui_gem_collection_identity contains 'filter'
          assign besjaar_ui_gem_lang = request.locale.iso_code | split: '-' | first | downcase
          case besjaar_ui_gem_lang
            when 'en'
              assign besjaar_ui_meta_description = 'Shop Besjaar replacement shower filters and compatible filter accessories. Check product fit, replacement guidance and availability before ordering.'
            when 'de'
              assign besjaar_ui_meta_description = 'Besjaar Ersatz-Duschfilter und kompatibles Filterzubehör kaufen. Passform, Wechselhinweise und Verfügbarkeit vor der Bestellung prüfen.'
            when 'fr'
              assign besjaar_ui_meta_description = 'Achetez les filtres de remplacement Besjaar et accessoires compatibles. Vérifiez la compatibilité, le remplacement et la disponibilité.'
            else
              assign besjaar_ui_meta_description = 'Shop Besjaar vervangingsfilters en compatibele filteraccessoires. Controleer pasvorm, vervangingsadvies en beschikbaarheid vóór bestellen.'
          endcase
        elsif collection.handle == 'all'
          assign besjaar_ui_gem_lang = request.locale.iso_code | split: '-' | first | downcase
          case besjaar_ui_gem_lang
            when 'en'
              assign besjaar_ui_meta_description = 'Shop Besjaar showerheads, shower filters and compatible bathroom accessories. Compare models, spray modes, filter options and availability online.'
            when 'de'
              assign besjaar_ui_meta_description = 'Besjaar Duschköpfe, Duschfilter und passendes Badzubehör entdecken. Modelle, Strahlarten, Filteroptionen und Verfügbarkeit online vergleichen.'
            when 'fr'
              assign besjaar_ui_meta_description = 'Découvrez les pommeaux, filtres de douche et accessoires Besjaar. Comparez les modèles, jets, options de filtre et disponibilités en ligne.'
            else
              assign besjaar_ui_meta_description = 'Shop Besjaar douchekoppen, douchefilters en passende badkameraccessoires. Vergelijk modellen, straalstanden, filteropties en beschikbaarheid online.'
          endcase
        elsif collection.description != blank
          assign besjaar_ui_meta_description = collection.description | strip_html | strip | truncate: 155
        else
          assign besjaar_ui_gem_lang = request.locale.iso_code | split: '-' | first | downcase
          capture besjaar_ui_gem_collection_fallback
            case besjaar_ui_gem_lang
              when 'en'
                echo 'Shop ' | append: collection.title | append: ' from Besjaar. Compare product features, compatibility, pricing and availability before ordering online.'
              when 'de'
                echo collection.title | append: ' von Besjaar entdecken. Produkteigenschaften, Kompatibilität, Preise und Verfügbarkeit vor der Bestellung vergleichen.'
              when 'fr'
                echo 'Découvrez ' | append: collection.title | append: ' chez Besjaar. Comparez les caractéristiques, la compatibilité, les prix et les disponibilités avant de commander.'
              else
                echo 'Shop ' | append: collection.title | append: ' van Besjaar. Vergelijk productkenmerken, compatibiliteit, prijzen en beschikbaarheid vóór je online bestelt.'
            endcase
          endcapture
          assign besjaar_ui_meta_description = besjaar_ui_gem_collection_fallback | strip | truncate: 155
        endif
      elsif besjaar_ui_meta_description == blank and request.page_type == 'page' and page.content != blank
        assign besjaar_ui_meta_description = page.content | strip_html | strip | truncate: 190
      elsif besjaar_ui_meta_description == blank and shop.description != blank
        assign besjaar_ui_meta_description = shop.description | strip_html | strip | truncate: 190
      endif
    %}
    {%- comment -%}
      Besjaar 11.6.24: Bing flags very short utility/content page titles such as
      "Over Besjaar" / "About Besjaar". Keep the short labels in navigation,
      but use a richer SERP/browser title for key indexable pages. A merchant
      custom Search engine listing title still wins.
    {%- endcomment -%}
    {% if request.page_type == 'page' %}
      {% assign besjaar_ui_use_priority_page_seo_title = false %}
      {% if page_title == blank or page_title == page.title %}
        {% assign besjaar_ui_use_priority_page_seo_title = true %}
      {% endif %}
      {% if besjaar_ui_use_priority_page_seo_title %}
        {% capture besjaar_ui_priority_page_seo_title %}{% render 'besjaar-priority-page-seo-title', page: page %}{% endcapture %}
        {% assign besjaar_ui_priority_page_seo_title = besjaar_ui_priority_page_seo_title | strip %}
        {% if besjaar_ui_priority_page_seo_title != blank %}
          {% assign besjaar_ui_browser_title = besjaar_ui_priority_page_seo_title %}
          {% assign besjaar_ui_browser_title_downcase = besjaar_ui_browser_title | downcase %}
        {% endif %}
      {% endif %}
    {% endif %}
    <title translate="no">
      {% if request.page_type == 'index' %}{{ 'besjaar_ui.shower_store.meta.title' | t }}{% else %}{{ besjaar_ui_browser_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} – {{ 'besjaar_ui.page.page_number' | t: number: current_page }}{% endif %}{% unless besjaar_ui_browser_title_downcase contains 'besjaar' %} – Besjaar{% endunless %}{% endif %}
    </title>
    <meta name="application-name" content="Besjaar">

    {% if besjaar_ui_meta_description != blank %}<meta name="description" content="{{ besjaar_ui_meta_description | escape }}">{% endif %}
    {% render 'meta-tags', besjaar_ui_browser_title: besjaar_ui_browser_title, besjaar_ui_meta_description: besjaar_ui_meta_description %}
    {% render 'structured-data' %}
    {{ content_for_header }}

    <style>
      :root {
        --besjaar-ui-bg: {{ settings.bg }};
        --besjaar-ui-surface: {{ settings.surface }};
        --besjaar-ui-text: {{ settings.text }};
        --besjaar-ui-muted: {{ settings.muted }};
        --besjaar-ui-accent: {{ settings.accent }};
        --besjaar-ui-accent-2: {{ settings.accent_2 }};
        --besjaar-ui-accent-warm: {{ settings.accent_warm }};
        --besjaar-ui-width: {{ settings.page_width }}px;
        --besjaar-ui-radius: {{ settings.card_radius }}px;
      }
    </style>
    <style id="besjaar-ui-critical-css">
      html,body{margin:0;padding:0}body{background:var(--besjaar-ui-bg,#F7F6F1);color:var(--besjaar-ui-text,#18231C);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}img{max-width:100%;height:auto;display:block}*,*:before,*:after{box-sizing:border-box}.besjaar-ui-shell{width:min(calc(100% - 32px),var(--besjaar-ui-width,1360px));margin-inline:auto}.besjaar-ui-header{position:sticky;top:0;z-index:100}.besjaar-ui-hero__grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);align-items:center;gap:48px}.besjaar-ui-button{display:inline-flex;align-items:center;justify-content:center}.besjaar-ui-grid{display:grid;gap:18px}@media(max-width:900px){.besjaar-ui-hero__grid{grid-template-columns:1fr}}@media(max-width:700px){.besjaar-ui-shell{width:min(calc(100% - 24px),var(--besjaar-ui-width,1360px))}}
    </style>
    {{ 'besjaar-ui-core.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-ui-shell.css' | asset_url | stylesheet_tag }}
    {% if request.page_type == 'index' or request.page_type == 'product' %}
      {{ 'besjaar-store-home.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {%- comment -%}Cart drawer is global, so its styles must be global too.{%- endcomment -%}
    {{ 'besjaar-ui-cart.css' | asset_url | stylesheet_tag }}
    {% case request.page_type %}
      {% when 'index' %}
        {{ 'besjaar-ui-home.css' | asset_url | stylesheet_tag }}
        {{ 'besjaar-premium-home.css' | asset_url | stylesheet_tag }}
      {% when 'product' %}
        {{ 'besjaar-ui-product-page.css' | asset_url | stylesheet_tag }}
        {% if settings.enable_shower_bundle %}{{ 'besjaar-ui-bundle.css' | asset_url | stylesheet_tag }}{% endif %}
        {% if settings.enable_smart_recommendations %}{{ 'besjaar-ui-recommendations.css' | asset_url | stylesheet_tag }}{% endif %}
      {% when 'collection', 'search', 'list-collections' %}
        {{ 'besjaar-ui-catalog.css' | asset_url | stylesheet_tag }}
      {% when 'cart' %}
        {% if settings.show_cart_addons %}{{ 'besjaar-ui-bundle.css' | asset_url | stylesheet_tag }}{% endif %}
        {% if settings.enable_smart_recommendations %}{{ 'besjaar-ui-recommendations.css' | asset_url | stylesheet_tag }}{% endif %}
      {% when 'page', 'blog', 'article', '404' %}
        {{ 'besjaar-ui-pages.css' | asset_url | stylesheet_tag }}
    {% endcase %}
    {% if request.page_type contains 'customers' or template.name contains 'customers' %}
      {{ 'besjaar-ui-account.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if request.path contains '/apps/parcelpanel' and request.page_type != 'page' and request.page_type != 'blog' and request.page_type != 'article' and request.page_type != '404' %}
      {{ 'besjaar-ui-pages.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {{ 'besjaar-ui-polish.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-ui-accessibility.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-editorial-base.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-polish-layer.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-foundation-v1.css' | asset_url | stylesheet_tag }}
    {% if request.page_type == 'index' %}{{ 'besjaar-home-step2.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if request.page_type == 'index' %}{{ 'besjaar-mobile-feature-cards.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if request.page_type == 'product' %}{{ 'besjaar-ui-shower-trust-education.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if request.page_type == 'product' %}{{ 'besjaar-product-step4.css' | asset_url | stylesheet_tag }}{% endif %}
    {{ 'besjaar-commerce-step5.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-final-step6.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-mobile-corrections.css' | asset_url | stylesheet_tag }}
    {% if request.page_type == 'product' %}{{ 'besjaar-mobile-detail-clarity.css' | asset_url | stylesheet_tag }}{% endif %}
    {{ 'besjaar-cart-polish-1140.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-premium-lux.css' | asset_url | stylesheet_tag }}
    {{ 'besjaar-1150.css' | asset_url | stylesheet_tag }}
    {% unless request.visual_preview_mode %}
    {% liquid
      capture besjaar_ui_js_shop_url_capture
        render 'shower-store-url'
      endcapture
      assign besjaar_ui_js_shop_url = besjaar_ui_js_shop_url_capture | strip

      assign besjaar_ui_search_collection = settings.shower_collection
      if besjaar_ui_search_collection == blank
        assign besjaar_ui_search_collection = collections['badkamer-douche']
      endif
      if besjaar_ui_search_collection == blank
        assign besjaar_ui_search_collection = collections['douchekoppen']
      endif
      if besjaar_ui_search_collection == blank
        assign besjaar_ui_search_collection = collections['showerheads']
      endif
      if besjaar_ui_search_collection == blank
        assign besjaar_ui_search_collection = collections['douche']
      endif
      if besjaar_ui_search_collection == blank
        assign besjaar_ui_search_collection = collections['shower']
      endif

      comment
        Featured shower model selectors are presentation controls only. They must
        never become a hard catalogue whitelist, so future shower products remain
        purchasable and discoverable without a theme update.
      endcomment
      assign besjaar_ui_focus_locked = false

      capture besjaar_ui_focus_product_ids
        echo '['
        assign besjaar_ui_focus_first = true
        if settings.shower_model_1 != blank
          echo settings.shower_model_1.id | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_2 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_2.id | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_3 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_3.id | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_4 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_4.id | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_5 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_5.id | json
        endif
        echo ']'
      endcapture

      capture besjaar_ui_search_product_ids
        echo '['
        assign besjaar_ui_search_first = true
        if besjaar_ui_search_collection != blank
          for besjaar_ui_search_product in besjaar_ui_search_collection.products limit: 50
            unless besjaar_ui_search_first
              echo ','
            endunless
            echo besjaar_ui_search_product.id | json
            assign besjaar_ui_search_first = false
          endfor
        endif
        if settings.bundle_accessory_1 != blank
          unless besjaar_ui_search_first
            echo ','
          endunless
          echo settings.bundle_accessory_1.id | json
          assign besjaar_ui_search_first = false
        endif
        if settings.bundle_accessory_2 != blank
          unless besjaar_ui_search_first
            echo ','
          endunless
          echo settings.bundle_accessory_2.id | json
          assign besjaar_ui_search_first = false
        endif
        if settings.bundle_accessory_3 != blank
          unless besjaar_ui_search_first
            echo ','
          endunless
          echo settings.bundle_accessory_3.id | json
          assign besjaar_ui_search_first = false
        endif
        echo ']'
      endcapture

      capture besjaar_ui_focus_handles
        echo '['
        assign besjaar_ui_focus_first = true
        if settings.shower_model_1 != blank
          echo settings.shower_model_1.handle | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_2 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_2.handle | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_3 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_3.handle | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_4 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_4.handle | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_5 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_5.handle | json
        endif
        echo ']'
      endcapture

      assign besjaar_ui_runtime_contact_page = settings.contact_page
      if besjaar_ui_runtime_contact_page == blank
        assign besjaar_ui_runtime_contact_page = pages['contact']
      endif
      capture besjaar_ui_runtime_contact_url
        if besjaar_ui_runtime_contact_page != blank
          render 'localized-internal-url', url: besjaar_ui_runtime_contact_page.url
        else
          render 'localized-internal-url', url: '/pages/contact'
        endif
      endcapture
      assign besjaar_ui_runtime_contact_url = besjaar_ui_runtime_contact_url | strip

      assign besjaar_ui_runtime_faq_page = settings.faq_page
