{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>{{ 'besjaar_ui.gift_card.title' | t }} — Besjaar</title>
  {{ content_for_header }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>
  <style>
    *{box-sizing:border-box}body{margin:0;background:#f7f6f1;color:#18231c;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.gift-shell{min-height:100vh;display:grid;place-items:center;padding:32px}.gift-card{width:min(100%,620px);background:#fff;border:1px solid #dde4dc;border-radius:28px;box-shadow:0 24px 70px rgba(24,35,28,.12);overflow:hidden}.gift-head{padding:28px 30px;background:linear-gradient(135deg,#eef4ec,#f8f7f2)}.gift-brand{font-size:.78rem;font-weight:900;letter-spacing:.18em}.gift-head h1{margin:18px 0 4px;font-size:clamp(2rem,7vw,3.4rem)}.gift-balance{font-size:1.05rem;color:#617066}.gift-body{padding:30px;display:grid;gap:22px}.gift-code{padding:18px;border:1px dashed #b9c5ba;border-radius:16px;text-align:center;font-weight:900;letter-spacing:.14em;font-size:1.15rem;background:#fafbf8}.gift-meta{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;color:#66746b;font-size:.86rem}.gift-qr{display:grid;place-items:center;padding:8px}.gift-actions{display:flex;gap:10px;flex-wrap:wrap}.gift-button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 18px;border-radius:999px;background:#1f6b57;color:#fff;font-weight:800;text-decoration:none;border:0;cursor:pointer}.gift-button--ghost{background:#eef3ed;color:#20342a}.gift-note{margin:0;color:#66746b;line-height:1.6}@media(max-width:560px){.gift-shell{padding:14px}.gift-head,.gift-body{padding:22px}.gift-card{border-radius:20px}}
  </style>
</head>
<body>
  <main class="gift-shell">
    <article class="gift-card">
      <header class="gift-head">
        <div class="gift-brand" translate="no">BESJAAR</div>
        <h1>{{ 'besjaar_ui.gift_card.title' | t }}</h1>
        <div class="gift-balance">{{ 'besjaar_ui.gift_card.balance' | t }}: <strong>{{ gift_card.balance | money_with_currency }}</strong></div>
      </header>
      <div class="gift-body">
        {% if gift_card.message != blank %}<p class="gift-note">{{ gift_card.message | escape }}</p>{% endif %}
        <div class="gift-code" aria-label="{{ 'besjaar_ui.gift_card.code' | t | escape }}">{{ gift_card.code | escape }}</div>
        <div class="gift-qr" id="GiftCardQRCode" aria-label="{{ 'besjaar_ui.gift_card.qr' | t | escape }}"></div>
        <div class="gift-meta">
          <span>{{ 'besjaar_ui.gift_card.initial_value' | t }}: {{ gift_card.initial_value | money_with_currency }}</span>
          {% if gift_card.expires_on %}<span>{{ 'besjaar_ui.gift_card.expires' | t }}: {{ gift_card.expires_on | date: '%d.%m.%Y' }}</span>{% endif %}
        </div>
        {% if gift_card.expired or gift_card.enabled == false %}<p class="gift-note"><strong>{{ 'besjaar_ui.gift_card.inactive' | t }}</strong></p>{% endif %}
        <div class="gift-actions">
          <a class="gift-button" href="{{ routes.root_url }}">{{ 'besjaar_ui.gift_card.shop_now' | t }}</a>
          <button class="gift-button gift-button--ghost" type="button" onclick="window.print()">{{ 'besjaar_ui.gift_card.print' | t }}</button>
          {% if gift_card.pass_url %}<a class="gift-button gift-button--ghost" href="{{ gift_card.pass_url | escape }}">{{ 'besjaar_ui.gift_card.apple_wallet' | t }}</a>{% endif %}
        </div>
      </div>
    </article>
  </main>
  <script>
    // Besjaar 11.6: qrcode.js loads deferred, so wait for it before initializing.
    window.addEventListener('DOMContentLoaded', function () {
      if (window.QRCode && document.getElementById('GiftCardQRCode')) {
        new QRCode(document.getElementById('GiftCardQRCode'), { text: {{ gift_card.qr_identifier | json }}, width: 132, height: 132 });
      }
    });
  </script>
</body>
</html>
