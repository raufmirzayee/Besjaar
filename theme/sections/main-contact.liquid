{% liquid
  assign nova_contact_faq_page = section.settings.faq_page | default: settings.faq_page
  if nova_contact_faq_page == blank
    assign nova_contact_faq_page = pages['veelgestelde-vragen']
  endif
  if nova_contact_faq_page == blank
    assign nova_contact_faq_page = pages['faq']
  endif
  capture nova_contact_faq_url
    if nova_contact_faq_page != blank
      render 'localized-internal-url', url: nova_contact_faq_page.url
    else
      render 'localized-internal-url', url: '/pages/faq'
    endif
  endcapture
  assign nova_contact_faq_url = nova_contact_faq_url | strip

  assign nova_contact_tracking_page = section.settings.tracking_page | default: settings.tracking_page
  if nova_contact_tracking_page == blank
    assign nova_contact_tracking_page = pages['track-order']
  endif
  if nova_contact_tracking_page == blank
    assign nova_contact_tracking_page = pages['tracking']
  endif
  capture nova_contact_tracking_url
    if nova_contact_tracking_page != blank
      render 'localized-internal-url', url: nova_contact_tracking_page.url
    else
      render 'localized-internal-url', url: '/apps/parcelpanel'
    endif
  endcapture
  assign nova_contact_tracking_url = nova_contact_tracking_url | strip
%}
<section class="nova-section nova-contact-page">
  <div class="nova-shell">
    <header class="nova-page-head nova-contact-head">
      <div>
        <p class="nova-kicker">{{ 'nova.contact.kicker' | t }}</p>
        <h1 class="nova-title">{% if page != blank %}{% render 'localized-page-title', page: page %}{% else %}{{ 'nova.navigation.contact' | t }}{% endif %}</h1>
        {% if page.content != blank %}<div class="nova-copy">{{ page.content }}</div>{% else %}<p class="nova-copy">{{ 'nova.contact.intro' | t }}</p>{% endif %}
      </div>
      <div class="nova-contact-service">
        <span>{{ 'nova.contact.response_label' | t }}</span>
        <strong>{% if section.settings.response_time != blank %}{{ section.settings.response_time }}{% else %}{{ 'nova.contact.response_default' | t }}{% endif %}</strong>
      </div>
    </header>

    <div class="nova-contact-layout">
      <div class="nova-contact-form-card">
        {% form 'contact', id: 'NovaContactForm' %}
          {% if form.errors %}<div id="NovaContactFormErrors" class="nova-form-message nova-form-message--error" role="alert" aria-live="assertive"><strong>{{ 'nova.forms.error_heading' | t }}</strong><span>{{ 'nova.forms.error_copy' | t }}</span>{{ form.errors | default_errors }}</div>{% endif %}
          <div class="nova-form-grid nova-form-grid--2">
            <div><label class="nova-label" for="ContactName">{{ 'nova.contact.name' | t }}</label><input class="nova-input" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}"></div>
            <div><label class="nova-label" for="ContactEmail">{{ 'nova.contact.email' | t }}</label><input class="nova-input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required aria-required="true"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="NovaContactFormErrors"{% endif %} value="{{ form.email | default: customer.email | escape }}"></div>
            <div><label class="nova-label" for="ContactTopic">{{ 'nova.contact.topic' | t }}</label><select class="nova-select" id="ContactTopic" name="contact[Topic]"><option value="Product">{{ 'nova.contact.topic_product' | t }}</option><option value="Order">{{ 'nova.contact.topic_order' | t }}</option><option value="Return">{{ 'nova.contact.topic_return' | t }}</option><option value="Stock">{{ 'nova.contact.topic_stock' | t }}</option><option value="Other">{{ 'nova.contact.topic_other' | t }}</option></select></div>
            <div><label class="nova-label" for="ContactOrder">{{ 'nova.contact.order_number' | t }}</label><input class="nova-input" id="ContactOrder" type="text" name="contact[Order number]" placeholder="#1001"></div>
            <div><label class="nova-label" for="ContactPhone">{{ 'nova.contact.phone' | t }}</label><input class="nova-input" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone | escape }}"></div>
          </div>
          <div class="nova-contact-message"><label class="nova-label" for="ContactMessage">{{ 'nova.contact.message' | t }}</label><textarea class="nova-textarea" id="ContactMessage" name="contact[body]" required aria-required="true"{% if form.errors contains 'body' %} aria-invalid="true" aria-describedby="NovaContactFormErrors"{% endif %} placeholder="{{ 'nova.contact.message_placeholder' | t | escape }}">{{ form.body | escape }}</textarea></div>
          <button class="nova-button nova-button--primary" type="submit">{{ 'nova.contact.send' | t }}</button>
          {% if form.posted_successfully? %}<div class="nova-form-message nova-form-message--success" role="status">{{ 'nova.contact.success' | t }}</div>{% endif %}
          
        {% endform %}
      </div>

      <aside class="nova-support-panel">
        <p class="nova-kicker">{{ 'nova.contact.self_service_kicker' | t }}</p>
        <h2>{{ 'nova.contact.quick_help' | t }}</h2>
        <p class="nova-copy">{{ 'nova.contact.quick_help_copy' | t }}</p>
        <div class="nova-support-links">
          <a href="{{ nova_contact_faq_url }}"><span>{{ 'nova.footer.faq' | t }}</span><b>→</b></a>
          <a href="{{ nova_contact_tracking_url }}"><span>{{ 'nova.footer.track_order' | t }}</span><b>→</b></a>
          <a href="{{ routes.account_url }}"><span>{{ 'nova.footer.account' | t }}</span><b>→</b></a>
          <a href="{{ routes.search_url }}"><span>{{ 'nova.footer.search' | t }}</span><b>→</b></a>
        </div>
      </aside>
    </div>
  </div>
</section>
{% schema %}
{"name":"Contact form","settings":[{"type":"text","id":"response_time","label":"Response-time message"},{"type":"page","id":"faq_page","label":"FAQ page"},{"type":"page","id":"tracking_page","label":"Track-order page"}]}
{% endschema %}
