{% capture besjaar_ui_focus_capture %}{% render 'is-focus-showerhead', product: product %}{% endcapture %}
{% assign besjaar_ui_is_focus = besjaar_ui_focus_capture | strip %}
{% if settings.enable_restock_requests and besjaar_ui_is_focus == 'true' %}
{% liquid
  assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign app_count = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_count = app_count | plus: 1
    endif
  endfor
  assign show_builtin_request = section.settings.show_builtin_request
  if app_count > 0 and section.settings.hide_builtin_when_app
    assign show_builtin_request = false
  endif
%}
<section class="besjaar-ui-section besjaar-ui-restock-os" id="besjaar-ui-restock" data-restock-section {% if selected_variant.available %}hidden{% endif %}>
  <div class="besjaar-ui-shell">
    <div class="besjaar-ui-restock-os__surface">
      <div class="besjaar-ui-restock-os__intro">
        <span class="besjaar-ui-restock-os__status"><i></i>{{ 'besjaar_ui.product.out_of_stock' | t }}</span>
        <p class="besjaar-ui-kicker">{{ 'besjaar_ui.restock.kicker' | t }}</p>
        <h2>{{ 'besjaar_ui.restock.heading' | t }}</h2>
        <p>{{ 'besjaar_ui.restock.copy' | t }}</p>
        {% if section.settings.show_alternatives_link %}<button class="besjaar-ui-mini-link" type="button" data-scroll-alternatives>{{ 'besjaar_ui.restock.view_alternatives' | t }} →</button>{% endif %}
      </div>

      <div class="besjaar-ui-restock-os__actions">
        {% if app_count > 0 %}
          <div class="besjaar-ui-restock-apps">
            <div class="besjaar-ui-restock-apps__head"><strong>{{ 'besjaar_ui.restock.app_heading' | t }}</strong><span>{{ 'besjaar_ui.restock.app_copy' | t }}</span></div>
            {% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}
          </div>
        {% endif %}
        {% if show_builtin_request %}
          <div class="besjaar-ui-restock-request">
            <strong>{{ 'besjaar_ui.restock.fallback_heading' | t }}</strong>
            {% form 'contact', id: 'BesjaarUIRestockRequestForm', class: 'besjaar-ui-restock-request__form' %}
              {% if form.posted_successfully? %}<div class="besjaar-ui-form-success" role="status">✓ {{ 'besjaar_ui.restock.success' | t }}</div>{% endif %}
              {% if form.errors %}<div id="BesjaarUIRestockErrors" class="besjaar-ui-form-message besjaar-ui-form-message--error" role="alert" aria-live="assertive"><strong>{{ 'besjaar_ui.forms.error_heading' | t }}</strong>{{ form.errors | default_errors }}</div>{% endif %}
              <input type="hidden" name="contact[request_type]" value="Back in stock request">
              <input type="hidden" name="contact[product]" value="{{ product.title | escape }}">
              <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">
              <input type="hidden" name="contact[variant_id]" value="{{ selected_variant.id }}" data-restock-variant>
              <label><span>{{ 'besjaar_ui.restock.name' | t }}</span><input class="besjaar-ui-input" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}"></label>
              <label><span>{{ 'besjaar_ui.restock.email' | t }}</span><input class="besjaar-ui-input" type="email" name="contact[email]" autocomplete="email" required aria-required="true"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="BesjaarUIRestockErrors"{% endif %} value="{{ form.email | default: customer.email | escape }}"></label>
              <button class="besjaar-ui-button besjaar-ui-button--primary" type="submit">{{ 'besjaar_ui.restock.submit' | t }}</button>
            {% endform %}
            <small>{{ 'besjaar_ui.restock.privacy' | t }}</small>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{
  "name":"Back in stock",
  "settings":[
    {"type":"checkbox","id":"show_builtin_request","label":"Show built-in restock interest form","default":true},
    {"type":"checkbox","id":"hide_builtin_when_app","label":"Hide built-in form when a restock app block is connected","default":true},
    {"type":"checkbox","id":"show_alternatives_link","label":"Link to available alternatives","default":true},
    {"type":"paragraph","content":"The built-in form sends a genuine contact request to the store. For automatic inventory-triggered emails, add a compatible back-in-stock app block and optionally disable the built-in form."}
  ],
  "blocks":[{"type":"@app"}],
  "presets":[{"name":"Back in stock"}]
}
{% endschema %}
