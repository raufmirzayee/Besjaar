{% capture nova_focus_capture %}{% render 'is-focus-showerhead', product: product %}{% endcapture %}
{% assign nova_is_focus = nova_focus_capture | strip %}
{% if settings.enable_product_qa and nova_is_focus == 'true' %}
{% liquid
  assign qa_count = 0
  assign app_count = 0
  for block in section.blocks
    if block.type == 'question_answer' and block.settings.question != blank and block.settings.answer != blank
      assign qa_count = qa_count | plus: 1
    elsif block.type == '@app'
      assign app_count = app_count | plus: 1
    endif
  endfor
%}
<section class="nova-section nova-product-qa" id="nova-product-qa" data-reveal>
  <div class="nova-shell">
    <div class="nova-heading-row nova-product-qa__head">
      <div><p class="nova-kicker">{{ 'nova.qa.kicker' | t }}</p><h2 class="nova-title">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'nova.qa.heading' | t }}{% endif %}</h2><p class="nova-copy">{{ 'nova.qa.copy' | t }}</p></div>
      {% if qa_count > 0 %}<span class="nova-qa-count">{{ qa_count }}</span>{% endif %}
    </div>

    <div class="nova-product-qa__layout">
      <div class="nova-product-qa__answers">
        {% if qa_count > 0 %}
          <div class="nova-qa-list">
            {% for block in section.blocks %}
              {% if block.type != 'question_answer' or block.settings.question == blank or block.settings.answer == blank %}{% continue %}{% endif %}
              <details class="nova-qa-item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
                <summary><span>{{ block.settings.question }}</span><i>+</i></summary>
                <div class="nova-qa-item__answer"><small>{{ 'nova.qa.merchant_answer' | t }}</small><div class="nova-content">{{ block.settings.answer }}</div></div>
              </details>
            {% endfor %}
          </div>
        {% else %}
          <div class="nova-qa-empty"><span aria-hidden="true">?</span><p>{{ 'nova.qa.empty' | t }}</p></div>
        {% endif %}

        {% if app_count > 0 %}
          <div class="nova-qa-apps"><p class="nova-kicker">{{ 'nova.qa.app_heading' | t }}</p>{% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}</div>
        {% endif %}
      </div>

      {% if section.settings.enable_question_form %}
        <aside class="nova-qa-form-card">
          <span class="nova-qa-form-card__icon" aria-hidden="true">?</span>
          <h3>{{ 'nova.qa.ask_heading' | t }}</h3>
          <p>{{ 'nova.qa.ask_copy' | t }}</p>
          {% form 'contact', id: 'NovaProductQuestionForm', class: 'nova-qa-form' %}
            {% if form.posted_successfully? %}<div class="nova-form-success" role="status">✓ {{ 'nova.qa.success' | t }}</div>{% endif %}
            {% if form.errors %}<div id="NovaProductQuestionErrors" class="nova-form-message nova-form-message--error" role="alert" aria-live="assertive"><strong>{{ 'nova.forms.error_heading' | t }}</strong><span>{{ 'nova.qa.error' | t }}</span>{{ form.errors | default_errors }}</div>{% endif %}
            <input type="hidden" name="contact[request_type]" value="Product question">
            <input type="hidden" name="contact[product]" value="{{ product.title | escape }}">
            <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">
            <input type="hidden" name="contact[variant_id]" value="{{ product.selected_or_first_available_variant.id }}" data-qa-variant>
            <label><span>{{ 'nova.qa.name' | t }}</span><input class="nova-input" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}"></label>
            <label><span>{{ 'nova.qa.email' | t }}</span><input class="nova-input" type="email" name="contact[email]" autocomplete="email" required aria-required="true"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="NovaProductQuestionErrors"{% endif %} value="{{ form.email | default: customer.email | escape }}"></label>
            <label><span>{{ 'nova.qa.question' | t }}</span><textarea class="nova-textarea" name="contact[question]" required aria-required="true" placeholder="{{ 'nova.qa.question_placeholder' | t | escape }}">{{ form.question | escape }}</textarea></label>
            <button class="nova-button nova-button--primary" type="submit">{{ 'nova.qa.submit' | t }}</button>
          {% endform %}
        </aside>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{
  "name":"Product Q&A",
  "settings":[
    {"type":"text","id":"heading","label":"Optional custom heading"},
    {"type":"checkbox","id":"enable_question_form","label":"Allow customers to send product questions","default":true}
  ],
  "blocks":[
    {"type":"question_answer","name":"Question & answer","settings":[
      {"type":"text","id":"question","label":"Question"},
      {"type":"richtext","id":"answer","label":"Answer"}
    ]},
    {"type":"@app"}
  ],
  "presets":[{"name":"Product Q&A"}]
}
{% endschema %}
