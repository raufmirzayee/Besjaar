      </form>
      <nav class="besjaar-ui-nojs-tools__links" aria-label="{{ 'besjaar_ui.accessibility.mobile_navigation' | t | escape }}">
        <a href="{% render 'localized-internal-url', url: besjaar_ui_shower_url %}">{{ 'besjaar_ui.shower_store.nav.shop' | t }}</a>
        <a href="{{ routes.root_url }}#besjaar-store-details">{{ 'besjaar_ui.shower_store.nav.guide' | t }}</a>
        <a href="{{ besjaar_ui_reviews_url }}">{{ 'besjaar_ui.shower_store.nav.reviews' | t }}</a>
        <a href="{{ besjaar_ui_about_url }}">{{ 'besjaar_ui.shower_store.nav.about' | t }}</a>
        <a href="{{ besjaar_ui_faq_url }}">{{ 'besjaar_ui.shower_store.nav.faq' | t }}</a>
        <a href="{{ besjaar_ui_contact_url }}">{{ 'besjaar_ui.shower_store.nav.contact' | t }}</a>
