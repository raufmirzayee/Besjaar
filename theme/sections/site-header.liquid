      <a href="{{ besjaar_ui_contact_url }}"{% if besjaar_ui_contact_current %} aria-current="page"{% endif %}>{{ 'besjaar_ui.shower_store.nav.contact' | t }}</a>
      <a href="{{ besjaar_ui_track_url }}"{% if besjaar_ui_track_current %} aria-current="page"{% endif %}>{{ 'besjaar_ui.shower_store.nav.track' | t }}</a>
