      <form class="besjaar-ui-nojs-search" action="{{ routes.search_url }}" method="get" role="search">
        <label class="besjaar-ui-visually-hidden" for="BesjaarUINoJsSearch-{{ section.id }}">{{ 'besjaar_ui.accessibility.search' | t }}</label>
        <input class="besjaar-ui-input" id="BesjaarUINoJsSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'besjaar_ui.header.search_placeholder' | t }}" required>
        <input name="type" type="hidden" value="product">
        <input name="options[prefix]" type="hidden" value="last">
