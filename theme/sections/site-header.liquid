{% capture besjaar_ui_cart_range_json %}
[
  {% assign besjaar_ui_cart_range_count = 0 %}
  {% for besjaar_ui_cart_product in collections['all'].products limit: 50 %}
    {% if besjaar_ui_cart_range_count >= 12 %}{% break %}{% endif %}
    {% capture besjaar_ui_cart_is_focus_capture %}{% render 'is-focus-showerhead', product: besjaar_ui_cart_product %}{% endcapture %}
    {% assign besjaar_ui_cart_is_focus = besjaar_ui_cart_is_focus_capture | strip %}
    {% if besjaar_ui_cart_is_focus == 'true' and besjaar_ui_cart_product.available %}
      {% assign besjaar_ui_cart_variant = besjaar_ui_cart_product.selected_or_first_available_variant %}
      {% if besjaar_ui_cart_variant != blank %}
        {% capture besjaar_ui_cart_product_url %}{% render 'localized-internal-url', url: besjaar_ui_cart_product.url %}{% endcapture %}
        {% if besjaar_ui_cart_range_count > 0 %},{% endif %}
        {
          "id": {{ besjaar_ui_cart_product.id | json }},
          "title": {{ besjaar_ui_cart_product.title | json }},
          "url": {{ besjaar_ui_cart_product_url | strip | json }},
          "image": {% if besjaar_ui_cart_product.featured_image %}{{ besjaar_ui_cart_product.featured_image | image_url: width: 180 | json }}{% else %}""{% endif %},
          "price": {{ besjaar_ui_cart_product.price | json }},
          "variantId": {{ besjaar_ui_cart_variant.id | json }}
        }
        {% assign besjaar_ui_cart_range_count = besjaar_ui_cart_range_count | plus: 1 %}
      {% endif %}
    {% endif %}
  {% endfor %}
]
{% endcapture %}
<script type="application/json" data-besjaar-ui-cart-range>{{ besjaar_ui_cart_range_json | strip }}</script>

{% capture besjaar_ui_cart_addons_json %}
[
  {% assign besjaar_ui_cart_addon_count = 0 %}
  {% for besjaar_ui_addon_index in (1..3) %}
    {% case besjaar_ui_addon_index %}{% when 1 %}{% assign besjaar_ui_cart_addon = settings.bundle_accessory_1 %}{% when 2 %}{% assign besjaar_ui_cart_addon = settings.bundle_accessory_2 %}{% else %}{% assign besjaar_ui_cart_addon = settings.bundle_accessory_3 %}{% endcase %}
    {% capture besjaar_ui_cart_addon_is_head_capture %}{% render 'is-shower-head', product: besjaar_ui_cart_addon %}{% endcapture %}
    {% assign besjaar_ui_cart_addon_is_head = besjaar_ui_cart_addon_is_head_capture | strip %}
    {% if besjaar_ui_cart_addon != blank and besjaar_ui_cart_addon.available and besjaar_ui_cart_addon_is_head != 'true' %}
      {% assign besjaar_ui_cart_addon_duplicate = false %}
      {% if besjaar_ui_addon_index == 2 and besjaar_ui_cart_addon.id == settings.bundle_accessory_1.id %}{% assign besjaar_ui_cart_addon_duplicate = true %}{% endif %}
      {% if besjaar_ui_addon_index == 3 %}{% if besjaar_ui_cart_addon.id == settings.bundle_accessory_1.id or besjaar_ui_cart_addon.id == settings.bundle_accessory_2.id %}{% assign besjaar_ui_cart_addon_duplicate = true %}{% endif %}{% endif %}
      {% unless besjaar_ui_cart_addon_duplicate %}
        {% assign besjaar_ui_cart_addon_variant = besjaar_ui_cart_addon.selected_or_first_available_variant %}
        {% capture besjaar_ui_cart_addon_url %}{% render 'localized-internal-url', url: besjaar_ui_cart_addon.url %}{% endcapture %}
        {% if besjaar_ui_cart_addon_count > 0 %},{% endif %}
        {
          "id": {{ besjaar_ui_cart_addon.id | json }},
          "title": {{ besjaar_ui_cart_addon.title | json }},
          "url": {{ besjaar_ui_cart_addon_url | strip | json }},
          "image": {% if besjaar_ui_cart_addon.featured_image %}{{ besjaar_ui_cart_addon.featured_image | image_url: width: 180 | json }}{% else %}""{% endif %},
          "price": {{ besjaar_ui_cart_addon_variant.price | json }},
          "variantId": {{ besjaar_ui_cart_addon_variant.id | json }}
        }
        {% assign besjaar_ui_cart_addon_count = besjaar_ui_cart_addon_count | plus: 1 %}
      {% endunless %}
    {% endif %}
  {% endfor %}
]
{% endcapture %}
<script type="application/json" data-besjaar-ui-cart-addons>{{ besjaar_ui_cart_addons_json | strip }}</script>

<div class="besjaar-ui-drawer-backdrop" data-drawer-backdrop aria-hidden="true"></div>
<aside class="besjaar-ui-drawer besjaar-ui-drawer--cart" id="BesjaarUICartDrawer" data-drawer="cart" role="dialog" aria-modal="true" aria-labelledby="BesjaarUICartDrawerTitle" tabindex="-1" aria-hidden="true" inert>
  <div class="besjaar-ui-drawer__head"><div><p class="besjaar-ui-kicker">BESJAAR / {{ 'besjaar_ui.catalog.cart' | t }}</p><h2 id="BesjaarUICartDrawerTitle">{{ 'besjaar_ui.header.cart_title' | t }} <span class="besjaar-ui-cart-drawer__count" data-cart-count aria-label="{{ 'besjaar_ui.cart.items_kicker' | t: count: cart.item_count | escape }}">{{ cart.item_count }}</span></h2></div><button class="besjaar-ui-drawer__close" type="button" data-close-drawer aria-label="{{ 'besjaar_ui.accessibility.close' | t }}">×</button></div>
  {% if settings.show_free_shipping_bar and besjaar_ui_free_shipping_threshold_cents > 0 %}
    <div class="besjaar-ui-cart-drawer__shipping-progress besjaar-ui-free-shipping" data-free-shipping aria-label="{{ 'besjaar_ui.cart.free_shipping_progress' | t | escape }}">
      <div class="besjaar-ui-free-shipping__row"><span data-free-shipping-text aria-live="polite"></span><strong>{{ besjaar_ui_free_shipping_threshold_money }}</strong></div>
      <div class="besjaar-ui-free-shipping__track" data-free-shipping-track role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i data-free-shipping-progress></i></div>
    </div>
  {% endif %}
  {%- comment -%}Besjaar 11.6: no aria-live on the full drawer body — re-rendering every line made screen readers announce the entire cart after each quantity tap. The totals/discount nodes below keep their own aria-live for the meaningful outcome.{%- endcomment -%}
  <div class="besjaar-ui-drawer__body" data-cart-drawer-body aria-busy="false"></div>
  <div class="besjaar-ui-cart-drawer__upsell" data-cart-drawer-upsell hidden></div>
  <div class="besjaar-ui-drawer__foot besjaar-ui-cart-drawer__foot" data-cart-drawer-foot{% if cart.item_count == 0 %} hidden{% endif %}>
    <div class="besjaar-ui-cart-drawer__discount" data-cart-drawer-discount hidden aria-live="polite"></div>
    <div class="besjaar-ui-cart__total"><span>{{ 'besjaar_ui.cart.estimated_total' | t }}</span><strong data-cart-drawer-total aria-live="polite">{{ cart.total_price | money }}</strong></div>
    <div class="besjaar-ui-cart-drawer__actions"><a class="besjaar-ui-button besjaar-ui-button--ghost" href="{{ routes.cart_url }}">{{ 'besjaar_ui.header.view_cart' | t }}</a><form action="{{ routes.cart_url }}" method="post" data-cart-checkout-form><input type="hidden" name="checkout" value="Checkout"><button class="besjaar-ui-button besjaar-ui-button--primary" type="submit" name="checkout" value="Checkout" data-cart-drawer-checkout>{{ 'besjaar_ui.cart.drawer_checkout' | t }}</button></form></div>
    <div class="besjaar-ui-cart-drawer__benefits" aria-label="{{ 'besjaar_ui.product.purchase_confidence' | t | escape }}">
      {% if besjaar_ui_free_shipping_threshold_cents > 0 %}
        <span class="besjaar-ui-cart-drawer__benefit-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h3l4 4v2h-7zM6 18a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 18a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg><small>{{ 'besjaar_ui.product.free_shipping_from' | t: amount: besjaar_ui_free_shipping_threshold_money }}</small></span>
      {% endif %}
      <span class="besjaar-ui-cart-drawer__benefit-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 7 8-4 8 4-8 4-8-4Zm0 0v10l8 4 8-4V7M12 11v10"/></svg><small>{{ 'besjaar_ui.product.returns_days' | t: days: settings.return_window_days }}</small></span>
      <span class="besjaar-ui-cart-drawer__benefit-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7a5 5 0 0 1 10 0v3M5 10h14v11H5zM12 14v3"/></svg><small>{{ 'besjaar_ui.cart.secure_checkout_note' | t }}</small></span>
    </div>
    {% if shop.enabled_payment_types.size > 0 %}
      <div class="besjaar-ui-payments besjaar-ui-cart-drawer__payments" aria-label="{{ 'besjaar_ui.footer.payments_label' | t | escape }}">
        {% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}
      </div>
    {% endif %}
    <p class="besjaar-ui-cart-drawer__secure"><span aria-hidden="true">⌁</span> {{ 'besjaar_ui.cart.secure_checkout_note' | t }}</p>
    <p class="besjaar-ui-cart-drawer__assurance">{{ 'besjaar_ui.cart.drawer_assurance' | t: days: settings.return_window_days }}</p>
    {% render 'delivery-promise', context: 'drawer' %}
    {% if settings.show_account_cart_prompt and shop.customer_accounts_enabled %}
      <div class="besjaar-ui-cart-account">
        {% if customer %}
          <div><span class="besjaar-ui-cart-account__icon">✓</span><p><strong>{{ 'besjaar_ui.account.cart_signed_in' | t }}</strong><small>{{ customer.email | escape }}</small></p></div>
          <a href="{{ routes.account_url }}">{{ 'besjaar_ui.header.my_account' | t }} →</a>
        {% else %}
          <div><span class="besjaar-ui-cart-account__icon">○</span><p><strong>{{ 'besjaar_ui.account.cart_account_title' | t }}</strong><small>{{ 'besjaar_ui.account.cart_account_copy' | t }}</small></p></div>
          <a href="{{ routes.account_login_url }}" rel="nofollow">{{ 'besjaar_ui.header.sign_in' | t }} →</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</aside>

{% if settings.show_mobile_bottom_nav %}
<nav class="besjaar-ui-bottom-nav besjaar-ui-bottom-nav--v21 besjaar-ui-bottom-nav--v33" aria-label="{{ 'besjaar_ui.accessibility.mobile_navigation' | t | escape }}">
  <a href="{{ routes.root_url }}"{% if request.page_type == 'index' %} class="is-active" aria-current="page"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m3 11 9-8 9 8v10H6a3 3 0 0 1-3-3Z"/><path d="M9 21v-7h6v7"/></svg><span>{{ 'besjaar_ui.header.home' | t }}</span></a>
  <a href="{% render 'localized-internal-url', url: besjaar_ui_shower_url %}"{% if request.page_type == 'collection' or request.page_type == 'product' or request.page_type == 'list-collections' %} class="is-active" aria-current="page"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></svg><span>{{ 'besjaar_ui.header.shop' | t }}</span></a>
  <button type="button" data-search-toggle aria-expanded="false" aria-haspopup="dialog" aria-controls="BesjaarUISearchPanel-{{ section.id }}"{% if request.page_type == 'search' %} class="is-active" aria-current="page"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg><span>{{ 'besjaar_ui.header.search_short' | t }}</span></button>
  <button type="button" data-open-drawer="cart" aria-haspopup="dialog" aria-controls="BesjaarUICartDrawer"{% if request.page_type == 'cart' %} class="is-active" aria-current="page"{% endif %}><span class="besjaar-ui-bottom-nav__count" data-cart-count>{{ cart.item_count }}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 4h2l2.2 10.1a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L20.5 7H6"/></svg><span>{{ 'besjaar_ui.header.cart_short' | t }}</span></button>
</nav>
{% endif %}

{% schema %}
{
  "name":"Header",
  "settings":[
    {"type":"checkbox","id":"show_announcement","label":"Show announcement","default":true},
    {"type":"checkbox","id":"use_localized_announcement","label":"Use automatic localized announcement (EN / NL / DE / FR)","default":true},
    {"type":"text","id":"announcement","label":"Custom announcement","default":"GRATIS VERZENDING IN NL VANAF €25 — BESJAAR DOUCHEKOPPEN, DUIDELIJK VERGELEKEN"},
    {"type":"text","id":"announcement_mobile","label":"Custom mobile announcement","default":"GRATIS NL VERZENDING VANAF €25","info":"Keep this short so it stays readable on small screens."},
    {"type":"url","id":"announcement_link","label":"Announcement link"},
    {"type":"text","id":"announcement_discount_code","label":"Optional real discount code","info":"Only enter a code that already exists in Shopify."},
    {"type":"text","id":"announcement_start_at","label":"Campaign start (ISO 8601)"},
    {"type":"text","id":"announcement_end_at","label":"Campaign end (ISO 8601)"},
    {"type":"checkbox","id":"announcement_show_countdown","label":"Countdown when end is set","default":false},
    {"type":"image_picker","id":"logo","label":"Logo"},
    {"type":"product","id":"mega_featured_product","label":"Mega menu featured product","info":"Optional. Leave blank for the compact catalog-only menu."},
    {"type":"checkbox","id":"use_shopify_account_component","label":"Use modern Shopify customer account component","default":true},
    {"type":"link_list","id":"customer_account_menu","label":"Customer account menu","default":"customer-account-main-menu"}
  ]
}
{% endschema %}
