{% liquid
  assign threshold_cents = settings.free_shipping_threshold | times: 100
  assign shipping_remaining = threshold_cents | minus: cart.total_price
  if shipping_remaining < 0
    assign shipping_remaining = 0
  endif
  assign shipping_percent = 100
  assign shipping_remaining_money = shipping_remaining | money
  assign threshold_money = threshold_cents | money_without_trailing_zeros
  if threshold_cents > 0 and cart.total_price < threshold_cents
    assign shipping_percent = cart.total_price | times: 100 | divided_by: threshold_cents
  endif
%}
{% capture nova_focused_shop_url %}{% render 'shower-store-url' %}{% endcapture %}

<section class="nova-section nova-cart-page">
  <div class="nova-shell">
    <header class="nova-page-head"><p class="nova-kicker">{{ 'nova.cart.items_kicker' | t: count: cart.item_count }}</p><h1 class="nova-title">{{ 'nova.cart.title' | t }}</h1></header>
    {% if cart.item_count == 0 %}
      <div class="nova-empty"><p>{{ 'nova.cart.empty' | t }}</p><a class="nova-button nova-button--primary" href="{{ nova_focused_shop_url | strip }}">{{ 'nova.cart.shop_products' | t }}</a></div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" class="nova-cart" data-cart-page-form>
        <div class="nova-cart__items">
          {% for item in cart.items %}
            <div class="nova-cart-item" data-cart-page-line data-cart-line-key="{{ item.key | escape }}">
              {% if item.image %}<a class="nova-cart-item__media" href="{% render 'localized-internal-url', url: item.url %}">{{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: item.product.title }}</a>{% endif %}
              <div class="nova-cart-item__info">
                <h3><a href="{% render 'localized-internal-url', url: item.url %}">{% render 'localized-product-title', product: item.product %}</a></h3>
                {% unless item.variant.title == 'Default Title' %}<p class="nova-copy">{{ item.variant.title }}</p>{% endunless %}
                {% if item.selling_plan_allocation %}<p class="nova-selling-plan-line">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
                {% for property in item.properties %}
                  {% assign property_first = property.first | slice: 0 %}
                  {% unless property.last == blank or property_first == '_' %}
                    <p class="nova-line-property"><span>{{ property.first | escape }}:</span> {% if property.last contains '/uploads/' %}<a href="{{ property.last | escape }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last | escape }}<span class="nova-visually-hidden"> ({{ 'nova.accessibility.opens_new_tab' | t }})</span></a>{% else %}{{ property.last | escape }}{% endif %}</p>
                  {% endunless %}
                {% endfor %}
                <a class="nova-mini-link" href="{% render 'localized-internal-url', url: item.url_to_remove %}" data-cart-page-remove>{{ 'nova.cart.remove' | t }}</a>
              </div>
              <div class="nova-cart-item__commerce"><div class="nova-line-quantity"><button type="button" data-cart-page-minus aria-label="{{ 'nova.js.decrease' | t | escape }}">−</button><input class="nova-input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" enterkeyhint="done" aria-label="{{ 'nova.product.quantity' | t | escape }}" data-cart-page-quantity><button type="button" data-cart-page-plus aria-label="{{ 'nova.js.increase' | t | escape }}">+</button></div><div><div class="nova-price" data-cart-page-line-price>{{ item.final_line_price | money }}</div>{% if item.unit_price_measurement %}<small class="nova-unit-price">{{ item.unit_price | money | unit_price_with_measurement: item.unit_price_measurement }}</small>{% endif %}</div></div>
            </div>
          {% endfor %}
          <button class="nova-button nova-button--ghost nova-cart__update-fallback" type="submit" name="update">{{ 'nova.cart.update' | t }}</button><p class="nova-cart-page__status" data-cart-page-status role="status" aria-live="polite" aria-atomic="true"></p>
        </div>
        <aside class="nova-cart__summary">
          <p class="nova-kicker">{{ 'nova.cart.summary' | t }}</p>
          {% if settings.show_free_shipping_bar and threshold_cents > 0 %}<div class="nova-free-shipping nova-free-shipping--page" data-cart-page-free-shipping aria-label="{{ 'nova.cart.free_shipping_progress' | t | escape }}"><div class="nova-free-shipping__row"><span data-cart-page-free-shipping-text>{% if shipping_remaining > 0 %}{{ 'nova.cart.free_shipping_remaining' | t: amount: shipping_remaining_money }}{% else %}{{ 'nova.cart.free_shipping_unlocked' | t }}{% endif %}</span><strong>{{ threshold_money }}</strong></div><div class="nova-free-shipping__track" data-cart-page-free-shipping-track role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ shipping_percent }}"><i data-cart-page-free-shipping-progress style="width:{{ shipping_percent }}%"></i></div><small class="nova-free-shipping__checkout-note">{{ 'nova.cart.shipping_checkout_note' | t }}</small></div>{% endif %}
          <div class="nova-cart-savings" data-cart-page-savings{% unless cart.total_discount > 0 %} hidden{% endunless %}><span>{{ 'nova.cart.savings' | t }}</span><strong data-cart-page-savings-amount>{% if cart.total_discount > 0 %}−{{ cart.total_discount | money }}{% endif %}</strong></div>
          <div class="nova-cart__total"><span>{{ 'nova.cart.total' | t }}</span><span data-cart-page-total>{{ cart.total_price | money }}</span></div><p class="nova-copy">{{ 'nova.cart.taxes_shipping' | t }}</p>
          {% render 'delivery-promise', context: 'cart' %}
          {% if settings.show_account_cart_prompt and shop.customer_accounts_enabled %}
            <div class="nova-cart-account nova-cart-account--page">
              {% if customer %}
                <div><span class="nova-cart-account__icon">✓</span><p><strong>{{ 'nova.account.cart_signed_in' | t }}</strong><small>{{ customer.email | escape }}</small></p></div>
                <a href="{{ routes.account_url }}">{{ 'nova.header.my_account' | t }} →</a>
              {% else %}
                <div><span class="nova-cart-account__icon">○</span><p><strong>{{ 'nova.account.cart_account_title' | t }}</strong><small>{{ 'nova.account.cart_account_copy' | t }}</small></p></div>
                <a href="{{ routes.account_login_url }}" rel="nofollow">{{ 'nova.header.sign_in' | t }} →</a>
              {% endif %}
            </div>
          {% endif %}
          <button class="nova-button nova-button--primary" style="width:100%" type="submit" name="checkout" value="Checkout" data-cart-page-checkout>{{ 'nova.cart.checkout' | t }}</button>
        </aside>
      </form>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
