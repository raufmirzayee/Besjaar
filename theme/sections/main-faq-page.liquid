        </div>
      </section>

      <section class="nova-faq-group" id="faq-ordering" data-faq-group data-reveal>
        <header class="nova-faq-group__head">
          <span>02</span>
          <div><p>{{ 'nova.faq_general.topic_ordering' | t }}</p><h2>{{ 'nova.faq_general.ordering_heading' | t }}</h2></div>
        </header>
        <div class="nova-product-v16__accordion nova-faq-page__accordion">
          <details data-faq-item><summary><b aria-hidden="true">05</b><span>{{ 'nova.faq_general.q6' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a6' | t }}</p></div></details>
          <details data-faq-item><summary><b aria-hidden="true">06</b><span>{{ 'nova.faq_general.q7' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a7' | t }}</p></div></details>
          <details data-faq-item><summary><b aria-hidden="true">07</b><span>{{ 'nova.faq_general.q11' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a11' | t }}</p></div></details>
          <details data-faq-item><summary><b aria-hidden="true">08</b><span>{{ 'nova.faq_general.q12' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a12' | t }}</p></div></details>
        </div>
      </section>

      <section class="nova-faq-group" id="faq-care" data-faq-group data-reveal>
        <header class="nova-faq-group__head">
          <span>03</span>
          <div><p>{{ 'nova.faq_general.topic_care' | t }}</p><h2>{{ 'nova.faq_general.care_heading' | t }}</h2></div>
        </header>
        <div class="nova-product-v16__accordion nova-faq-page__accordion">
          <details data-faq-item><summary><b aria-hidden="true">09</b><span>{{ 'nova.faq_general.q9' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a9' | t }}</p></div></details>
          <details data-faq-item><summary><b aria-hidden="true">10</b><span>{{ 'nova.faq_general.q10' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a10' | t }}</p></div></details>
        </div>
      </section>

      <section class="nova-faq-group" id="faq-service" data-faq-group data-reveal>
        <header class="nova-faq-group__head">
          <span>04</span>
          <div><p>{{ 'nova.faq_general.topic_service' | t }}</p><h2>{{ 'nova.faq_general.service_heading' | t }}</h2></div>
        </header>
        <div class="nova-product-v16__accordion nova-faq-page__accordion">
          <details data-faq-item><summary><b aria-hidden="true">11</b><span>{{ 'nova.faq_general.q5' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a5' | t }}</p></div></details>
          <details data-faq-item><summary><b aria-hidden="true">12</b><span>{{ 'nova.faq_general.q8' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a8' | t }}</p></div></details>
        </div>
      </section>
    </div>

    <div class="nova-faq-no-results" data-faq-no-results hidden>
      <span aria-hidden="true">?</span>
      <div><strong>{{ 'nova.faq_general.search_no_results_title' | t }}</strong><p>{{ 'nova.faq_general.search_no_results_copy' | t }}</p></div>
      <a class="nova-button nova-button--ghost" href="{{ nova_contact_url }}">{{ 'nova.faq_general.contact_cta' | t }}</a>
    </div>

    <div class="nova-faq-page__help" data-reveal>
      <div><span>{{ 'nova.faq_general.help_kicker' | t }}</span><strong>{{ 'nova.faq_general.help_title' | t }}</strong><p>{{ 'nova.faq_general.help_copy' | t }}</p></div>
      <div class="nova-faq-page__help-actions">
        <a class="nova-button nova-button--primary" href="{{ nova_contact_url }}">{{ 'nova.faq_general.contact_cta' | t }}</a>
        <a class="nova-button nova-button--ghost" href="{{ nova_tracking_url }}">{{ 'nova.faq_general.track_cta' | t }} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>

