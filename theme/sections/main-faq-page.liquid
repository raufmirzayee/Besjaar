      <div class="besjaar-ui-faq-search__control">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
        <input id="BesjaarUIFaqSearch-{{ section.id }}" type="search" autocomplete="off" spellcheck="false" placeholder="{{ 'besjaar_ui.faq_general.search_placeholder' | t | escape }}" aria-describedby="BesjaarUIFaqSearchHint-{{ section.id }} BesjaarUIFaqSearchStatus-{{ section.id }}" data-faq-search>
        <button type="button" class="besjaar-ui-faq-search__clear" aria-label="{{ 'besjaar_ui.faq_general.search_clear' | t | escape }}" data-faq-clear hidden>×</button>
      </div>
      <div class="besjaar-ui-faq-search__meta">
        <span id="BesjaarUIFaqSearchHint-{{ section.id }}">{{ 'besjaar_ui.faq_general.search_hint' | t }}</span>
        <strong id="BesjaarUIFaqSearchStatus-{{ section.id }}" role="status" aria-live="polite" data-faq-status></strong>
      </div>
    </div>

