{% liquid
  assign nova_contact_page = settings.contact_page
  if nova_contact_page == blank
    assign nova_contact_page = pages['contact']
  endif
  if nova_contact_page == blank
    assign nova_contact_page = pages['contact-us']
  endif
  capture nova_contact_url
    if nova_contact_page != blank
      render 'localized-internal-url', url: nova_contact_page.url
    else
      render 'localized-internal-url', url: '/pages/contact'
    endif
  endcapture
  assign nova_contact_url = nova_contact_url | strip

  assign nova_tracking_page = settings.tracking_page
  if nova_tracking_page == blank
    assign nova_tracking_page = pages['track-order']
  endif
  if nova_tracking_page == blank
    assign nova_tracking_page = pages['tracking']
  endif
  capture nova_tracking_url
    if nova_tracking_page != blank
      render 'localized-internal-url', url: nova_tracking_page.url
    else
      render 'localized-internal-url', url: '/apps/parcelpanel'
    endif
  endcapture
  assign nova_tracking_url = nova_tracking_url | strip
%}
<section class="nova-section nova-faq-page nova-faq-page--dedicated" data-nova-faq-page data-result-singular="{{ 'nova.faq_general.search_result_singular' | t | escape }}" data-result-plural="{{ 'nova.faq_general.search_result_plural' | t | escape }}">
  <div class="nova-shell">
    <header class="nova-faq-page__hero">
      <div>
        <p class="nova-kicker">{{ 'nova.faq_general.kicker' | t }}</p>
        <h1>{{ 'nova.faq_general.title' | t }}</h1>
        <p>{{ 'nova.faq_general.intro' | t }}</p>
      </div>
      <div class="nova-faq-page__hero-mark" aria-hidden="true">
        <span>?</span>
        <small>BESJAAR</small>
      </div>
    </header>

    <div class="nova-faq-search" role="search">
      <label class="nova-faq-search__label" for="NovaFaqSearch-{{ section.id }}">{{ 'nova.faq_general.search_label' | t }}</label>
      <div class="nova-faq-search__control">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
        <input id="NovaFaqSearch-{{ section.id }}" type="search" autocomplete="off" spellcheck="false" placeholder="{{ 'nova.faq_general.search_placeholder' | t | escape }}" aria-describedby="NovaFaqSearchHint-{{ section.id }} NovaFaqSearchStatus-{{ section.id }}" data-faq-search>
        <button type="button" class="nova-faq-search__clear" aria-label="{{ 'nova.faq_general.search_clear' | t | escape }}" data-faq-clear hidden>×</button>
      </div>
      <div class="nova-faq-search__meta">
        <span id="NovaFaqSearchHint-{{ section.id }}">{{ 'nova.faq_general.search_hint' | t }}</span>
        <strong id="NovaFaqSearchStatus-{{ section.id }}" role="status" aria-live="polite" data-faq-status></strong>
      </div>
    </div>

    <nav class="nova-faq-page__topics" aria-label="{{ 'nova.faq_general.topics_label' | t | escape }}">
      <a href="#faq-products">{{ 'nova.faq_general.topic_products' | t }}</a>
      <a href="#faq-ordering">{{ 'nova.faq_general.topic_ordering' | t }}</a>
      <a href="#faq-care">{{ 'nova.faq_general.topic_care' | t }}</a>
      <a href="#faq-service">{{ 'nova.faq_general.topic_service' | t }}</a>
    </nav>

    <div class="nova-faq-page__groups">
      <section class="nova-faq-group" id="faq-products" data-faq-group data-reveal>
        <header class="nova-faq-group__head">
          <span>01</span>
          <div><p>{{ 'nova.faq_general.topic_products' | t }}</p><h2>{{ 'nova.faq_general.products_heading' | t }}</h2></div>
        </header>
        <div class="nova-product-v16__accordion nova-faq-page__accordion">
          <details open data-faq-item><summary><b aria-hidden="true">01</b><span>{{ 'nova.faq_general.q1' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a1' | t }}</p></div></details>
          <details data-faq-item><summary><b aria-hidden="true">02</b><span>{{ 'nova.faq_general.q2' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a2' | t }}</p></div></details>
          <details data-faq-item><summary><b aria-hidden="true">03</b><span>{{ 'nova.faq_general.q3' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a3' | t }}</p></div></details>
