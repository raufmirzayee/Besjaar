{%- comment -%}
  Besjaar 2026-09-22: guide article layout. Breadcrumb, meta line (blog,
  date, reading time), calmer title, lede from the excerpt, optional hero
  image, "In deze gids" table of contents built from the h2s, readable body
  typography, a shop call-to-action card and "Meer gidsen" cards. Labels
  for nl/en/de/fr come from the locale files or the case below.
{%- endcomment -%}
{%- liquid
  assign article_lang = request.locale.iso_code | split: '-' | first | downcase
  case article_lang
    when 'en'
      assign article_more_label = 'More guides'
      assign article_shop_label = 'Shop Besjaar shower heads'
      assign article_read_label = 'min read'
      assign article_toc_label = 'In this guide'
      assign article_cta_kicker = 'Besjaar shower heads'
      assign article_cta_title = 'Ready for a better shower?'
      assign article_cta_copy = 'Water-saving, high pressure, with or without filter. Fitted yourself in five minutes.'
    when 'de'
      assign article_more_label = 'Weitere Ratgeber'
      assign article_shop_label = 'Besjaar Duschköpfe ansehen'
      assign article_read_label = 'Min. Lesezeit'
      assign article_toc_label = 'In diesem Ratgeber'
      assign article_cta_kicker = 'Besjaar Duschköpfe'
      assign article_cta_title = 'Bereit für eine bessere Dusche?'
      assign article_cta_copy = 'Wassersparend, hoher Druck, mit oder ohne Filter. In fünf Minuten selbst montiert.'
    when 'fr'
      assign article_more_label = 'Autres guides'
      assign article_shop_label = 'Voir les pommeaux Besjaar'
      assign article_read_label = 'min de lecture'
      assign article_toc_label = 'Dans ce guide'
      assign article_cta_kicker = 'Pommeaux Besjaar'
      assign article_cta_title = 'Prêt pour une meilleure douche ?'
      assign article_cta_copy = 'Économe en eau, haute pression, avec ou sans filtre. Installé soi-même en cinq minutes.'
    when 'es'
      assign article_more_label = 'Más guías'
      assign article_shop_label = 'Ver las alcachofas de ducha Besjaar'
      assign article_read_label = 'min de lectura'
      assign article_toc_label = 'En esta guía'
      assign article_cta_kicker = 'Alcachofas de ducha Besjaar'
      assign article_cta_title = '¿Listo para una ducha mejor?'
      assign article_cta_copy = 'Ahorro de agua, alta presión, con o sin filtro. La instalas tú mismo en cinco minutos.'
    else
      assign article_more_label = 'Meer gidsen'
      assign article_shop_label = 'Bekijk de Besjaar douchekoppen'
      assign article_read_label = 'min leestijd'
      assign article_toc_label = 'In deze gids'
      assign article_cta_kicker = 'Besjaar douchekoppen'
      assign article_cta_title = 'Klaar voor een betere douche?'
      assign article_cta_copy = 'Waterbesparend, hoge druk, met of zonder filter. Zelf te monteren in vijf minuten.'
  endcase

  assign article_blog_label = blog.title
  if blog.handle == 'gids'
    assign article_blog_label = 'besjaar_ui.blog.title' | t
  endif
  capture article_blog_url
    render 'localized-internal-url', url: blog.url
  endcapture
  assign article_blog_url = article_blog_url | strip
  capture article_shop_url
    render 'shower-store-url'
  endcapture
  assign article_shop_url = article_shop_url | strip

  assign article_words = article.content | strip_html | split: ' ' | size
  assign article_minutes = article_words | divided_by: 200.0 | ceil | at_least: 1
  assign article_lede = article.excerpt | strip_html | strip

  assign article_related_count = 0
  if blog.articles.size > 1
    for other_article in blog.articles limit: 6
      unless other_article.id == article.id
        assign article_related_count = article_related_count | plus: 1
      endunless
    endfor
  endif
-%}
<style id="bj-article-{{ section.id }}">
  .bj-article{background:#fff;padding:26px 0 70px}
  .bj-article__shell{width:min(calc(100% - 32px),1120px);margin-inline:auto}
  .bj-article__crumb{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:0 0 26px;font-size:.78rem;font-weight:600;color:#61798E}
  .bj-article__crumb a{color:#173B5E;text-decoration:none}
  .bj-article__crumb a:hover{text-decoration:underline;text-underline-offset:3px}
  .bj-article__crumb span[aria-hidden]{color:#9fb0bf}
  .bj-article__head{max-width:820px}
  .bj-article__meta{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;margin:0 0 16px;font-size:.76rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#173B5E}
  .bj-article__meta span+span::before{content:"·";margin-right:10px;color:#9fb0bf}
  body[data-page-type="article"] .bj-article .bj-article__title{margin:0;font-size:clamp(2rem,4vw,3.4rem)!important;line-height:1.06!important;letter-spacing:-.03em;color:#132A3E;max-width:20ch}
  .bj-article__lede{margin:18px 0 0;font-size:1.15rem;line-height:1.6;color:#4b5a66;max-width:720px}
  .bj-article__hero{margin:30px 0 0;border-radius:22px;overflow:hidden;background:#EEF6FB}
  .bj-article__hero img{display:block;width:100%;height:auto}
  .bj-article__layout{display:grid;grid-template-columns:minmax(0,1fr);gap:28px;margin-top:34px;padding-top:34px;border-top:1px solid #e4e9ec}
  .bj-article__toc{border:1px solid #dfe5ea;border-radius:18px;background:#f5f9fc;padding:18px 20px}
  .bj-article__toc[hidden]{display:none}
  .bj-article__toc p{margin:0 0 10px;font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#173B5E}
  .bj-article__toc ol{margin:0;padding:0;list-style:none;counter-reset:toc}
  .bj-article__toc li{counter-increment:toc;margin:0;padding:7px 0;border-top:1px solid rgba(23,59,94,.1);font-size:.9rem;line-height:1.35}
  .bj-article__toc li:first-child{border-top:0}
  .bj-article__toc a{display:flex;gap:10px;color:#132A3E;text-decoration:none}
  .bj-article__toc a::before{content:counter(toc,decimal-leading-zero);flex:0 0 auto;font-weight:800;color:#173B5E;font-size:.78rem;padding-top:2px}
  .bj-article__toc a:hover{color:#173B5E;text-decoration:underline;text-underline-offset:3px}
  .bj-article__body{max-width:760px;min-width:0}
  body[data-page-type="article"] .bj-article .bj-article__body p{margin:0 0 1.25em;font-size:1.05rem;line-height:1.78;color:#3f4b46!important}
  body[data-page-type="article"] .bj-article .bj-article__body h2{margin:2.1em 0 .7em;padding-left:16px;border-left:4px solid #173B5E;font-size:clamp(1.35rem,2.2vw,1.65rem);line-height:1.25;letter-spacing:-.02em;color:#132A3E;scroll-margin-top:110px}
  body[data-page-type="article"] .bj-article .bj-article__body h3{margin:1.6em 0 .5em;font-size:1.15rem;color:#132A3E}
  body[data-page-type="article"] .bj-article .bj-article__body a{color:#173B5E;font-weight:600;text-decoration:underline;text-underline-offset:3px}
  body[data-page-type="article"] .bj-article .bj-article__body strong{color:#132A3E}
  body[data-page-type="article"] .bj-article .bj-article__body ol{list-style:none;margin:0 0 1.5em;padding:0;counter-reset:step}
  body[data-page-type="article"] .bj-article .bj-article__body ol>li{position:relative;counter-increment:step;margin:0 0 14px;padding:14px 16px 14px 62px;border:1px solid #e1e8ee;border-radius:16px;background:#f7fafc;font-size:1rem;line-height:1.7;color:#3f4b46!important}
  body[data-page-type="article"] .bj-article .bj-article__body ol>li::before{content:counter(step);position:absolute;left:16px;top:14px;width:32px;height:32px;border-radius:50%;background:#173B5E;color:#fff;font-size:.85rem;font-weight:800;display:grid;place-items:center}
  body[data-page-type="article"] .bj-article .bj-article__body ul{margin:0 0 1.5em;padding-left:22px}
  body[data-page-type="article"] .bj-article .bj-article__body ul>li{margin:0 0 8px;font-size:1.02rem;line-height:1.7;color:#3f4b46!important}
  body[data-page-type="article"] .bj-article .bj-article__body ul>li::marker{color:#173B5E}
  body[data-page-type="article"] .bj-article .bj-article__body img{max-width:100%;height:auto;border-radius:16px}
  body[data-page-type="article"] .bj-article .bj-article__body blockquote{margin:1.5em 0;padding:16px 20px;border-left:4px solid #173B5E;border-radius:0 14px 14px 0;background:#f5f9fc;color:#132A3E}
  .bj-article__cta{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:18px 28px;margin:46px 0 0;padding:28px 30px;border-radius:22px;background:#173B5E;color:#fff}
  .bj-article__cta small{display:block;margin:0 0 6px;font-size:.7rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.72)}
  .bj-article__cta h2{margin:0 0 6px;font-size:clamp(1.35rem,2.4vw,1.8rem);line-height:1.15;letter-spacing:-.02em;color:#fff}
  .bj-article__cta p{margin:0;font-size:.95rem;line-height:1.55;color:rgba(255,255,255,.84)}
  .bj-article__cta a{display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 22px;border-radius:999px;background:#fff;color:#173B5E;font-size:.82rem;font-weight:800;letter-spacing:.02em;text-decoration:none;white-space:nowrap;transition:transform .18s ease,box-shadow .18s ease}
  .bj-article__cta a:hover{transform:translateY(-1px);box-shadow:0 10px 24px rgba(0,0,0,.18)}
  .bj-article__more{margin:44px 0 0}
  .bj-article__more h2{margin:0 0 14px;font-size:1.05rem;font-weight:700;letter-spacing:-.01em;color:#173B5E}
  .bj-article__more ul{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin:0;padding:0;list-style:none}
  .bj-article__more a{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:64px;padding:14px 16px;border:1px solid rgba(23,59,94,.12);border-radius:14px;background:#EEF6FB;color:#132A3E;font-size:.9rem;font-weight:600;line-height:1.35;text-decoration:none;transition:border-color .18s ease,background .18s ease,transform .18s ease}
  .bj-article__more a::after{content:"→";flex:0 0 auto;color:#173B5E}
  .bj-article__more a:hover{background:#fff;border-color:rgba(23,59,94,.3);transform:translateY(-1px)}
  .bj-article__back{margin:30px 0 0;font-size:.85rem;font-weight:700}
  .bj-article__back a{color:#173B5E;text-decoration:underline;text-underline-offset:3px}
  @media (min-width:1024px){
    .bj-article__layout{grid-template-columns:250px minmax(0,1fr);gap:48px}
    .bj-article__toc{position:sticky;top:110px;align-self:start}
  }
  @media (max-width:700px){
    .bj-article{padding:18px 0 54px}
    .bj-article__shell{width:min(calc(100% - 24px),1120px)}
    .bj-article__lede{font-size:1.05rem}
    .bj-article__layout{margin-top:26px;padding-top:26px;gap:22px}
    body[data-page-type="article"] .bj-article .bj-article__body p{font-size:1rem}
    body[data-page-type="article"] .bj-article .bj-article__body ol>li{padding:12px 14px 12px 54px}
    body[data-page-type="article"] .bj-article .bj-article__body ol>li::before{left:12px;top:12px;width:28px;height:28px;font-size:.78rem}
    .bj-article__cta{grid-template-columns:1fr;padding:22px}
    .bj-article__cta a{width:100%;justify-content:center}
  }
</style>
<article class="bj-article">
  <div class="bj-article__shell">
    <nav class="bj-article__crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'besjaar_grouped_collection.home' | t }}</a>
      <span aria-hidden="true">›</span>
      <a href="{{ article_blog_url }}">{{ article_blog_label | escape }}</a>
    </nav>
    <header class="bj-article__head">
      <p class="bj-article__meta">
        <span>{{ article_blog_label | escape }}</span>
        <span><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %B %Y' }}</time></span>
        <span>{{ article_minutes }} {{ article_read_label }}</span>
      </p>
      <h1 class="bj-article__title besjaar-ui-title">{{ article.title }}</h1>
      {%- if article_lede != blank -%}<p class="bj-article__lede">{{ article_lede }}</p>{%- endif -%}
    </header>
    {%- if article.image -%}
      <figure class="bj-article__hero">{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', alt: article.image.alt | default: article.title, widths: '600, 900, 1200, 1600', sizes: '(max-width: 1120px) 100vw, 1120px' }}</figure>
    {%- endif -%}
    <div class="bj-article__layout">
      <aside class="bj-article__toc" data-bj-article-toc hidden>
        <p>{{ article_toc_label }}</p>
        <ol data-bj-article-toc-list></ol>
      </aside>
      <div class="bj-article__body besjaar-ui-content" data-bj-article-body>{{ article.content }}</div>
    </div>
    <section class="bj-article__cta" aria-label="{{ article_cta_kicker | escape }}">
      <div>
        <small>{{ article_cta_kicker }}</small>
        <h2>{{ article_cta_title }}</h2>
        <p>{{ article_cta_copy }}</p>
      </div>
      <a href="{{ article_shop_url }}">{{ article_shop_label }} →</a>
    </section>
    {%- if article_related_count > 0 -%}
      <section class="bj-article__more" aria-labelledby="BesjaarArticleMore-{{ section.id }}">
        <h2 id="BesjaarArticleMore-{{ section.id }}">{{ article_more_label }}</h2>
        <ul>
          {%- for other_article in blog.articles limit: 6 -%}
            {%- unless other_article.id == article.id -%}
              <li><a href="{% render 'localized-internal-url', url: other_article.url %}">{{ other_article.title | escape }}</a></li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}
    <p class="bj-article__back"><a href="{{ article_blog_url }}">← {{ 'besjaar_ui.blog.back_to' | t }} {{ article_blog_label | escape }}</a></p>
  </div>
</article>
<script>
  (function () {
    var body = document.querySelector('[data-bj-article-body]');
    var toc = document.querySelector('[data-bj-article-toc]');
    var list = document.querySelector('[data-bj-article-toc-list]');
    if (!body || !toc || !list) return;
    var headings = body.querySelectorAll('h2');
    if (headings.length < 2) return;
    var used = {};
    headings.forEach(function (heading, index) {
      var slug = (heading.textContent || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'sectie-' + (index + 1);
      if (used[slug]) slug += '-' + (index + 1);
      used[slug] = true;
      if (!heading.id) heading.id = slug;
      var item = document.createElement('li');
      var link = document.createElement('a');
      link.href = '#' + heading.id;
      link.textContent = heading.textContent;
      item.appendChild(link);
      list.appendChild(item);
    });
    toc.hidden = false;
  })();
</script>
{% schema %}{"name":"Main article","settings":[]}{% endschema %}
