<article class="besjaar-ui-section"><div class="besjaar-ui-shell besjaar-ui-content"><header class="besjaar-ui-page-head"><p class="besjaar-ui-kicker">{{ article.published_at | date: '%d.%m.%Y' }} / BESJAAR {{ 'besjaar_ui.catalog.journal' | t }}</p><h1 class="besjaar-ui-title">{{ article.title }}</h1></header>{% if article.image %}{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: article.title }}{% endif %}<div style="margin-top:32px">{{ article.content }}</div><p style="margin-top:40px"><a class="besjaar-ui-button besjaar-ui-button--ghost" href="{% render 'localized-internal-url', url: blog.url %}">← {{ 'besjaar_ui.blog.back_to' | t }} {{ blog.title }}</a></p></div></article>
{% schema %}{"name":"Main article","settings":[]}{% endschema %}
