<article class="nova-section"><div class="nova-shell nova-content"><header class="nova-page-head"><p class="nova-kicker">{{ article.published_at | date: '%d.%m.%Y' }} / BESJAAR {{ 'nova.catalog.journal' | t }}</p><h1 class="nova-title">{{ article.title }}</h1></header>{% if article.image %}{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: article.title }}{% endif %}<div style="margin-top:32px">{{ article.content }}</div><p style="margin-top:40px"><a class="nova-button nova-button--ghost" href="{% render 'localized-internal-url', url: blog.url %}">← {{ 'nova.blog.back_to' | t }} {{ blog.title }}</a></p></div></article>
{% schema %}{"name":"Main article","settings":[]}{% endschema %}
