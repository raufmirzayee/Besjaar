</style>
<script>
(function () {
  'use strict';
  var header = document.querySelector('.nova-header');
  if (!header || header.getAttribute('data-bj-scroll') === '1') return;
  header.setAttribute('data-bj-scroll', '1');
  var ticking = false;
  var update = function () {
    ticking = false;
    header.classList.toggle('is-scrolled', (window.scrollY || document.documentElement.scrollTop || 0) > 8);
  };
  window.addEventListener('scroll', function () {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(update);
  }, { passive: true });
  update();
})();
</script>
