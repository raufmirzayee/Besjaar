</style>
<script>
(function () {
  'use strict';
  if (document.body.getAttribute('data-page-type') !== 'product') return;
  var tidyJudgeme = function () {
    Array.prototype.forEach.call(document.querySelectorAll('.ind-bj-pd__rating--judgeme'), function (link) {
      var badge = link.querySelector('.jdgm-prev-badge');
      var count = badge ? parseInt(badge.getAttribute('data-number-of-reviews') || '', 10) : NaN;
      var text = (link.textContent || '').trim().toLowerCase();
      var empty = (badge && count === 0) || /^(no reviews|geen reviews|nog geen reviews|keine bewertungen|aucun avis)/.test(text);
      link.classList.toggle('is-empty', !!empty);
    });
  };
  var run = function () {
    tidyJudgeme();
    if ('MutationObserver' in window) {
      var observer = new MutationObserver(tidyJudgeme);
      Array.prototype.forEach.call(document.querySelectorAll('.ind-bj-pd__rating--judgeme'), function (link) {
        observer.observe(link, { childList: true, subtree: true, attributes: true });
      });
    }
    window.setTimeout(tidyJudgeme, 1500);
    window.setTimeout(tidyJudgeme, 4000);
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run, { once: true });
  else run();
})();
</script>
