body[data-page-type="index"] .besjaar-store.besjaar-store-reviews .besjaar-store-rating-card>span{margin:0!important;color:rgba(255,255,255,.82)!important;font-size:.95rem!important;font-weight:500!important}
body[data-page-type="index"] .besjaar-store.besjaar-store-reviews .besjaar-store-rating-card>small{margin:8px 0 0!important;color:var(--bj-sky)!important;font-size:.64rem!important;font-weight:700!important;letter-spacing:.16em!important;text-transform:uppercase!important}
@media (prefers-reduced-motion:reduce){
  body[data-page-type="index"] .besjaar-store-hero.besjaar-store-hero--premium-exact .besjaar-store-hero__actions .besjaar-store-btn--primary::after{transition:none!important}
  body[data-page-type="index"] .besjaar-store-hero.besjaar-store-hero--premium-exact .besjaar-store-hero__actions .besjaar-store-btn--primary:hover::after{transform:none!important}
}
</style>
<script>
(function () {
  'use strict';
  if (document.body.getAttribute('data-page-type') !== 'index') return;
  var run = function () {
    var hero = document.querySelector('.besjaar-store-hero--premium-exact');
    if (!hero || hero.getAttribute('data-bj-hero') === '1') return;
    var proof = hero.querySelector('.besjaar-store-hero__customer-proof');
    var visual = hero.querySelector('.besjaar-store-hero__visual');
    if (!proof || !visual) return;
    hero.setAttribute('data-bj-hero', '1');
    visual.appendChild(proof);
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run, { once: true });
  else run();
  document.addEventListener('shopify:section:load', run);
})();
</script>
{% schema %}
{
  "name": "Besjaar home polish",
  "settings": [
    {
      "type": "paragraph",
      "content": "11.6.9: home page shapes — pill kickers, tighter titles and spacing, hero image card with the review chip floated over it, catalogue-style range cards, inset scene, 18px feature cards and a navy rating card. Keep in the header group after the runtime section."
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
