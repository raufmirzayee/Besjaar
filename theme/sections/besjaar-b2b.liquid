  assign bj_email = section.settings.contact_email | default: settings.support_email | default: 'info@univexbv.com'
  assign bj_phone = settings.support_phone | default: '+31 6 16745062'
  assign bj_phone_href = bj_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', ''
  assign bj_hero_image = section.settings.hero_image
%}
<section class="bj-b2b" id="bj-b2b">
  <div class="besjaar-store-shell">

    <div class="bj-b2b__hero">
      <div class="bj-b2b__hero-copy">
        <span class="bj-b2b__kicker">{{ t_kicker | escape }}</span>
        <h1 class="bj-b2b__title"><em>{{ t_title_a | escape }}</em> <span>{{ t_title_b | escape }}</span> <span>{{ t_title_c | escape }}</span></h1>
        <p class="bj-b2b__intro">{{ t_intro | escape }}</p>
        <div class="bj-b2b__hero-actions">
          <a class="bj-b2b__btn" href="#bj-b2b-form">{{ t_cta | escape }} <span aria-hidden="true">→</span></a>
          <a class="bj-b2b__mail" href="mailto:{{ bj_email }}">{{ bj_email }}</a>
          {% if bj_phone != blank %}<a class="bj-b2b__mail" href="tel:{{ bj_phone_href }}">{{ bj_phone }}</a>{% endif %}
        </div>
      </div>
      <div class="bj-b2b__hero-visual">
        {% if bj_hero_image != blank %}
          <img src="{{ bj_hero_image | image_url: width: 1200 }}" alt="{{ bj_hero_image.alt | default: 'Besjaar' | escape }}" width="1200" height="900" loading="eager">
        {% else %}
          <img src="{{ 'besjaar-premium-hero-pressure-v3.webp' | asset_url }}" alt="Besjaar" loading="eager">
        {% endif %}
        <div class="bj-b2b__badge"><strong>{{ t_badge_n | escape }}</strong><small>{{ t_badge_l | escape }}</small></div>
      </div>
    </div>

    <div class="bj-b2b__benefits">
      <div class="bj-b2b__benefits-head">
        <span class="bj-b2b__kicker">{{ t_ben_kicker | escape }}</span>
        <h2>{{ t_ben_title | escape }}</h2>
      </div>
      <div class="bj-b2b__cards">
        <article><span>01</span><h3>{{ t_b1t | escape }}</h3><p>{{ t_b1c | escape }}</p></article>
        <article><span>02</span><h3>{{ t_b2t | escape }}</h3><p>{{ t_b2c | escape }}</p></article>
        <article><span>03</span><h3>{{ t_b3t | escape }}</h3><p>{{ t_b3c | escape }}</p></article>
        <article><span>04</span><h3>{{ t_b4t | escape }}</h3><p>{{ t_b4c | escape }}</p></article>
      </div>
    </div>

    <div class="bj-b2b__quote" id="bj-b2b-form">
      <aside class="bj-b2b__aside">
        <span class="bj-b2b__kicker">{{ t_side_kicker | escape }}</span>
        <h2>{{ t_side_title | escape }}</h2>
        <p>{{ t_side_copy | escape }}</p>
        <div class="bj-b2b__mailcard">
          <small>{{ t_side_label | escape }}</small>
          <a href="mailto:{{ bj_email }}">{{ bj_email }}</a>
          {% if bj_phone != blank %}<a href="tel:{{ bj_phone_href }}">{{ bj_phone }}</a>{% endif %}
          <small>{{ t_side_reply | escape }}</small>
        </div>
        <a class="bj-b2b__link" href="{% render 'shower-store-url' %}">{{ t_side_link | escape }} <span aria-hidden="true">→</span></a>
      </aside>

      <div class="bj-b2b__formcard">
        <span class="bj-b2b__kicker">{{ t_form_kicker | escape }}</span>
        <h2>{{ t_form_title | escape }}</h2>
        <p class="bj-b2b__formintro">{{ t_form_intro | escape }}</p>

        {% form 'contact', id: 'bj-b2b-contact' %}
          {% if form.posted_successfully? %}
            <p class="bj-b2b__ok" role="status">{{ t_f_ok | escape }}</p>
          {% else %}
            {% if form.errors %}
              <p class="bj-b2b__err" role="alert">{{ form.errors | default_errors }}</p>
            {% endif %}
            <input type="hidden" name="contact[Aanvraagtype]" value="Zakelijke offerte">
            <div class="bj-b2b__grid">
              <label>{{ t_f_company | escape }} *<input type="text" name="contact[Bedrijfsnaam]" required></label>
              <label>{{ t_f_person | escape }} *<input type="text" name="contact[Contactpersoon]" required></label>
              <label>{{ t_f_email | escape }} *<input type="email" name="contact[email]" required autocomplete="email"></label>
              <label>{{ t_f_phone | escape }}<input type="tel" name="contact[Telefoonnummer]" autocomplete="tel"></label>
              <label>{{ t_f_reg | escape }}<input type="text" name="contact[KVK-nummer]"></label>
              <label>{{ t_f_country | escape }}
                <select name="contact[Land]">
                  <option>Nederland</option><option>België</option><option>Deutschland</option><option>France</option><option>{{ t_other | escape }}</option>
                </select>
              </label>
              <label>{{ t_f_product | escape }}
                <select name="contact[Product]">
                  <option value="">{{ t_f_choose | escape }}</option>
                  {% for p in collections.all.products limit: 25 %}<option>{{ p.title | escape }}</option>{% endfor %}
                </select>
              </label>
              <label>{{ t_f_qty | escape }}
                <select name="contact[Gewenst aantal]">
                  <option value="">{{ t_f_choose | escape }}</option>
                  <option>10–25</option><option>25–50</option><option>50–100</option><option>100–250</option><option>250–500</option><option>500+</option>
                </select>
              </label>
              <label class="bj-b2b__wide">{{ t_f_date | escape }}<input type="date" name="contact[Gewenste leverdatum]"></label>
              <label class="bj-b2b__wide">{{ t_f_notes | escape }}<textarea name="contact[body]" rows="4" placeholder="{{ t_f_notes_ph | escape }}"></textarea></label>
            </div>
            <label class="bj-b2b__consent"><input type="checkbox" required> <span>{{ t_f_consent | escape }}</span></label>
            <button type="submit" class="bj-b2b__submit">{{ t_f_send | escape }} <span aria-hidden="true">→</span></button>
          {% endif %}
        {% endform %}
      </div>
    </div>

  </div>
</section>
<style>
  .bj-b2b{padding:clamp(28px,6vw,60px) 0 clamp(40px,8vw,80px);background:var(--bj-ice-50,#F6F9FC);color:var(--bj-ink,#11110E)}
  .bj-b2b__kicker{display:inline-flex;align-items:center;margin:0 0 12px;padding:6px 12px;border:1px solid var(--bj-line,rgba(21,50,82,.12));border-radius:999px;background:var(--bj-ice-100,#EEF6FB);color:var(--bj-blue,#2F628F);font-size:.62rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;line-height:1}
  .bj-b2b h2{margin:0 0 12px;color:var(--bj-navy-deep,#0F2947);font-size:clamp(1.5rem,4.4vw,2.1rem);font-weight:600;line-height:1.14;letter-spacing:-.025em}
  .bj-b2b p{color:var(--bj-muted,#49627D);line-height:1.6}
  .bj-b2b__hero{display:grid;grid-template-columns:minmax(0,1fr);gap:20px;align-items:stretch}
  .bj-b2b__hero-copy{padding:clamp(24px,5vw,40px);border:1px solid var(--bj-line,rgba(21,50,82,.12));border-radius:22px;background:var(--bj-ice-100,#EEF6FB)}
  .bj-b2b__title{margin:0 0 14px;color:var(--bj-navy-deep,#0F2947);font-size:clamp(2.1rem,8vw,3.2rem);font-weight:700;line-height:1.02;letter-spacing:-.03em}
  .bj-b2b__title em{font-style:normal;display:block}
  .bj-b2b__title span{display:block;font-weight:600}
  .bj-b2b__intro{margin:0;max-width:46ch;font-size:1rem}
  .bj-b2b__hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;margin-top:22px}
  .bj-b2b__btn{display:inline-flex;align-items:center;gap:8px;min-height:52px;padding:0 22px;border-radius:999px;background:var(--bj-navy-deep,#0F2947);color:#FFFFFF;font-size:.95rem;font-weight:600;text-decoration:none}
  .bj-b2b__btn:hover{background:var(--bj-navy,#153252)}
  .bj-b2b__mail{color:var(--bj-navy,#153252);font-size:.85rem;font-weight:600;text-decoration:none;border-bottom:1px solid var(--bj-line,rgba(21,50,82,.25));padding-bottom:2px}
  .bj-b2b__hero-visual{position:relative;border-radius:22px;overflow:hidden;background:#FFFFFF;border:1px solid var(--bj-line,rgba(21,50,82,.12))}
  .bj-b2b__hero-visual img{width:100%;height:100%;object-fit:cover;display:block;aspect-ratio:4/3}
  .bj-b2b__badge{position:absolute;left:16px;bottom:16px;display:flex;flex-direction:column;gap:2px;padding:12px 16px;border-radius:14px;background:rgba(255,255,255,.95);box-shadow:0 10px 26px rgba(15,41,71,.14)}
  .bj-b2b__badge strong{color:var(--bj-navy-deep,#0F2947);font-size:1.15rem;font-weight:700;line-height:1}
  .bj-b2b__badge small{color:var(--bj-muted,#49627D);font-size:.7rem}
  .bj-b2b__benefits{margin-top:clamp(36px,7vw,64px)}
  .bj-b2b__benefits-head{max-width:40ch;margin:0 0 20px}
  .bj-b2b__cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .bj-b2b__cards article{padding:18px;border:1px solid var(--bj-line,rgba(21,50,82,.12));border-radius:16px;background:#FFFFFF}
  .bj-b2b__cards span{display:block;margin:0 0 22px;color:var(--bj-muted,#49627D);font-size:.68rem;font-weight:700;letter-spacing:.1em}
  .bj-b2b__cards h3{margin:0 0 6px;color:var(--bj-navy-deep,#0F2947);font-size:1rem;font-weight:600;letter-spacing:-.015em}
