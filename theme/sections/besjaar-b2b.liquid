    else
      assign t_kicker = 'ZAKELIJK BESTELLEN BIJ BESJAAR'
      assign t_title_a = 'BESJAAR'
      assign t_title_b = 'in grotere'
      assign t_title_c = 'aantallen.'
      assign t_intro = 'Voor retailers, installateurs, hotels, sportscholen en andere organisaties. Vraag een offerte aan voor douchekoppen, filters of complete sets.'
      assign t_cta = 'Vraag een offerte aan'
      assign t_badge_n = '10–500+'
      assign t_badge_l = 'stuks per aanvraag'
      assign t_ben_kicker = 'ZAKELIJKE VOORDELEN'
      assign t_ben_title = 'Duidelijk inkopen, zonder ingewikkeld proces.'
      assign t_b1t = 'Prijs op volume'
      assign t_b1c = 'Een voorstel dat past bij het product, het aantal en de gewenste levering.'
