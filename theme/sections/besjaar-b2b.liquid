  .bj-b2b__aside p{max-width:44ch;font-size:.95rem}
  .bj-b2b__mailcard{display:flex;flex-direction:column;gap:6px;margin:20px 0;padding:16px 18px;border-radius:16px;background:var(--bj-ice-100,#EEF6FB)}
  .bj-b2b__mailcard small{color:var(--bj-muted,#49627D);font-size:.76rem}
  .bj-b2b__mailcard a{color:var(--bj-navy-deep,#0F2947);font-size:1.05rem;font-weight:700;text-decoration:none}
  .bj-b2b__link{display:inline-flex;align-items:center;gap:6px;color:var(--bj-blue,#2F628F);font-size:.86rem;font-weight:600;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:3px}
