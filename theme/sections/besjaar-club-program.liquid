</style>

<script>
  (function () {
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function ymd(d) { return d.getFullYear() + pad(d.getMonth() + 1) + pad(d.getDate()); }
    function icsText(s) { return String(s).replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\r?\n/g, '\\n'); }
    function fold(line) {
      var out = [];
      while (line.length > 70) { out.push(line.slice(0, 70)); line = ' ' + line.slice(70); }
      out.push(line);
      return out.join('\r\n');
    }
    function copyText(text) {
      if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
      return new Promise(function (resolve, reject) {
        var area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        try { document.execCommand('copy') ? resolve() : reject(); } catch (e) { reject(e); }
        document.body.removeChild(area);
      });
    }
    function init(root) {
      if (!root || root.dataset.bjcReady) return;
      root.dataset.bjcReady = '1';
      var live = root.querySelector('[data-bjc-live]');
      var copiedLabel = {{ t_copied | json }};
      root.querySelectorAll('[data-bjc-copy]').forEach(function (button) {
        var label = button.querySelector('[data-bjc-copy-label]');
        var original = label ? label.textContent : '';
        button.addEventListener('click', function () {
          var code = button.getAttribute('data-bjc-copy');
          copyText(code).then(function () {
            button.classList.add('is-done');
            if (label) label.textContent = copiedLabel;
            if (live) live.textContent = copiedLabel + ': ' + code;
            setTimeout(function () {
              button.classList.remove('is-done');
              if (label) label.textContent = original;
            }, 2200);
          }).catch(function () {
            var value = button.parentNode.querySelector('.bjc-code__value');
            if (!value || !window.getSelection) return;
            var range = document.createRange();
            range.selectNodeContents(value);
            var selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
          });
        });
      });
      var reminder = root.querySelector('[data-bjc-reminder]');
      if (!reminder) return;
      var months = parseInt(reminder.getAttribute('data-months'), 10) || 3;
      var title = reminder.getAttribute('data-title');
      var details = reminder.getAttribute('data-details');
      var today = new Date();
      var start = new Date(today.getFullYear(), today.getMonth() + months, today.getDate());
      var end = new Date(start.getFullYear(), start.getMonth(), start.getDate() + 1);
      var gcal = reminder.querySelector('[data-bjc-gcal]');
      if (gcal) {
        gcal.href = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
          + '&text=' + encodeURIComponent(title)
          + '&dates=' + ymd(start) + '/' + ymd(end)
          + '&details=' + encodeURIComponent(details);
      }
      var ics = reminder.querySelector('[data-bjc-ics]');
      if (ics) {
        ics.addEventListener('click', function () {
          var now = new Date();
          var stamp = now.getUTCFullYear() + pad(now.getUTCMonth() + 1) + pad(now.getUTCDate()) + 'T' + pad(now.getUTCHours()) + pad(now.getUTCMinutes()) + pad(now.getUTCSeconds()) + 'Z';
          var lines = [
            'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Besjaar//Besjaar Club//NL', 'CALSCALE:GREGORIAN', 'METHOD:PUBLISH',
            'BEGIN:VEVENT',
            'UID:' + now.getTime() + '-filter@besjaar.eu',
            'DTSTAMP:' + stamp,
            'DTSTART;VALUE=DATE:' + ymd(start),
            'DTEND;VALUE=DATE:' + ymd(end),
            'SUMMARY:' + icsText(title),
            'DESCRIPTION:' + icsText(details),
            'BEGIN:VALARM', 'ACTION:DISPLAY', 'DESCRIPTION:' + icsText(title), 'TRIGGER:PT9H', 'END:VALARM',
            'END:VEVENT', 'END:VCALENDAR'
          ];
          var blob = new Blob([lines.map(fold).join('\r\n') + '\r\n'], { type: 'text/calendar;charset=utf-8' });
          var link = document.createElement('a');
          link.href = URL.createObjectURL(blob);
          link.download = reminder.getAttribute('data-file') || 'besjaar.ics';
          document.body.appendChild(link);
          link.click();
          setTimeout(function () { URL.revokeObjectURL(link.href); link.remove(); }, 1000);
        });
      }
    }
    function initAll() { document.querySelectorAll('[data-bjc]').forEach(init); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAll); else initAll();
    document.addEventListener('shopify:section:load', initAll);
  })();
</script>

{% schema %}
{
  "name": "Besjaar Club",
  "settings": [
    {"type": "paragraph", "content": "This page only promises what is set up in Shopify. Keep the codes and percentages equal to Shopify > Discounts. Clear a code to take that benefit off the page."},
    {"type": "text", "id": "welcome_code", "label": "Welcome code", "default": "WELKOM20", "info": "One-time welcome discount. Must exist in Shopify > Discounts. Leave empty to hide this benefit."},
    {"type": "range", "id": "welcome_percent", "label": "Welcome discount", "min": 5, "max": 50, "step": 1, "unit": "%", "default": 20},
    {"type": "checkbox", "id": "show_member_price", "label": "Member price on replacement filters", "default": true, "info": "Signed-in members get it automatically through the automatic discount ‘Besjaar Club – ledenprijs’ in Shopify > Discounts. Untick to hide this benefit."},
    {"type": "range", "id": "refill_percent", "label": "Member discount on replacement filters", "min": 5, "max": 50, "step": 1, "unit": "%", "default": 20},
    {"type": "product", "id": "refill_product", "label": "Replacement filter product", "info": "Used for the member price, the product card and the reminder link."},
