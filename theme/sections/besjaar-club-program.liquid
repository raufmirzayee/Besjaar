    assign c_max = c_min
  endif
  assign c_w_code = section.settings.welcome_code | default: '' | strip | upcase
  assign c_has_w = false
  if c_w_code != blank
    assign c_has_w = true
  endif
  assign c_has_r = false
  if section.settings.show_member_price
    assign c_has_r = true
  endif

  assign c_member = false
  if customer
    assign c_member = true
  elsif request.design_mode and section.settings.preview_member
    assign c_member = true
  endif
  assign c_name_part = ''
  assign c_card_name = t_card_name
  if customer
    assign c_first = customer.first_name | default: '' | strip | escape
    if c_first != blank
      assign c_name_part = ', ' | append: c_first
    endif
    assign c_card_name = customer.name | default: '' | strip
    if c_card_name == blank
      assign c_card_name = customer.email | split: '@' | first
    endif
    assign c_card_name = c_card_name | upcase
  endif

  assign c_customer_email = ''
  if customer
    assign c_customer_email = customer.email | escape
  endif

  assign c_login = routes.storefront_login_url | default: routes.account_login_url
  assign c_account = routes.account_url

  assign c_refill = section.settings.refill_product
  assign c_refill_url = ''
  assign c_old = ''
  assign c_new = ''
  if c_refill != blank
    capture c_refill_url
      render 'localized-internal-url', url: c_refill.url
    endcapture
    assign c_refill_url = c_refill_url | strip
    assign c_old_cents = c_refill.price
    assign c_off_cents = c_old_cents | times: c_r | divided_by: 100.0 | round
    assign c_new_cents = c_old_cents | minus: c_off_cents
    assign c_old = c_old_cents | money
    assign c_new = c_new_cents | money
    assign c_img_alt = c_refill.featured_image.alt | default: c_refill.title
  endif
  capture c_shop_url
    render 'shower-store-url'
  endcapture
  assign c_shop_url = c_shop_url | strip

  capture c_ship_free
    render 'besjaar-shipping-zone', field: 'free_always'
  endcapture
  capture c_ship_thr
    render 'besjaar-shipping-zone', field: 'threshold_cents'
  endcapture
  capture c_ship_rate
    render 'besjaar-shipping-zone', field: 'rate'
  endcapture
  assign c_ship_free = c_ship_free | strip
  assign c_ship_thr = c_ship_thr | strip | plus: 0
  assign c_ship_rate = c_ship_rate | strip
  if c_ship_free == 'true'
    assign c_ship_t = t_ship_free
    assign c_ship_s = t_ship_free_s
  elsif c_ship_thr > 0
    assign c_ship_amount = c_ship_thr | money_without_trailing_zeros
    assign c_ship_t = t_ship_from | replace: '[AMOUNT]', c_ship_amount
    assign c_ship_s = t_ship_none_s
    if c_ship_rate != blank
      assign c_rate_money = c_ship_rate | times: 100 | round | money
      assign c_ship_s = t_ship_from_s | replace: '[RATE]', c_rate_money
    endif
  else
    assign c_ship_t = t_ship_none
    assign c_ship_s = t_ship_none_s
  endif
  assign c_days = settings.return_window_days | default: 30
  assign c_months = settings.warranty_months | default: 12

  assign c_intro = t_intro_a
  if c_has_w and c_has_r
    assign c_intro = c_intro | append: ' ' | append: t_intro_both
  elsif c_has_w
    assign c_intro = c_intro | append: ' ' | append: t_intro_w
  elsif c_has_r
    assign c_intro = c_intro | append: ' ' | append: t_intro_r
  endif
  assign c_intro = c_intro | append: ' ' | append: t_intro_c
  assign c_intro_m = t_intro_member
  if c_has_r
    assign c_intro_m = c_intro_m | append: ' ' | append: t_intro_member_r
  endif
  if c_has_w
    assign c_intro_m = c_intro_m | append: ' ' | append: t_intro_member_w
  endif
  assign c_h1b = t_h1b_alt
  if c_has_r
    assign c_h1b = t_h1b
  endif

  assign c_terms = t_terms_a
  if c_has_w
    assign c_terms = c_terms | append: ' ' | append: t_terms_w
  endif
  if c_has_r
    assign c_terms = c_terms | append: ' ' | append: t_terms_r
  endif
  assign c_terms = c_terms | append: ' ' | append: t_terms_b

  assign c_email = settings.support_email | default: shop.email
  assign c_rem_details = t_rem_desc
  if c_member and c_has_r and c_new != blank
    assign c_rem_member = t_rem_desc_member | replace: '[NEW]', c_new | replace: '[OLD]', c_old
    assign c_rem_details = c_rem_details | append: ' ' | append: c_rem_member
  endif
  if c_refill_url != blank
    assign c_rem_details = c_rem_details | append: ' ' | append: request.origin | append: c_refill_url
  endif
-%}
<section class="bjc" data-bjc>
  <div class="besjaar-store-shell">

    <div class="bjc-hero">
      <div class="bjc-hero__copy">
        <h1 class="bjc-hero__title">
          <span class="bjc-kicker">{{ c_club_name | escape }}</span>
          <span class="bjc-hero__l1">{{ t_h1a | escape }}</span>
          <span class="bjc-hero__l2">{{ c_h1b | escape }}</span>
        </h1>
        {%- if c_member -%}
          <p class="bjc-hero__intro">{{ c_intro_m | escape | replace: '[NAME]', c_name_part }}</p>
          <div class="bjc-hero__actions">
            {%- if c_refill_url != blank -%}
              <a class="bjc-btn" href="{{ c_refill_url }}">{{ t_cta_refill | escape }} <span aria-hidden="true">→</span></a>
            {%- else -%}
              <a class="bjc-btn" href="{{ c_shop_url }}">{{ t_cta_shop | escape }} <span aria-hidden="true">→</span></a>
            {%- endif -%}
            <a class="bjc-link" href="{{ c_account }}">{{ t_cta_account | escape }}</a>
          </div>
          {%- if customer -%}
            <p class="bjc-hero__trust">{{ t_signed_in | escape | replace: '[EMAIL]', c_customer_email }} · <a href="{{ routes.account_logout_url }}">{{ t_logout | escape }}</a></p>
          {%- endif -%}
        {%- else -%}
          <p class="bjc-hero__intro">{{ c_intro | replace: '[W]', c_w | replace: '[R]', c_r | escape }}</p>
          <div class="bjc-hero__actions">
            <a class="bjc-btn" href="{{ c_login }}" rel="nofollow">{{ t_cta_join | escape }} <span aria-hidden="true">→</span></a>
            <span class="bjc-hero__have">{{ t_have | escape }} <a class="bjc-link" href="{{ c_login }}" rel="nofollow">{{ t_login | escape }}</a></span>
          </div>
          <p class="bjc-hero__trust">{{ t_trust | escape }}</p>
        {%- endif -%}
      </div>

      <div class="bjc-hero__visual" aria-hidden="true">
        <div class="bjc-card bjc-card--ghost"></div>
        <div class="bjc-card">
          <svg class="bjc-card__waves" viewBox="0 0 400 250" preserveAspectRatio="none"><path d="M0 170c60-28 120-28 180 0s120 28 220-4"/><path d="M0 198c60-28 120-28 180 0s120 28 220-4"/><path d="M0 226c60-28 120-28 180 0s120 28 220-4"/></svg>
          <div class="bjc-card__top">
            <span class="bjc-card__brand">BESJAAR <b>CLUB</b></span>
            <svg class="bjc-card__drop" viewBox="0 0 24 24"><path d="M12 3s6 6.4 6 11a6 6 0 0 1-12 0c0-4.6 6-11 6-11Z"/></svg>
          </div>
          {%- if c_has_r -%}
            <div class="bjc-card__value"><strong>{{ c_r }}<span>%</span></strong><small>{{ t_card_perk | escape }}</small></div>
          {%- elsif c_has_w -%}
            <div class="bjc-card__value"><strong>{{ c_w }}<span>%</span></strong><small>{{ t_card_perk_w | escape }}</small></div>
          {%- endif -%}
          <div class="bjc-card__bottom">
            <span class="bjc-card__name">{{ c_card_name | escape }}</span>
            <span class="bjc-card__tier">{{ t_card_member | escape }}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="bjc-block">
      <div class="bjc-head">
        <span class="bjc-kicker">{{ t_perks_kicker | escape }}</span>
        <h2>{{ t_perks_title | escape }}</h2>
      </div>
      <div class="bjc-perks">
        {%- if c_has_w -%}
          <article class="bjc-perk">
            <span class="bjc-perk__tag">{{ t_p1_tag | escape }}</span>
            <strong class="bjc-perk__big">{{ c_w }}<span>%</span></strong>
            <h3>{{ t_p1_title | escape }}</h3>
            <p>{{ t_p1_text | escape }}</p>
            {%- if c_member -%}
              <div class="bjc-code">
                <span class="bjc-code__label">{{ t_code_label | escape }}</span>
                <code class="bjc-code__value">{{ c_w_code | escape }}</code>
                <button class="bjc-code__copy" type="button" data-bjc-copy="{{ c_w_code | escape }}" aria-label="{{ t_copy_aria | replace: '[CODE]', c_w_code | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg><span data-bjc-copy-label>{{ t_copy | escape }}</span></button>
              </div>
            {%- else -%}
              <a class="bjc-lock" href="{{ c_login }}" rel="nofollow"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span>{{ t_locked | escape }}</span><i aria-hidden="true">••••••••</i></a>
            {%- endif -%}
            <small class="bjc-perk__note">{{ t_p1_note | escape }}</small>
          </article>
        {%- endif -%}
        {%- if c_has_r -%}
          <article class="bjc-perk bjc-perk--feature">
            <span class="bjc-perk__tag">{{ t_p2_tag | escape }}</span>
            <strong class="bjc-perk__big">{{ c_r }}<span>%</span></strong>
            <h3>{{ t_p2_title | escape }}</h3>
            <p>{{ t_p2_text | escape }}{% if c_new != blank %} <b>{{ t_p2_price | escape | replace: '[NEW]', c_new | replace: '[OLD]', c_old }}</b>{% endif %}</p>
            {%- if c_member -%}
              <p class="bjc-auto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.2 4.2L19 7"/></svg><span>{{ t_p2_auto_m | escape }}</span></p>
            {%- else -%}
              <a class="bjc-lock" href="{{ c_login }}" rel="nofollow"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span>{{ t_p2_auto | escape }}</span><i aria-hidden="true">→</i></a>
            {%- endif -%}
            {%- if c_has_w -%}<small class="bjc-perk__note">{{ t_p2_note | escape }}</small>{%- endif -%}
          </article>
        {%- endif -%}
        <article class="bjc-perk">
          <span class="bjc-perk__tag">{{ t_p3_tag | escape }}</span>
          <span class="bjc-perk__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z"/><path d="M3 7.5 12 12l9-4.5M12 12v9"/></svg></span>
          <h3>{{ t_p3_title | escape }}</h3>
          <p>{{ t_p3_text | escape }}</p>
          <a class="bjc-link" href="{% if customer %}{{ c_account }}{% else %}{{ c_login }}{% endif %}" rel="nofollow">{{ t_p3_link | escape }} <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>

    <div class="bjc-block">
      <div class="bjc-head">
        <span class="bjc-kicker">{{ t_steps_kicker | escape }}</span>
        <h2>{{ t_steps_title | escape }}</h2>
      </div>
      <ol class="bjc-steps">
        <li><span class="bjc-steps__n" aria-hidden="true">01</span><h3>{{ t_s1t | escape }}</h3><p>{{ t_s1c | escape }}</p></li>
        {%- if c_has_r -%}
          <li><span class="bjc-steps__n" aria-hidden="true">02</span><h3>{{ t_s2t | escape }}</h3><p>{{ t_s2c | escape }}</p></li>
        {%- elsif c_has_w -%}
          <li><span class="bjc-steps__n" aria-hidden="true">02</span><h3>{{ t_s2t_w | escape }}</h3><p>{{ t_s2c_w | escape }}</p></li>
        {%- endif -%}
        {%- if c_has_r and c_has_w -%}
          <li><span class="bjc-steps__n" aria-hidden="true">03</span><h3>{{ t_s3t | escape }}</h3><p>{{ t_s3c | escape }}</p></li>
        {%- else -%}
          <li><span class="bjc-steps__n" aria-hidden="true">{% if c_has_r or c_has_w %}03{% else %}02{% endif %}</span><h3>{{ t_s3t_any | escape }}</h3><p>{{ t_s3c_any | escape }}</p></li>
        {%- endif -%}
      </ol>
    </div>

    {%- if c_refill != blank -%}
      <div class="bjc-block bjc-refill">
        <div class="bjc-refill__copy">
          <span class="bjc-kicker">{{ t_refill_kicker | escape }}</span>
          <h2>{{ t_refill_title | escape }}</h2>
          <p>{{ t_refill_text | replace: '[MIN]', c_min | replace: '[MAX]', c_max | escape }}</p>
          <ol class="bjc-tl" aria-label="{{ t_tl_label | escape }}">
            <li><strong>{{ t_tl1 | escape }}</strong><span>{{ t_tl1s | escape }}</span></li>
            <li><strong>{{ t_tl2 | escape }}</strong><span>{{ t_tl2s | replace: '[MIN]', c_min | escape }}</span></li>
            <li><strong>{{ t_tl3 | escape }}</strong><span>{{ t_tl3s | replace: '[MAX]', c_max | escape }}</span></li>
          </ol>
          {%- if section.settings.show_reminder -%}
            <div class="bjc-rem" data-bjc-reminder data-months="{{ c_min }}" data-title="{{ t_rem_event | escape }}" data-details="{{ c_rem_details | escape }}" data-file="besjaar-filter.ics">
              <span class="bjc-rem__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span>
              <div>
                <h3>{{ t_rem_title | escape }}</h3>
                <p>{{ t_rem_text | replace: '[MIN]', c_min | escape }}</p>
                <div class="bjc-rem__btns">
                  <a class="bjc-chip" href="https://calendar.google.com/calendar/render?action=TEMPLATE" target="_blank" rel="noopener" data-bjc-gcal>{{ t_rem_google | escape }}</a>
                  <button class="bjc-chip" type="button" data-bjc-ics>{{ t_rem_ics | escape }}</button>
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
        <a class="bjc-product" href="{{ c_refill_url }}">
          <span class="bjc-product__media">
            {%- if c_refill.featured_image != blank -%}
              {{ c_refill.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 901px) 380px, 90vw', alt: c_img_alt }}
            {%- endif -%}
          </span>
          <span class="bjc-product__title">{{ c_refill.title | escape }}</span>
          {%- if c_has_r -%}
            <span class="bjc-product__prices">
              <span class="bjc-product__member"><small>{{ t_member_price | escape }}</small><strong>{{ c_new }}</strong></span>
              <span class="bjc-product__regular"><small>{{ t_regular | escape }}</small><s>{{ c_old }}</s></span>
            </span>
          {%- else -%}
            <span class="bjc-product__prices"><span class="bjc-product__member"><strong>{{ c_old }}</strong></span></span>
          {%- endif -%}
          <span class="bjc-product__cta">{{ t_view_refill | escape }} <span aria-hidden="true">→</span></span>
        </a>
      </div>
    {%- endif -%}

    <div class="bjc-block bjc-incl">
      <div class="bjc-head">
        <span class="bjc-kicker">{{ t_inc_kicker | escape }}</span>
        <h2>{{ t_inc_title | escape }}</h2>
      </div>
      <ul class="bjc-incl__list" role="list">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h3l4 4v2h-7zM6 18a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 18a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg><div><strong>{{ c_ship_t | escape }}</strong><span>{{ c_ship_s | escape }}</span></div></li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10a6 6 0 1 1-5.2 9M4 7l3-3M4 7l3 3"/></svg><div><strong>{{ t_returns | replace: '[D]', c_days | escape }}</strong><span>{{ t_returns_s | replace: '[D]', c_days | escape }}</span></div></li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.6-2.9 8.2-7 10-4.1-1.8-7-5.4-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg><div><strong>{{ t_warranty | replace: '[M]', c_months | escape }}</strong><span>{{ t_warranty_s | escape }}</span></div></li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><div><strong>{{ t_secure | escape }}</strong><span>{{ t_secure_s | escape }}</span></div></li>
      </ul>
    </div>

    <div class="bjc-block bjc-faq">
      <div class="bjc-head">
        <span class="bjc-kicker">{{ t_faq_kicker | escape }}</span>
        <h2>{{ t_faq_title | escape }}</h2>
      </div>
      <div class="bjc-faq__list">
        <details><summary>{{ t_q1 | escape }}</summary><p>{{ t_a1 | escape }}</p></details>
        <details><summary>{{ t_q2 | escape }}</summary><p>{{ t_a2 | escape }}</p></details>
        {%- if c_has_r -%}<details><summary>{{ t_q3 | escape }}</summary><p>{% if c_has_w %}{{ t_a3_w | escape }}{% else %}{{ t_a3 | escape }}{% endif %}</p></details>{%- endif -%}
        <details><summary>{{ t_q4 | escape }}</summary><p>{{ t_a4 | escape }}{% if c_has_r %} {{ t_a4_r | escape }}{% endif %}</p></details>
        <details><summary>{{ t_q5 | escape }}</summary><p>{{ t_a5 | escape }}{% if shop.privacy_policy != blank %} <a href="{% render 'localized-internal-url', url: shop.privacy_policy.url %}">{{ t_privacy_cta | escape }}</a>{% endif %}</p></details>
        <details><summary>{{ t_q6 | escape }}</summary><p>{%- assign c_a6 = t_a6 | escape | split: '[EMAIL]' -%}{{ c_a6[0] }}<a href="mailto:{{ c_email | escape }}">{{ c_email | escape }}</a>{{ c_a6[1] }}</p></details>
      </div>
    </div>

    <div class="bjc-end">
      {%- if c_member -%}
        <div>
          <h2>{{ t_end_title_m | escape }}</h2>
          {%- if c_has_r and c_new != blank -%}<p>{{ t_end_text_m | escape | replace: '[NEW]', c_new | replace: '[OLD]', c_old }}</p>{%- endif -%}
        </div>
        {%- if c_refill_url != blank -%}
          <a class="bjc-btn bjc-btn--light" href="{{ c_refill_url }}">{{ t_cta_refill | escape }} <span aria-hidden="true">→</span></a>
        {%- else -%}
          <a class="bjc-btn bjc-btn--light" href="{{ c_shop_url }}">{{ t_cta_shop | escape }} <span aria-hidden="true">→</span></a>
        {%- endif -%}
      {%- else -%}
        <div>
          <h2>{{ t_end_title | escape }}</h2>
          <p>{{ t_end_text | escape }}</p>
        </div>
        <a class="bjc-btn bjc-btn--light" href="{{ c_login }}" rel="nofollow">{{ t_cta_join | escape }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>

    <div class="bjc-terms">
      <h2>{{ t_terms_title | escape }}</h2>
      <p>{{ c_terms | replace: '[W]', c_w | replace: '[R]', c_r | escape }}</p>
      <p class="bjc-terms__date">{{ t_updated | escape }}</p>
    </div>

    <p class="bjc-live" aria-live="polite" data-bjc-live></p>
  </div>
</section>

<style>
  .bjc{padding:clamp(24px,5vw,56px) 0 clamp(40px,8vw,88px);background:#FFFFFF;color:var(--bj-ink,#132A3E)}
  body[data-page-type] .bjc>.besjaar-store-shell{box-sizing:border-box!important;width:min(100% - 32px,1240px)!important;max-width:1240px!important;margin-left:auto!important;margin-right:auto!important;padding-left:0!important;padding-right:0!important}
  .bjc *{box-sizing:border-box}
  .bjc h1,.bjc h2,.bjc h3{font-family:var(--bj-font-heading,inherit);color:var(--bj-navy-deep,#102D49)}
  .bjc h2{margin:0;font-size:clamp(1.5rem,4.2vw,2.2rem);font-weight:600;line-height:1.12;letter-spacing:-.025em}
  .bjc h3{margin:0;font-size:1.02rem;font-weight:600;line-height:1.3;letter-spacing:-.01em}
  .bjc p{margin:0;color:var(--bj-muted,#61798E);line-height:1.6}
  .bjc a{color:inherit}
  .bjc :focus-visible{outline:2px solid var(--bj-blue,#3F779F);outline-offset:3px;border-radius:6px}
  .bjc-kicker{display:inline-flex;align-items:center;align-self:flex-start;margin:0 0 14px;padding:6px 12px;border:1px solid var(--bj-line,rgba(23,59,94,.12));border-radius:999px;background:var(--bj-ice-100,#EDF6FA);color:var(--bj-navy-bright,#24547C);font-family:var(--bj-font-body,inherit);font-size:.62rem;font-weight:700;letter-spacing:.14em;line-height:1;text-transform:uppercase}
  .bjc-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;padding:0 24px;border-radius:999px;background:var(--bj-navy-deep,#102D49);color:#FFFFFF!important;font-size:.95rem;font-weight:600;text-decoration:none;transition:background-color .2s ease,transform .2s ease}
  .bjc-btn:hover{background:var(--bj-navy,#173B5E)}
  .bjc-btn--light{background:#FFFFFF;color:var(--bj-navy-deep,#102D49)!important}
  .bjc-btn--light:hover{background:var(--bj-ice-100,#EDF6FA)}
  .bjc-link{color:var(--bj-navy-bright,#24547C)!important;font-size:.9rem;font-weight:600;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:2px}
  .bjc-block{margin-top:clamp(48px,8vw,96px)}
  .bjc-head{display:flex;flex-direction:column;max-width:44ch;margin:0 0 clamp(18px,3vw,28px)}

