{% liquid
  if section.settings.use_localized_copy
    assign v_kicker = 'industry.cta.kicker' | t
    assign v_heading = 'industry.cta.heading' | t
    assign v_primary = 'industry.cta.primary' | t
    assign v_secondary = 'industry.cta.secondary' | t
  else
    assign v_kicker = section.settings.kicker
    assign v_heading = section.settings.heading
    assign v_primary = section.settings.primary_label
    assign v_secondary = section.settings.secondary_label
  endif
%}
{% capture cta_primary_url %}{% render 'shower-store-url' %}{% endcapture %}
{% assign cta_primary_url = cta_primary_url | strip %}
{% assign cta_secondary_url = '#ind-details' %}
{% if request.page_type == 'product' %}{% assign cta_secondary_url = '#besjaar-product-details' %}{% endif %}
<section class="ind ind-cta" id="ind-koop">
  <div class="ind-shell ind-cta__grid">
    <div class="ind-cta__copy">
      <span class="ind-cta__kicker">{{ v_kicker | escape }}</span>
      <h2 class="ind-cta__title">{{ v_heading | escape }}</h2>
      <div class="ind-cta__actions">
        <a class="ind-btn ind-btn--paper" href="{% if section.settings.primary_link != blank %}{% render 'localized-internal-url', url: section.settings.primary_link %}{% else %}{{ cta_primary_url }}{% endif %}">{{ v_primary | escape }} <span aria-hidden="true">→</span></a>
        <a class="ind-btn ind-btn--ghostlight" href="{{ cta_secondary_url }}">{{ v_secondary | escape }}</a>
      </div>
    </div>
    <div class="ind-cta__visual" aria-hidden="true"><img src="{{ 'besjaar-product-front-exact.webp' | asset_url }}" alt="" width="1254" height="1254" loading="lazy" decoding="async"></div>
  </div>
</section>
{% schema %}
{
  "name": "Premium closing CTA",
  "settings": [
    {"type": "checkbox", "id": "use_localized_copy", "label": "Gebruik vertaalde teksten (NL/EN/DE/FR)", "default": true},
    {"type": "text", "id": "kicker", "label": "Kicker", "default": "BESJAAR® SHOWERHEADS"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Upgrade the shower you use every day."},
    {"type": "text", "id": "primary_label", "label": "Primary button", "default": "SHOP SHOWERHEADS"},
    {"type": "url", "id": "primary_link", "label": "Primary link"},
    {"type": "text", "id": "secondary_label", "label": "Secondary button", "default": "EXPLORE THE DETAILS"}
  ],
  "presets": [{"name": "Premium closing CTA"}]
}
{% endschema %}
