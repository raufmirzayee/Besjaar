{%- comment -%}
  Besjaar brand intro (2026-10-14): introduces BESJAAR as "jouw dagelijkse
  douchepartner" with three brand principles. Copy comes from the
  besjaar-brand-copy snippet in the visitor's language; switch off
  "Use translated brand copy" to type your own text (then shown in every
  language).
{%- endcomment -%}
{%- liquid
  if section.settings.use_localized_copy
    capture v_kicker
      render 'besjaar-brand-copy', key: 'intro_kicker'
    endcapture
    capture v_heading
      render 'besjaar-brand-copy', key: 'intro_heading'
    endcapture
    capture v_text
      render 'besjaar-brand-copy', key: 'intro_text'
    endcapture
    capture v_p1_title
      render 'besjaar-brand-copy', key: 'p1_title'
    endcapture
    capture v_p1_text
      render 'besjaar-brand-copy', key: 'p1_text'
    endcapture
    capture v_p2_title
      render 'besjaar-brand-copy', key: 'p2_title'
    endcapture
    capture v_p2_text
      render 'besjaar-brand-copy', key: 'p2_text'
    endcapture
    capture v_p3_title
      render 'besjaar-brand-copy', key: 'p3_title'
    endcapture
    capture v_p3_text
      render 'besjaar-brand-copy', key: 'p3_text'
    endcapture
    capture v_link
      render 'besjaar-brand-copy', key: 'intro_link'
    endcapture
  else
    assign v_kicker = section.settings.kicker
    assign v_heading = section.settings.heading
    assign v_text = section.settings.text
    assign v_p1_title = section.settings.p1_title
    assign v_p1_text = section.settings.p1_text
    assign v_p2_title = section.settings.p2_title
    assign v_p2_text = section.settings.p2_text
    assign v_p3_title = section.settings.p3_title
    assign v_p3_text = section.settings.p3_text
    assign v_link = section.settings.link_label
  endif

  assign about_page = section.settings.about_page
  if about_page == blank
    assign about_page = pages['about-us']
  endif
  if about_page == blank
    assign about_page = pages['over-ons']
  endif
-%}
{{ 'besjaar-brand.css' | asset_url | stylesheet_tag }}
<section class="bjb bjb-intro" id="besjaar-brand-intro" aria-labelledby="BjbIntroTitle-{{ section.id }}">
  <div class="bjb__shell bjb-intro__grid">
    <div class="bjb-intro__copy">
      <p class="bjb__kicker">{{ v_kicker | strip | escape }}</p>
      <h2 class="bjb__h2" id="BjbIntroTitle-{{ section.id }}">{{ v_heading | strip | escape }}</h2>
      <p class="bjb__lead">{{ v_text | strip | escape }}</p>
      {%- if about_page != blank and section.settings.show_about_link -%}
        <a class="bjb__link" href="{% render 'localized-internal-url', url: about_page.url %}">{{ v_link | strip | escape }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>
    <ul class="bjb-intro__principles">
      <li class="bjb-intro__principle">
        <span class="bjb-intro__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 11l3 3 8-8"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/></svg></span>
        <h3>{{ v_p1_title | strip | escape }}</h3>
        <p>{{ v_p1_text | strip | escape }}</p>
      </li>
      <li class="bjb-intro__principle">
        <span class="bjb-intro__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3c3.5 4.2 6 7.4 6 10.5a6 6 0 0 1-12 0C6 10.4 8.5 7.2 12 3z"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/></svg></span>
        <h3>{{ v_p2_title | strip | escape }}</h3>
        <p>{{ v_p2_text | strip | escape }}</p>
      </li>
      <li class="bjb-intro__principle">
        <span class="bjb-intro__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/><path d="M9 10h6M9 14h4"/></svg></span>
        <h3>{{ v_p3_title | strip | escape }}</h3>
        <p>{{ v_p3_text | strip | escape }}</p>
      </li>
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Besjaar brand intro",
  "tag": "div",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_localized_copy",
      "label": "Use translated brand copy (NL/EN/DE/FR/ES)",
      "info": "On: the brand text is shown in the visitor's language. Off: the text fields below are used in every language.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_about_link",
      "label": "Show link to the About page",
      "default": true
    },
    {
      "type": "page",
      "id": "about_page",
      "label": "About page",
      "info": "Defaults to the page with handle about-us."
    },
    {
      "type": "header",
      "content": "Own text (only when translated copy is off)"
    },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "JOUW DAGELIJKSE DOUCHEPARTNER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Jouw dagelijkse douche verdient aandacht." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "p1_title", "label": "Principle 1 title", "default": "Kies met vertrouwen" },
    { "type": "text", "id": "p1_text", "label": "Principle 1 text" },
    { "type": "text", "id": "p2_title", "label": "Principle 2 title", "default": "Gemaakt voor dagelijks gebruik" },
    { "type": "text", "id": "p2_text", "label": "Principle 2 text" },
    { "type": "text", "id": "p3_title", "label": "Principle 3 title", "default": "Hulp wanneer je die nodig hebt" },
    { "type": "text", "id": "p3_text", "label": "Principle 3 text" },
    { "type": "text", "id": "link_label", "label": "About link label", "default": "Over BESJAAR" }
  ],
  "presets": [{ "name": "Besjaar brand intro" }]
}
{% endschema %}
