<section class="nova-404"><div class="nova-shell"><p class="nova-kicker">{{ 'nova.password.kicker' | t }}</p><h1 class="nova-title" translate="no">Besjaar</h1>{% unless shop.password_message == blank %}<p class="nova-copy" style="margin-inline:auto">{{ shop.password_message }}</p>{% endunless %}{% form 'storefront_password' %}<div class="nova-search-form" style="margin-top:24px"><label class="nova-visually-hidden" for="StorefrontPassword">{{ 'nova.password.placeholder' | t }}</label><input class="nova-input" id="StorefrontPassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'nova.password.placeholder' | t }}" required><button class="nova-button nova-button--primary" type="submit">{{ 'nova.password.open_store' | t }}</button></div>{% if form.errors %}<div class="nova-form-message" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div></section>
{% schema %}{"name":"Password page","settings":[]}{% endschema %}
