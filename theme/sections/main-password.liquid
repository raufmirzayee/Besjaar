<section class="besjaar-ui-404"><div class="besjaar-ui-shell"><p class="besjaar-ui-kicker">{{ 'besjaar_ui.password.kicker' | t }}</p><h1 class="besjaar-ui-title" translate="no">Besjaar</h1>{% unless shop.password_message == blank %}<p class="besjaar-ui-copy" style="margin-inline:auto">{{ shop.password_message }}</p>{% endunless %}{% form 'storefront_password' %}<div class="besjaar-ui-search-form" style="margin-top:24px"><label class="besjaar-ui-visually-hidden" for="StorefrontPassword">{{ 'besjaar_ui.password.placeholder' | t }}</label><input class="besjaar-ui-input" id="StorefrontPassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'besjaar_ui.password.placeholder' | t }}" required><button class="besjaar-ui-button besjaar-ui-button--primary" type="submit">{{ 'besjaar_ui.password.open_store' | t }}</button></div>{% if form.errors %}<div class="besjaar-ui-form-message" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div></section>
{% schema %}{"name":"Password page","settings":[]}{% endschema %}
