<section class="nova-section nova-home-faq" id="besjaar-faq">
  <div class="nova-shell">
    <header class="nova-home-support__head">
      <p class="nova-kicker">{{ 'nova.faq_general.kicker' | t }}</p>
      <h2>{{ 'nova.faq_general.title' | t }}</h2>
      <p>{{ 'nova.faq_general.intro' | t }}</p>
    </header>
    <div class="nova-product-v16__accordion nova-home-faq__accordion">
      <details open><summary><b aria-hidden="true">01</b><span>{{ 'nova.faq_general.q1' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a1' | t }}</p></div></details>
      <details><summary><b aria-hidden="true">02</b><span>{{ 'nova.faq_general.q2' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a2' | t }}</p></div></details>
      <details><summary><b aria-hidden="true">03</b><span>{{ 'nova.faq_general.q3' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a3' | t }}</p></div></details>
      <details><summary><b aria-hidden="true">04</b><span>{{ 'nova.faq_general.q6' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a6' | t }}</p></div></details>
      <details><summary><b aria-hidden="true">05</b><span>{{ 'nova.faq_general.q7' | t }}</span><i aria-hidden="true">+</i></summary><div class="nova-product-v16__accordion-content nova-content"><p>{{ 'nova.faq_general.a7' | t }}</p></div></details>
    </div>
  </div>
</section>
{% schema %}{"name":"Home FAQ","settings":[],"presets":[{"name":"Home FAQ"}]}{% endschema %}
