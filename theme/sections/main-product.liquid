{% capture besjaar_ui_focus_head_capture %}{% render 'is-focus-showerhead', product: product %}{% endcapture %}
{% assign besjaar_ui_focus_head = besjaar_ui_focus_head_capture | strip %}
{% if besjaar_ui_focus_head != 'true' %}
  {% capture besjaar_ui_focused_shop_url %}{% render 'shower-store-url' %}{% endcapture %}
  <section class="besjaar-ui-section besjaar-ui-shower-retired-product">
    <div class="besjaar-ui-shell">
      <div class="besjaar-ui-shower-retired-product__panel">
        <p class="besjaar-ui-kicker">{{ 'besjaar_ui.shower_store.retired.kicker' | t }}</p>
        <h1>{{ 'besjaar_ui.shower_store.retired.heading' | t }}</h1>
        <p>{{ 'besjaar_ui.shower_store.retired.copy' | t }}</p>
        <a class="besjaar-ui-button besjaar-ui-button--primary" href="{{ besjaar_ui_focused_shop_url | strip }}">{{ 'besjaar_ui.shower_store.retired.cta' | t }} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
{% else %}
{% if section.settings.shower_editorial_mode %}{{ 'besjaar-ui-conversion-qa.css' | asset_url | stylesheet_tag }}{% endif %}
{% liquid
  assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign product_form_id = 'product-form-' | append: section.id
  assign product_status_id = 'BesjaarUIProductStatus-' | append: section.id
  assign first_collection = product.collections.first
  assign selected_media = selected_variant.featured_media | default: product.featured_media
  assign selected_media_index = 1
  for media in product.media
    if media.id == selected_media.id
      assign selected_media_index = forloop.index
      break
    endif
  endfor
  assign rating_metafield = product.metafields.reviews.rating
  assign rating_count_metafield = product.metafields.reviews.rating_count
  assign title_downcase = product.title | downcase
  assign allow_legacy_title_fallback = false
  if product.metafields.custom.product_family == blank
    assign allow_legacy_title_fallback = true
  endif
  capture besjaar_ui_localized_product_title
    render 'localized-product-title', product: product
  endcapture
  assign display_title = besjaar_ui_localized_product_title | strip
  assign product_subtitle = ''
  if product.metafields.descriptors.subtitle != blank
    assign product_subtitle = product.metafields.descriptors.subtitle.value
  elsif product.metafields.custom.product_subtitle != blank
    assign product_subtitle = product.metafields.custom.product_subtitle.value
  endif
  assign best_for = ''
  if product.metafields.custom.best_for != blank
    assign best_for = product.metafields.custom.best_for.value
  endif
  assign why_choose = ''
  if product.metafields.custom.why_choose != blank
    assign why_choose = product.metafields.custom.why_choose.value
  endif

  capture besjaar_ui_product_family
    render 'product-family', product: product, template_hint: template.suffix
  endcapture
  assign product_family = besjaar_ui_product_family | strip
  assign is_shower_product = false
  if product_family == 'shower'
    assign is_shower_product = true
  endif

  assign shower_family = ''
  if product.metafields.custom.shower_family != blank
    assign shower_family = product.metafields.custom.shower_family.value | downcase | strip
  endif
  if shower_family != blank
    assign is_shower_product = true
    assign product_family = 'shower'
  endif

  assign product_360_frames = product.metafields.custom.product_360_frames.value
  assign has_360_frames = false
  if product_360_frames != blank and product_360_frames.size >= 8
    assign has_360_frames = true
  elsif product.handle == 'besjaar-douchekop-met-slang-hoge-druk-met-filter-10-sproeistanden-regendouche-waterbesparende-handdouche-zilver'
    assign has_360_frames = true
  endif
  assign has_product_video = false
  assign has_product_model = false
  for media in product.media
    if media.media_type == 'video' or media.media_type == 'external_video'
      assign has_product_video = true
    elsif media.media_type == 'model'
      assign has_product_model = true
    endif
  endfor

  assign shower_type = ''
  if product.metafields.custom.shower_type != blank
    assign shower_type = product.metafields.custom.shower_type.value
  endif
  assign shower_spray_modes = ''
  if product.metafields.custom.spray_modes != blank
    assign shower_spray_modes = product.metafields.custom.spray_modes.value
  endif
  assign shower_diameter = ''
  if product.metafields.custom.diameter_mm != blank
    assign shower_diameter = product.metafields.custom.diameter_mm.value
  endif
  assign shower_material = ''
  if product.metafields.custom.material != blank
    assign shower_material = product.metafields.custom.material.value
  elsif product.metafields.custom.materials != blank
    assign shower_material = product.metafields.custom.materials.value
  endif
  assign shower_colour = ''
  if product.metafields.custom.colour != blank
    assign shower_colour = product.metafields.custom.colour.value
  endif
  assign shower_filter_defined = false
  assign shower_filter_included = false
  if product.metafields.custom.filter_included != blank
    assign shower_filter_defined = true
    assign shower_filter_included = product.metafields.custom.filter_included.value
  endif
  assign shower_filter_type = ''
  if product.metafields.custom.filter_type != blank
    assign shower_filter_type = product.metafields.custom.filter_type.value
  endif
  assign shower_hose_defined = false
  assign shower_hose_included = false
  if product.metafields.custom.hose_included != blank
    assign shower_hose_defined = true
    assign shower_hose_included = product.metafields.custom.hose_included.value
  endif
  assign shower_hose_length = ''
  if product.metafields.custom.hose_length_cm != blank
    assign shower_hose_length = product.metafields.custom.hose_length_cm.value
  endif
  assign shower_connection = ''
  if product.metafields.custom.connection_size != blank
    assign shower_connection = product.metafields.custom.connection_size.value
  endif
  assign shower_anti_limescale_defined = false
  assign shower_anti_limescale = false
  if product.metafields.custom.anti_limescale != blank
    assign shower_anti_limescale_defined = true
    assign shower_anti_limescale = product.metafields.custom.anti_limescale.value
  endif
  assign shower_installation_time = ''
  if product.metafields.custom.installation_time_min != blank
    assign shower_installation_time = product.metafields.custom.installation_time_min.value
  endif
  assign shower_warranty_months = ''
  if product.metafields.custom.warranty_months != blank
    assign shower_warranty_months = product.metafields.custom.warranty_months.value
  endif
  assign shower_compatibility = ''
  if product.metafields.custom.compatibility_note != blank
    assign shower_compatibility = product.metafields.custom.compatibility_note.value
  elsif product.metafields.custom.compatibility != blank
    assign shower_compatibility = product.metafields.custom.compatibility.value
  endif

  assign display_vendor = product.vendor | default: 'Besjaar'
  if is_shower_product or title_downcase contains 'besjaar'
    assign display_vendor = 'Besjaar'
  endif

  assign retail_spray_modes = shower_spray_modes
  if retail_spray_modes == blank and allow_legacy_title_fallback
    if title_downcase contains '12 sproei' or title_downcase contains '12 spray'
      assign retail_spray_modes = 12
    elsif title_downcase contains '11 sproei' or title_downcase contains '11 spray'
      assign retail_spray_modes = 11
    elsif title_downcase contains '10 sproei' or title_downcase contains '10 spray'
      assign retail_spray_modes = 10
    elsif title_downcase contains '9 sproei' or title_downcase contains '9 spray'
      assign retail_spray_modes = 9
    elsif title_downcase contains '8 sproei' or title_downcase contains '8 spray'
      assign retail_spray_modes = 8
    elsif title_downcase contains '7 sproei' or title_downcase contains '7 spray'
      assign retail_spray_modes = 7
    elsif title_downcase contains '6 sproei' or title_downcase contains '6 spray'
      assign retail_spray_modes = 6
    elsif title_downcase contains '5 sproei' or title_downcase contains '5 spray'
      assign retail_spray_modes = 5
    elsif title_downcase contains '4 sproei' or title_downcase contains '4 spray'
      assign retail_spray_modes = 4
    elsif title_downcase contains '3 sproei' or title_downcase contains '3 spray'
      assign retail_spray_modes = 3
    elsif title_downcase contains '2 sproei' or title_downcase contains '2 spray'
      assign retail_spray_modes = 2
    endif
  endif
  assign retail_has_filter = shower_filter_included
  if shower_filter_defined == false and allow_legacy_title_fallback
    if title_downcase contains 'met filter' or title_downcase contains 'with filter' or title_downcase contains 'filtered shower'
      assign retail_has_filter = true
    endif
  endif
  assign retail_has_hose = shower_hose_included
  if shower_hose_defined == false and allow_legacy_title_fallback
    if title_downcase contains 'met slang' or title_downcase contains 'with hose'
      assign retail_has_hose = true
    endif
  endif
  assign retail_package_count = product.metafields.custom.package_quantity.value | default: 0
  if retail_package_count == 0 and allow_legacy_title_fallback
    if title_downcase contains '2 stuks' or title_downcase contains '2-pack' or title_downcase contains '2 pack' or title_downcase contains '2 filters' or title_downcase contains '2 vervangingsfilters'
      assign retail_package_count = 2
    endif
  endif

  assign retail_colour = shower_colour | default: ''
  if retail_colour == blank and allow_legacy_title_fallback
    if title_downcase contains 'zilver' or title_downcase contains 'silver'
      assign retail_colour = 'silver'
    elsif title_downcase contains 'chroom' or title_downcase contains 'chrome'
      assign retail_colour = 'chrome'
    elsif title_downcase contains 'zwart' or title_downcase contains 'black'
      assign retail_colour = 'black'
    elsif title_downcase contains 'wit' or title_downcase contains 'white'
      assign retail_colour = 'white'
    endif
  endif
  assign retail_colour_key = retail_colour | downcase | strip
  assign localized_retail_colour = retail_colour
  case retail_colour_key
    when 'zilver', 'silver'
      assign localized_retail_colour = 'besjaar_ui.product.color_silver' | t
    when 'chroom', 'chrome'
      assign localized_retail_colour = 'besjaar_ui.product.color_chrome' | t
    when 'zwart', 'black'
      assign localized_retail_colour = 'besjaar_ui.product.color_black' | t
    when 'wit', 'white'
      assign localized_retail_colour = 'besjaar_ui.product.color_white' | t
  endcase

  assign retail_is_filter_only = false
  if shower_family == 'shower_filter'
    assign retail_is_filter_only = true
  elsif allow_legacy_title_fallback
    if title_downcase contains 'douchefilter' or title_downcase contains 'shower filter'
      unless title_downcase contains 'douchekop' or title_downcase contains 'shower head'
        assign retail_is_filter_only = true
      endunless
    endif
  endif

  if is_shower_product and product.metafields.custom.short_title == blank
    assign retail_is_filter_only = false
    if shower_family == 'shower_filter'
      assign retail_is_filter_only = true
    elsif allow_legacy_title_fallback
      if title_downcase contains 'douchefilter' or title_downcase contains 'shower filter'
        unless title_downcase contains 'douchekop' or title_downcase contains 'shower head'
          assign retail_is_filter_only = true
        endunless
      endif
    endif
    if retail_is_filter_only
      if retail_package_count == 2
        assign display_title = 'besjaar_ui.product.retail_shower_filter_two_pack' | t
      else
        assign display_title = 'besjaar_ui.product.retail_shower_filter' | t
      endif
    else
      assign display_title = 'besjaar_ui.product.retail_shower_head' | t
      if retail_has_filter and retail_has_hose
        assign retail_suffix = 'besjaar_ui.product.retail_with_filter_hose' | t
        assign display_title = display_title | append: ' ' | append: retail_suffix
      elsif retail_has_filter
        assign retail_suffix = 'besjaar_ui.product.retail_with_filter' | t
        assign display_title = display_title | append: ' ' | append: retail_suffix
      elsif retail_has_hose
        assign retail_suffix = 'besjaar_ui.product.retail_with_hose' | t
        assign display_title = display_title | append: ' ' | append: retail_suffix
      endif
      if retail_spray_modes != blank
        assign retail_modes_text = 'besjaar_ui.product.retail_spray_modes' | t: count: retail_spray_modes
        assign display_title = display_title | append: ' – ' | append: retail_modes_text
      endif
    endif
    if localized_retail_colour != blank and retail_is_filter_only == false
      assign display_title = display_title | append: ' – ' | append: localized_retail_colour
    endif
  endif

  assign description_needs_locale_fallback = false
  assign description_plain_lc = product.description | strip_html | downcase
  if request.locale.iso_code == 'en'
    if description_plain_lc contains 'douche' or description_plain_lc contains 'sproei' or description_plain_lc contains 'dankzij' or description_plain_lc contains 'kies uit' or description_plain_lc contains 'waterbespar' or description_plain_lc contains 'huisdieren' or description_plain_lc contains 'geschikt voor' or description_plain_lc contains 'wordt geleverd' or description_plain_lc contains 'inclusief' or description_plain_lc contains 'eenvoudig'
      assign description_needs_locale_fallback = true
    endif
  elsif request.locale.iso_code == 'nl'
    if description_plain_lc contains 'shower head' or description_plain_lc contains 'spray modes' or description_plain_lc contains 'choose from' or description_plain_lc contains 'designed for' or description_plain_lc contains 'includes' or description_plain_lc contains 'easy to use'
      assign description_needs_locale_fallback = true
    endif
  elsif request.locale.iso_code == 'de' or request.locale.iso_code == 'fr'
    if description_plain_lc contains 'douche' or description_plain_lc contains 'sproei' or description_plain_lc contains 'dankzij' or description_plain_lc contains 'kies uit' or description_plain_lc contains 'waterbespar' or description_plain_lc contains 'huisdieren' or description_plain_lc contains 'geschikt voor' or description_plain_lc contains 'wordt geleverd' or description_plain_lc contains 'inclusief' or description_plain_lc contains 'eenvoudig' or description_plain_lc contains 'shower head' or description_plain_lc contains 'spray modes' or description_plain_lc contains 'choose from' or description_plain_lc contains 'designed for' or description_plain_lc contains 'includes' or description_plain_lc contains 'easy to use'
      assign description_needs_locale_fallback = true
    endif
  endif

  assign has_shower_specs = false
  if is_shower_product
    if shower_type != blank or retail_spray_modes != blank or shower_diameter != blank or shower_material != blank or shower_colour != blank or shower_filter_defined or retail_has_filter or shower_filter_type != blank or shower_hose_defined or retail_has_hose or shower_hose_length != blank or shower_connection != blank or shower_anti_limescale_defined or shower_installation_time != blank or shower_warranty_months != blank or shower_compatibility != blank
      assign has_shower_specs = true
    endif
  endif
  assign has_shower_quick_facts = false
  if is_shower_product
    if retail_spray_modes != blank or shower_filter_defined or retail_has_filter or shower_hose_defined or retail_has_hose or shower_connection != blank or shower_diameter != blank or retail_package_count > 0
      assign has_shower_quick_facts = true
    endif
  endif


  assign has_specs = false
  if product.metafields.custom.materials != blank or product.metafields.custom.dimensions != blank or product.metafields.custom.weight != blank or product.metafields.custom.warranty != blank or product.metafields.custom.compatibility != blank or has_shower_specs
    assign has_specs = true
  endif

  assign quick_fact_count = 0
  assign has_quick_facts = false
  if product.metafields.custom.warranty != blank or product.metafields.custom.weight != blank or has_shower_quick_facts
    assign has_quick_facts = true
  endif

  assign show_fact_strip = false
  if section.settings.show_quick_facts
    if has_quick_facts
      assign show_fact_strip = true
    endif
  endif

  assign show_model_finder_link = false
  assign model_finder_collection = settings.shower_collection
  if model_finder_collection == blank
    assign model_finder_collection = collections['badkamer-douche']
  endif
  if model_finder_collection == blank
    assign model_finder_collection = collections['douchekoppen']
  endif
  if model_finder_collection == blank
    assign model_finder_collection = collections['showerheads']
  endif
  if model_finder_collection == blank
    assign model_finder_collection = collections['douche']
  endif
  if model_finder_collection == blank
    assign model_finder_collection = collections['shower']
  endif
  if is_shower_product
    if settings.shower_model_1 != blank and settings.shower_model_2 != blank
      assign show_model_finder_link = true
    elsif model_finder_collection != blank and model_finder_collection.products_count > 1
      assign show_model_finder_link = true
    endif
  endif
%}

<section
  class="besjaar-ui-product-v16 besjaar-ui-product-v17 besjaar-ui-product-v18 besjaar-ui-product-v20{% if section.settings.shower_editorial_mode and is_shower_product %} besjaar-ui-product-shower-editorial{% endif %}{% if is_shower_product %} besjaar-ui-product--shower{% endif %}{% if product.media.size > 1 %} besjaar-ui-mobile-gallery-enabled besjaar-ui-desktop-gallery-enabled{% endif %}"
  data-product-root
  data-product-family="{{ product_family | escape }}"
  data-add-label="{{ 'besjaar_ui.product.add_to_cart_label' | t | escape }}"
  data-sold-out-label="{{ 'besjaar_ui.product.sold_out' | t | escape }}"
  data-in-stock-label="{{ 'besjaar_ui.product.in_stock' | t | escape }}"
  data-out-of-stock-label="{{ 'besjaar_ui.product.out_of_stock' | t | escape }}"
  data-add-error="{{ 'besjaar_ui.conversion.add_error' | t | escape }}"
  data-added-status="{{ 'besjaar_ui.conversion.added_status' | t | escape }}"
  data-purchase-option-price-label="{{ 'besjaar_ui.product.purchase_option_price' | t | escape }}"
  data-one-time-purchase-label="{{ 'besjaar_ui.product.one_time_purchase' | t | escape }}"
  data-requires-selling-plan="{{ product.requires_selling_plan | json }}"
>
  {% if request.design_mode %}
    {% if product.metafields.custom.product_family == blank %}<div class="besjaar-ui-product-data-health"><strong>Besjaar showerhead data:</strong> set <code>custom.product_family</code> to <code>shower</code> and complete the showerhead metafields for this model. Current migration fallback: <code>{{ product_family }}</code>.</div>
    {% elsif product_family == 'shower' and template.suffix != 'shower' %}<div class="besjaar-ui-product-data-health"><strong>BesjaarUI 5.4 setup:</strong> this product is marked <code>shower</code>. Assign the <code>shower</code> theme template to enable the dedicated shower sections.</div>{% endif %}
  {% endif %}
  <div class="besjaar-ui-shell">
    {% if section.settings.show_breadcrumbs %}
      <nav class="besjaar-ui-product-v16__breadcrumbs" aria-label="{{ 'besjaar_ui.product.breadcrumbs' | t | escape }}">
        <a href="{{ routes.root_url }}">{{ 'besjaar_ui.product.home' | t }}</a>
        <span>/</span>
        {% if section.settings.show_collection_breadcrumb and collection != blank %}
          <a href="{% render 'localized-internal-url', url: collection.url %}">{% render 'localized-collection-title', collection: collection %}</a>
          <span>/</span>
        {% endif %}
        <span aria-current="page">{{ display_title | truncate: 54 }}</span>
      </nav>
    {% endif %}

    <div class="besjaar-ui-product-v16__grid">
      <div class="besjaar-ui-product-v16__gallery" data-reveal>
        <div class="besjaar-ui-product-v16__media-stage"{% if product.media.size > 1 %} tabindex="0" role="region" aria-label="{{ 'besjaar_ui.product.gallery_browse_label' | t | escape }}"{% endif %}>
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <div
                class="besjaar-ui-product-v16__media{% if media.id == selected_media.id %} is-active{% endif %}{% if media.media_type == 'image' %} is-image{% endif %}"
                data-product-media="{{ media.id }}"
                data-media-type="{{ media.media_type }}"
                {% unless media.id == selected_media.id %}hidden aria-hidden="true"{% else %}aria-hidden="false"{% endunless %}
              >
                {% case media.media_type %}
                  {% when 'image' %}
                    {% assign media_alt = media.alt | default: display_title %}
                    {% assign zoom_src = media | image_url: width: 2400 %}
                    <img
                      class="besjaar-ui-product-v16__image"
                      src="{{ media | image_url: width: 1200 }}"
                      srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1500 }} 1500w, {{ media | image_url: width: 1800 }} 1800w"
                      sizes="(min-width: 1000px) 56vw, 100vw"
                      alt="{{ media_alt | escape }}"
                      width="{{ media.preview_image.width }}"
                      height="{{ media.preview_image.height }}"
                      loading="{% if media.id == selected_media.id %}eager{% else %}lazy{% endif %}"
                      fetchpriority="{% if media.id == selected_media.id %}high{% else %}auto{% endif %}"
                      decoding="async"
                      data-product-image
                      data-zoom-src="{{ zoom_src }}"
                    >
                  {% when 'video' %}
                    {{ media | video_tag: controls: true, preload: 'metadata', image_size: '1200x', class: 'besjaar-ui-product-v16__video' }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag: class: 'besjaar-ui-product-v16__external-video' }}
                  {% when 'model' %}
                    {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, class: 'besjaar-ui-product-v16__model' }}
                  {% else %}
                    {{ media.preview_image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: display_title }}
                {% endcase %}
              </div>
            {% endfor %}
          {% else %}
            <div class="besjaar-ui-product-v16__media is-active is-image"><div class="besjaar-ui-abstract-device"></div></div>
          {% endif %}

          {% if product.media.size > 1 %}
            <button type="button" class="besjaar-ui-product-gallery-nav besjaar-ui-product-gallery-nav--prev" data-gallery-prev aria-label="{{ 'besjaar_ui.accessibility.previous_product_image' | t | escape }}">←</button>
            <button type="button" class="besjaar-ui-product-gallery-nav besjaar-ui-product-gallery-nav--next" data-gallery-next aria-label="{{ 'besjaar_ui.accessibility.next_product_image' | t | escape }}">→</button>
            <div class="besjaar-ui-product-v16__media-count" role="status" aria-live="polite" aria-atomic="true"><span data-media-current>{{ selected_media_index }}</span> / {{ product.media.size }}</div>
          {% endif %}
        </div>

        {% if product.media.size > 1 %}<p class="besjaar-ui-mobile-gallery-hint besjaar-ui-gallery-interaction-hint"><span aria-hidden="true">↔</span><span class="besjaar-ui-gallery-hint--desktop">{{ 'besjaar_ui.product.drag_gallery' | t }}</span><span class="besjaar-ui-gallery-hint--mobile">{{ 'besjaar_ui.mobile.swipe_gallery' | t }}</span></p>{% endif %}

        {% if product.media.size > 1 %}
          <div class="besjaar-ui-product-v16__thumbs" role="group" aria-label="{{ 'besjaar_ui.product.product_media' | t | escape }}">
            {% for media in product.media limit: 12 %}
              <button
                class="besjaar-ui-product-v16__thumb{% if media.id == selected_media.id %} is-active{% endif %}"
                type="button"
                data-product-media-thumb="{{ media.id }}"
                data-media-index="{{ forloop.index }}"
                aria-label="{{ 'besjaar_ui.accessibility.view_image' | t: index: forloop.index }}"
                aria-pressed="{% if media.id == selected_media.id %}true{% else %}false{% endif %}"
              >
                {% if media.preview_image != blank %}
                  {{ media.preview_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: media.alt | default: display_title }}
                {% endif %}
                {% unless media.media_type == 'image' %}
                  <span class="besjaar-ui-product-v16__media-type">{% if media.media_type == 'model' %}3D{% else %}{{ 'besjaar_ui.immersive.video_short' | t }}{% endif %}</span>
                {% endunless %}
              </button>
            {% endfor %}
          </div>
        {% endif %}

        {% if has_360_frames or has_product_video or has_product_model %}
          <div class="besjaar-ui-product-media-dock" aria-label="{{ 'besjaar_ui.immersive.media_options' | t | escape }}">
            {% if has_360_frames %}<a class="besjaar-ui-product-media-dock__item" href="#BesjaarUIProduct360-{{ product.id }}"><span class="besjaar-ui-product-media-dock__icon" aria-hidden="true">↻</span>{{ 'besjaar_ui.immersive.view_360' | t }}</a>{% endif %}
