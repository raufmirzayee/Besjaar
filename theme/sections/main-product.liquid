              {% if shower_anti_limescale_defined %}<div><span>{{ 'besjaar_ui.product.shower_anti_limescale' | t }}</span><strong>{% if shower_anti_limescale %}{{ 'besjaar_ui.common.yes' | t }}{% else %}{{ 'besjaar_ui.common.no' | t }}{% endif %}</strong></div>{% endif %}
              {% if shower_installation_time != blank %}<div><span>{{ 'besjaar_ui.product.shower_installation' | t }}</span><strong>{{ 'besjaar_ui.product.shower_minutes' | t: count: shower_installation_time }}</strong></div>{% endif %}
              {% if shower_warranty_months != blank %}<div><span>{{ 'besjaar_ui.product.spec_warranty' | t }}</span><strong>{{ 'besjaar_ui.product.shower_months' | t: count: shower_warranty_months }}</strong></div>{% elsif product.metafields.custom.warranty != blank %}<div><span>{{ 'besjaar_ui.product.spec_warranty' | t }}</span><strong>{{ product.metafields.custom.warranty.value }}</strong></div>{% endif %}
              {% if shower_compatibility != blank %}<div><span>{{ 'besjaar_ui.product.shower_compatibility' | t }}</span><strong>{{ shower_compatibility }}</strong></div>{% endif %}
            {% endif %}
          </div>
        </details>
      {% endif %}

      {% if product.metafields.custom.package_contents != blank or product.metafields.custom.box_contents != blank %}
        <details>
          <summary><span>{{ 'besjaar_ui.product.box_contents' | t }}</span><i>+</i></summary>
          <div class="besjaar-ui-product-v16__accordion-content">{% if product.metafields.custom.package_contents != blank %}{{ product.metafields.custom.package_contents.value | newline_to_br }}{% else %}{{ product.metafields.custom.box_contents.value }}{% endif %}</div>
        </details>
      {% endif %}

      {% if is_shower_product and product.metafields.custom.care_instructions != blank or is_shower_product and product.metafields.custom.filter_replacement_interval != blank %}
        <details>
          <summary><span>{{ 'besjaar_ui.product.shower_care' | t }}</span><i>+</i></summary>
          <div class="besjaar-ui-product-v16__accordion-content besjaar-ui-content">
            {% if product.metafields.custom.care_instructions != blank %}<p>{{ product.metafields.custom.care_instructions.value | newline_to_br }}</p>{% endif %}
            {% if product.metafields.custom.filter_replacement_interval != blank %}<p><strong>{{ 'besjaar_ui.product.shower_filter_replacement' | t }}:</strong> {{ product.metafields.custom.filter_replacement_interval.value }}</p>{% endif %}
          </div>
        </details>
      {% endif %}

      <details>
        <summary><span>{{ 'besjaar_ui.product.delivery_returns' | t }}</span><i>+</i></summary>
        <div class="besjaar-ui-product-v16__service-copy">
          <div><strong>{{ 'besjaar_ui.delivery.estimate_title' | t }}</strong><p>{% if settings.show_delivery_estimates %}<span data-delivery-estimate>{{ 'besjaar_ui.delivery.estimate_fallback' | t: min: settings.transit_min_business_days, max: settings.transit_max_business_days }}</span>. {% endif %}{{ 'besjaar_ui.delivery.checkout_confirmation' | t }}</p></div>
          <div><strong>{{ 'besjaar_ui.delivery.returns_title' | t }}</strong><p>{{ 'besjaar_ui.delivery.returns_value' | t: days: settings.return_window_days }}. {{ 'besjaar_ui.delivery.returns_note' | t }}</p></div>
          <div><strong>{{ 'besjaar_ui.product.secure_payment' | t }}</strong><p>{{ 'besjaar_ui.product.payment_long' | t }}</p></div>
        </div>
      </details>
    </div>
  </div>

  {% endif %}
  {% if section.settings.show_sticky_atc %}
    <div class="besjaar-ui-sticky-atc" data-sticky-atc aria-hidden="true" inert>
      <div class="besjaar-ui-sticky-atc__product">
        {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: display_title }}{% endif %}
        <div><strong data-sticky-title>{{ display_title | truncate: 48 }}</strong><span class="besjaar-ui-sticky-atc__meta"><span data-sticky-price>{{ selected_variant.price | money }}</span>{% if section.settings.show_reviews and rating_metafield != blank and rating_count_metafield != blank and rating_count_metafield.value > 0 %}<span class="besjaar-ui-sticky-atc__rating">★ {{ rating_metafield.value.rating | default: rating_metafield.value }}</span>{% endif %}</span></div>
      </div>
      <button class="besjaar-ui-button besjaar-ui-button--primary" type="button" data-sticky-submit aria-describedby="{{ product_status_id }}" {% unless selected_variant.available %}disabled{% endunless %}>{% if selected_variant.available %}{{ 'besjaar_ui.product.add_to_cart' | t: price: selected_variant.price | money }}{% else %}{{ 'besjaar_ui.product.sold_out' | t }}{% endif %}</button>
    </div>
  {% endif %}

  <dialog class="besjaar-ui-product-zoom" data-product-zoom-dialog aria-label="{{ 'besjaar_ui.product.zoom_image' | t | escape }}">
    <button type="button" class="besjaar-ui-product-zoom__close" data-product-zoom-close aria-label="{{ 'besjaar_ui.product.close_zoom' | t | escape }}">×</button>
    <img src="" alt="{{ display_title | escape }}" width="{{ product.featured_image.width | default: 1600 }}" height="{{ product.featured_image.height | default: 1600 }}" data-product-zoom-image>
  </dialog>


  <script type="application/json" data-besjaar-ui-product-context>
    {
      "id": {{ product.id | json }},
      "title": {{ display_title | json }},
      "family": {{ product_family | json }},
      "url": {{ product.url | json }},
      "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | json }}{% else %}""{% endif %},
      "price": {{ product.price | money | json }},
      "brand": {{ display_vendor | json }}
    }
  </script>

  <script type="application/json" data-product-variants-json>
    [
      {% for variant in product.variants %}
        {
          "id": {{ variant.id | json }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | json }},
          "priceFormatted": {{ variant.price | money | json }},
          "compareAtPrice": {{ variant.compare_at_price | default: 0 | json }},
          "compareAtPriceFormatted": {{ variant.compare_at_price | money | json }},
          "unitPriceFormatted": {% if variant.unit_price_measurement %}{{ variant.unit_price | money | unit_price_with_measurement: variant.unit_price_measurement | json }}{% else %}""{% endif %},
          "sellingPlans": [
            {% for allocation in variant.selling_plan_allocations %}
              {
                "id": {{ allocation.selling_plan.id | json }},
                "name": {{ allocation.selling_plan.name | json }},
                "priceFormatted": {{ allocation.price | money | json }},
                "checkoutChargeFormatted": {{ allocation.checkout_charge_amount | money | json }},
                "selected": {{ allocation.selling_plan.selected | json }}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          "sku": {{ variant.sku | json }},
          "featuredMediaId": {% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</section>

{% endif %}
{% schema %}{
  "name": "Main product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_breadcrumb",
      "label": "Show contextual collection in breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show review rating when available",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_short_description",
      "label": "Show short description below purchase box",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_facts",
      "label": "Show metafield quick facts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sticky_atc",
      "label": "Show sticky purchase bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "shower_editorial_mode",
      "label": "Use shower editorial purchase styling",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_details",
      "label": "Show product metadata",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_restock_fallback",
      "label": "Show sold-out fallback panel",
      "default": true
    },
    {
      "type": "url",
      "id": "restock_contact_link",
      "label": "Restock contact / notification link"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}{% endschema %}
