                              assign value_label = 'besjaar_ui.common.included' | t
                            when 'exclusief', 'not included', 'niet inbegrepen'
                              assign value_label = 'besjaar_ui.product.option_not_included' | t
                            when 'zonder slang', 'without hose'
                              assign value_label = 'besjaar_ui.product.option_without_hose' | t
                            when 'zilver', 'silver'
                              assign value_label = 'besjaar_ui.product.color_silver' | t
                            when 'chroom', 'chrome'
                              assign value_label = 'besjaar_ui.product.color_chrome' | t
                            when 'zwart', 'black'
                              assign value_label = 'besjaar_ui.product.color_black' | t
                            when 'wit', 'white'
                              assign value_label = 'besjaar_ui.product.color_white' | t
                          endcase
                        %}
                        <option value="{{ value | escape }}"{% if value.selected or option.selected_value == value %} selected{% endif %}>{{ value_label }}</option>
                      {% endfor %}
                    </select>
                  {% endif %}
                {% endfor %}
