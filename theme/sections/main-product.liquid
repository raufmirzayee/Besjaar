                      elsif option_name_lc == 'kleur' or option_name_lc == 'color' or option_name_lc == 'colour'
                        assign option_label = 'besjaar_ui.product.option_color' | t
                      endif
                    %}
                    <label class="besjaar-ui-label" for="ProductOption-{{ section.id }}-{{ option.position }}">{{ option_label }}</label>
