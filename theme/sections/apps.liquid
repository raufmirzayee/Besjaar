{%- comment -%}
  Besjaar 6 Nov 2026: compact spacing. This section only holds small app
  widgets (on the home page: the Trustpilot "Beoordeel ons op Trustpilot"
  button), yet it took the full section padding of the theme (up to 132px above
  and below). On the home page an older rule in besjaar-seo-carriers-late.css
  added up to 60px more on the wrapper, left from when this section held the
  Judge.me carousel. The space above and below is now a setting, 24px by
  default. The section id in the selectors outranks both older rules.
{%- endcomment -%}
<section class="besjaar-ui-section besjaar-ui-apps-section">
  <div class="besjaar-ui-shell">
    <div class="besjaar-ui-apps-section__inner">
      {% for block in section.blocks %}
        {% if block.type == '@app' %}{% render block %}{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
<style>
  html body #shopify-section-{{ section.id }}{padding:0}
  html body #shopify-section-{{ section.id }} .besjaar-ui-apps-section{padding:{{ section.settings.padding_y | default: 24 }}px 0}
</style>
{% schema %}
{
  "name":"Apps",
  "settings":[
    {"type":"range","id":"padding_y","min":0,"max":96,"step":4,"unit":"px","label":"Ruimte boven en onder","default":24}
  ],
  "blocks":[{"type":"@app"}],
  "presets":[{"name":"Apps"}]
}
{% endschema %}
