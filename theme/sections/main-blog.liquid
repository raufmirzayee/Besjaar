<section class="nova-section"><div class="nova-shell"><header class="nova-page-head"><p class="nova-kicker">{{ 'nova.blog.kicker' | t }}</p><h1 class="nova-title">{{ blog.title }}</h1></header>{% paginate blog.articles by 12 %}<div class="nova-grid nova-grid--3">{% for article in blog.articles %}<article class="nova-card nova-result-card" data-reveal>{% if article.image %}<a href="{% render 'localized-internal-url', url: article.url %}">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}</a>{% endif %}<p class="nova-kicker" style="margin-top:15px">{{ article.published_at | date: '%d.%m.%Y' }}</p><h2><a href="{% render 'localized-internal-url', url: article.url %}">{{ article.title }}</a></h2><p>{% if article.excerpt != blank %}{{ article.excerpt | strip_html | truncatewords: 24 }}{% else %}{{ article.content | strip_html | truncatewords: 24 }}{% endif %}</p></article>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="nova-pagination" aria-label="{{ 'nova.accessibility.pagination' | t | escape }}">{% if paginate.previous %}<a href="{% render 'localized-internal-url', url: paginate.previous.url %}" aria-label="{{ 'nova.accessibility.previous_page' | t | escape }}">←</a>{% endif %}<span class="current">{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a href="{% render 'localized-internal-url', url: paginate.next.url %}" aria-label="{{ 'nova.accessibility.next_page' | t | escape }}">→</a>{% endif %}</nav>{% endif %}{% endpaginate %}</div></section>
{% schema %}{"name":"Main blog","settings":[]}{% endschema %}
