<section class="besjaar-ui-section"><div class="besjaar-ui-shell"><header class="besjaar-ui-page-head"><p class="besjaar-ui-kicker">{{ 'besjaar_ui.blog.kicker' | t }}</p><h1 class="besjaar-ui-title">{{ blog.title }}</h1></header>{% paginate blog.articles by 12 %}<div class="besjaar-ui-grid besjaar-ui-grid--3">{% for article in blog.articles %}<article class="besjaar-ui-card besjaar-ui-result-card" data-reveal>{% if article.image %}<a href="{% render 'localized-internal-url', url: article.url %}">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}</a>{% endif %}<p class="besjaar-ui-kicker" style="margin-top:15px">{{ article.published_at | date: '%d.%m.%Y' }}</p><h2><a href="{% render 'localized-internal-url', url: article.url %}">{{ article.title }}</a></h2><p>{% if article.excerpt != blank %}{{ article.excerpt | strip_html | truncatewords: 24 }}{% else %}{{ article.content | strip_html | truncatewords: 24 }}{% endif %}</p></article>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="besjaar-ui-pagination" aria-label="{{ 'besjaar_ui.accessibility.pagination' | t | escape }}">{% if paginate.previous %}<a href="{% render 'localized-internal-url', url: paginate.previous.url %}" aria-label="{{ 'besjaar_ui.accessibility.previous_page' | t | escape }}">←</a>{% endif %}<span class="current">{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a href="{% render 'localized-internal-url', url: paginate.next.url %}" aria-label="{{ 'besjaar_ui.accessibility.next_page' | t | escape }}">→</a>{% endif %}</nav>{% endif %}{% endpaginate %}</div></section>
{% schema %}{"name":"Main blog","settings":[]}{% endschema %}
