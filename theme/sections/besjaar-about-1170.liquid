  body[data-page-type="page"] .nova-about-v461__categories>a>small{display:block!important;margin:0 12px 14px!important;color:var(--bj-muted,#49627D)!important;font-size:.8rem!important;line-height:1.45!important}

  /* About — service */
  body[data-page-type="page"] .nova-about-v461__service{display:grid!important;grid-template-columns:minmax(0,1fr)!important;gap:18px!important;margin:0 0 20px!important;padding:22px!important;border:1px solid var(--bj-line,rgba(21,50,82,.12))!important;border-radius:18px!important;background:var(--bj-ice-50,#F6F9FC)!important}
  body[data-page-type="page"] .nova-about-v461__service h2{margin:0 0 8px!important;font-size:1.3rem!important}
  body[data-page-type="page"] .nova-about-v461__service-points{display:flex!important;flex-direction:column!important;gap:8px!important}
  body[data-page-type="page"] .nova-about-v461__service-points span{display:flex!important;align-items:center!important;gap:10px!important;padding:12px 14px!important;border:1px solid var(--bj-line,rgba(21,50,82,.12))!important;border-radius:12px!important;background:#FFFFFF!important;color:var(--bj-navy,#153252)!important;font-size:.9rem!important;font-weight:600!important}
}
</style>
{%- endif -%}
{% schema %}
{
  "name": "Besjaar page polish",
  "settings": [
    {
      "type": "paragraph",
      "content": "11.6.18: About page on phones (hero fits the screen, navy/ice cards two-up) and the Zakelijk page at every width (stops the hero photo overflowing sideways and pinning the content to the left). Keep in the header group."
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
