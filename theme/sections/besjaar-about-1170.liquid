  body[data-page-type="page"] .nova-about-v461__hero{display:grid!important;grid-template-columns:minmax(0,1fr)!important;align-items:start!important;gap:26px!important;padding:18px 0 30px!important}
  body[data-page-type="page"] .nova-about-v461__hero>*{min-width:0!important;max-width:100%!important}
  body[data-page-type="page"] .nova-about-v461__principles>*,
  body[data-page-type="page"] .nova-about-v461__categories>*,
  body[data-page-type="page"] .nova-about-v461__story>*,
  body[data-page-type="page"] .nova-about-v461__service>*{min-width:0!important}

  /* About — type and palette */
