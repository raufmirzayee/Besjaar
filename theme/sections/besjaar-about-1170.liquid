  body[data-page-type="page"] .nova-about-v461 h1{max-width:none!important;margin:0 0 14px!important;color:var(--bj-navy-deep,#0F2947)!important;font-size:clamp(1.95rem,8.4vw,2.8rem)!important;font-weight:600!important;line-height:1.06!important;letter-spacing:-.03em!important;overflow-wrap:break-word!important;hyphens:auto}
  body[data-page-type="page"] .nova-about-v461 h2{color:var(--bj-navy-deep,#0F2947)!important;font-weight:600!important;letter-spacing:-.025em!important;line-height:1.12!important;overflow-wrap:break-word!important}
  body[data-page-type="page"] .nova-about-v461 p{color:var(--bj-muted,#49627D)!important}
  body[data-page-type="page"] .nova-about-v461__hero-copy>p:not(.nova-kicker){max-width:none!important;font-size:1rem!important;line-height:1.6!important;overflow-wrap:break-word!important}
  body[data-page-type="page"] .nova-about-v461__hero-actions{display:flex!important;flex-wrap:wrap!important;gap:10px!important;margin-top:20px!important}
  body[data-page-type="page"] .nova-about-v461 .nova-button{flex:1 1 auto!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;min-height:52px!important;padding:0 18px!important;border-radius:999px!important;font-size:.95rem!important;font-weight:600!important;letter-spacing:0!important;text-transform:none!important;text-decoration:none!important;white-space:nowrap!important}
  body[data-page-type="page"] .nova-about-v461 .nova-button--primary{border:0!important;background:var(--bj-navy,#153252)!important;color:#FFFFFF!important;box-shadow:0 12px 28px rgba(15,41,71,.2)!important}
  body[data-page-type="page"] .nova-about-v461 .nova-button--ghost{border:1.5px solid var(--bj-navy,#153252)!important;background:#FFFFFF!important;color:var(--bj-navy,#153252)!important;box-shadow:none!important}

  /* About — principles */
  body[data-page-type="page"] .nova-about-v461__principles{display:grid!important;grid-template-columns:minmax(0,1fr)!important;gap:12px!important;margin:4px 0 36px!important;padding:0!important;border:0!important;overflow:visible!important}
  body[data-page-type="page"] .nova-about-v461__principles article{margin:0!important;padding:18px!important;border:1px solid var(--bj-line,rgba(21,50,82,.12))!important;border-radius:16px!important;background:var(--bj-ice-50,#F6F9FC)!important;box-shadow:none!important}
  body[data-page-type="page"] .nova-about-v461__principles article span{display:inline-flex!important;align-items:center!important;justify-content:center!important;width:32px!important;height:32px!important;margin:0 0 12px!important;border-radius:50%!important;background:var(--bj-navy,#153252)!important;color:#FFFFFF!important;font-size:.68rem!important;font-weight:700!important}
  body[data-page-type="page"] .nova-about-v461__principles article h2{margin:0 0 6px!important;font-size:1.05rem!important}
  body[data-page-type="page"] .nova-about-v461__principles article p{margin:0!important;font-size:.9rem!important;line-height:1.5!important}

  /* About — story */
  body[data-page-type="page"] .nova-about-v461__story{display:grid!important;grid-template-columns:minmax(0,1fr)!important;gap:14px!important;margin:0 0 36px!important;padding:26px 0!important;border-top:1px solid var(--bj-line,rgba(21,50,82,.12))!important;border-bottom:1px solid var(--bj-line,rgba(21,50,82,.12))!important}
  body[data-page-type="page"] .nova-about-v461__story h2{margin:0 0 8px!important;font-size:1.35rem!important}
  body[data-page-type="page"] .nova-about-v461__story p:not(.nova-kicker){font-size:.98rem!important;line-height:1.6!important;max-width:none!important}

  /* About — category head */
  body[data-page-type="page"] .nova-about-v461__category-head{display:flex!important;flex-direction:column!important;align-items:flex-start!important;gap:10px!important;margin:0 0 16px!important}
  body[data-page-type="page"] .nova-about-v461__category-head h2{margin:0!important;max-width:none!important;font-size:clamp(1.5rem,6.6vw,2rem)!important}
  body[data-page-type="page"] .nova-about-v461__category-head a{display:inline-flex!important;align-items:center!important;gap:6px!important;padding:0!important;color:var(--bj-blue,#2F628F)!important;font-size:.9rem!important;font-weight:600!important;text-decoration:none!important;white-space:nowrap!important}

  /* About — category cards */
  body[data-page-type="page"] .nova-about-v461__categories{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important;margin:0 0 36px!important;padding:0!important;overflow:visible!important;scroll-snap-type:none!important}
  body[data-page-type="page"] .nova-about-v461__categories>a{position:relative!important;display:flex!important;flex-direction:column!important;width:auto!important;min-width:0!important;max-width:none!important;min-height:0!important;margin:0!important;padding:0!important;border:1px solid var(--bj-line,rgba(21,50,82,.12))!important;border-radius:16px!important;background:#FFFFFF!important;color:var(--bj-navy-deep,#0F2947)!important;overflow:hidden!important;box-shadow:none!important;text-decoration:none!important;flex:0 1 auto!important;scroll-snap-align:none!important}
  body[data-page-type="page"] .nova-about-v461__categories>a::before{content:""!important;display:block!important;width:100%!important;aspect-ratio:4/3!important;background:var(--bj-card-img) center center / cover no-repeat!important}
  body[data-page-type="page"] .nova-about-v461__categories>a:nth-child(1){--bj-card-img:var(--bj-about-1)}
  body[data-page-type="page"] .nova-about-v461__categories>a:nth-child(2){--bj-card-img:var(--bj-about-2)}
  body[data-page-type="page"] .nova-about-v461__categories>a:nth-child(3){--bj-card-img:var(--bj-about-3)}
  body[data-page-type="page"] .nova-about-v461__categories>a:nth-child(4){--bj-card-img:var(--bj-about-4)}
  body[data-page-type="page"] .nova-about-v461__categories>a>span{position:absolute!important;top:10px!important;left:10px!important;z-index:1!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;min-width:30px!important;height:24px!important;margin:0!important;padding:0 8px!important;border-radius:999px!important;background:rgba(255,255,255,.92)!important;color:var(--bj-navy,#153252)!important;font-size:.62rem!important;font-weight:700!important;letter-spacing:.08em!important}
  body[data-page-type="page"] .nova-about-v461__categories>a>i{position:absolute!important;top:10px!important;right:10px!important;z-index:1!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;width:28px!important;height:28px!important;margin:0!important;border-radius:50%!important;background:rgba(255,255,255,.92)!important;color:var(--bj-navy,#153252)!important;font-style:normal!important;font-size:.85rem!important}
