<section class="besjaar-ui-section besjaar-ui-auth-page besjaar-ui-auth-v41 besjaar-ui-auth-v41--utility">
  <div class="besjaar-ui-shell besjaar-ui-auth-v41__utility-shell">
    <div class="besjaar-ui-auth-v41__card">
      <div class="besjaar-ui-auth-v41__card-head"><span>{{ 'besjaar_ui.account.customer_space' | t }}</span><h1>{{ 'besjaar_ui.account.reset_title' | t }}</h1><p>{{ 'besjaar_ui.account.reset_copy' | t }}</p></div>
      {% form 'reset_customer_password' %}
        <div class="besjaar-ui-auth-fields">
          <div><label class="besjaar-ui-label" for="ResetPassword">{{ 'besjaar_ui.account.new_password' | t }}</label><input class="besjaar-ui-input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
          <div><label class="besjaar-ui-label" for="ResetPasswordConfirmation">{{ 'besjaar_ui.account.confirm_password' | t }}</label><input class="besjaar-ui-input" id="ResetPasswordConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
          <button class="besjaar-ui-button besjaar-ui-button--primary besjaar-ui-auth-v41__submit" type="submit">{{ 'besjaar_ui.account.save' | t }}</button>
        </div>
        {% if form.errors %}<div class="besjaar-ui-form-message" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      {% endform %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Reset password","settings":[]}
{% endschema %}
