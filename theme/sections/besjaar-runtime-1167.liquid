        var chev = document.createElement('span');
        chev.className = 'bj-m-chev';
        chev.setAttribute('aria-hidden', 'true');
        chev.innerHTML = svg('chevron');
        link.appendChild(chev);
      }
    };
    var makeLabel = function (text) {
      var label = document.createElement('span');
      label.className = 'bj-m-label';
      label.textContent = text;
      return label;
    };

    var shop = menu.querySelector('.besjaar-ui-mobile-menu__shop');
    if (shop) {
      var title = shop.querySelector('.besjaar-ui-mobile-menu__shop-title');
      if (title) {
        title.classList.add('bj-m-primary');
        if (!title.querySelector('span[aria-hidden]')) {
          var arrow = document.createElement('span');
          arrow.setAttribute('aria-hidden', 'true');
          arrow.textContent = '\u2192';
          title.appendChild(arrow);
        }
        if (title.parentNode !== shop) shop.insertBefore(title, shop.firstChild);
      }
      var cats = shop.querySelector('.besjaar-ui-mobile-menu__categories');
      if (cats && cats.children.length) {
        cats.hidden = false;
        cats.classList.add('bj-m-tiles');
        Array.prototype.forEach.call(cats.querySelectorAll('a'), function (link) { link.classList.add('bj-m-tile'); decorate(link, 'grid', false); });
        if (config.categories && !shop.querySelector('.bj-m-label')) shop.insertBefore(makeLabel(config.categories), cats);
      }
    }

    Array.prototype.forEach.call(menu.children, function (child) {
      if (child.tagName === 'A') { child.classList.add('bj-m-row'); decorate(child, 'link', true); }
    });

    var more = menu.querySelector('.besjaar-ui-mobile-menu__more');
    if (more) {
      var label = null;
      var links = [];
      Array.prototype.forEach.call(more.children, function (child) {
        if (child.tagName === 'SPAN' && !label) label = child;
        else if (child.tagName === 'A') links.push(child);
      });
      if (links.length) {
        var grid = more.querySelector('.bj-m-tiles');
        if (!grid) {
          grid = document.createElement('div');
          grid.className = 'bj-m-tiles';
          links.forEach(function (link) { grid.appendChild(link); });
          more.appendChild(grid);
        }
        links.forEach(function (link) { link.classList.add('bj-m-tile'); decorate(link, 'link', false); });
        if (label) { label.className = 'bj-m-label'; if (config.more) label.textContent = config.more; more.insertBefore(label, grid); }
      }
    }

    var legacy = menu.querySelectorAll('.bj-menu-toggle, .bj-menu-panel');
    Array.prototype.forEach.call(legacy, function (node) { if (node.classList.contains('bj-menu-toggle')) node.remove(); });

    if (config.foot && !menu.querySelector('.bj-menu-foot')) {
      var foot = document.createElement('p');
      foot.className = 'bj-menu-foot';
      foot.textContent = config.foot;
      menu.appendChild(foot);
    }
  };

  var init = function () { warmGallery(); stabiliseAccordions(); tickerStrip(); linkFeatureCards(); mountCta360(); modernizeMobileMenu(); };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
  document.addEventListener('shopify:section:load', init);
})();
</script>
