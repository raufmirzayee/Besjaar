{%- comment -%}
  Besjaar trust & support (2026-10-14, simplified 2026-10-15): shipping,
  returns, warranty and payment as four short tiles in one row, plus one
  contact button. On phones the row stays on one line: icon above a short
  title, without the sub-line.
  Policy pages stay reachable from the footer; fitting help lives in the
  guides section above.

  Nothing here is hard-coded: the return window and warranty come from the
  theme settings (return_window_days, warranty_months), the payment icons from
  the payment methods enabled for the store, and the contact page from the
  theme settings already used elsewhere.
{%- endcomment -%}
{%- liquid
  capture v_kicker
    render 'besjaar-brand-copy', key: 'trust_kicker'
  endcapture
  capture v_heading
    render 'besjaar-brand-copy', key: 'trust_heading'
  endcapture
  capture v_ship_title
    render 'besjaar-brand-copy', key: 'ship_title'
  endcapture
  capture v_return_title
    render 'besjaar-brand-copy', key: 'return_title'
  endcapture
  capture v_warranty_title
    render 'besjaar-brand-copy', key: 'warranty_title'
  endcapture
  capture v_pay_title
    render 'besjaar-brand-copy', key: 'pay_title'
  endcapture
  capture v_help_title
    render 'besjaar-brand-copy', key: 'help_title'
  endcapture
  capture v_contact
    render 'besjaar-brand-copy', key: 'contact_cta'
  endcapture

  comment
    One short line per tile, per language.
  endcomment
  assign bjt_lang = request.locale.iso_code | split: '-' | first | downcase
  case bjt_lang
    when 'en'
      assign t_ship = 'Costs and delivery time shown before checkout.'
      assign t_return = '[days] days to change your mind.'
      assign t_warranty = '[months]-month warranty on your product.'
      assign t_pay = 'Shopify’s secure checkout.'
      assign t_help = 'We’re happy to help.'
    when 'de'
      assign t_ship = 'Kosten und Lieferzeit siehst du vor dem Bezahlen.'
      assign t_return = '[days] Tage Bedenkzeit ab Erhalt.'
      assign t_warranty = '[months] Monate Garantie auf dein Produkt.'
      assign t_pay = 'Sicherer Shopify-Checkout.'
      assign t_help = 'Wir helfen dir gern.'
    when 'fr'
      assign t_ship = 'Frais et délai affichés avant le paiement.'
      assign t_return = '[days] jours pour changer d’avis.'
      assign t_warranty = 'Garantie de [months] mois sur votre produit.'
      assign t_pay = 'Paiement sécurisé Shopify.'
      assign t_help = 'Nous vous aidons volontiers.'
    when 'es'
      assign t_ship = 'Ves costes y plazo de entrega antes de pagar.'
      assign t_return = '[days] días para cambiar de opinión.'
      assign t_warranty = '[months] meses de garantía en tu producto.'
      assign t_pay = 'Checkout seguro de Shopify.'
      assign t_help = 'Te ayudamos encantados.'
    else
      assign t_ship = 'Kosten en levertijd zie je vóór het afrekenen.'
      assign t_return = '[days] dagen bedenktijd na ontvangst.'
      assign t_warranty = '[months] maanden garantie op je product.'
      assign t_pay = 'Via de beveiligde Shopify-checkout.'
      assign t_help = 'We helpen je graag.'
  endcase

  assign return_days = settings.return_window_days | default: 0 | plus: 0
  assign warranty_months = settings.warranty_months | default: 0 | plus: 0
  assign return_days_label = return_days | append: ''
  assign warranty_months_label = warranty_months | append: ''

  assign contact_page = settings.contact_page
  if contact_page == blank
    assign contact_page = pages['contact-us']
  endif
-%}
{{ 'besjaar-brand.css' | asset_url | stylesheet_tag }}
<section class="bjb bjb-trust bjb-trust--simple" id="besjaar-brand-trust" aria-labelledby="BjbTrustTitle-{{ section.id }}">
  <div class="bjb__shell">
    <header class="bjb-trust__head">
      <div>
        <p class="bjb__kicker">{{ v_kicker | strip | escape }}</p>
        <h2 class="bjb__h2" id="BjbTrustTitle-{{ section.id }}">{{ v_heading | strip | escape }}</h2>
      </div>
    </header>

    <ul class="bjb-trust__grid">
      <li class="bjb-trust__item">
        <h3><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg>{{ v_ship_title | strip | escape }}</h3>
        <p>{{ t_ship | escape }}</p>
      </li>

      {%- if return_days > 0 -%}
        <li class="bjb-trust__item">
          <h3><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h11a5 5 0 0 1 0 10H9"/><path d="M8 5 4 9l4 4"/></svg>{{ v_return_title | strip | escape }}</h3>
          <p>{{ t_return | replace: '[days]', return_days_label | escape }}</p>
        </li>
      {%- endif -%}

      {%- if section.settings.show_warranty and warranty_months > 0 -%}
        <li class="bjb-trust__item">
          <h3><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg>{{ v_warranty_title | strip | escape }}</h3>
          <p>{{ t_warranty | replace: '[months]', warranty_months_label | escape }}</p>
        </li>
      {%- endif -%}

      <li class="bjb-trust__item">
        <h3><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>{{ v_pay_title | strip | escape }}</h3>
        <p>{{ t_pay | escape }}</p>
      </li>
    </ul>

    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="bjb-trust__payments" aria-label="{{ v_pay_title | strip | escape }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if contact_page != blank -%}
      <div class="bjb-trust__help">
        <h3>{{ v_help_title | strip | escape }} <span>{{ t_help | escape }}</span></h3>
        <a class="bjb-btn bjb-btn--light" href="{% render 'localized-internal-url', url: contact_page.url %}">{{ v_contact | strip | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
<style>
  .bjb-trust--simple{padding:clamp(40px,5.5vw,76px) 0}
  .bjb-trust--simple .bjb-trust__head{display:block;margin-bottom:22px}
  .bjb-trust--simple .bjb-trust__grid{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:12px}
  .bjb-trust--simple .bjb-trust__item{gap:6px;padding:18px}
  .bjb-trust--simple .bjb-trust__item h3{font-size:.98rem}
  .bjb-trust--simple .bjb-trust__item p{font-size:.86rem;line-height:1.5}
  .bjb-trust--simple .bjb-trust__payments{justify-content:center;gap:8px;margin:20px 0 0}
  .bjb-trust--simple .bjb-trust__help{margin-top:20px;padding:18px 22px;border-radius:18px}
  .bjb-trust--simple .bjb-trust__help h3{font-size:1.1rem}
  .bjb-trust--simple .bjb-trust__help h3 span{font-weight:400;opacity:.88}
  @media (max-width:640px){
    .bjb-trust--simple .bjb-trust__grid{gap:0;border:1px solid var(--bjb-line);border-radius:16px;background:var(--bjb-chrome);overflow:hidden}
    .bjb-trust--simple .bjb-trust__item{align-items:center;padding:14px 4px 13px;border:0;border-radius:0;background:transparent;text-align:center}
    .bjb-trust--simple .bjb-trust__item+.bjb-trust__item{border-left:1px solid var(--bjb-line)}
    .bjb-trust--simple .bjb-trust__item h3{flex-direction:column;gap:7px;font-size:.74rem;line-height:1.2;text-wrap:balance}
    .bjb-trust--simple .bjb-trust__item h3 svg{width:22px;height:22px}
    .bjb-trust--simple .bjb-trust__item p{display:none}
    .bjb-trust--simple .bjb-trust__help{flex-direction:column;align-items:stretch;gap:14px;padding:18px}
    .bjb-trust--simple .bjb-trust__help h3 span{display:block;margin-top:2px;font-size:.92rem}
  }
</style>
{% schema %}
{
  "name": "Besjaar trust & support",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Return window and warranty come from Theme settings. Payment icons show the payment methods enabled for the store."
    },
    {
      "type": "checkbox",
      "id": "show_warranty",
      "label": "Show warranty",
      "info": "Uses the 'warranty months' theme setting. Only switch on when that period matches your warranty terms.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_contact_details",
      "label": "Show support e-mail and phone",
      "info": "Not used in the simplified layout.",
      "default": false
    },
    {
      "type": "text",
      "id": "blog_handle",
      "label": "Guides blog handle",
      "info": "Not used in the simplified layout.",
      "default": "gids"
    }
  ],
  "presets": [{ "name": "Besjaar trust & support" }]
}
{% endschema %}