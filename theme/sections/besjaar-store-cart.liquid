{% liquid
  capture threshold
    render 'besjaar-shipping-zone', field: 'threshold_cents'
  endcapture
  assign threshold = threshold | strip | plus: 0
  assign remaining = threshold | minus: cart.total_price
  assign progress = 0
  assign remaining_money = remaining | money
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
  endif
  capture continue_url_capture
    render 'shower-store-url'
  endcapture
  assign continue_url = continue_url_capture | strip
  comment
    Besjaar 11.6: the continue/empty links are merchant-overridable via the two
    theme-editor URL settings; the focused shower collection stays the default.
  endcomment
  if section.settings.continue_link != blank
    capture continue_url_capture
      render 'localized-internal-url', url: section.settings.continue_link
    endcapture
    assign continue_url = continue_url_capture | strip
  endif
  assign empty_url = continue_url
  if section.settings.empty_link != blank
    capture empty_url_capture
      render 'localized-internal-url', url: section.settings.empty_link
    endcapture
    assign empty_url = empty_url_capture | strip
  endif
%}

