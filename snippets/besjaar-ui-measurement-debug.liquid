{% if settings.enable_measurement_layer and settings.analytics_debug_mode %}
<details class="besjaar-ui-measurement-debug" data-besjaar-ui-measurement-debug>
  <summary>{{ 'besjaar_ui.analytics.debug_title' | t }}</summary>
  <div class="besjaar-ui-measurement-debug__body">
    <div><span>{{ 'besjaar_ui.analytics.debug_page' | t }}</span><strong data-besjaar-ui-debug="page">{{ request.page_type }}</strong></div>
    <div><span>{{ 'besjaar_ui.analytics.debug_analytics' | t }}</span><strong data-besjaar-ui-debug="analytics">{{ 'besjaar_ui.analytics.unknown' | t }}</strong></div>
    <div><span>{{ 'besjaar_ui.analytics.debug_marketing' | t }}</span><strong data-besjaar-ui-debug="marketing">{{ 'besjaar_ui.analytics.unknown' | t }}</strong></div>
    <div><span>{{ 'besjaar_ui.analytics.debug_preferences' | t }}</span><strong data-besjaar-ui-debug="preferences">{{ 'besjaar_ui.analytics.unknown' | t }}</strong></div>
    <div><span>{{ 'besjaar_ui.analytics.debug_attribution' | t }}</span><strong data-besjaar-ui-debug="attribution">{{ 'besjaar_ui.analytics.no_campaign' | t }}</strong></div>
    <div><span>{{ 'besjaar_ui.analytics.debug_pixel_bridge' | t }}</span><strong data-besjaar-ui-debug="bridge">{{ 'besjaar_ui.analytics.unknown' | t }}</strong></div>
    <div><span>{{ 'besjaar_ui.analytics.debug_last_event' | t }}</span><strong data-besjaar-ui-debug="event">{{ 'besjaar_ui.analytics.debug_waiting' | t }}</strong></div>
    <p>{{ 'besjaar_ui.analytics.debug_notice' | t }}</p>
  </div>
</details>
{% endif %}
