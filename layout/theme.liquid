<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#FFFFFF">
    <meta name="color-scheme" content="light">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="//cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- comment -%}Besjaar 11.3: variable Inter (true intermediate weights instead of browser-synthesized ones) + Jost, the display face the homepage skin was designed around.{%- endcomment -%}
    {%- comment -%}Besjaar 11.6: font CSS loads asynchronously (print-swap trick) so first paint never waits on the cross-origin stylesheet; display=swap plus the size-adjusted fallback faces below keep text visible and stable meanwhile.{%- endcomment -%}
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Jost:wght@300..800&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Jost:wght@300..800&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Jost:wght@300..800&display=swap"></noscript>
    <link rel="canonical" href="{{ canonical_url | escape }}">
    {% if request.page_type == 'index' %}
      {%- comment -%}Besjaar SEO 2026-09-11: preload the asset the home page hero actually renders (sections/besjaar-store-hero.liquid). The previous preload pointed at besjaar-premium-hero-pressure-v3.webp, which the home page never requests — it cost an unused ~77 KB download and left the real LCP image unprioritised. No srcset here for the same reason the hero section gives: Shopify's CDN does not generate size variants for theme assets.{%- endcomment -%}
      <link rel="preload" as="image" href="{{ 'besjaar-hero-premium-spa.webp' | asset_url }}" fetchpriority="high">
    {% elsif request.page_type == 'product' and product.featured_image != blank %}
      {%- comment -%}Besjaar 11.6: preload the image the gallery actually renders (variant media wins over featured image) with the section's exact sizes value, so the preload always matches the LCP request.{%- endcomment -%}
      {% assign besjaar_ui_preload_image = product.selected_or_first_available_variant.featured_media.preview_image | default: product.featured_media.preview_image | default: product.featured_image %}
      <link rel="preload" as="image" href="{{ besjaar_ui_preload_image | image_url: width: 1600 }}" imagesrcset="{{ besjaar_ui_preload_image | image_url: width: 700 }} 700w, {{ besjaar_ui_preload_image | image_url: width: 1100 }} 1100w, {{ besjaar_ui_preload_image | image_url: width: 1600 }} 1600w" imagesizes="(max-width: 900px) 100vw, 56vw" fetchpriority="high">
    {% endif %}
    {%- comment -%}
      Besjaar 11.6.18: Google only uses a favicon that is square and a multiple
      of 48px (48, 96, 144 …) and explicitly says NOT to supply a 16x16 — the
      old 16/32/128 set is why search showed a generic globe. A merchant
      favicon is now emitted at 96 and 192; without one the theme falls back to
      the bundled square PNG first, with the SVG retained as a supplemental
      browser favicon. Google
      re-reads this on its own crawl schedule, so changes take days to weeks.
    {%- endcomment -%}
    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" sizes="96x96" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {% else %}
      <link rel="icon" type="image/png" sizes="128x128" href="{{ 'besjaar-favicon.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'besjaar-favicon-32.png' | asset_url }}">
      <link rel="icon" type="image/svg+xml" href="{{ 'besjaar-favicon.svg' | asset_url }}">
      <link rel="shortcut icon" type="image/png" href="{{ 'besjaar-favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ 'besjaar-apple-touch-icon.png' | asset_url }}">
    {% endif %}

    {% render 'seo-head' %}
    {{ content_for_header }}

    <style>
      :root {
        --besjaar-ui-bg: {{ settings.bg }};
        --besjaar-ui-surface: {{ settings.surface }};
        --besjaar-ui-text: {{ settings.text }};
        --besjaar-ui-muted: {{ settings.muted }};
        --besjaar-ui-accent: {{ settings.accent }};
        --besjaar-ui-accent-2: {{ settings.accent_2 }};
        --besjaar-ui-accent-warm: {{ settings.accent_warm }};
        --besjaar-ui-width: {{ settings.page_width }}px;
        --besjaar-ui-radius: {{ settings.card_radius }}px;
      }
    </style>
    <style id="besjaar-ui-critical-css">
      /* Besjaar 11.6: size-adjusted local fallback faces so the Inter/Jost swap-in causes no layout shift while the async font CSS loads. */
      @font-face{font-family:"Inter Fallback";src:local("Arial");size-adjust:107%;ascent-override:90%;descent-override:22.5%;line-gap-override:0%}
      @font-face{font-family:"Jost Fallback";src:local("Arial");size-adjust:93%;ascent-override:101%;descent-override:28%;line-gap-override:0%}
      html,body{margin:0;padding:0}body{background:var(--besjaar-ui-bg,#FFFFFF);color:var(--besjaar-ui-text,#10231C);font-family:Inter,"Inter Fallback",ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}img{max-width:100%;height:auto;display:block}*,*:before,*:after{box-sizing:border-box}.besjaar-ui-shell{width:min(calc(100% - 32px),var(--besjaar-ui-width,1360px));margin-inline:auto}.besjaar-ui-header{position:sticky;top:0;z-index:100}.besjaar-ui-hero__grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);align-items:center;gap:48px}.besjaar-ui-button{display:inline-flex;align-items:center;justify-content:center}.besjaar-ui-grid{display:grid;gap:18px}@media(max-width:900px){.besjaar-ui-hero__grid{grid-template-columns:1fr}}@media(max-width:700px){.besjaar-ui-shell{width:min(calc(100% - 24px),var(--besjaar-ui-width,1360px))}}
    </style>
    {{ 'besjaar-seo-base.css' | asset_url | stylesheet_tag }}
    
    {%- comment -%}Besjaar 9.3: load the editorial system only where homepage/product storytelling needs it.{%- endcomment -%}
    {% if request.page_type == 'index' or request.page_type == 'product' %}
      {{ 'besjaar-store-home.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {%- comment -%}Cart drawer is global, so its styles must be global too.{%- endcomment -%}
    {{ 'besjaar-ui-cart.css' | asset_url | stylesheet_tag }}
    {% case request.page_type %}
      {% when 'index' %}
        {%- comment -%}Besjaar 9.0: homepage uses the current editorial system; legacy besjaar-ui-home.css remains compatibility-only.{%- endcomment -%}
      {% when 'product' %}
        {% if template.suffix == 'shower' %}
          {{ 'besjaar-ui-product-page.css' | asset_url | stylesheet_tag }}
          {% if settings.enable_shower_bundle %}{{ 'besjaar-ui-bundle.css' | asset_url | stylesheet_tag }}{% endif %}
          {% if settings.enable_smart_recommendations %}{{ 'besjaar-ui-recommendations.css' | asset_url | stylesheet_tag }}{% endif %}
        {% endif %}
      {% when 'collection' %}
        {%- comment -%}Besjaar 11.6: both collection templates render besjaar-shower-collection (besjaar-collection-* classes) — besjaar-ui-catalog.css styled nothing there while the real collection CSS was only discovered late from the section body. Load the Besjaar collection files from the head (the section's identical tags deduplicate); main-collection.liquid now self-loads besjaar-ui-catalog.css if it is ever reselected.{%- endcomment -%}
        {{ 'besjaar-shower-collection.css' | asset_url | stylesheet_tag }}
        {{ 'besjaar-collection-step3.css' | asset_url | stylesheet_tag }}
        {{ 'besjaar-collection-actions-1134.css' | asset_url | stylesheet_tag }}
      {% when 'search', 'list-collections' %}
        {{ 'besjaar-ui-catalog.css' | asset_url | stylesheet_tag }}
      {% when 'cart' %}
        {% if settings.show_cart_addons %}{{ 'besjaar-ui-bundle.css' | asset_url | stylesheet_tag }}{% endif %}
        {% if settings.enable_smart_recommendations %}{{ 'besjaar-ui-recommendations.css' | asset_url | stylesheet_tag }}{% endif %}
      {% when 'page', 'blog', 'article', '404' %}
        {{ 'besjaar-ui-pages.css' | asset_url | stylesheet_tag }}
    {% endcase %}
    {% if request.page_type contains 'customers' or template.name contains 'customers' %}
      {{ 'besjaar-ui-account.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if request.path contains '/apps/parcelpanel' and request.page_type != 'page' and request.page_type != 'blog' and request.page_type != 'article' and request.page_type != '404' %}
      {{ 'besjaar-ui-pages.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {{ 'besjaar-seo-design.css' | asset_url | stylesheet_tag }}
    
    {%- comment -%}Besjaar 10.2: screenshot-matched Besjaar layout correction + unified navy/white visual system.{%- endcomment -%}
    
    
    
    {% if request.page_type == 'index' %}{{ 'besjaar-home-step2.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if request.page_type == 'index' %}{{ 'besjaar-mobile-feature-cards.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if request.page_type == 'product' and template.suffix == 'shower' %}{{ 'besjaar-ui-shower-trust-education.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if request.page_type == 'product' %}{{ 'besjaar-product-step4.css' | asset_url | stylesheet_tag }}{% endif %}
    {{ 'besjaar-seo-commerce.css' | asset_url | stylesheet_tag }}
    
    
    {% if request.page_type == 'product' %}{{ 'besjaar-mobile-detail-clarity.css' | asset_url | stylesheet_tag }}{% endif %}
    {{ 'besjaar-seo-finish.css' | asset_url | stylesheet_tag }}
    {%- comment -%}Besjaar 11.3: premium lux layer — must stay the LAST stylesheet so its navy unification and polish sit on top of every earlier generation.{%- endcomment -%}
    
    {%- comment -%}Besjaar 11.5: shared storefront refinement and interaction states.{%- endcomment -%}
    
    {% unless request.visual_preview_mode %}
    {% liquid
      capture besjaar_ui_js_shop_url_capture
        render 'shower-store-url'
      endcapture
      assign besjaar_ui_js_shop_url = besjaar_ui_js_shop_url_capture | strip

      assign besjaar_ui_search_collection = settings.shower_collection
      if besjaar_ui_search_collection == blank
        assign besjaar_ui_search_collection = collections['badkamer-douche']
      endif
      if besjaar_ui_search_collection == blank
        assign besjaar_ui_search_collection = collections['douchekoppen']
      endif
      if besjaar_ui_search_collection == blank
        assign besjaar_ui_search_collection = collections['showerheads']
      endif
      if besjaar_ui_search_collection == blank
        assign besjaar_ui_search_collection = collections['douche']
      endif
      if besjaar_ui_search_collection == blank
        assign besjaar_ui_search_collection = collections['shower']
      endif

      comment
        Featured shower model selectors are presentation controls only. They must
        never become a hard catalogue whitelist, so future shower products remain
        purchasable and discoverable without a theme update.
      endcomment
      assign besjaar_ui_focus_locked = false

      capture besjaar_ui_focus_product_ids
        echo '['
        assign besjaar_ui_focus_first = true
        if settings.shower_model_1 != blank
          echo settings.shower_model_1.id | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_2 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_2.id | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_3 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_3.id | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_4 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_4.id | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_5 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_5.id | json
        endif
        echo ']'
      endcapture

      capture besjaar_ui_search_product_ids
        echo '['
        assign besjaar_ui_search_first = true
        if besjaar_ui_search_collection != blank
          for besjaar_ui_search_product in besjaar_ui_search_collection.products limit: 50
            unless besjaar_ui_search_first
              echo ','
            endunless
            echo besjaar_ui_search_product.id | json
            assign besjaar_ui_search_first = false
          endfor
        endif
        if settings.bundle_accessory_1 != blank
          unless besjaar_ui_search_first
            echo ','
          endunless
          echo settings.bundle_accessory_1.id | json
          assign besjaar_ui_search_first = false
        endif
        if settings.bundle_accessory_2 != blank
          unless besjaar_ui_search_first
            echo ','
          endunless
          echo settings.bundle_accessory_2.id | json
          assign besjaar_ui_search_first = false
        endif
        if settings.bundle_accessory_3 != blank
          unless besjaar_ui_search_first
            echo ','
          endunless
          echo settings.bundle_accessory_3.id | json
          assign besjaar_ui_search_first = false
        endif
        echo ']'
      endcapture

      capture besjaar_ui_focus_handles
        echo '['
        assign besjaar_ui_focus_first = true
        if settings.shower_model_1 != blank
          echo settings.shower_model_1.handle | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_2 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_2.handle | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_3 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_3.handle | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_4 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_4.handle | json
          assign besjaar_ui_focus_first = false
        endif
        if settings.shower_model_5 != blank
          unless besjaar_ui_focus_first
            echo ','
          endunless
          echo settings.shower_model_5.handle | json
        endif
        echo ']'
      endcapture

      assign besjaar_ui_runtime_contact_page = settings.contact_page
      if besjaar_ui_runtime_contact_page == blank
        assign besjaar_ui_runtime_contact_page = pages['contact']
      endif
      capture besjaar_ui_runtime_contact_url
        if besjaar_ui_runtime_contact_page != blank
          render 'localized-internal-url', url: besjaar_ui_runtime_contact_page.url
        else
          render 'localized-internal-url', url: '/pages/contact'
        endif
      endcapture
      assign besjaar_ui_runtime_contact_url = besjaar_ui_runtime_contact_url | strip

      assign besjaar_ui_runtime_faq_page = settings.faq_page
      if besjaar_ui_runtime_faq_page == blank
        assign besjaar_ui_runtime_faq_page = pages['veelgestelde-vragen']
      endif
      if besjaar_ui_runtime_faq_page == blank
        assign besjaar_ui_runtime_faq_page = pages['faq']
      endif
      capture besjaar_ui_runtime_faq_url
        if besjaar_ui_runtime_faq_page != blank
          render 'localized-internal-url', url: besjaar_ui_runtime_faq_page.url
        else
          render 'localized-internal-url', url: '/pages/faq'
        endif
      endcapture
      assign besjaar_ui_runtime_faq_url = besjaar_ui_runtime_faq_url | strip

      assign besjaar_ui_runtime_tracking_page = settings.tracking_page
      capture besjaar_ui_runtime_tracking_url
        if besjaar_ui_runtime_tracking_page != blank
          render 'localized-internal-url', url: besjaar_ui_runtime_tracking_page.url
        else
          render 'localized-internal-url', url: '/apps/parcelpanel'
        endif
      endcapture
      assign besjaar_ui_runtime_tracking_url = besjaar_ui_runtime_tracking_url | strip
    %}
    <script>
      window.BesjaarUIConfig = {
        routes: {
          root: {{ routes.root_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          cart: {{ routes.cart_url | json }},
          cartJson: {{ routes.cart_url | append: '.js' | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          allProducts: {{ besjaar_ui_js_shop_url | json }},
          contact: {{ besjaar_ui_runtime_contact_url | json }},
          faq: {{ besjaar_ui_runtime_faq_url | json }},
          tracking: {{ besjaar_ui_runtime_tracking_url | json }}
        },
        trackingCopy: {
          kicker: {{ 'besjaar_ui.tracking_app.kicker' | t | json }},
          title: {{ 'besjaar_ui.tracking_app.title' | t | json }},
          body: {{ 'besjaar_ui.tracking_app.body' | t | json }},
          order: {{ 'besjaar_ui.tracking_app.order' | t | json }},
          tracking: {{ 'besjaar_ui.tracking_app.tracking' | t | json }},
          support: {{ 'besjaar_ui.tracking_app.support' | t | json }},
          supportBody: {{ 'besjaar_ui.tracking_app.support_body' | t | json }},
          supportCta: {{ 'besjaar_ui.tracking_app.support_cta' | t | json }},
          chip1: {{ 'besjaar_ui.tracking_app.chip1' | t | json }},
          chip2: {{ 'besjaar_ui.tracking_app.chip2' | t | json }},
          chip3: {{ 'besjaar_ui.tracking_app.chip3' | t | json }}
        },
        currency: {{ cart.currency.iso_code | default: shop.currency | json }},
        catalog: {
          focusLocked: {{ besjaar_ui_focus_locked | json }},
          focusProductIds: {{ besjaar_ui_focus_product_ids | strip }},
          searchProductIds: {{ besjaar_ui_search_product_ids | strip }},
          focusHandles: {{ besjaar_ui_focus_handles | strip }}
        },
        commerce: {
          showFreeShippingBar: {{ settings.show_free_shipping_bar | json }},
          freeShippingThresholdCents: {{ settings.free_shipping_threshold | times: 100 | json }},
          showCartAddons: {{ settings.show_cart_addons | json }}
        },
        delivery: {
          enabled: {{ settings.show_delivery_estimates | json }},
          region: {% if settings.enable_markets_localization and localization.country != blank %}{{ localization.country.name | json }}{% else %}{{ settings.delivery_region_label | json }}{% endif %},
          cutoffHour: {{ settings.order_cutoff_hour | json }},
          processingDays: {{ settings.processing_business_days | json }},
          transitMinDays: {{ settings.transit_min_business_days | json }},
          transitMaxDays: {{ settings.transit_max_business_days | json }},
          skipWeekends: {{ settings.skip_delivery_weekends | json }}
        },
        searchDiscovery: {
          showRecent: {{ settings.show_recent_searches | json }},
          recentLimit: {{ settings.recent_search_limit | json }},
          showBrands: {{ settings.show_search_brands | json }},
          showPopular: {{ settings.show_search_popular | json }},
          popularTerms: {{ 'besjaar_ui.search.popular_terms' | t | json }}
        },
        mobile: {
          fullscreenSearch: {{ settings.mobile_fullscreen_search | json }},
          swipeGallery: {{ settings.mobile_swipe_gallery | json }},
          filterSheet: {{ settings.mobile_filter_sheet | json }},
          compactHeader: {{ settings.mobile_compact_header | json }}
        },
        markets: {
          enabled: {{ settings.enable_markets_localization | json }},
          country: {{ localization.country.iso_code | json }},
          countryName: {{ localization.country.name | json }},
          currency: {{ localization.country.currency.iso_code | json }},
          language: {{ localization.language.iso_code | json }}
        },
        editor: {
          designMode: {{ request.design_mode | json }}
        },
        design: {
          polishedMotion: {{ settings.enable_polished_motion | json }},
          sectionReveal: {{ settings.enable_section_reveal | json }},
          cardLift: {{ settings.enable_card_lift | json }},
          stickyDesktopBuybox: {{ settings.sticky_desktop_buybox | json }}
        },
        analytics: {
          enabled: {{ settings.enable_measurement_layer | json }},
          attribution: {{ settings.enable_campaign_attribution | json }},
          debug: {{ settings.analytics_debug_mode | json }},
          context: {
            pageType: {{ request.page_type | json }},
            locale: {{ request.locale.iso_code | json }},
            currency: {{ cart.currency.iso_code | default: shop.currency | json }},
            productId: {% if product %}{{ product.id | json }}{% else %}null{% endif %},
            productHandle: {% if product %}{{ product.handle | json }}{% else %}null{% endif %},
            productTitle: {% if product %}{{ product.title | json }}{% else %}null{% endif %},
            variantId: {% if product %}{{ product.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
            collectionHandle: {% if collection %}{{ collection.handle | json }}{% else %}null{% endif %},
            searchTerms: {% if search %}{{ search.terms | json }}{% else %}null{% endif %},
            cartItemCount: {{ cart.item_count | default: 0 | json }}
          },
          i18n: {
            yes: {{ 'besjaar_ui.analytics.yes' | t | json }},
            no: {{ 'besjaar_ui.analytics.no' | t | json }},
            unknown: {{ 'besjaar_ui.analytics.unknown' | t | json }},
            noCampaign: {{ 'besjaar_ui.analytics.no_campaign' | t | json }},
            waiting: {{ 'besjaar_ui.analytics.debug_waiting' | t | json }},
            save: {{ 'besjaar_ui.analytics.save' | t | json }},
            saving: {{ 'besjaar_ui.analytics.saving' | t | json }},
            saved: {{ 'besjaar_ui.analytics.saved' | t | json }},
            unavailable: {{ 'besjaar_ui.analytics.unavailable' | t | json }},
            ready: {{ 'besjaar_ui.analytics.ready' | t | json }},
            unavailableShort: {{ 'besjaar_ui.analytics.unavailable_short' | t | json }}
          }
        },
        i18n: {
          cartLoading: {{ 'besjaar_ui.js.cart_loading' | t | json }},
          cartEmpty: {{ 'besjaar_ui.js.cart_empty' | t | json }},
          shopProducts: {{ 'besjaar_ui.js.shop_products' | t | json }},
          remove: {{ 'besjaar_ui.js.remove' | t | json }},
          regularPrice: {{ 'besjaar_ui.product.regular_price' | t | json }},
          salePrice: {{ 'besjaar_ui.product.sale_price' | t | json }},
          cartError: {{ 'besjaar_ui.js.cart_error' | t | json }},
          cartUpdateError: {{ 'besjaar_ui.js.cart_update_error' | t | json }},
          cartUpdating: {{ 'besjaar_ui.js.cart_updating' | t | json }},
          cartUpdated: {{ 'besjaar_ui.js.cart_updated' | t | json }},
          invalidQuantity: {{ 'besjaar_ui.js.invalid_quantity' | t | json }},
          variantUnavailable: {{ 'besjaar_ui.js.variant_unavailable' | t | json }},
          retry: {{ 'besjaar_ui.js.retry' | t | json }},
          checkoutLoading: {{ 'besjaar_ui.js.checkout_loading' | t | json }},
