{%- comment -%}
  Besjaar 11.76 (2026-11-04) — mobile cart optimisation, for the cart drawer
  and the cart page. A carrier in the header group, like the other besjaar-*
  sections, so nothing in site-header.liquid, besjaar-cart-1168.liquid or
  besjaar-store-cart.liquid had to change.

  1. Tap targets: on phones the quantity − / + buttons and the bin are 40px
     (they were 34px and 36px), in the drawer and on the cart page.
  2. The discount-code and note fields use 16px text on phones, so iOS Safari
     no longer zooms the page in when a shopper taps them.
  3. Express checkout: Apple Pay / Google Pay / Shop Pay under the checkout
     button. Shopify renders only the wallets the shop has switched on and the
     device supports. They are rendered here and moved under the drawer's (or
     the cart page's) checkout button; in the drawer they are re-rendered
     through the Section Rendering API (sections/besjaar-express-checkout.liquid)
     when the cart changes, as Shopify recommends for cart drawers.
  4. Free-shipping nudge: while the cart is under the free-shipping amount,
     the shipping band (drawer and cart page) offers one matching accessory
     with a one-tap add button: spare filters for a showerhead with a filter,
     the hose for a showerhead sold without one. Nothing shows when nothing
     fits. Products are picked by product type (showerhead / Shower Filter /
     Shower Hose) and tags (Filter, Doucheset); no handles are hard-coded.
  5. Cart page on phones: a checkout bar pinned to the bottom of the screen
     (with the total) while the summary's own checkout button is out of view.
{%- endcomment -%}
{%- liquid
  assign bjn_filter_heads = ''
  assign bjn_bare_heads = ''
  assign bjn_has_refill = false
  assign bjn_has_hose = false
  for bjn_p in collections['all'].products limit: 50
    unless bjn_p.available
      continue
    endunless
    assign bjn_type = bjn_p.type | downcase
    assign bjn_title_lc = bjn_p.title | downcase
    if bjn_type contains 'showerhead' or bjn_type contains 'shower head'
      if bjn_p.tags contains 'Filter' or bjn_title_lc contains 'met filter'
        assign bjn_filter_heads = bjn_filter_heads | append: ',' | append: bjn_p.id
      endif
      unless bjn_p.tags contains 'Doucheset' or bjn_title_lc contains 'met slang'
        assign bjn_bare_heads = bjn_bare_heads | append: ',' | append: bjn_p.id
      endunless
    elsif bjn_type contains 'filter'
      unless bjn_has_refill
        assign bjn_refill = bjn_p
        assign bjn_has_refill = true
      endunless
    elsif bjn_type contains 'hose' or bjn_type contains 'slang'
      unless bjn_has_hose
        assign bjn_hose = bjn_p
        assign bjn_has_hose = true
      endunless
    endif
  endfor
  assign bjn_filter_heads = bjn_filter_heads | remove_first: ','
  assign bjn_bare_heads = bjn_bare_heads | remove_first: ','
-%}
<script type="application/json" data-bj-ship-nudge>
{
  "filterHeads": [{{ bjn_filter_heads }}],
  "bareHeads": [{{ bjn_bare_heads }}],
  "items": [
    {%- assign bjn_n = 0 -%}
    {%- for bjn_i in (1..2) -%}
      {%- if bjn_i == 1 -%}{%- assign bjn_item = bjn_refill -%}{%- assign bjn_kind = 'refill' -%}{%- assign bjn_ok = bjn_has_refill -%}{%- else -%}{%- assign bjn_item = bjn_hose -%}{%- assign bjn_kind = 'hose' -%}{%- assign bjn_ok = bjn_has_hose -%}{%- endif -%}
      {%- if bjn_ok -%}
        {%- assign bjn_v = bjn_item.selected_or_first_available_variant -%}
        {%- if bjn_n > 0 -%},{%- endif -%}
        {"kind": {{ bjn_kind | json }}, "id": {{ bjn_item.id }}, "variantId": {{ bjn_v.id }}, "price": {{ bjn_v.price }}, "image": {% if bjn_item.featured_image %}{{ bjn_item.featured_image | image_url: width: 120 | json }}{% else %}""{% endif %}}
        {%- assign bjn_n = bjn_n | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  ],
  "cart": {"total_price": {{ cart.total_price }}, "item_count": {{ cart.item_count }}, "currency": {{ cart.currency.iso_code | json }}, "items": [{%- for bjn_line in cart.items -%}{%- unless forloop.first -%},{%- endunless -%}{"product_id": {{ bjn_line.product_id }}}{%- endfor -%}]}
}
</script>
{%- if additional_checkout_buttons -%}
  {%- if request.page_type == 'cart' -%}
    <div class="bj-cp-express" data-bj-cp-express>{{ content_for_additional_checkout_buttons }}</div>
  {%- else -%}
    <div class="bj-cd-express" data-bj-cd-express data-sig="{{ cart.item_count }}:{{ cart.total_price }}">{{ content_for_additional_checkout_buttons }}</div>
  {%- endif -%}
{%- endif -%}
{%- if request.page_type == 'cart' and cart.item_count > 0 -%}
  {%- assign bjm_checkout = 'besjaar_ui.cart.drawer_checkout' | t | replace: '→', '' | strip -%}
  <div class="bj-cp-sticky" data-bj-cp-sticky aria-hidden="true">
    <button type="submit" form="besjaar-store-cart-form" name="checkout" value="Checkout" class="bj-cp-checkout" tabindex="-1"><span>{{ bjm_checkout }}</span><span class="bj-cp-sticky__total" data-bj-cp-sticky-total>{{ cart.total_price | money }}</span></button>
  </div>
{%- endif -%}
<style>
  /* Besjaar 11.76 mobile cart optimisation, see the comment above. */
  html body #BesjaarUICartDrawer .bj-cd-express{order:5!important;margin-top:10px!important;--shopify-accelerated-checkout-button-block-size:48px;--shopify-accelerated-checkout-button-inline-size:48px;--shopify-accelerated-checkout-button-border-radius:40px;--shopify-accelerated-checkout-row-gap:8px}
  html body #BesjaarUICartDrawer .bj-cd-express:empty{display:none!important}
  @media (max-width:760px){
    html body #BesjaarUICartDrawer .besjaar-ui-line-quantity{grid-template-columns:40px 40px 40px!important;height:42px!important}
    html body #BesjaarUICartDrawer .besjaar-ui-line-quantity button{width:40px!important;height:40px!important;min-height:40px!important}
    html body #BesjaarUICartDrawer .besjaar-ui-cart-drawer__remove{width:40px!important;height:40px!important;min-height:40px!important;margin-left:134px!important}
    html body #BesjaarUICartDrawer .bj-cd-discount input,html body #BesjaarUICartDrawer .bj-cd-fold textarea{font-size:16px!important}
  }
  /* Free-shipping nudge (drawer band and cart-page band). */
  html body :is(#BesjaarUICartDrawer,.bj-cp) .bj-ship-add{display:grid;grid-template-columns:44px minmax(0,1fr) auto;align-items:center;gap:10px;margin:10px 0 0;padding:8px;border-radius:12px;background:#fff;box-shadow:0 1px 2px rgba(28,35,38,.08)}
  html body :is(#BesjaarUICartDrawer,.bj-cp) .bj-ship-add__media{display:block;width:44px;height:44px;border-radius:8px;background:#F5F2EC;overflow:hidden}
  html body :is(#BesjaarUICartDrawer,.bj-cp) .bj-ship-add__media img{display:block;width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}
  html body :is(#BesjaarUICartDrawer,.bj-cp) .bj-ship-add__copy{display:flex;flex-direction:column;gap:1px;min-width:0}
  html body :is(#BesjaarUICartDrawer,.bj-cp) .bj-ship-add__title{display:block;overflow:hidden;color:#1C2326!important;font-size:13.5px;font-weight:600!important;line-height:1.3;text-overflow:ellipsis;white-space:nowrap}
  html body :is(#BesjaarUICartDrawer,.bj-cp) .bj-ship-add__hint{display:block;color:#1F5F52!important;font-size:12.5px;font-weight:500!important;line-height:1.35}
  html body :is(#BesjaarUICartDrawer,.bj-cp) .bj-ship-add__btn{display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:2px!important;width:auto!important;min-width:0!important;height:40px!important;min-height:40px!important;margin:0!important;padding:0 14px!important;border:0!important;border-radius:40px!important;background:#1F5F52!important;color:#fff!important;font:inherit!important;font-size:14px!important;font-weight:700!important;letter-spacing:0!important;line-height:1!important;text-transform:none!important;white-space:nowrap!important;box-shadow:none!important;cursor:pointer}
  html body :is(#BesjaarUICartDrawer,.bj-cp) .bj-ship-add__btn:hover{background:#174A40!important}
  html body :is(#BesjaarUICartDrawer,.bj-cp) .bj-ship-add__btn[disabled]{opacity:.6!important;cursor:default}
  html body :is(#BesjaarUICartDrawer,.bj-cp) .bj-ship-add__err{grid-column:1 / -1;margin:0;color:#B24530;font-size:12.5px}
  html body :is(#BesjaarUICartDrawer,.bj-cp) .bj-ship-add__err[hidden]{display:none}
  /* Until the script has moved them under a checkout button. */
  html body [data-bj-cd-express]:not(.is-placed),html body [data-bj-cp-express]:not(.is-placed){display:none!important}
  /* Cart page (sections/besjaar-store-cart.liquid). The extra .bj-cp in each
     selector outranks that section's own rules, which come later in the page. */
  html body .bj-cp .bj-cp-express{margin:0;--shopify-accelerated-checkout-button-block-size:48px;--shopify-accelerated-checkout-button-inline-size:48px;--shopify-accelerated-checkout-button-border-radius:40px;--shopify-accelerated-checkout-row-gap:8px}
  html body .bj-cp-sticky{display:none}
  @media (max-width:749px){
    html body .bj-cp .bj-cp-qty button,html body .bj-cp .bj-cp-qty input{width:40px;height:40px;min-height:40px}
    html body .bj-cp .bj-cp-item__remove{width:40px;height:40px}
    html body .bj-cp .bj-cp-qty input,html body .bj-cp .bj-cp-discount input,html body .bj-cp .bj-cp-fold textarea{font-size:16px}
    html body .bj-cp-sticky{position:fixed;left:0;right:0;bottom:0;z-index:45;display:block;padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -8px 18px -14px rgba(28,35,38,.45);transform:translateY(110%);visibility:hidden;transition:transform .25s ease,visibility 0s linear .25s}
    html body .bj-cp-sticky.is-visible{transform:none;visibility:visible;transition:transform .25s ease,visibility 0s}
    html body .bj-cp-sticky .bj-cp-checkout{min-height:52px!important;font-size:16px!important}
    html body .bj-cp-sticky__total::before{content:"·";margin:0 8px 0 2px;opacity:.7}
    html body:has(.bj-cp-sticky){padding-bottom:calc(72px + env(safe-area-inset-bottom))}
  }
  @media (prefers-reduced-motion:reduce){html body .bj-cp-sticky{transition:none}}
</style>
<script src="{{ 'besjaar-cart-mobile-1176.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "Besjaar mobile cart",
  "settings": [
    {
      "type": "paragraph",
      "content": "11.76 (2026-11-04): bigger tap targets and 16px fields on phones, Apple Pay / Google Pay / Shop Pay under the checkout button, a one-tap accessory in the free-shipping band, and a pinned checkout bar on the cart page on phones. Keep in the header group after Besjaar cart polish."
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
