+{%- liquid
+  comment
+    2026-11-07 SEO audit: Shopify policy pages (/policies/*) have no search
+    engine listing field, so page_description was empty and the theme printed
+    <meta name="description" content="">. Policy pages now get a short,
+    language-specific description built from the policy title.
+  endcomment
+  assign seo_head_description = page_description
+  if request.page_type == 'policy' and seo_head_description == blank
+    case seo_head_lang
+      when 'en'
+        assign seo_head_description = page_title | append: ' of Besjaar (Univex B.V., Assen, the Netherlands), the official store for shower heads and shower filters. Questions? Email info@univexbv.com.'
+      when 'de'
+        assign seo_head_description = page_title | append: ' von Besjaar (Univex B.V., Assen, Niederlande), dem offiziellen Shop für Duschköpfe und Duschfilter. Fragen? E-Mail an info@univexbv.com.'
+      when 'fr'
+        assign seo_head_description = page_title | append: ' de Besjaar (Univex B.V., Assen, Pays-Bas), la boutique officielle de pommeaux et filtres de douche. Questions ? info@univexbv.com.'
+      when 'es'
+        assign seo_head_description = page_title | append: ' de Besjaar (Univex B.V., Assen, Países Bajos), la tienda oficial de alcachofas y filtros de ducha. ¿Preguntas? info@univexbv.com.'
+      else
+        assign seo_head_description = page_title | append: ' van Besjaar (Univex B.V., Assen), de officiële webshop voor douchekoppen en douchefilters. Vragen? Mail naar info@univexbv.com.'
+    endcase
+  endif
+-%}
