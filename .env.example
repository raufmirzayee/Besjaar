# Besjaar storefront — environment configuration
#
# Copy to .env and fill in. .env is gitignored: never commit real credentials.
# The store runs without any of these (it serves the bundled catalogue and
# keeps payments disabled), so you can start locally and add services as they
# become available.

# ---------------------------------------------------------------------------
# Supabase — catalogue, accounts, orders, admin
# ---------------------------------------------------------------------------
# Project settings → API. The publishable key is safe in the browser; the
# service role key is server-only and must never be exposed to the client.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Vite inlines the VITE_* copies into the browser bundle. Only ever mirror the
# public values here — never the service role key.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# ---------------------------------------------------------------------------
# Payments — Mollie
# ---------------------------------------------------------------------------
# Without MOLLIE_API_KEY the storefront keeps live payments switched off:
# orders can be placed but are stored as awaiting payment, and the customer is
# told so. Nothing is ever reported as paid without the provider confirming it.
# Start with a test_ key; only the methods enabled in your Mollie account work.
MOLLIE_API_KEY=""
# Public HTTPS URL of the webhook route in this app. Mollie calls it on every
# status change. Must be reachable from the internet (not localhost).
MOLLIE_WEBHOOK_URL="https://www.besjaar.nl/api/public/mollie-webhook"

# ---------------------------------------------------------------------------
# Store identity and policy
# ---------------------------------------------------------------------------
# Canonical origin — used for canonical URLs, OpenGraph, sitemap and redirects.
VITE_SITE_URL="https://www.besjaar.nl"
# Legal entity behind the Besjaar storefront.
VITE_STORE_LEGAL_ENTITY="EenTop"
VITE_STORE_EMAIL="klantenservice@besjaar.nl"
VITE_STORE_PHONE=""

# Shipping and returns policy. These drive the storefront's messaging, so keep
# them in step with what fulfilment can actually deliver.
VITE_FREE_SHIPPING_THRESHOLD="50"
VITE_SHIPPING_RATE="4.95"
VITE_RETURN_DAYS="30"
VITE_WARRANTY_MONTHS="24"
# Optional extra delivery note. Leave empty rather than promising a next-day
# cut-off the carrier has not committed to.
VITE_DISPATCH_NOTE=""
# Set to any value once a payment provider is live, to advertise the methods.
VITE_PAYMENTS_ENABLED=""

# ---------------------------------------------------------------------------
# bol.com marketplace integration (optional)
# ---------------------------------------------------------------------------
# The independent store works fully without these; the integration stays
# configurable and simply reports as not connected.
BOL_CLIENT_ID=""
BOL_CLIENT_SECRET=""
# Shared secret for the scheduled sync endpoint /api/public/bol-sync.
SYNC_TRIGGER_SECRET=""
