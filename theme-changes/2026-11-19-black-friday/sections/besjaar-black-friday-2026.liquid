{%- comment -%}
  Besjaar 2026-11-19: Black Friday 2026 messaging.

  Every product is 35% below its compare-at price until Mon 30 Nov 2026 23:59
  Amsterdam. The price itself carries the discount, so no code is needed (all
  discount codes are paused until 1 Dec). This section makes it obvious that
  the reduction is the Black Friday sale:

    top of every page  one black Black Friday line with a live countdown. It
                       takes the place of the announcement strip ("Gratis
                       verzending vanaf €25 · Morgen in huis · 30 dagen
                       retour"), which is hidden while the sale runs.
    product cards      discount badges read "BLACK FRIDAY / 35% KORTING".
    product page       the badges read "BLACK FRIDAY · …", and a "Black
                       Friday-prijs" line sits under the price.

  It sits in the header group directly before the site header (the group
  allows 25 sections; this is the 25th).

  Nothing renders from 1796079600 (Tue 1 Dec 2026 00:00 Amsterdam), the moment
  the prices go back, and the announcement strip returns by itself. A page that
  stays open past that moment does the same in the browser. No editing is
  needed to retire it.
{%- endcomment -%}
{%- liquid
  assign bjbf_end = 1796079600
  assign bjbf_now = 'now' | date: '%s' | plus: 0
  assign bjbf_live = false
  if bjbf_now < bjbf_end
    assign bjbf_live = true
  endif
-%}
{%- if bjbf_live -%}
{%- liquid
  assign bjbf_lang = request.locale.iso_code | split: '-' | first | downcase
  case bjbf_lang
    when 'en'
      assign bjbf_line = '35% off everything'
      assign bjbf_note = 'No code needed · until 30 November'
      assign bjbf_cta = 'Shop the deals'
      assign bjbf_prefix = 'Ends in'
      assign bjbf_units = 'd|h|m'
      assign bjbf_pdp = 'Black Friday price: 35% off until 30 November. No code needed.'
    when 'de'
      assign bjbf_line = '35% Rabatt auf alles'
      assign bjbf_note = 'Kein Code nötig · bis 30. November'
      assign bjbf_cta = 'Zu den Deals'
      assign bjbf_prefix = 'Noch'
      assign bjbf_units = 'd|h|m'
      assign bjbf_pdp = 'Black-Friday-Preis: 35% Rabatt bis 30. November. Kein Code nötig.'
    when 'fr'
      assign bjbf_line = '-35 % sur tout'
      assign bjbf_note = 'Sans code · jusqu’au 30 novembre'
      assign bjbf_cta = 'Voir les offres'
      assign bjbf_prefix = 'Encore'
      assign bjbf_units = 'j|h|m'
      assign bjbf_pdp = 'Prix Black Friday : -35 % jusqu’au 30 novembre. Aucun code nécessaire.'
    when 'es'
      assign bjbf_line = '35 % de descuento en todo'
      assign bjbf_note = 'Sin código · hasta el 30 de noviembre'
      assign bjbf_cta = 'Ver ofertas'
      assign bjbf_prefix = 'Quedan'
      assign bjbf_units = 'd|h|m'
      assign bjbf_pdp = 'Precio Black Friday: 35 % de descuento hasta el 30 de noviembre. Sin código.'
    else
      assign bjbf_line = '35% korting op alles'
      assign bjbf_note = 'Geen code nodig · t/m 30 november'
      assign bjbf_cta = 'Shop de deals'
      assign bjbf_prefix = 'Nog'
      assign bjbf_units = 'd|u|m'
      assign bjbf_pdp = 'Black Friday-prijs: 35% korting t/m 30 november. Geen code nodig.'
  endcase

  assign bjbf_url = routes.all_products_collection_url

  assign bjbf_left = bjbf_end | minus: bjbf_now
  assign bjbf_d = bjbf_left | divided_by: 86400
  assign bjbf_h = bjbf_left | modulo: 86400 | divided_by: 3600
  assign bjbf_m = bjbf_left | modulo: 3600 | divided_by: 60
  assign bjbf_mm = bjbf_m | prepend: '0' | slice: -2, 2
  assign bjbf_u = bjbf_units | split: '|'
  capture bjbf_compact
    echo bjbf_prefix
    echo ' '
    if bjbf_d > 0
      echo bjbf_d
      echo bjbf_u[0]
      echo ' '
    endif
    echo bjbf_h
    echo bjbf_u[1]
    echo ' '
    echo bjbf_mm
    echo bjbf_u[2]
  endcapture
-%}
<style>
  :root{--bjbf-ink:#0b0b0b;--bjbf-lime:#d4f25a}
  {%- comment -%} The announcement strip makes way for the Black Friday line. {%- endcomment -%}
  html:not(.bjbf-over) body .besjaar-ui-announcement:not(#bjbf-a):not(#bjbf-b):not(#bjbf-c){display:none!important}
  .bjbf-bar{position:relative;z-index:1;background:var(--bjbf-ink);color:#fff;font-family:var(--bj-font-body,Inter,system-ui,sans-serif)}
  html body .bjbf-bar .bjbf-bar__link:not(#bjbf-a){display:flex;align-items:center;justify-content:center;gap:0 12px;width:min(calc(100% - 24px),var(--besjaar-ui-width,1280px));min-height:40px;margin-inline:auto;padding:8px 0;color:#fff;font-size:13px;line-height:1.2;white-space:nowrap;overflow:hidden;text-decoration:none}
  .bjbf-bar__tag{flex:0 0 auto;padding:3px 9px;border-radius:999px;background:var(--bjbf-lime);color:var(--bjbf-ink);font-size:11px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}
  .bjbf-bar__line{flex:0 0 auto;font-weight:800;letter-spacing:.01em}
  .bjbf-bar__note{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;color:rgba(255,255,255,.78);font-weight:500}
  .bjbf-bar__clock{flex:0 0 auto;font-weight:700;font-variant-numeric:tabular-nums;color:var(--bjbf-lime)}
  .bjbf-bar__note::before,.bjbf-bar__clock::before{content:"\00B7";margin-inline-end:12px;color:rgba(255,255,255,.4)}
  .bjbf-bar__cta{flex:0 0 auto;display:inline-flex;align-items:center;gap:6px;padding:3px 11px;border:1px solid rgba(255,255,255,.5);border-radius:999px;font-weight:700;transition:background-color .18s ease,color .18s ease,border-color .18s ease}
  .bjbf-bar__link:hover .bjbf-bar__cta,.bjbf-bar__link:focus-visible .bjbf-bar__cta{background:#fff;border-color:#fff;color:var(--bjbf-ink)}
  @media (max-width:980px){.bjbf-bar__note{display:none}}
  @media (max-width:640px){html body .bjbf-bar .bjbf-bar__link:not(#bjbf-a){gap:0 8px;font-size:12px;min-height:38px;padding:7px 0}.bjbf-bar__cta-label{display:none}.bjbf-bar__cta{padding:2px 8px}.bjbf-bar__tag{font-size:10px;padding:3px 7px}}
  @media (max-width:400px){.bjbf-bar__clock{display:none}}
  @media print{.bjbf-bar{display:none}}

  {%- comment -%} Discount badges on product cards: two lines, "BLACK FRIDAY" above the percentage. {%- endcomment -%}
  html:not(.bjbf-over) body .bj-discount-badge:not(.bj-pd-badge):not(#bjbf-a):not(#bjbf-b){display:inline-flex!important;flex-direction:column!important;align-items:flex-start!important;justify-content:center!important;gap:1px!important;min-height:0!important;padding:5px 10px 6px!important;border-radius:10px!important;background:var(--bjbf-ink)!important;border-color:var(--bjbf-ink)!important;color:#fff!important;line-height:1.1!important;text-align:left!important;white-space:nowrap!important}
  html:not(.bjbf-over) body .bj-discount-badge:not(.bj-pd-badge):not(#bjbf-a):not(#bjbf-b)::before{content:"Black Friday";display:block;color:var(--bjbf-lime);font-size:.9em;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  {%- comment -%} Product page badges (next to the price and on the photo): one line, "BLACK FRIDAY · …". {%- endcomment -%}
  html:not(.bjbf-over) body :is(.bj-pd-badge.bj-pd-badge--dark,.bj-pd-badge.bj-discount-badge,.besjaar-store-premium-pd__sale):not(#bjbf-a):not(#bjbf-b):not(#bjbf-c):not(#bjbf-d){background:var(--bjbf-ink)!important;color:#fff!important;box-shadow:0 10px 24px -14px rgba(0,0,0,.55)!important}
  html:not(.bjbf-over) body :is(.bj-pd-badge.bj-pd-badge--dark,.bj-pd-badge.bj-discount-badge,.besjaar-store-premium-pd__sale):not(#bjbf-a):not(#bjbf-b):not(#bjbf-c):not(#bjbf-d)::before{content:"Black Friday \00B7\00A0";color:var(--bjbf-lime);font-weight:800;letter-spacing:.06em;text-transform:uppercase;white-space:pre}
  {%- comment -%} Product page: a full-width Black Friday line under the price. {%- endcomment -%}
  html:not(.bjbf-over) body .besjaar-store-premium-pd .bj-pd-price:not(#bjbf-a):not(#bjbf-b)::after{content:"{{ bjbf_pdp }}";display:block;flex:0 0 100%;order:99;margin-top:6px;padding:11px 14px;border-left:4px solid var(--bjbf-lime);border-radius:10px;background:var(--bjbf-ink);color:#fff;font-size:13.5px;font-weight:650;line-height:1.35;letter-spacing:0}
</style>
<aside class="bjbf-bar" aria-label="Black Friday" data-bjbf>
  <a class="bjbf-bar__link" href="{{ bjbf_url }}">
    <span class="bjbf-bar__tag">Black Friday</span>
    <span class="bjbf-bar__line">{{ bjbf_line | escape }}</span>
    <span class="bjbf-bar__note">{{ bjbf_note | escape }}</span>
    <span class="bjbf-bar__clock" data-bjbf-compact data-prefix="{{ bjbf_prefix | escape }}" data-units="{{ bjbf_units | escape }}">{{ bjbf_compact | strip | escape }}</span>
    <span class="bjbf-bar__cta"><span class="bjbf-bar__cta-label">{{ bjbf_cta | escape }}</span><span aria-hidden="true">→</span></span>
  </a>
</aside>
<script>
  (() => {
    const END = {{ bjbf_end }} * 1000;
    const pad = (n) => String(n).padStart(2, '0');
    const run = () => {
      const left = Math.floor((END - Date.now()) / 1000);
      if (left <= 0) {
        document.documentElement.classList.add('bjbf-over');
        document.querySelectorAll('[data-bjbf]').forEach((node) => node.remove());
        return false;
      }
      const d = Math.floor(left / 86400);
      const h = Math.floor((left % 86400) / 3600);
      const m = Math.floor((left % 3600) / 60);
      document.querySelectorAll('[data-bjbf-compact]').forEach((node) => {
        const u = (node.dataset.units || 'd|h|m').split('|');
        const parts = [];
        if (d > 0) parts.push(d + u[0]);
        parts.push(h + u[1], pad(m) + u[2]);
        node.textContent = (node.dataset.prefix ? node.dataset.prefix + ' ' : '') + parts.join(' ');
      });
      return true;
    };
    const start = () => {
      if (!run()) return;
      const timer = window.setInterval(() => { if (!run()) window.clearInterval(timer); }, 1000);
      window.addEventListener('pageshow', run);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Besjaar Black Friday 2026",
  "settings": [
    {
      "type": "paragraph",
      "content": "Black Friday 2026: one line at the top of every page (in place of the announcement strip) and Black Friday badges. 35% off the compare-at price, no code needed. Disappears on its own on 1 December 2026 at 00:00 Amsterdam."
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
