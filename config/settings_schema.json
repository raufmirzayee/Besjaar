  {
    "name": "Delivery & trust",
    "settings": [
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 25
      },
      {
        "type": "text",
        "id": "free_shipping_threshold_exact",
        "label": "Exact free shipping threshold (EUR)",
        "info": "Optional. Overrides the slider when the threshold has cents, e.g. 20.99. Must match Settings > Shipping. Leave empty to use the slider."
      },
      {
        "type": "text",
        "id": "standard_shipping_rate",
        "label": "Standard shipping rate (EUR)",
        "info": "Shipping rate for orders below the free-shipping threshold, used in product structured data (Offer shippingDetails). Use a dot for decimals (4.99). Leave 0 or empty to omit.",
        "default": "4.99"
      },
      {
        "type": "text",
        "id": "policy_countries",
        "label": "Zone 1 countries (home zone)",
        "info": "Two-letter country codes, comma-separated (e.g. NL or NL,BE). Shoppers from these countries see the free-shipping threshold and shipping rate above. Also used for the return policy in the product structured data (max. 50).",
        "default": "NL"
      },
      {
        "type": "header",
        "content": "Shipping zone 2"
      },
      {
        "type": "paragraph",
        "content": "Mirror of your second shipping zone in Settings > Shipping. Shoppers from these countries see this threshold, rate and delivery time instead of the home-zone values. Countries outside both zones see no free-shipping promise."
      },
      {
        "type": "text",
        "id": "ship_zone2_countries",
        "label": "Zone 2 countries",
        "info": "Two-letter country codes, comma-separated.",
        "default": "BE,DE,FR"
      },
      {
        "type": "range",
        "id": "ship_zone2_threshold",
        "label": "Zone 2 free shipping threshold",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 30
      },
      {
        "type": "text",
        "id": "ship_zone2_rate",
        "label": "Zone 2 shipping rate (EUR)",
        "info": "Rate below the threshold. Use a dot for decimals (4.95).",
        "default": "4.95"
      },
      {
        "type": "range",
        "id": "ship_zone2_transit_min",
        "label": "Zone 2 minimum transit business days",
        "min": 0,
        "max": 14,
        "step": 1,
        "default": 1
      },
      {
        "type": "range",
        "id": "ship_zone2_transit_max",
        "label": "Zone 2 maximum transit business days",
        "min": 0,
        "max": 14,
        "step": 1,
        "default": 2
      },
      {
        "type": "checkbox",
        "id": "show_free_shipping_bar",
        "label": "Show free-shipping progress",
        "default": true
      },
      {
        "type": "text",
        "id": "delivery_region_label",
        "label": "Shipping origin label",
        "default": "Netherlands"
      },
      {
        "type": "checkbox",
        "id": "show_delivery_estimates",
        "label": "Show delivery estimates",
        "default": true
      },
      {
        "type": "range",
