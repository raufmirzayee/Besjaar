{%- comment -%}
  Besjaar 25 Oct 2026 — customer videos on the product page.

  Each block is one video a customer sent in, picked from Content > Files in
  the theme editor. Because every showerhead uses the default product
  template, one set of blocks covers all of them; the "Show on" setting keeps a
  10-mode filter video off the 3-mode pages and the other way round (matched on
  the 3-standen / 10-standen product tags).

  The section only renders on products whose type is in "Product types" and
  only when at least one video applies, so the filter refill and the hose
  pages stay unchanged and an empty section never shows.

  Only publish videos the customer has given permission for — the caption
  names them.
{%- endcomment -%}
{%- liquid
  assign ptype = product.type | downcase | strip
  assign allowed_types = section.settings.product_types | downcase | split: ','
  assign type_ok = false
  for t in allowed_types
    assign t_clean = t | strip
    if t_clean != blank and t_clean == ptype
      assign type_ok = true
    endif
  endfor

  assign shown = 0
  if type_ok
    for block in section.blocks
      if block.settings.video == blank
        continue
      endif
      case block.settings.show_on
        when '3-standen'
          unless product.tags contains '3-standen'
            continue
          endunless
        when '10-standen'
          unless product.tags contains '10-standen'
            continue
          endunless
      endcase
      assign shown = shown | plus: 1
    endfor
  endif
  assign render_section = false
  if shown > 0
    assign render_section = true
  elsif type_ok and request.design_mode
    assign render_section = true
  endif

  assign v_lang = request.locale.iso_code | split: '-' | first | downcase
  if section.settings.use_localized_copy
    case v_lang
      when 'en'
        assign v_kicker = 'CUSTOMER VIDEOS'
        assign v_heading = 'Real customers, real showers.'
        assign v_note = 'Filmed by customers in their own bathroom and sent to us.'
        assign v_play = 'Customer video'
      when 'de'
        assign v_kicker = 'KUNDENVIDEOS'
        assign v_heading = 'Echte Kunden, echte Duschen.'
        assign v_note = 'Von Kunden im eigenen Bad gefilmt und uns zugeschickt.'
        assign v_play = 'Kundenvideo'
      when 'fr'
        assign v_kicker = 'VIDÉOS CLIENTS'
        assign v_heading = 'De vrais clients, de vraies douches.'
        assign v_note = 'Filmées par nos clients dans leur propre salle de bain.'
        assign v_play = 'Vidéo client'
      when 'es'
        assign v_kicker = 'VÍDEOS DE CLIENTES'
        assign v_heading = 'Clientes reales, duchas reales.'
        assign v_note = 'Grabados por clientes en su propio baño y enviados a nosotros.'
        assign v_play = 'Vídeo de cliente'
      else
        assign v_kicker = "KLANTVIDEO'S"
        assign v_heading = 'Echte klanten, echte douches.'
        assign v_note = 'Gefilmd door klanten in hun eigen badkamer en naar ons gestuurd.'
        assign v_play = 'Klantvideo'
    endcase
  else
    assign v_kicker = section.settings.kicker
    assign v_heading = section.settings.heading
    assign v_note = section.settings.note
    assign v_play = section.settings.kicker
  endif
-%}
{%- if render_section -%}
<section class="besjaar-store bj-cvid" id="bj-cvid-{{ section.id }}" aria-labelledby="BjCvid-{{ section.id }}">
  <div class="besjaar-store-shell">
    <div class="bj-cvid__copy">
      <span class="besjaar-store-kicker">{{ v_kicker | escape }}</span>
      <h2 class="besjaar-store-h2" id="BjCvid-{{ section.id }}">{{ v_heading | escape }}</h2>
      {%- if v_note != blank -%}<p class="bj-cvid__note">{{ v_note | escape }}</p>{%- endif -%}
    </div>

    <ul class="bj-cvid__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.video == blank -%}{%- continue -%}{%- endif -%}
        {%- case block.settings.show_on -%}
          {%- when '3-standen' -%}
            {%- unless product.tags contains '3-standen' -%}{%- continue -%}{%- endunless -%}
          {%- when '10-standen' -%}
            {%- unless product.tags contains '10-standen' -%}{%- continue -%}{%- endunless -%}
        {%- endcase -%}
        {%- liquid
          assign v_label = v_play
          if block.settings.customer != blank
            assign v_label = v_play | append: ' — ' | append: block.settings.customer
          endif
        -%}
        <li class="bj-cvid__item" {{ block.shopify_attributes }}>
          <figure class="bj-cvid__card">
            <div class="bj-cvid__media" role="group" aria-label="{{ v_label | escape }}">
              {{ block.settings.video | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '720x' }}
            </div>
            {%- if block.settings.customer != blank or block.settings.quote != blank -%}
              <figcaption class="bj-cvid__caption">
                {%- if block.settings.rating > 0 -%}
                  <span class="bj-cvid__stars" role="img" aria-label="{{ block.settings.rating }}/5">
                    {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
                  </span>
                {%- endif -%}
                {%- if block.settings.quote != blank -%}<p class="bj-cvid__quote">“{{ block.settings.quote | escape }}”</p>{%- endif -%}
                {%- if block.settings.customer != blank -%}<span class="bj-cvid__name">{{ block.settings.customer | escape }}</span>{%- endif -%}
              </figcaption>
            {%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
      {%- if shown == 0 -%}
        <li class="bj-cvid__empty">Voeg een blok "Klantvideo" toe en kies een video. Klanten zien deze sectie pas als er een video in staat.</li>
      {%- endif -%}
    </ul>
  </div>
</section>
<style>
  .bj-cvid__copy{max-width:44ch}
  .bj-cvid__note{margin:8px 0 0;color:var(--bj-muted,#49627D)}
  .bj-cvid__list{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(220px,72%);gap:14px;margin:22px 0 0;padding:0 0 8px;list-style:none;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
  .bj-cvid__empty{padding:24px;border:1px dashed var(--bj-line,rgba(21,50,82,.24));border-radius:20px;color:var(--bj-muted,#49627D)}
  .bj-cvid__item{scroll-snap-align:start;min-width:0}
  .bj-cvid__card{display:flex;flex-direction:column;height:100%;margin:0;border:1px solid var(--bj-line,rgba(21,50,82,.12));border-radius:20px;background:#FFFFFF;overflow:hidden;box-shadow:0 18px 40px rgba(15,41,71,.08)}
  .bj-cvid__media{position:relative;aspect-ratio:9/16;background:var(--bj-navy-deep,#0F2947)}
  .bj-cvid__media video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
  .bj-cvid__caption{display:flex;flex-direction:column;gap:6px;padding:14px 16px 16px}
  .bj-cvid__stars{color:var(--bj-gold,#D9A441);font-size:.95rem;letter-spacing:.1em;line-height:1}
  .bj-cvid__quote{margin:0;color:var(--bj-navy-deep,#0F2947);font-size:.95rem;line-height:1.45}
  .bj-cvid__name{color:var(--bj-muted,#49627D);font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  @media (min-width:560px){
    .bj-cvid__list{grid-auto-columns:minmax(220px,42%)}
  }
  @media (min-width:901px){
    .bj-cvid__list{grid-auto-flow:row;grid-auto-columns:auto;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;overflow:visible;scroll-snap-type:none}
  }
</style>
<script>
  (function () {
    var root = document.getElementById('bj-cvid-{{ section.id }}');
    if (!root) return;
    // One video at a time: starting one pauses the others.
    root.addEventListener('play', function (e) {
      root.querySelectorAll('video').forEach(function (v) {
        if (v !== e.target) v.pause();
      });
    }, true);
  })();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Klantvideo's",
  "max_blocks": 12,
  "settings": [
    {"type": "text", "id": "product_types", "label": "Producttypes", "info": "Komma-gescheiden. De sectie verschijnt alleen op producten met dit producttype.", "default": "showerhead"},
    {"type": "checkbox", "id": "use_localized_copy", "label": "Gebruik ingebouwde vertalingen (NL/EN/DE/FR/ES)", "default": true},
    {"type": "header", "content": "Eigen teksten"},
    {"type": "paragraph", "content": "Alleen gebruikt als de ingebouwde vertalingen hierboven uit staan."},
    {"type": "text", "id": "kicker", "label": "Kicker", "default": "KLANTVIDEO'S"},
    {"type": "text", "id": "heading", "label": "Kop", "default": "Echte klanten, echte douches."},
    {"type": "textarea", "id": "note", "label": "Tekst", "default": "Gefilmd door klanten in hun eigen badkamer en naar ons gestuurd."}
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Klantvideo",
      "settings": [
        {"type": "video", "id": "video", "label": "Video", "info": "Upload hier of kies uit Content > Bestanden. Staande video's (9:16) passen het best."},
        {
          "type": "select",
          "id": "show_on",
          "label": "Toon op",
          "options": [
            {"value": "all", "label": "Alle douchekoppen"},
            {"value": "3-standen", "label": "Alleen 3-standen douchekoppen"},
            {"value": "10-standen", "label": "Alleen 10-standen douchekoppen (filter)"}
          ],
          "default": "all"
        },
        {"type": "text", "id": "customer", "label": "Naam klant", "info": "Bijv. 'Sanne, Utrecht'. Alleen met toestemming van de klant."},
        {"type": "textarea", "id": "quote", "label": "Citaat (optioneel)"},
        {"type": "range", "id": "rating", "label": "Sterren (0 = verbergen)", "min": 0, "max": 5, "step": 1, "default": 0, "info": "Alleen invullen als de klant zelf deze score gaf."}
      ]
    }
  ],
  "presets": [{"name": "Klantvideo's"}]
}
{% endschema %}
