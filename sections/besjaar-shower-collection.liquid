{{ 'besjaar-shower-collection.css' | asset_url | stylesheet_tag }}
{{ 'besjaar-collection-step3.css' | asset_url | stylesheet_tag }}
{{ 'besjaar-collection-actions-1134.css' | asset_url | stylesheet_tag }}
{{ 'besjaar-collection-wow.css' | asset_url | stylesheet_tag }}

{% liquid
  capture root_url_localized
    render 'localized-internal-url', url: routes.root_url
  endcapture
  assign root_url_localized = root_url_localized | strip

  assign is_all_collection = false
  if collection.handle == 'all'
    assign is_all_collection = true
  endif
  assign current_sort = collection.sort_by | default: collection.default_sort_by
%}

<section class="besjaar-collection-collection besjaar-collection-collection--grouped besjaar-collection-step3 bjc-wow" data-besjaar-collection-collection>
  <div class="besjaar-collection-collection__shell">
    {%- comment -%}2026-10-15: the breadcrumb now sits inside the ocean hero (snippets/besjaar-collection-wow-hero).{%- endcomment -%}

    {% if is_all_collection %}
      {%- comment -%}Besjaar 11.6: the grouped shop hub previously rendered no h1 at all — only per-collection h2s.{%- endcomment -%}
      {% render 'besjaar-collection-wow-hero', collection: collection, is_all: true, root_url: root_url_localized %}
      <div class="besjaar-collection-collection-groups besjaar-collection-collection-groups--shop-first">
        {%- comment -%}
          2026-11-10: one loop instead of three passes. snippets/besjaar-shop-groups
          gives the order (shower heads, filters, other collections, Accessoires
          last) and how many products each group shows; products that are in
          Accessoires (hose, replacement filters) are not repeated in the earlier
          groups, and a group left empty is skipped.
        {%- endcomment -%}
        {%- capture shop_groups -%}{% render 'besjaar-shop-groups' %}{%- endcapture -%}
        {%- capture shop_extras_ids -%}{% render 'besjaar-shop-groups', field: 'extras_ids' %}{%- endcapture -%}
        {%- assign shop_groups = shop_groups | strip | split: ',' -%}
        {%- assign shop_extras_ids = shop_extras_ids | strip -%}
        {% assign rendered_collection_count = 0 %}

        {% for shop_group in shop_groups %}
          {% assign shop_group_parts = shop_group | split: ':' %}
          {% assign shop_group_id = shop_group_parts[0] | plus: 0 %}
          {% assign shop_group_count = shop_group_parts[1] | plus: 0 %}
          {% assign shop_group_kind = shop_group_parts[2] %}
          {% assign shop_collection = nil %}
          {% for candidate_collection in collections %}
            {% if candidate_collection.id == shop_group_id %}{% assign shop_collection = candidate_collection %}{% break %}{% endif %}
          {% endfor %}
          {% if shop_collection == blank %}{% continue %}{% endif %}

          {% capture shop_collection_title %}{% render 'localized-collection-title', collection: shop_collection %}{% endcapture %}
          {% capture shop_collection_url %}{% render 'localized-internal-url', url: shop_collection.url %}{% endcapture %}
          {% assign group_number = rendered_collection_count | plus: 1 %}

          <section class="besjaar-collection-collection-group{% if shop_group_kind != 'other' %} besjaar-collection-collection-group--{{ shop_group_kind }}{% endif %}" id="Collection-{{ shop_collection.handle | escape }}">
            <header class="besjaar-collection-collection-group__head">
              <div class="besjaar-collection-collection-group__identity">
                <span class="besjaar-collection-collection-group__index" aria-hidden="true">{% if group_number < 10 %}0{% endif %}{{ group_number }}</span>
                <div>
                  <p class="besjaar-collection-collection-group__count">{{ 'besjaar_ui.collection.products_count' | t: count: shop_group_count }}</p>
                  <h2>{{ shop_collection_title | strip | escape_once }}</h2>
                  {%- comment -%}Besjaar 11.7: the collection blurb no longer runs under the group heading — the grid speaks for itself. The description still feeds meta tags and structured data.{%- endcomment -%}
                </div>
              </div>
              <a class="besjaar-collection-collection-group__link" href="{{ shop_collection_url | strip }}">{{ 'besjaar_grouped_collection.view_collection' | t }} <span aria-hidden="true">→</span></a>
            </header>

            <div class="besjaar-collection-product-grid besjaar-collection-product-grid--grouped">
              {% render 'seo-visible-item-list', products: shop_collection.products, list_key: shop_collection.id, limit_count: 50, offset: 0 %}
              {% assign shown_in_group = 0 %}
              {% for product in shop_collection.products limit: 50 %}
                {% if shop_group_kind != 'extras' %}
                  {% assign product_token = '|' | append: product.id | append: '|' %}
                  {% if shop_extras_ids contains product_token %}{% continue %}{% endif %}
                {% endif %}
                {% assign shown_in_group = shown_in_group | plus: 1 %}
                {% assign card_loading = 'lazy' %}{% assign card_priority = 'auto' %}{% if rendered_collection_count == 0 and shown_in_group <= 2 %}{% assign card_loading = 'eager' %}{% if shown_in_group == 1 %}{% assign card_priority = 'high' %}{% endif %}{% endif %}
                {% render 'besjaar-grouped-product-card', product: product, image_loading: card_loading, image_priority: card_priority %}
              {% endfor %}
            </div>
          </section>
          {% assign rendered_collection_count = rendered_collection_count | plus: 1 %}
        {% endfor %}

        {% if rendered_collection_count == 0 %}
          <div class="besjaar-collection-empty"><h2>{{ 'besjaar_ui.collection.no_products' | t }}</h2></div>
        {% endif %}
      </div>
    {% else %}
      {% capture current_collection_title %}{% render 'localized-collection-title', collection: collection %}{% endcapture %}

      {%- capture current_collection_description -%}{% render 'localized-collection-description', collection: collection %}{%- endcapture -%}
      {%- assign current_collection_intro = current_collection_description | split: '</p>' | first | strip_html | strip -%}
      {% render 'besjaar-collection-wow-hero', collection: collection, is_all: false, root_url: root_url_localized, intro: current_collection_intro %}

      {%- comment -%}2026-09-22: the product-count / sort toolbar is hidden when sorting is off (templates/collection.json) so the grid follows the intro directly.{%- endcomment -%}
      {% if section.settings.show_sort and collection.sort_options.size > 1 %}
      <div class="besjaar-collection-single-collection-meta besjaar-collection-single-collection-toolbar">
        <div class="besjaar-collection-single-collection-toolbar__count">
          <span aria-hidden="true">—</span>
          <strong>{{ 'besjaar_ui.collection.products_count' | t: count: collection.products_count }}</strong>
        </div>
          <form class="besjaar-collection-collection-sort" action="{{ collection.url }}" method="get" data-collection-sort>
            <label for="BesjaarCollectionSort-{{ section.id }}">{{ 'besjaar_ui.collection.sort' | t }}</label>
            <div class="besjaar-collection-collection-sort__select">
              <select id="BesjaarCollectionSort-{{ section.id }}" name="sort_by" data-collection-sort-select>
                {% for option in collection.sort_options %}
                  <option value="{{ option.value | escape }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name | escape }}</option>
                {% endfor %}
              </select>
              <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m3 5 4 4 4-4"></path></svg>
            </div>
            <button class="besjaar-collection-collection-sort__submit" type="submit">{{ 'besjaar_ui.collection.sort' | t }}</button>
          </form>
      </div>
      {% endif %}

      {% paginate collection.products by section.settings.products_per_page %}
        {% if collection.products_count > 0 %}
          <div class="besjaar-collection-product-grid besjaar-collection-product-grid--grouped">
            {% render 'seo-visible-item-list', products: collection.products, list_key: section.id, limit_count: section.settings.products_per_page, offset: paginate.current_offset %}
            {% for product in collection.products %}
              {% assign card_loading = 'lazy' %}{% assign card_priority = 'auto' %}{% if forloop.index <= 2 %}{% assign card_loading = 'eager' %}{% if forloop.index == 1 %}{% assign card_priority = 'high' %}{% endif %}{% endif %}
              {% render 'besjaar-grouped-product-card', product: product, image_loading: card_loading, image_priority: card_priority %}
            {% endfor %}
          </div>
        {% else %}
          <div class="besjaar-collection-empty"><h2>{{ 'besjaar_ui.collection.no_products' | t }}</h2></div>
        {% endif %}

        {% if paginate.pages > 1 %}
          <nav class="besjaar-collection-pagination" aria-label="{{ 'besjaar_ui.conversion.pagination' | t | escape }}">
            {% if paginate.previous %}<a href="{% render 'localized-internal-url', url: paginate.previous.url %}" aria-label="{{ 'besjaar_ui.conversion.previous_page' | t | escape }}">←</a>{% endif %}
            {% for part in paginate.parts %}
              {% if part.is_link %}<a href="{% render 'localized-internal-url', url: part.url %}">{{ part.title }}</a>
              {% elsif part.title == paginate.current_page %}<span class="is-current" aria-current="page">{{ part.title }}</span>
              {% else %}<span>{{ part.title }}</span>{% endif %}
            {% endfor %}
            {% if paginate.next %}<a href="{% render 'localized-internal-url', url: paginate.next.url %}" aria-label="{{ 'besjaar_ui.conversion.next_page' | t | escape }}">→</a>{% endif %}
          </nav>
        {% endif %}
      {% endpaginate %}
      {%- comment -%}
        2026-09-13: the full collection description no longer renders under the
        grid; it pushed the trust row and footer further down on a five-product
        shop. 2026-09-22: the first paragraph of the description renders under
        the h1 in the header above; the remaining paragraphs render here in a
        collapsed "Meer over ..." panel so the merchant's own category text is
        still on the page (and indexable) without pushing the trust row down.
        The text is untouched in Shopify.
      {%- endcomment -%}
      {%- liquid
        assign more_paragraphs = current_collection_description | split: '</p>'
        capture current_collection_more
          for more_paragraph in more_paragraphs
            if forloop.first
              continue
            endif
            assign more_paragraph_text = more_paragraph | strip_html | strip
            if more_paragraph_text != blank
              echo more_paragraph | append: '</p>'
            endif
          endfor
        endcapture
        assign current_collection_more_text = current_collection_more | strip_html | strip
        assign more_locale = request.locale.iso_code | split: '-' | first | downcase
        case more_locale
          when 'en'
            assign more_label = 'More about'
          when 'de'
            assign more_label = 'Mehr über'
          when 'fr'
            assign more_label = 'En savoir plus sur'
          when 'es'
            assign more_label = 'Más información sobre'
          else
            assign more_label = 'Meer over'
        endcase
        capture more_collection_title
          render 'localized-collection-title', collection: collection
        endcapture
        assign more_collection_title = more_collection_title | strip | replace: '&amp;', '&' | downcase
      -%}
      {%- if current_collection_more_text != blank -%}
        <style>
          .besjaar-collection-collection__more{max-width:760px;margin:26px 0 4px;border-top:1px solid var(--besjaar-collection-line,#e7e9eb)}
          .besjaar-collection-collection__more summary{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 0;cursor:pointer;list-style:none;color:var(--besjaar-collection-ink,#101820);font-size:.92rem;font-weight:700}
          .besjaar-collection-collection__more summary::-webkit-details-marker{display:none}
          .besjaar-collection-collection__more summary::after{content:"+";font-size:1.1rem;font-weight:500;color:#173555}
          .besjaar-collection-collection__more[open] summary::after{content:"\2013"}
          .besjaar-collection-collection__more .besjaar-collection-collection__more-body{padding:0 0 18px;color:#4b5a66;font-size:.92rem;line-height:1.65}
          .besjaar-collection-collection__more .besjaar-collection-collection__more-body p{margin:0 0 12px}
          .besjaar-collection-collection__more .besjaar-collection-collection__more-body a{color:#173555;text-decoration:underline;text-underline-offset:3px}
        </style>
        <details class="besjaar-collection-collection__more">
          <summary>{{ more_label }} {{ more_collection_title | escape_once }}</summary>
          <div class="besjaar-collection-collection__more-body">{{ current_collection_more }}</div>
        </details>
      {%- endif -%}
    {% endif %}

    {%- render 'besjaar-collection-trust' -%}
  </div>
</section>

{% schema %}
{
  "name": "Grouped collection shop",
  "settings": [
    {"type":"range","id":"products_per_page","label":"Products per page","min":8,"max":24,"step":4,"default":12},
    {"type":"checkbox","id":"show_sort","label":"Show collection sorting","default":true}
  ],
  "presets":[{"name":"Grouped collection shop"}]
}
{% endschema %}
