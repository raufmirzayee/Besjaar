{%- comment -%}
  Besjaar 25 Oct 2026 — slim review-score bar for the top of the home page.

  Holds app blocks only (the Trustpilot TrustScore widget), centred in a low
  white strip under the hero, so the score is visible without scrolling. The
  widget's own settings (size, colours, language) stay editable in the theme
  editor on the block.
{%- endcomment -%}
<section class="bj-tp" aria-label="Trustpilot">
  <div class="bj-tp__inner">
    {%- for block in section.blocks -%}
      <div class="bj-tp__item" {{ block.shopify_attributes }}>{% render block %}</div>
    {%- endfor -%}
  </div>
</section>
<style>
  .bj-tp{padding:14px 16px;background:#fff;border-bottom:1px solid #e4e9ed}
  .bj-tp__inner{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:10px 28px;max-width:1320px;margin:0 auto}
  .bj-tp__item{flex:0 1 auto;min-width:0;max-width:100%}
  .bj-tp__item:only-child{flex-basis:100%}
</style>
{% schema %}
{
  "name": "Trustpilot-score",
  "settings": [],
  "blocks": [{"type": "@app"}],
  "presets": [{"name": "Trustpilot-score"}]
}
{% endschema %}
